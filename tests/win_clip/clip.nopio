// win.clip 官方 API 面回归（E-17）。
//
// 契约来源：D:\aardio\lib\win\clip\_.aardio（`namespace win.clip;`）
// 官方定义 12 个成员：
//   readUtf16 / read / write / writeBitmap / readBitmap / clear / test /
//   formats / formatNames / getFormatName / eachFormat / readUnicode
//
// 官方文档（docs\guide\language\syntax-quick-ref.md:1621、
// docs\guide\ide\system-prompt.md:2541）要求显式 `import win.clip;`，
// 而 Nodio 的 IDE（ide/nodio/app/editor.nodio）不导入、直接用 `win.clip.*`。
// 于是同一条 API 存在两条路径：
//   B-* = 引擎内置实现（未导入时的兜底）
//   O-* = 官方包实现（import win.clip; 之后）
// 本脚本把两条路径都跑一遍，要求二者的 API 面与语义一致。
//
// 剪贴板是**全局**系统资源：被同机其它进程占用时 OpenClipboard 返回 0
// （ERROR_ACCESS_DENIED），官方语义是「静默失败」——相关调用返回 null。
// 占用可能发生在运行中途（剪贴板管理器/远端会话随时来抢），开头探测一次
// 判定全程是错的（会有假红）——所以**每一步操作前都重新探测**，把结果
// 作为 `CLIP0/CLIP1` 门拼在该步输出末尾，由回归脚本按门选择期望值：
//   CLIP1 → 断言成功语义；CLIP0 → 断言官方「静默失败」语义。
// 依赖「我们写入的内容」的断言（read/test/formats/eachFormat）只在
// 对应 write 真正成功时才判定（写入失败时板上是什么内容不可控）。
function safe(f)
{
	try{ return f() }
	catch(e){ return null }
}

// 每步前重探：自己 Open 一次试试（开了就关掉），拿到的就是「此刻能不能用」
function probeClip()
{
	var h = ::User32.OpenClipboard(0);
	if(h) ::User32.CloseClipboard();
	return h ? 1 : 0;
}

io.print("CLIP-OK " ++ probeClip());

// ---------------- B: 引擎内置实现 ----------------
var names = {"readUtf16","read","write","writeBitmap","readBitmap","clear","test","formats","getFormatName","eachFormat","readUnicode"};
var miss = 0;
for(i=1;#names;1)
{
	if(type(win.clip[names[i]]) != "native function")
	{
		miss = miss + 1;
		io.print("B-MISSING " ++ names[i] ++ " " ++ tostring(type(win.clip[names[i]])));
	}
}
io.print("B-API-MISS " ++ miss);
io.print("B-FMTNAMES " ++ tostring(type(win.clip.formatNames)) ++ " " ++ tostring(win.clip.formatNames[13]) ++ " " ++ tostring(win.clip.formatNames[1]));
io.print("B-GFN " ++ tostring(win.clip.getFormatName(13,true)) ++ " " ++ tostring(win.clip.getFormatName(999,true)) ++ " " ++ tostring(win.clip.getFormatName(999,false)));

var bClipW = probeClip();
var bWrite = safe(function(){ return win.clip.write("nodio-clip-roundtrip") });
io.print("B-WRITE " ++ tostring(bWrite ? 1 : 0) ++ " CLIP" ++ bClipW);

var bClipR = probeClip();
var bRead = safe(function(){ return win.clip.read() });
io.print("B-READ " ++ tostring(bRead) ++ " CLIP" ++ bClipR);

var bClipR2 = probeClip();
var bRead16 = safe(function(){ return win.clip.readUtf16() });
io.print("B-READ16 " ++ tostring(bRead16) ++ " CLIP" ++ bClipR2);

var bClipT = probeClip();
io.print("B-TEST13 " ++ tostring(safe(function(){ return win.clip.test(13) })) ++ " CLIP" ++ bClipT);

var bClipF = probeClip();
var bFmt = safe(function(){ return win.clip.formats() });
io.print("B-FMT-HAS13 " ++ tostring(bFmt ? (..table.find(bFmt,13) ? 1 : 0) : null) ++ " CLIP" ++ bClipF);

var bClipE = probeClip();
var bEach = safe(function(){ return win.clip.eachFormat() });
var bEachHas = null;
if(bEach)
{
	bEachHas = 0;
	var id, name;
	while(true)
	{
		id, name = bEach();
		if(id === null) break;
		if(id == 13) bEachHas = 1;
	}
}
io.print("B-EACH-HAS13 " ++ tostring(bEachHas) ++ " CLIP" ++ bClipE);

var bClipC = probeClip();
var bClear = safe(function(){ return win.clip.clear() });
io.print("B-CLEAR " ++ tostring(bClear) ++ " CLIP" ++ bClipC);

var bClipR3 = probeClip();
var bRead2 = safe(function(){ return win.clip.read() });
io.print("B-READ2 " ++ tostring(bRead2) ++ " CLIP" ++ bClipR3);

// ---------------- O: 官方包实现 ----------------
// 官方文档要求显式导入；导入后官方包整体覆盖内置实现。
import win.clip;

var miss2 = 0;
for(i=1;#names;1)
{
	if(type(win.clip[names[i]]) != "function")
	{
		miss2 = miss2 + 1;
		io.print("O-MISSING " ++ names[i] ++ " " ++ tostring(type(win.clip[names[i]])));
	}
}
io.print("O-API-MISS " ++ miss2);
io.print("O-FMTNAMES " ++ tostring(type(win.clip.formatNames)) ++ " " ++ tostring(win.clip.formatNames[13]) ++ " " ++ tostring(win.clip.formatNames[1]));
io.print("O-GFN " ++ tostring(safe(function(){ return win.clip.getFormatName(13,true) })) ++ " " ++ tostring(safe(function(){ return win.clip.getFormatName(999,true) })) ++ " " ++ tostring(safe(function(){ return win.clip.getFormatName(999,false) })));

var oClipW = probeClip();
var oWrite = safe(function(){ return win.clip.write("nodio-clip-roundtrip") });
io.print("O-WRITE " ++ tostring(oWrite ? 1 : 0) ++ " CLIP" ++ oClipW);

var oClipR = probeClip();
var oRead = safe(function(){ return win.clip.read() });
io.print("O-READ " ++ tostring(oRead) ++ " CLIP" ++ oClipR);

var oClipR2 = probeClip();
var oRead16 = safe(function(){ return win.clip.readUtf16() });
io.print("O-READ16 " ++ tostring(oRead16) ++ " CLIP" ++ oClipR2);

var oClipT = probeClip();
io.print("O-TEST13 " ++ tostring(safe(function(){ return win.clip.test(13) })) ++ " CLIP" ++ oClipT);

var oClipF = probeClip();
var oFmt = safe(function(){ return win.clip.formats() });
io.print("O-FMT-HAS13 " ++ tostring(oFmt ? (..table.find(oFmt,13) ? 1 : 0) : null) ++ " CLIP" ++ oClipF);

var oClipE = probeClip();
var oEach = safe(function(){ return win.clip.eachFormat() });
var oEachHas = null;
if(oEach)
{
	oEachHas = 0;
	var id2, name2;
	while(true)
	{
		id2, name2 = oEach();
		if(id2 === null) break;
		if(id2 == 13) oEachHas = 1;
	}
}
io.print("O-EACH-HAS13 " ++ tostring(oEachHas) ++ " CLIP" ++ oClipE);

var oClipC = probeClip();
var oClear = safe(function(){ return win.clip.clear() });
io.print("O-CLEAR " ++ tostring(oClear) ++ " CLIP" ++ oClipC);

var oClipR3 = probeClip();
var oRead2 = safe(function(){ return win.clip.read() });
io.print("O-READ2 " ++ tostring(oRead2) ++ " CLIP" ++ oClipR3);
