import console;

// byte layout: a=1 b=2 c=3, 中=4..6, 文=7..9, 字=10..12, 符=13..15, 1..3=16..18
var s = "abc中文字符123";
// byte layout: emoji are 4 bytes each: 😀=1..4, 😁=5..8, 😂=9..12, abc=13..15
var s2 = "😀😁😂abc";

// byte-length contract (# and string.len(s,false))
assert(#s == 18, "#s should be 18 bytes, got " ++ tostring(#s));
assert(string.len(s, false) == 18, "len bytes should be 18, got " ++ tostring(string.len(s, false)));
assert(#s2 == 15, "#s2 should be 15 bytes, got " ++ tostring(#s2));
assert(string.len(s2, false) == 15, "len bytes s2 should be 15, got " ++ tostring(string.len(s2, false)));

// index / indexOf return UTF-8 byte positions
assert(string.index(s, "中文") == 4, "index 中文 should be 4, got " ++ tostring(string.index(s, "中文")));
assert(string.indexOf(s, "中文") == 4, "indexOf 中文 should be 4, got " ++ tostring(string.indexOf(s, "中文")));
assert(string.index(s, "c") == 3, "index c should be 3, got " ++ tostring(string.index(s, "c")));
assert(string.index(s, "xyz") == null, "index miss should be null, got " ++ tostring(string.index(s, "xyz")));
// from=5 lands inside 中 (bytes 4..6); 字 starts at byte 10
assert(string.indexOf(s, "字", 5) == 10, "indexOf 字 from 5 should be 10, got " ++ tostring(string.indexOf(s, "字", 5)));
assert(string.index(s2, "😂") == 9, "index emoji should be 9, got " ++ tostring(string.index(s2, "😂")));

// lastIndexOf: from limits match start (1-based inclusive), clamped to tail
assert(string.lastIndexOf(s2, "😀") == 1, "lastIndexOf 😀 should be 1, got " ++ tostring(string.lastIndexOf(s2, "😀")));
assert(string.lastIndexOf(s, "c", 10) == 3, "lastIndexOf c from 10 should be 3, got " ++ tostring(string.lastIndexOf(s, "c", 10)));
assert(string.lastIndexOf(s, "中", 1) == null, "lastIndexOf 中 from 1 should be null, got " ++ tostring(string.lastIndexOf(s, "中", 1)));

// reverse per Unicode codepoint: surrogate pairs stay intact
assert(string.reverse("abc中文") == "文中cba", "reverse cn failed: " ++ tostring(string.reverse("abc中文")));
assert(string.reverse("a😀b") == "b😀a", "reverse emoji failed: " ++ tostring(string.reverse("a😀b")));

// one-arg split walks Unicode codepoints (never UTF-8 lead-byte guesses)
var sp = string.split("a😀b");
assert(#sp == 3, "split emoji count should be 3, got " ++ tostring(#sp));
assert(sp[2] == "😀", "split emoji element failed: " ++ tostring(sp[2]));
assert(#string.split("xÿy") == 3, "split ÿ count should be 3, got " ++ tostring(#string.split("xÿy")));
assert(#string.split("aπb") == 3, "split π count should be 3, got " ++ tostring(#string.split("aπb")));

// ---- round 11: all-Num assign fast path (slot folding in Exec(Assign)) ----
// semantics must match the generic Eval+DoAssign path exactly
var fa = 2;
for (i = 1; 3; i++) { fa = fa * 2; }
assert(fa == 16, "fast assign mul chain failed: " ++ tostring(fa));
var fb = 0;
for (i = 1; 100; i++) { fb = fb + i; }
assert(fb == 5050, "fast assign sum failed: " ++ tostring(fb));
var fc = 100;
fc = fc - 1;
fc = fc / 9;
fc = fc % 7;
assert(fc == 4, "fast assign sub/div/mod failed: " ++ tostring(fc));
var fd = 5;
fd = fd ** 2;
fd = fd | 2;
fd = fd & 6;
fd = fd ^ 5;
assert(fd == 7, "fast assign pow/bit failed: " ++ tostring(fd));
var fe = 3;
fe = fe << 2;
assert(fe == 12, "fast assign lshift failed: " ++ tostring(fe));
fe = fe >> 1;
assert(fe == 6, "fast assign rshift failed: " ++ tostring(fe));
var ff = 8;
ff = ff / 0;
assert(ff == 0, "fast assign div0 should be 0, got " ++ tostring(ff));
var fg = 0;
fg = 41;
fg = fg + 1;
assert(fg == 42, "fast assign literal rhs failed: " ++ tostring(fg));
var fh = 7;
var fi = 0;
fi = fh;
assert(fi == 7, "fast assign ident rhs failed: " ++ tostring(fi));
// string rhs falls back to the generic path
var fj = 10;
fj = "s";
fj = fj ++ "x";
assert(fj == "sx", "str fallback concat failed: " ++ tostring(fj));
// Num -> Str -> Num transitions across fast/generic paths
var fk = 1;
fk = fk + 1;
fk = "t" ++ fk;
fk = #fk;
assert(fk == 2, "num->str->num assign chain failed: " ++ tostring(fk));
// undefined global target: eFound miss -> generic globals write
gu11 = 0;
gu11 = gu11 + 3;
assert(gu11 == 3, "global target assign failed: " ++ tostring(gu11));
for (i = 1; 10; i++) { gu11 = gu11 + i; }
assert(gu11 == 58, "global accumulate in loop failed (3 + 55 expected): " ++ tostring(gu11));
// closure frame write still lands on the outer slot
var fu = 0;
var fadd = function(n) {
    fu = fu + n;
    return fu;
};
assert(fadd(2) == 2, "closure frame assign first failed: " ++ tostring(fadd(0)));
assert(fadd(3) == 5, "closure frame assign second failed: " ++ tostring(fadd(0)));
// namespace body: bare assign mirrors into the ns table (bNoNs guard)
namespace tst11 {
    var nv = 1;
    nv = nv + 1;
}
assert(tst11.nv == 2, "namespace assign mirror failed: " ++ tostring(tst11.nv));
// class body member assign keeps its instance-table semantics
class cls11 {
    cv = 1;
}
var oc = cls11();
assert(oc.cv == 1, "class member assign failed: " ++ tostring(oc.cv));

// ---- round 10: for step semantics (loop var re-resolved every access) ----
var fs = 0;
for (i = 1; 10; i++) { fs = fs + i; }
assert(fs == 55, "for i++ sum failed: " ++ tostring(fs));
var fs2 = 0;
for (j = 1; 10; j += 2) { fs2 = fs2 + j; }
assert(fs2 == 25, "for j+=2 sum failed: " ++ tostring(fs2));
var fs3 = 0;
for (k = 10; 1; k--) { fs3 = fs3 + k; }
assert(fs3 == 55, "for k-- desc sum failed: " ++ tostring(fs3));
var fs4 = 0;
for (m = 1; 10; m += 1) { fs4 = fs4 + m; continue; }
assert(fs4 == 55, "for continue advance failed: " ++ tostring(fs4));
var fs5 = 0;
for (q = 1; 5; q++) { q = q + 1; fs5 = fs5 + q; }
assert(fs5 == 12, "for body rewrites loop var failed: " ++ tostring(fs5));

// ---- rounds 7/8: sub/left/right/mid/charAt core regressions ----
assert(string.sub(s, 4, 6) == "中", "sub byte 4..6 failed: " ++ tostring(string.sub(s, 4, 6)));
assert(string.sub(s, 4, 9) == "中文", "sub byte 4..9 failed: " ++ tostring(string.sub(s, 4, 9)));
assert(string.sub(s2, 5, 8) == "😁", "sub emoji 5..8 failed: " ++ tostring(string.sub(s2, 5, 8)));
assert(string.sub(s, 4) == "中文字符123", "sub open end failed: " ++ tostring(string.sub(s, 4)));
assert(string.sub(s, -3) == "123", "sub neg tail failed: " ++ tostring(string.sub(s, -3)));
assert(string.left(s, 6) == "abc中", "left bytes failed: " ++ tostring(string.left(s, 6)));
assert(string.right(s, 3) == "123", "right bytes failed: " ++ tostring(string.right(s, 3)));
assert(string.right(s, 3, true) == "123", "right 3 chars failed: " ++ tostring(string.right(s, 3, true)));
assert(string.right(s, 4, true) == "符123", "right 4 chars failed: " ++ tostring(string.right(s, 4, true)));
assert(string.mid(s, 4, 6) == "中文", "mid 6 bytes failed: " ++ tostring(string.mid(s, 4, 6)));
assert(string.mid(s, 7, 3) == "文", "mid 3 bytes at 7 failed: " ++ tostring(string.mid(s, 7, 3)));
// mid has no char-mode 4th arg (byte start/count only) — an in-codepoint
// 2-byte slice at 7 clamps to the containing codepoint start
assert(string.mid(s, 7, 2) == "", "mid 2 bytes at 7 failed: " ++ tostring(string.mid(s, 7, 2)));
assert(string.charAt(s, 4) == "中", "charAt codepoint failed: " ++ tostring(string.charAt(s, 4)));

// ---- round 9: concat fast path (both operands plain Str) ----
var cc = "a";
cc = cc ++ "b";
assert(cc == "ab", "concat failed: " ++ tostring(cc));
var cd = "x" ++ 1;
assert(cd == "x1", "concat num failed: " ++ tostring(cd));

console.log("STRING_CHARS_EXT_CHECK_PASS");