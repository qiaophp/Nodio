// round 43: two threads, one wait each.
//
// Official contract: thread.waitOne returns the 1-based index of the
// signalled handle (see t28), so two waits give "11", not "truetrue".
import thread;
var t0 = time.tick();
var h1 = thread.create(function() {
    sleep(400);
    return 1;
});
var h2 = thread.create(function() {
    sleep(400);
    return 2;
});
var ok1 = thread.waitOne(h1, 3000);
var ok2 = thread.waitOne(h2, 3000);
io.print(tostring(ok1) ++ tostring(ok2));
io.print(time.tick() - t0 < 700);
