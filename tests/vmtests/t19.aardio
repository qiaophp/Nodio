io.print(string.match("hello123world", "[a-z]+"));
io.print(string.match("key=val", "(\w+)=(\w+)"));
var t = string.match("k=v", "(\w+)=(\w+)");
io.print(t[1] ++ "|" ++ t[2]);
io.print(string.gsub("2026-10", "(\d+)", "<$1>"));
io.print(string.count("a1b22c333", "\d+"));
io.print(string.find("foo bar", "b[a-z]r")[1]);
