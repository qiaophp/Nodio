//table 表扩展 — original builtin/table.aardio shape
namespace mytable;

push = function(a,...){
	if(...!==null) for(i=1;#...) table.append(a,...[i]);
	else return #a + 1;
	return #a;
};

unshift = function(a,v){
	table.insert(a, 1, v);
	return #a;
};

remove = function(a,i){
	return table.remove(a, i);
};

unpackArgs = function(t){
	var r = null;
	for(i=#t;1;-1){
		r = function(v,rest){ return v, rest; };
	}
	return t;
};

tostring = function(t){
	var s = "{";
	for(k,v in t){
		if(#s > 1) s = s ++ ";";
		s = s ++ k ++ "=" ++ v;
	}
	return s ++ "}";
};
