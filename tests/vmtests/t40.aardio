// round 43: file IO + transcoding.
//
// Official contract (D:\aardio\lib\builtin\io.aardio, intellisense):
//   io.writeFile(path, ...) — the extra arguments are the DATA to write, NOT
//   an encoding. "io.writeFile(p,s,"gbk")" writes s AND the literal "gbk".
//   io.readFile(path, len)  — len is a byte count ("%s" = one text line).
// Nodio extension: io.readFile(path, "raw"/"gbk"/"ansi"/"utf8") reads the
// whole file and converts it ("raw" keeps the bytes).
var s = "中文ABC";
var p = ..io.fullpath("r43test.txt");

..io.writeFile(p, s);
io.print("size:", ..io.getSize(p));
var raw = ..io.readFile(p);
io.print("bytes:", #raw);
io.print("equal:", raw == s);

var gbk = ..string.fromto(s, "", "gbk");
..io.writeFile(p, gbk);
io.print("gbksize:", ..io.getSize(p));
var back = ..io.readFile(p, "gbk");
io.print("gbkequal:", back == s);

..io.remove(p);
