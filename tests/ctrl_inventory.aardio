// win.ui.ctrl inventory probe: import + instantiate every official
// ctrl module against the engine, one result line each.
import win.ui;
import win.form;
import win.ui.ctrl._;
import console;

var wf = win.form(text="probe";right=400;bottom=400;border="none";exmode="toolwindow")

try{ import win.ui.ctrl.button;
	var c = win.ui.ctrl.button(wf,{left=1;top=1;right=50;bottom=20;text="t"});
	io.print("button:", c != null); } catch(e){ io.print("button: FAIL", e) }

try{ import win.ui.ctrl.static;
	var c = win.ui.ctrl.static(wf,{left=1;top=30;right=80;bottom=50;text="s"});
	io.print("static:", c != null); } catch(e){ io.print("static: FAIL", e) }

