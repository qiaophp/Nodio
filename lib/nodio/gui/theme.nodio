// nodio.gui.theme — 语义主题（角色 → 色值）。
//
// 移植自 Zan.Gui 的 Styling/Theme.zan。Zan.Gui 的 Theme 是一张**语义角色表**：
// 控件不直接写死颜色，只声明「我要 primary 色的按钮」，主题决定 primary 是哪支。
// 皮肤（skin）改主题 → 所有控件跟着变，控件代码一行都不用动。
//
// 这里保留 Zan.Gui 的角色划分，并按 IDE 实际用到的部分裁剪：
//   功能色   primary / info / success / warning / error（各带 hover/pressed）
//   文字     textPrimary / Secondary / Tertiary / Disabled / Inverse
//   背景     bgPrimary / Secondary / Tertiary / Hover / Active / Selected / Disabled
//   描边     borderPrimary / Secondary / Hover / Focus，divider
//   浮层     overlay / scrim / tooltip*
//   滚动条   scrollbar / scrollbarHover
//   度量     fontSize* / height* / padding* / gap* / radius* / borderWidth / iconSize*
//
// 单位：度量是**逻辑像素**，颜色是 0xAARRGGBB。
namespace nodio.gui{

// ---------- 深色（默认）----------
// 基准是 VS Code Dark+ 的 IDE chrome（0xFF1E1E1E / 0xFF252526），
// 和 nodio.ui.theme 之前用的配色一致 —— 换过来不会出现「新旧两套黑」。
var themeDark = {
	name = "dark";

	// ---- 功能色 ----
	primary        = 0xFF0F6CBD;   // 蓝：主操作
	primaryHover   = 0xFF1A7ED0;
	primaryPressed = 0xFF0A5A9E;
	info           = 0xFF3B9BD9;
	infoHover      = 0xFF2F8CC8;
	infoPressed    = 0xFF2278AE;
	success        = 0xFF89D185;
	successHover   = 0xFF9BDC96;
	successPressed = 0xFF6EB56B;
	warning        = 0xFFCCA700;
	warningHover   = 0xFFD9BC1D;
	warningPressed = 0xFFAD8B00;
	error          = 0xFFF14C4C;
	errorHover     = 0xFFF45B5B;
	errorPressed   = 0xFFD13B3B;

	// ---- 文字 ----
	textPrimary   = 0xFFD4D4D4;
	textSecondary = 0xFF9D9D9D;
	textTertiary  = 0xFF6E6E6E;
	textDisabled  = 0xFF5A5A5A;
	textInverse   = 0xFFFFFFFF;

	// ---- 背景 ----
	bgPrimary   = 0xFF1E1E1E;   // 窗体 / 编辑区
	bgSecondary = 0xFF252526;   // 面板
	bgTertiary  = 0xFF2D2D2D;   // 次级面板
	bgHover     = 0xFF2A2D2E;   // 悬停
	bgActive    = 0xFF37373D;   // 按下 / 激活
	bgSelected  = 0xFF04395E;   // 选中行
	bgDisabled  = 0xFF2A2A2A;

	// ---- 描边 ----
	borderPrimary   = 0xFF3C3C3C;
	borderSecondary = 0xFF2F2F2F;
	borderHover     = 0xFF4E4E4E;
	borderFocus     = 0xFF0F6CBD;
	divider         = 0xFF2F2F2F;

	// ---- 浮层 ----
	overlay = 0xCC000000;
	scrim   = 0x99000000;

	// ---- 滚动条 ----
	scrollbar      = 0xFF424242;
	scrollbarHover = 0xFF5A5A5A;

	// ---- 提示 ----
	tooltipBg     = 0xFF2B2B2B;
	tooltipBorder = 0xFF454545;
	tooltipText   = 0xFFE8E8E8;

	// ---- 设计器 ----
	canvasBg = 0xFF252526;   // 设计画布底色
	grid     = 0xFF323232;   // 画布网格

	// ---- 度量（逻辑像素）----
	fontSizeTiny   = 11;
	fontSizeSmall  = 12;
	fontSizeMedium = 13;
	fontSizeLarge  = 16;
	fontSizeHuge   = 20;

	heightTiny   = 24;
	heightSmall  = 28;
	heightMedium = 32;
	heightLarge  = 40;

	paddingTiny   = 4;
	paddingSmall  = 8;
	paddingMedium = 12;
	paddingLarge  = 16;

	gapSmall  = 4;
	gapMedium = 8;
	gapLarge  = 16;

	radiusSmall  = 4;
	radiusMedium = 6;
	radiusLarge  = 8;

	borderWidth = 1;

	iconSizeSmall   = 12;
	iconSizeMedium  = 16;
	iconSizeLarge   = 20;
	iconSizeCaption = 10;
};

// ---------- 浅色 ----------
var themeLight = {
	name = "light";

	primary        = 0xFF0F6CBD;
	primaryHover   = 0xFF1A7ED0;
	primaryPressed = 0xFF0A5A9E;
	info           = 0xFF3B9BD9;
	infoHover      = 0xFF2F8CC8;
	infoPressed    = 0xFF2278AE;
	success        = 0xFF2E7D32;
	successHover   = 0xFF3C9140;
	successPressed = 0xFF256428;
	warning        = 0xFF9A6700;
	warningHover   = 0xFFB37C00;
	warningPressed = 0xFF7A5300;
	error          = 0xFFC9302C;
	errorHover     = 0xFFD94548;
	errorPressed   = 0xFFA61B1D;

	textPrimary   = 0xFF1A1A1A;
	textSecondary = 0xFF666666;
	textTertiary  = 0xFF8A8A8A;
	textDisabled  = 0xFFA0A0A0;
	textInverse   = 0xFFFFFFFF;

	bgPrimary   = 0xFFFFFFFF;
	bgSecondary = 0xFFF3F3F3;
	bgTertiary  = 0xFFEDEDED;
	bgHover     = 0xFFE8E8E8;
	bgActive    = 0xFFDDDDDD;
	bgSelected  = 0xFFDCEBFA;
	bgDisabled  = 0xFFF0F0F0;

	borderPrimary   = 0xFFD0D0D0;
	borderSecondary = 0xFFE4E4E4;
	borderHover     = 0xFFBEBEBE;
	borderFocus     = 0xFF0F6CBD;
	divider         = 0xFFE0E0E0;

	overlay = 0x33000000;
	scrim   = 0x55000000;

	scrollbar      = 0xFFC8C8C8;
	scrollbarHover = 0xFFA0A0A0;

	tooltipBg     = 0xFF333333;
	tooltipBorder = 0xFF555555;
	tooltipText   = 0xFFF0F0F0;

	canvasBg = 0xFFF0F0F0;
	grid     = 0xFFE0E0E0;

	fontSizeTiny   = 11;
	fontSizeSmall  = 12;
	fontSizeMedium = 13;
	fontSizeLarge  = 16;
	fontSizeHuge   = 20;

	heightTiny   = 24;
	heightSmall  = 28;
	heightMedium = 32;
	heightLarge  = 40;

	paddingTiny   = 4;
	paddingSmall  = 8;
	paddingMedium = 12;
	paddingLarge  = 16;

	gapSmall  = 4;
	gapMedium = 8;
	gapLarge  = 16;

	radiusSmall  = 4;
	radiusMedium = 6;
	radiusLarge  = 8;

	borderWidth = 1;

	iconSizeSmall   = 12;
	iconSizeMedium  = 16;
	iconSizeLarge   = 20;
	iconSizeCaption = 10;
};

// ---------- 当前主题 ----------
var __theme = themeDark;
var themes = { dark = themeDark; light = themeLight };

// 取当前主题表
theme = function(){
	return __theme;
}

// 切换主题：themeSet("dark") / themeSet("light")
themeSet = function(name){
	var t = themes[name];
	if(t) __theme = t;
	return __theme;
}

// 按名字取主题表（不切换当前主题）：
// 组件展厅用它做「预览另一套主题」，不用改动全局主题。
themeByName = function(name){
	return themes[name];
}

themeName = function(){
	return __theme.name;
}

// 按角色取色：themeColor("primary")
themeColor = function(role){
	return __theme[role];
}

// ARGB(0xAARRGGBB) → COLORREF(0x00BBGGRR)
// 原生控件（richedit / edit）要的是 COLORREF，不是 gdip 的 ARGB。
themeRef = function(argb){
	var v = tonumber(argb);
	if(v === null) return 0;
	var r = (v >> 16) & 0xFF;
	var g = (v >> 8) & 0xFF;
	var b = v & 0xFF;
	return (b << 16) | (g << 8) | r;
}

// ---------- 官方 Theme XML 解析与装配 ----------
//
// 官方 config/themes/*.xml 以及 USR.THEME / SYS.THEME 的格式：
// <Theme>
//   <Title>深色主题</Title>
//   <Editor>
//     <Color>D4D4D4</Color>
//     <Background>1E1E1E</Background>
//     <SelectionColor>D4D4D4</SelectionColor>
//     <SelectionBackground>0083EC</SelectionBackground>
//     <LineNumberColor>C1B99B</LineNumberColor>
//     <LineNumberBackground>1E1E1E</LineNumberBackground>
//     <OutlineColor>808080</OutlineColor>
//     <MatchingBracket>FF0033</MatchingBracket>
//     <Error>FF4444</Error>
//   </Editor>
// </Theme>

var __hexToArgb = function(h){
	if(!h) return null;
	h = ..string.trim(h);
	if(..string.startsWith(h, "#")) h = ..string.slice(h, 2);
	if(..string.startsWith(h, "0x") || ..string.startsWith(h, "0X")) h = ..string.slice(h, 3);
	if(#h == 6){
		var n = tonumber(h, 16);
		if(n === null) return null;
		return 0xFF000000 + n;
	}
	if(#h == 8){
		return tonumber(h, 16);
	}
	var n = tonumber(h, 16);
	if(n === null) return null;
	return 0xFF000000 + n;
};

var __parseTag = function(xml, tag){
	var open = "<" ++ tag ++ ">";
	var close = "</" ++ tag ++ ">";
	var p1 = ..string.indexOf(xml, open);
	if(!p1) return null;
	var p2 = ..string.indexOf(xml, close, p1 + #open);
	if(!p2) return null;
	return ..string.trim(..string.slice(xml, p1 + #open, p2 - 1));
};

var __cloneTable = function(t){
	var res = {};
	for(k, v in t){
		res[k] = v;
	}
	return res;
};

loadThemeXml = function(xmlText, customName){
	if(!xmlText || !#xmlText) return null;
	var title = __parseTag(xmlText, "Title");
	var edXml = __parseTag(xmlText, "Editor");
	if(!edXml) edXml = xmlText;

	var fg = __hexToArgb(__parseTag(edXml, "Color"));
	var bg = __hexToArgb(__parseTag(edXml, "Background"));
	var selFg = __hexToArgb(__parseTag(edXml, "SelectionColor"));
	var selBg = __hexToArgb(__parseTag(edXml, "SelectionBackground"));
	var lnCol = __hexToArgb(__parseTag(edXml, "LineNumberColor"));
	var lnBg = __hexToArgb(__parseTag(edXml, "LineNumberBackground"));
	var outl = __hexToArgb(__parseTag(edXml, "OutlineColor"));
	var errCol = __hexToArgb(__parseTag(edXml, "Error"));
	var brkCol = __hexToArgb(__parseTag(edXml, "MatchingBracket"));

	// 依据 Background 亮度选择基底主题（深色 vs 浅色）
	var base = themeDark;
	if(bg !== null){
		var r = (bg >> 16) & 0xFF;
		var g = (bg >> 8) & 0xFF;
		var b = bg & 0xFF;
		var lum = 0.299 * r + 0.587 * g + 0.114 * b;
		if(lum >= 128) base = themeLight;
	}

	var th = __cloneTable(base);
	if(bg !== null){
		th.bgPrimary = bg;
		th.canvasBg = bg;
	}
	if(fg !== null){
		th.textPrimary = fg;
	}
	if(selBg !== null){
		th.bgSelected = selBg;
		th.primary = selBg;
	}
	if(lnBg !== null){
		th.bgSecondary = lnBg;
		th.bgTertiary = lnBg;
	}
	if(lnCol !== null){
		th.textSecondary = lnCol;
		th.textDim = lnCol;
	}
	if(outl !== null){
		th.borderPrimary = outl;
		th.borderSecondary = outl;
	}
	if(errCol !== null) th.error = errCol;
	if(brkCol !== null) th.accent = brkCol;

	var tName = customName : (title : "custom");
	th.name = tName;
	th.title = title : tName;
	themes[tName] = th;
	if(title && title != tName) themes[title] = th;
	return th;
};

loadThemeXmlFile = function(path, customName){
	if(!path || !..io.exist(path)) return null;
	var txt = ..string.load(path);
	if(!txt) return null;
	var name = customName;
	if(!name){
		var pi = ..io.splitpath(path);
		name = pi ? pi.name : null;
	}
	return loadThemeXml(txt, name);
};

scanThemesDir = function(dir){
	if(!dir || !..io.exist(dir)) return {};
	var list = {};
	var files = ..io.listFiles(dir, "*.xml") : {};
	for(i=1; #files; 1){
		var f = files[i];
		if(f && !f.isDir && f.path){
			var pi = ..io.splitpath(f.path);
			var th = loadThemeXmlFile(f.path, pi ? pi.name : null);
			if(th) ..table.push(list, th);
		}
	}
	return list;
};

}
