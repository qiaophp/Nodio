// nodio.designer.toolbox — 工具箱（自绘：分类分组 + 组件列表）。
//
// 数据来自 nodio.designer.registry，用户注册的组件会自动出现在这里。
//
// 为什么自绘而不是用原生 treeview：
//   ① 官方 IDE 的「控件」页就是自绘的（截图里没有系统 treeview 的
//      展开箭头、虚线、3D 边框）；
//   ② 引擎的原生控件表没有 treeview 的 insertItem/setItemData/expand，
//      用原生树根本就跑不起来。
//
// 用法：
//   tb = nodio.designer.toolbox(winform, {left=0;top=0;right=260;bottom=400})
//   tb.refresh()
//   tb.onPick = function(spec){ ... }   // 选中一个组件
namespace nodio.designer{
import nodio.designer.registry;
import nodio.ui.board;
import nodio.ui.rect;
import nodio.ui.theme;
import nodio.ui.icons;
import nodio.ui.dpi;

var __tbSeq = 0;

toolbox = function(winform, opt){
	opt = opt : {};
	// 配色默认取当前主题（nodio.ui.theme）
	var th = ..nodio.ui.theme();
	var self = {
		winform = winform;
		board = null;
		rect = opt.rect;
		rows = {};        // 布局好的行：{kind="cat"/"item"; text=..; spec=..; y=..; h=..}
		hover = 0;        // 悬停行号
		selIndex = 0;
		onPick = null;
		// 配色
		bgColor     = opt.bgColor : th.panel;
		catColor    = opt.catColor : th.text;
		textColor   = opt.textColor : th.text;
		hoverColor  = opt.hoverColor : th.hoverBg;
		selColor    = opt.selColor : th.selBg;
		lineColor   = opt.lineColor : th.border;
	};

	__tbSeq = __tbSeq + 1;
	var r = opt.rect : {left=0; top=0; right=260; bottom=400};

	self.board = nodio.ui.board(winform, {
		left = r.left; top = r.top; right = r.right; bottom = r.bottom;
	});
	self.board.onDraw = function(graphics, rc, bd){
		self.__draw(graphics, rc, bd);
	}
	// 兼容旧接口：宿主拿到的控件句柄
	self.ctrl = self.board.ctrl;
	self.board.onMouseMove = function(x, y, bd){
		var h = self.__hitIndex(y);
		if(h != self.hover){
			self.hover = h;
			self.board.invalidate();
		}
	}
	self.board.onMouseClick = function(x, y, bd){
		var i = self.__hitIndex(y);
		if(!i) return;
		var row = self.rows[i];
		if(row.kind == "cat"){
			// 点分类：折叠/展开
			row.collapsed = !row.collapsed;
			self.__layout();
			self.board.invalidate();
			return;
		}
		self.selIndex = i;
		self.board.invalidate();
		if(self.onPick && row.spec) self.onPick(row.spec);
	}

	// 重新生成行
	self.refresh = function(){
		self.rows = {};
		var cats = ..nodio.designer.registry.categories();
		for(i=1;#cats;1){
			var cat = cats[i];
			..table.push(self.rows, {kind="cat"; text=cat; collapsed=false});
			var specs = ..nodio.designer.registry.list(cat);
			for(k=1;#specs;1){
				..table.push(self.rows, {kind="item"; text=specs[k].name; spec=specs[k]});
			}
		}
		self.__layout();
		self.board.invalidate();
		return #self.rows;
	}

	// 计算每行的位置
	// 行高/缩进/缩略图尺寸都是**逻辑像素**，按 DPI 换算成物理像素
	self.__layout = function(){
		var y = 0;
		for(i=1;#self.rows;1){
			var row = self.rows[i];
			row.y = y;
			row.h = ..nodio.ui.px((row.kind == "cat") ? 22 : 20);
			y = y + row.h;
			if(row.kind == "cat" && row.collapsed){
				// 折叠：跳过该分类下的组件
				for(k=i+1;#self.rows;1){
					if(self.rows[k].kind == "cat") break;
					self.rows[k].h = 0;
				}
			}
		}
		// 折叠的行高度为 0，位置需要重排
		y = 0;
		for(i=1;#self.rows;1){
			var row = self.rows[i];
			row.y = y;
			y = y + row.h;
		}
	}

	// 命中测试：y → 行号
	self.__hitIndex = function(y){
		for(i=1;#self.rows;1){
			var row = self.rows[i];
			if(row.h <= 0) continue;
			if(y >= row.y && y < row.y + row.h) return i;
		}
		return 0;
	}

	// 绘制
	self.__draw = function(graphics, rc, bd){
		var font = bd.font;
		var fmt = bd.format;
		var w = rc.right - rc.left;
		var h = rc.bottom - rc.top;
		var pWidget = ..nodio.ui.px(16);   // 控件缩略图边长
		var pIndent = ..nodio.ui.px(24);   // 组件行的文字缩进
		var pCatPad = ..nodio.ui.px(6);    // 分类行的缩进
		// 背景
		var bg = ..gdip.solidBrush(self.bgColor);
		graphics.fillRect(bg, rc.left, rc.top, w, h);
		bg.delete();
		for(i=1;#self.rows;1){
			var row = self.rows[i];
			if(row.h <= 0) continue;
			var y = rc.top + row.y;
			// 选中/悬停底色
			if(i == self.selIndex){
				var sb = ..gdip.solidBrush(self.selColor);
				graphics.fillRect(sb, rc.left, y, w, row.h);
				sb.delete();
			}
			elseif(i == self.hover){
				var hb = ..gdip.solidBrush(self.hoverColor);
				graphics.fillRect(hb, rc.left, y, w, row.h);
				hb.delete();
			}
			// 文字
			var x = rc.left + ((row.kind == "cat") ? pCatPad : pIndent);
			var color = (row.kind == "cat") ? self.catColor : self.textColor;
			var brush = ..gdip.solidBrush(color);
			if(row.kind == "cat"){
				// 折叠标记：细箭头（对齐参考 IDE 的树形展开符）
				var mark = row.collapsed ? "› " : "⌄ ";
				graphics.drawString(mark ++ row.text, font,
					::RECTF(x, y, w - x, row.h), fmt, brush);
			}
			else{
				// 控件缩略图（FontAwesome 没有控件图标，这里用 GDI+ 手绘小控件）
				..nodio.ui.drawWidget(graphics, row.spec ? row.spec.cls : null,
					rc.left + ..nodio.ui.px(3), y + (row.h - pWidget) / 2, 16,
					self.textColor, self.bgColor);
				graphics.drawString(row.text, font,
					::RECTF(x, y, w - x, row.h), fmt, brush);
			}
			brush.delete();
			// 分类下方分隔线
			if(row.kind == "cat"){
				var pen = ..gdip.pen(self.lineColor, 1);
				graphics.drawLine(pen, rc.left, y + row.h - 1, rc.right, y + row.h - 1);
				pen.delete();
			}
		}
	}

	self.layout = function(l,t,r,b){
		if(l === null || l === undefined){
			var rc = self.rect;
			if(!rc) return;
			l = rc.left; t = rc.top; r = rc.right; b = rc.bottom;
		}
		self.rect = {left=l; top=t; right=r; bottom=b};
		self.board.layout(l, t, r, b);
	}

	self.__layout();
	self.layout();
	return self;
}

}
