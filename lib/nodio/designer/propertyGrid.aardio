// nodio.designer.propertyGrid — 属性格（自绘两列：属性 / 值）。
//
// 用法：
//   pg = nodio.designer.propertyGrid(winform, {left=0;top=0;right=240;bottom=200})
//   pg.setItems({ {name="标题";value="按钮";type="string"} })
//   pg.onChange = function(index, value){ ... }
//
// 为什么自绘而不是用原生 listview：
//   ① 官方 IDE 的「属性」页就是自绘的（截图里是两列纯色表，没有系统
//      listview 的网格线和选中虚线框）；
//   ② 引擎的原生控件表没有 listview 的 addItem/setItem。
//
// 改值：点「值」列 → 在单元格里落一个 edit 控件（就地编辑），
// 输入即时回写并触发 onChange；点别处收起。
//
// 几何说明：自绘板（board）是页面里的一个 plus 控件，编辑框是另一个控件，
// 两者的 z 序要分开 —— 编辑框必须 z 更高，否则会被自绘板盖住。
namespace nodio.designer{
import nodio.ui.board;
import nodio.ui.rect;
import nodio.ui.theme;
import nodio.ui.dpi;

var __pgSeq = 0;

propertyGrid = function(winform, opt){
	opt = opt : {};
	var th = ..nodio.ui.theme();
	var self = {
		winform = winform;
		board = null;
		editCtrl = null;
		editName = null;
		rect = opt.rect;
		items = {};
		// 行高、列宽是**逻辑像素**（按 DPI 换算成物理像素）
		rowH = ..nodio.ui.px(20);
		nameW = ..nodio.ui.px(90);
		selIndex = 0;
		editIndex = 0;
		onChange = null;
		// 配色（默认取当前主题 nodio.ui.theme）
		bgColor     = opt.bgColor : th.panel;
		headColor   = opt.headColor : th.panel2;
		textColor   = opt.textColor : th.text;
		headText    = opt.headText : th.textDim;
		valueColor  = opt.valueColor : th.text;
		selColor    = opt.selColor : th.selBg;
		lineColor   = opt.lineColor : th.border;
		headText1   = opt.headText1 : "属性";
		headText2   = opt.headText2 : "值";
	};

	__pgSeq = __pgSeq + 1;
	var r = opt.rect : {left=0; top=0; right=240; bottom=200};

	self.board = nodio.ui.board(winform, {
		left = r.left; top = r.top; right = r.right; bottom = r.bottom;
	});
	self.board.onDraw = function(graphics, rc, bd){
		self.__draw(graphics, rc, bd);
	}
	// 兼容旧接口：宿主拿到的控件句柄
	self.ctrl = self.board.ctrl;
	self.board.onMouseClick = function(x, y, bd){
		self.__click(x, y);
	}

	// 填充
	self.setItems = function(items){
		self.items = items : {};
		self.selIndex = 0;
		self.__endEdit();
		self.board.invalidate();
		return #self.items;
	}

	self.getItems = function(){
		return self.items;
	}

	// 改某一行的值
	self.setValue = function(index, value){
		if(index < 1 || index > #self.items) return;
		self.items[index].value = value;
		self.board.invalidate();
	}

	// 行号 → 单元格（1=属性列，2=值列）
	self.__cellOf = function(y){
		if(y < self.rowH) return 0;
		var idx = (y - self.rowH) / self.rowH + 1;
		if(idx < 1 || idx > #self.items) return 0;
		return idx;
	}

	// 点哪一格
	self.__click = function(x, y){
		var idx = self.__cellOf(y);
		if(!idx){
			self.__endEdit();
			return;
		}
		self.selIndex = idx;
		if(x >= self.nameW){
			// 值列 → 就地编辑
			self.__beginEdit(idx, y);
		}
		else{
			self.__endEdit();
		}
		self.board.invalidate();
	}

	// 自绘板在宿主窗体客户区里的位置（编辑框要按它来摆）
	self.__boardRect = function(){
		try{
			var br = self.board.ctrl.getRect();
			if(br && br.left !== null) return br;
		}
		catch(e){}
		return self.rect : {left=0; top=0; right=240; bottom=200};
	}

	self.__beginEdit = function(index, y){
		if(index < 1 || index > #self.items) return;
		self.editIndex = index;
		if(!self.editCtrl){
			// 就地编辑用的 edit（后建 → z 更高，盖在自绘板上面）
			var ename = "propEdit" + __pgSeq;
			self.editCtrl = ..nodio.ui.addCtrl(winform, ename, {
				cls="edit";left=0;top=0;right=0;bottom=0;z=40
			});
			self.editName = ename;
			var onChanged = function(){
				if(!self.editIndex) return;
				var v = ..nodio.ui.getCtrlText(self.editCtrl);
				self.items[self.editIndex].value = v;
				self.board.invalidate();
				if(self.onChange) self.onChange(self.editIndex, v);
			}
			// 官方控件的事件名是 onChange，引擎原生控件是 onchange，两个都挂
			self.editCtrl.onChange = onChanged;
			self.editCtrl.onchange = onChanged;
		}
		var br = self.__boardRect();
		var cellY = br.top + self.rowH + (index - 1) * self.rowH;
		var x = br.left + self.nameW + 2;
		var w = (br.right - br.left) - self.nameW - 4;
		..nodio.ui.setRect(self.editCtrl, x, cellY, x + w, cellY + self.rowH - 2);
		..nodio.ui.setCtrlText(self.editCtrl, self.items[index].value : "");
		self.editCtrl.show(true);
	}

	self.__endEdit = function(){
		self.editIndex = 0;
		if(self.editCtrl){
			try{ self.editCtrl.show(false) }catch(e){}
		}
	}

	// 绘制
	self.__draw = function(graphics, rc, bd){
		var font = bd.font;
		var fmt = bd.format;
		var w = rc.right - rc.left;
		var h = rc.bottom - rc.top;
		var pPad = ..nodio.ui.px(6);
		// 背景
		var bg = ..gdip.solidBrush(self.bgColor);
		graphics.fillRect(bg, rc.left, rc.top, w, h);
		bg.delete();
		// 表头
		var hb = ..gdip.solidBrush(self.headColor);
		graphics.fillRect(hb, rc.left, rc.top, w, self.rowH);
		hb.delete();
		var headBrush = ..gdip.solidBrush(self.headText);
		graphics.drawString(self.headText1, font,
			::RECTF(rc.left + pPad, rc.top, self.nameW, self.rowH), fmt, headBrush);
		graphics.drawString(self.headText2, font,
			::RECTF(rc.left + self.nameW + pPad, rc.top, w - self.nameW, self.rowH),
			fmt, headBrush);
		headBrush.delete();
		// 行
		for(i=1;#self.items;1){
			var it = self.items[i];
			var y = rc.top + self.rowH + (i - 1) * self.rowH;
			if(y + self.rowH > h) break;
			if(i == self.selIndex){
				var sb = ..gdip.solidBrush(self.selColor);
				graphics.fillRect(sb, rc.left, y, w, self.rowH);
				sb.delete();
			}
			var brush = ..gdip.solidBrush(self.textColor);
			graphics.drawString(tostring(it.name : ""), font,
				::RECTF(rc.left + pPad, y, self.nameW, self.rowH), fmt, brush);
			brush.delete();
			// 值列正在编辑时不画（edit 控件盖在上面）
			if(i != self.editIndex){
				var vb = ..gdip.solidBrush(self.valueColor);
				graphics.drawString(tostring(it.value : ""), font,
					::RECTF(rc.left + self.nameW + pPad, y, w - self.nameW, self.rowH),
					fmt, vb);
				vb.delete();
			}
			// 行分隔线
			var pen = ..gdip.pen(self.lineColor, 1);
			graphics.drawLine(pen, rc.left, y + self.rowH - 1, rc.right, y + self.rowH - 1);
			pen.delete();
		}
		// 列分隔线
		var pen2 = ..gdip.pen(self.lineColor, 1);
		graphics.drawLine(pen2, rc.left + self.nameW, rc.top, rc.left + self.nameW, rc.bottom);
		pen2.delete();
	}

	self.layout = function(l,t,r,b){
		if(l === null || l === undefined){
			var rc = self.rect;
			if(!rc) return;
			l = rc.left; t = rc.top; r = rc.right; b = rc.bottom;
		}
		self.rect = {left=l; top=t; right=r; bottom=b};
		self.board.layout(l, t, r, b);
	}

	self.layout();
	return self;
}

}
