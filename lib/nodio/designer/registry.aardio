// nodio.designer.registry — 设计器组件注册表。
//
// 自定义组件加入设计器的入口：
//
//   // myWidget.aardio（放在 <工程目录>\components\ 下）
//   import nodio.designer.registry;
//   nodio.designer.registry.register({
//       name = "我的按钮";
//       cls = "button";          // 真实控件类
//       drawAs = "button";       // 设计器里的替身类（对应官方 ide.customCtrl）
//       category = "我的组件";
//       props = { {"text";"标题";"string"} };
//   })
//
// IDE 启动/打开工程时调用 registry.discover(<工程目录>\components)，
// 组件即刻出现在工具箱里。
//
// 官方对应机制见 docs/official-ide-reference.md §3。
namespace nodio.designer{

var store = {};   // name → spec
var order = {};   // 注册顺序

registry = {

	// 注册一个组件（同名覆盖）
	register = function(spec){
		if(!spec || !spec.name) return null;
		spec.cls = spec.cls : "static";
		spec.category = spec.category : "自定义";
		spec.props = spec.props : {};
		spec.drawAs = spec.drawAs : spec.cls;
		if(!store[spec.name]) ..table.push(order, spec.name);
		store[spec.name] = spec;
		return spec;
	}

	// 注销
	unregister = function(name){
		if(!store[name]) return;
		store[name] = null;
		for(i=#order;1;-1){
			if(order[i] == name) ..table.remove(order,i);
		}
	}

	// 取一个组件
	get = function(name){
		return store[name];
	}

	// 列出组件（category 为空则列全部）
	list = function(category){
		var out = {};
		for(i=1;#order;1){
			var s = store[order[i]];
			if(!s) continue;
			if(category && s.category != category) continue;
			..table.push(out, s);
		}
		return out;
	}

	// 分类名
	categories = function(){
		var out = {};
		for(i=1;#order;1){
			var s = store[order[i]];
			if(!s) continue;
			var found = false;
			for(k=1;#out;1){
				if(out[k] == s.category){ found = true; break }
			}
			if(!found) ..table.push(out, s.category);
		}
		return out;
	}

	// 扫描目录，把每个 .aardio / .nodio 模块 import 进来（模块里自行 register）
	discover = function(dir){
		if(!dir) return 0;
		var n = 0;
		var masks = {"*.aardio"; "*.nodio"};
		for(m=1;#masks;1){
			var files = ..io.listFiles(dir, masks[m]) : {};
			for(i=1;#files;1){
				if(files[i].isDir) continue;
				try{
					global.import(files[i].path);
					n = n + 1;
				}
				catch(e){
					// 单个组件加载失败不影响其它组件
				}
			}
		}
		return n;
	}

	// 内置控件集
	// 每个控件都带 左/上/宽/高 四个几何属性：属性格改它们时
	// 画布会真的移动/缩放控件（见 nodio.designer.canvas.applyProps）。
	defaults = function(){
		var defs = {
			{name="静态文本";cls="static";props={{"text";"标题";"string"};{"align";"对齐";"string"};{"left";"左边";"number"};{"top";"上边";"number"};{"width";"宽度";"number"};{"height";"高度";"number"}}};
			{name="按钮";cls="button";props={{"text";"标题";"string"};{"left";"左边";"number"};{"top";"上边";"number"};{"width";"宽度";"number"};{"height";"高度";"number"}}};
			{name="复选框";cls="checkbox";props={{"text";"标题";"string"};{"checked";"选中";"bool"};{"left";"左边";"number"};{"top";"上边";"number"};{"width";"宽度";"number"};{"height";"高度";"number"}}};
			{name="单选框";cls="radio";props={{"text";"标题";"string"};{"checked";"选中";"bool"};{"left";"左边";"number"};{"top";"上边";"number"};{"width";"宽度";"number"};{"height";"高度";"number"}}};
			{name="编辑框";cls="edit";props={{"text";"内容";"string"};{"password";"密码";"bool"};{"left";"左边";"number"};{"top";"上边";"number"};{"width";"宽度";"number"};{"height";"高度";"number"}}};
			{name="多行编辑";cls="richedit";props={{"text";"内容";"string"};{"readonly";"只读";"bool"};{"left";"左边";"number"};{"top";"上边";"number"};{"width";"宽度";"number"};{"height";"高度";"number"}}};
			{name="列表框";cls="listbox";props={{"items";"条目";"string"};{"left";"左边";"number"};{"top";"上边";"number"};{"width";"宽度";"number"};{"height";"高度";"number"}}};
			{name="下拉框";cls="combobox";props={{"items";"条目";"string"};{"left";"左边";"number"};{"top";"上边";"number"};{"width";"宽度";"number"};{"height";"高度";"number"}}};
			{name="列表";cls="listview";props={{"columns";"列";"string"};{"left";"左边";"number"};{"top";"上边";"number"};{"width";"宽度";"number"};{"height";"高度";"number"}}};
			{name="树";cls="treeview";props={{"hasLines";"显示连线";"bool"};{"left";"左边";"number"};{"top";"上边";"number"};{"width";"宽度";"number"};{"height";"高度";"number"}}};
			{name="分组框";cls="groupbox";props={{"text";"标题";"string"};{"left";"左边";"number"};{"top";"上边";"number"};{"width";"宽度";"number"};{"height";"高度";"number"}}};
			{name="选项卡";cls="tab";props={{"tabs";"页签";"string"};{"left";"左边";"number"};{"top";"上边";"number"};{"width";"宽度";"number"};{"height";"高度";"number"}}};
			{name="进度条";cls="progress";props={{"value";"进度";"number"};{"left";"左边";"number"};{"top";"上边";"number"};{"width";"宽度";"number"};{"height";"高度";"number"}}};
		};
		for(i=1;#defs;1){
			registry.register(defs[i]);
		}
		return #defs;
	}
}

}
