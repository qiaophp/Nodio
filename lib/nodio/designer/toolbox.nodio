// nodio.designer.toolbox — 工具箱（自绘：分类分组 + 组件列表）。
//
// 数据来自 nodio.designer.registry，用户注册的组件会自动出现在这里。
//
// 为什么自绘而不是用原生 treeview：
//   ① 官方 IDE 的「控件」页就是自绘的（截图里没有系统 treeview 的
//      展开箭头、虚线、3D 边框）；
//   ② 引擎的原生控件表没有 treeview 的 insertItem/setItemData/expand，
//      用原生树根本就跑不起来。
//
// 用法：
//   tb = nodio.designer.toolbox(winform, {left=0;top=0;right=260;bottom=400})
//   tb.refresh()
//   tb.onPick = function(spec){ ... }   // 选中一个组件
namespace nodio.designer{
import win;              // win.getRect：模拟拖拽时要把屏幕坐标换回客户区坐标
import nodio.designer.registry;
import nodio.ui.board;
import nodio.ui.rect;
import nodio.ui.theme;
import nodio.ui.icons;
import nodio.ui.dpi;

var __tbSeq = 0;

toolbox = function(winform, opt){
	opt = opt : {};
	// 配色默认取当前主题（nodio.ui.theme）
	var th = ..nodio.ui.theme();
	var self = {
		winform = winform;
		board = null;
		rect = opt.rect;
		rows = {};        // 布局好的行：{kind="cat"/"item"; text=..; spec=..; y=..; h=..}
		hover = 0;        // 悬停行号
		selIndex = 0;
		onPick = null;    // function(spec) —— 单击选中一个组件
		onDrop = null;    // function(spec, screenX, screenY) —— **拖**到画布上
		onDragMove = null; // function(spec, screenX, screenY) —— 拖动过程中（预览）
		// 配色
		bgColor     = opt.bgColor : th.panel;
		catColor    = opt.catColor : th.text;
		textColor   = opt.textColor : th.text;
		hoverColor  = opt.hoverColor : th.hoverBg;
		selColor    = opt.selColor : th.selBg;
		lineColor   = opt.lineColor : th.border;
	};

	__tbSeq = __tbSeq + 1;
	var r = opt.rect : {left=0; top=0; right=260; bottom=400};

	self.board = nodio.ui.board(winform, {
		left = r.left; top = r.top; right = r.right; bottom = r.bottom;
	});
	self.board.onDraw = function(graphics, rc, bd){
		self.__draw(graphics, rc, bd);
	}
	// 兼容旧接口：宿主拿到的控件句柄
	self.ctrl = self.board.ctrl;
	self.board.onMouseMove = function(x, y, bd){
		var h = self.__hitIndex(y);
		if(h != self.hover){
			self.hover = h;
			self.board.invalidate();
		}
	}
	self.board.onMouseClick = function(x, y, bd){
		var i = self.__hitIndex(y);
		if(!i) return;
		var row = self.rows[i];
		if(row.kind == "cat"){
			// 点分类：折叠/展开
			row.collapsed = !row.collapsed;
			self.__layout();
			self.board.invalidate();
			return;
		}
		self.selIndex = i;
		self.board.invalidate();
		if(self.onPick && row.spec) self.onPick(row.spec);
	}

	// ---------- 拖拽（第五十六轮） ----------
	//
	// 官方设计器是把控件从工具箱**拖**到窗体上；以前这里只能「点一下」，
	// 落点还固定在 (20,20)（designer.nodio 的 onPick）—— 连点三次就是
	// 三个控件叠在左上角，谁也点不中第二个。
	//
	// 拖拽判定：按下后位移超过阈值（4px，与 board 的点击判定同值）
	// 就算拖拽；松开时按**屏幕坐标**回报落点 ——
	// 拖拽途中鼠标会离开工具箱，客户区坐标不再可靠。
	//
	// ⚠ __drag 必须用 **var** 声明为局部变量：aardio 里函数体内的裸赋值
	//   写的是**全局表**（模块成员），这里要的是每次构造一份的局部状态。
	var __drag = null;

	self.board.onMouseDown = function(x, y, bd, lp){
		var i = self.__hitIndex(y);
		if(!i) return;
		var row = self.rows[i];
		if(row.kind != "item" || !row.spec) return;
		// 按下时还分不清是「点」还是「拖」，先记下候选
		__drag = {spec = row.spec; row = i; downX = x; downY = y; moved = false};
		// 捕获鼠标：拖到工具箱外面（画布上）也要继续收到 move/up
		self.board.setCapture(true);
	}
	self.board.onMouseMove = function(x, y, bd, lp){
		if(!__drag) return;
		if(!__drag.moved){
			if(math.abs(x - __drag.downX) < 4 && math.abs(y - __drag.downY) < 4) return;
			__drag.moved = true;
		}
		if(self.onDragMove){
			var m = ..nodio.ui.mouseScreen(self.board.ctrl.hwnd, lp);
			if(m) self.onDragMove(__drag.spec, m.x, m.y);
		}
	}
	self.board.onMouseUp = function(x, y, bd, lp){
		if(!__drag) return;
		var d = __drag;
		__drag = null;
		self.board.setCapture(false);
		// 没拖动 = 单击 → 交给 onMouseClick 的既有路径
		if(!d.moved) return;
		var m = ..nodio.ui.mouseScreen(self.board.ctrl.hwnd, lp);
		if(!m) return;
		if(self.onDrop) self.onDrop(d.spec, m.x, m.y);
	}

	// 供回归：模拟一次拖拽（按下 → 移动 → 松开）
	//
	// 走的是**真实回调路径**（onMouseDown/onMouseMove/onMouseUp），
	// 所以拖拽状态机（阈值判定、鼠标捕获、onDrop 触发）都被覆盖到 ——
	// 只测「onDrop 被调用」是自欺欺人。
	//
	// specName：工具箱里的控件名；screenX/screenY：目标**屏幕坐标**。
	// 返回 true = 这一路模拟跑完了（不代表控件真的建出来了）。
	self.simulateDrag = function(specName, screenX, screenY){
		var idx = 0;
		for(i=1;#self.rows;1){
			var row = self.rows[i];
			if(row.kind == "item" && row.spec && row.spec.name == specName){
				idx = i;
				break;
			}
		}
		if(!idx) return false;
		var r0 = self.rows[idx];
		var bx = 10, by = r0.y + math.floor(r0.h/2);
		// 目标屏幕坐标 → board 客户区坐标（lParam 低16位=x、高16位=y）
		// ⚠ 基准必须用**客户区原点**（win.toScreen），与 mouseScreen 的
		//   解读口径完全一致 —— 用窗口矩形左上会差一个边框宽度。
		var ox, oy = ..win.toScreen(self.board.ctrl.hwnd, 0, 0);
		if(ox === null || ox === undefined) return false;
		var lpx = screenX - ox;
		var lpy = screenY - oy;
		var lp = ((lpy & 0xFFFF) << 16) | (lpx & 0xFFFF);
		self.board.onMouseDown(bx, by, self.board, 0);
		// 越过拖拽阈值（4px）
		self.board.onMouseMove(bx + 40, by, self.board, 0);
		self.board.onMouseUp(bx + 40, by, self.board, lp);
		return true;
	}

	// 供回归：**真实窗口消息**路径的拖拽模拟
	//
	// simulateDrag 直接调回调，能测状态机，但绕过了窗口过程；
	// 这里用 ::PostMessage 把 WM_LBUTTONDOWN / WM_MOUSEMOVE /
	// WM_LBUTTONUP 投给工具箱板 —— 走的是**真实消息路径**
	// （子类化窗口过程 → onMouseDown/Move/Up → 拖拽状态机），
	// 和用户真的用鼠标拖是同一条路。
	// 仓库里已有同款做法：tests/ide_click.ps1 就是直接向命中的子窗口
	// 发 WM_LBUTTONDOWN/UP（桌面锁屏时合成鼠标事件送不到 IDE）。
	//
	// 三条消息进同一个线程的消息队列，顺序保证（down → move → up）。
	// 目标坐标在工具箱**左边**的画布上 → 客户区坐标是负数 ——
	// 这正是有符号解读要覆盖的场景。
	self.simulateDragMsg = function(specName, screenX, screenY){
		var idx = 0;
		for(i=1;#self.rows;1){
			var row = self.rows[i];
			if(row.kind == "item" && row.spec && row.spec.name == specName){
				idx = i;
				break;
			}
		}
		if(!idx) return false;
		var r0 = self.rows[idx];
		var bx = 10, by = r0.y + math.floor(r0.h/2);
		var hwnd = self.board.ctrl.hwnd;
		// 目标屏幕坐标 → 客户区坐标（基准是客户区原点，与 mouseScreen 一致）
		var ox, oy = ..win.toScreen(hwnd, 0, 0);
		if(ox === null || ox === undefined) return false;
		var lpx = screenX - ox;
		var lpy = screenY - oy;
		var lpDown = (by << 16) | (bx & 0xFFFF);
		var lpMove = ((lpy & 0xFFFF) << 16) | (lpx & 0xFFFF);
		::PostMessage(hwnd, 0x201/*WM_LBUTTONDOWN*/, 1, lpDown);
		::PostMessage(hwnd, 0x200/*WM_MOUSEMOVE*/, 0, lpMove);
		::PostMessage(hwnd, 0x202/*WM_LBUTTONUP*/, 0, lpMove);
		return true;
	}

	// 重新生成行
	self.refresh = function(){
		self.rows = {};
		var cats = ..nodio.designer.registry.categories();
		for(i=1;#cats;1){
			var cat = cats[i];
			..table.push(self.rows, {kind="cat"; text=cat; collapsed=false});
			var specs = ..nodio.designer.registry.list(cat);
			for(k=1;#specs;1){
				..table.push(self.rows, {kind="item"; text=specs[k].name; spec=specs[k]});
			}
		}
		self.__layout();
		self.board.invalidate();
		return #self.rows;
	}

	// 计算每行的位置
	// 行高/缩进/缩略图尺寸都是**逻辑像素**，按 DPI 换算成物理像素
	self.__layout = function(){
		var y = 0;
		for(i=1;#self.rows;1){
			var row = self.rows[i];
			row.y = y;
			row.h = ..nodio.ui.px((row.kind == "cat") ? 22 : 20);
			y = y + row.h;
			if(row.kind == "cat" && row.collapsed){
				// 折叠：跳过该分类下的组件
				for(k=i+1;#self.rows;1){
					if(self.rows[k].kind == "cat") break;
					self.rows[k].h = 0;
				}
			}
		}
		// 折叠的行高度为 0，位置需要重排
		y = 0;
		for(i=1;#self.rows;1){
			var row = self.rows[i];
			row.y = y;
			y = y + row.h;
		}
	}

	// 命中测试：y → 行号
	self.__hitIndex = function(y){
		for(i=1;#self.rows;1){
			var row = self.rows[i];
			if(row.h <= 0) continue;
			if(y >= row.y && y < row.y + row.h) return i;
		}
		return 0;
	}

	// 绘制
	self.__draw = function(graphics, rc, bd){
		var font = bd.font;
		var fmt = bd.format;
		var w = rc.right - rc.left;
		var h = rc.bottom - rc.top;
		var pWidget = ..nodio.ui.px(16);   // 控件缩略图边长
		var pIndent = ..nodio.ui.px(24);   // 组件行的文字缩进
		var pCatPad = ..nodio.ui.px(6);    // 分类行的缩进
		// 背景
		var bg = ..gdip.solidBrush(self.bgColor);
		graphics.fillRect(bg, rc.left, rc.top, w, h);
		bg.delete();
		for(i=1;#self.rows;1){
			var row = self.rows[i];
			if(row.h <= 0) continue;
			var y = rc.top + row.y;
			// 选中/悬停底色
			if(i == self.selIndex){
				var sb = ..gdip.solidBrush(self.selColor);
				graphics.fillRect(sb, rc.left, y, w, row.h);
				sb.delete();
			}
			elseif(i == self.hover){
				var hb = ..gdip.solidBrush(self.hoverColor);
				graphics.fillRect(hb, rc.left, y, w, row.h);
				hb.delete();
			}
			// 文字
			var x = rc.left + ((row.kind == "cat") ? pCatPad : pIndent);
			var color = (row.kind == "cat") ? self.catColor : self.textColor;
			var brush = ..gdip.solidBrush(color);
			if(row.kind == "cat"){
				// 折叠标记：细箭头（对齐参考 IDE 的树形展开符）
				var mark = row.collapsed ? "› " : "⌄ ";
				graphics.drawString(mark ++ row.text, font,
					::RECTF(x, y, w - x, row.h), fmt, brush);
			}
			else{
				// 控件缩略图（FontAwesome 没有控件图标，这里用 GDI+ 手绘小控件）
				..nodio.ui.drawWidget(graphics, row.spec ? row.spec.cls : null,
					rc.left + ..nodio.ui.px(3), y + (row.h - pWidget) / 2, 16,
					self.textColor, self.bgColor);
				graphics.drawString(row.text, font,
					::RECTF(x, y, w - x, row.h), fmt, brush);
			}
			brush.delete();
			// 分类下方分隔线
			if(row.kind == "cat"){
				var pen = ..gdip.pen(self.lineColor, 1);
				graphics.drawLine(pen, rc.left, y + row.h - 1, rc.right, y + row.h - 1);
				pen.delete();
			}
		}
	}

	self.layout = function(l,t,r,b){
		if(l === null || l === undefined){
			var rc = self.rect;
			if(!rc) return;
			l = rc.left; t = rc.top; r = rc.right; b = rc.bottom;
		}
		self.rect = {left=l; top=t; right=r; bottom=b};
		self.board.layout(l, t, r, b);
	}

	self.__layout();
	self.layout();
	return self;
}

}
