// nodio.ui.board — 画板（自绘控件）。
//
// 基于官方 plus 控件，但**鼠标事件走自己的窗口子类化**
// （nodio.ui.subclass），不依赖官方 win.ui 的控件事件路由：
//   · 官方路由靠 `::SetWindowPointer` 装窗口过程，在 Nodio 里装不上，
//     控件能画但收不到任何鼠标消息；
//   · 自己子类化还能拿到 WM_MOUSEMOVE（悬停/拖动都要用），官方 plus
//     的事件表里也没有可靠的 mousemove。
//
// 坐标约定：**物理像素**。GDI+ 文字度量只在像素单位下自洽
// （字体按物理像素创建，measureString 返回的就是物理宽度），
// 所以绘制、摆放、命中测试一律用物理像素。
// 设计常量（字号/行高/内边距）按逻辑像素写，用 nodio.ui.px() 换算。
//
// 用法：
//   board = nodio.ui.board(winform, {left=..;top=..;right=..;bottom=..})
//   board.onDraw       = function(graphics, rc, self){ ... }  // 完全自绘
//   board.onMouseDown  = function(x, y, self){ ... }          // 客户区坐标
//   board.onMouseMove  = function(x, y, self){ ... }
//   board.onMouseUp    = function(x, y, self){ ... }
//   board.onMouseClick = function(x, y, self){ ... }
//   board.onContextMenu = function(x, y, self){ ... }  // 屏幕坐标
//   board.invalidate()                                       // 重绘
//
// 绘制工具（来自官方 gdip）：
//   var brush = ..gdip.solidBrush(0xFFE3E3E3); graphics.fillRect(brush,x,y,w,h); brush.delete();
//   var pen = ..gdip.pen(0xFF808080,1); graphics.drawLine(pen,x1,y1,x2,y2); pen.delete();
//   graphics.drawString(text, font, ::RECTF(x,y,w,h), null, brush);
namespace nodio.ui{
import win.ui.ctrl.plus;
import nodio.ui.subclass;
import nodio.ui.rect;
import nodio.ui.dpi;
import gdip;
import raw;

var __bdSeq = 0;

// ---------- 画板登记表 ----------
//
// 官方 plus 的 WM_PAINT（win/ui/ctrl/plus.aardio:833）：
//     var rcPaint = ps.rcPaint;
//     graphics.setClipRect(rcPaint, _GdipCombineModeReplace);
//     this._draw(...)
// **裁剪区 = 本次失效区域**。窗口从没画过时更新区可能是空的，
// 于是「画了一遍」等于什么都没画 —— 画板在、可见、矩形也对，屏幕上却是空的。
//
// 这就是「IDE 打开后组件半天不显示」的根因：自绘板都在等一个
// **永远不会来的失效通知**。这里登记所有画板，启动后统一强制整块重画。
var __boards = {};

// ---------- 延迟绘制（防屏闪） ----------
//
// ⚠⚠⚠ **为什么 27 块画板没法「合成一帧」** —— 这是本仓库最贵的一条经验，
// 走过的弯路必须写下来：
//
//   官方 plus 的 WM_PAINT（win/ui/ctrl/plus.aardio:836）是这样画的：
//     BitBlt 自身像素 → setClipRect(rcPaint) → _draw → BitBlt 回去
//   **裁剪区 = 本次失效区（ps.rcPaint）**。
//
//   所以「InvalidateRect 全部置脏 + 一次
//    RedrawWindow(父, RDW_ALLCHILDREN|RDW_UPDATENOW) 一次成帧」这条路**走不通**：
//   父窗口先画自己的背景，把子控件的更新区**吃掉**，
//   子控件随后拿到的是**空裁剪区** —— 裁剪区一空就等于什么都没画
//   ⇒ 标题栏 / 工具条 / 停靠面板**整片消失**（实测截图确认）。
//
//   探针 tests/probe_redraw.aardio 里「一次成帧」是成立的
//   （当场 1,1,1 次 WM_PAINT），但那 3 块 plus 是直接 form.add 出来的、
//   没有「官方窗体背景板」参与遮挡；真实 IDE 是 27 块 + 官方窗体背景，
//   结论正好相反。**探针的结论不能直接套到 IDE 上。**
//
//   ⇒ 结论：**N 个独立子窗口没法原子成帧**。
//     真正的一帧只能把整个 chrome 画成**一块画板**（标题栏+工具条+停靠面板
//     全画进同一个 HWND）—— 架构级改造，不在本次范围。
//
//   在那之前能做的是**别画中间态**：
//   启动期窗口尺寸要跳 3 次（1281×821 → 1943×1287 → 3840×2160，
//   官方窗体 DPI 初始化 / 去掉标题栏 / 最大化各来一次），
//   每次跳变触发一次全量重排 + 27 块画板各强制上屏一次
//   ⇒ 上百次上屏 = 用户看到的「满屏闪」。
//   用 setDeferredPaint(true) 把这段期间的绘制**全部压掉**，
//   只在最后画一次 ⇒ 窗口一出现就是最终样子。
var __deferred = false;
// 开关：true = 只置脏不上屏（中间态不显示），false = 立刻上屏
setDeferredPaint = function(on){
	__deferred = on ? true : false;
	return __deferred;
}
isDeferredPaint = function(){
	return __deferred;
}

// ---------- 拖拽改尺寸/挪位置的状态 ----------
//
// WM_ENTERSIZEMOVE(0x231)/WM_EXITSIZEMOVE(0x232) 之间，用户正在拖动
// 窗口的边或标题栏。这个状态由 ide/nodio/app/shell.nodio 的窗体消息钩子
// 维护，layout() 收尾据此决定要不要「逐块强制上屏」：
//   拖拽中  → 只置脏，成帧交给系统的合成器（WS_EX_COMPOSITED 一帧上屏）；
//   拖拽结束 → 立刻补一次完整重画。
var __sizeMove = false;
setSizeMove = function(on){
	__sizeMove = on ? true : false;
	return __sizeMove;
}
inSizeMove = function(){
	return __sizeMove;
}

// 强制画板重画。
//
// ⚠ 计时：一次 redrawAll = N 个画板各做一次「整块失效 + 同步重画」，
//   是启动期最贵的一次操作（窗口尺寸每跳一次就重来一遍）。
//
// onlyDirty = true 时**只重画「上次重画之后矩形变过」的板子**：
//   布局 flush 里大多数板子只是挪了位置（尺寸没变）——
//   主窗体有 WS_CLIPCHILDREN 之后，父窗体重绘不再擦掉子窗体的像素，
//   挪位置的板子内容跟着窗口走，根本不需要重画；
//   全量失效 27 块 = 每次 flush 白白多花一百多毫秒（实测）。
//   板子自己的 __dirty 标记由 board.layout() 在尺寸变化时置位。
redrawAll = function(onlyDirty){
	var t0 = ..time.tick();
	var n = 0;
	var __slow = "";
	for(k,v in __boards){
		if(onlyDirty && !(v.isDirty ? v.isDirty() : false)) continue;
		var __t = ..time.tick();
		try{ v.redraw(); n = n + 1 }catch(e){}
		try{ v.markClean() }catch(e4){}
		var __c = ..time.tick() - __t;
		if(__c >= 3){
			__slow = __slow ++ " " ++ tostring(k) ++ ":" ++ tostring(__c) ++ "ms";
		}
	}
	if( ..string.getenv("NODIO_IDE_DIAG") ){
		io.print("DIAG redrawAll onlyDirty=" ++ tostring(onlyDirty ? true : false)
			++ " boards=" ++ tostring(n)
			++ " cost=" ++ tostring(..time.tick() - t0) ++ "ms"
			++ " deferred=" ++ tostring(__deferred)
			++ ( __slow ? (" slow:" ++ __slow) : "" ));
	}
}

// ---------- 鼠标移出跟踪（TrackMouseEvent）----------
//
// 没有它，鼠标移出画板后画板收不到任何消息，悬停态会一直挂着
// （按钮一直是高亮的样子）。官方 win.ui.tracker 就是这么做的。
// 官方写法是 `::User32.api("TrackMouseEvent", "bool(struct& lpEventTrack)")`，
// 但 Nodio 的 `::` 只认引擎内置符号，所以这里走 raw.loadDll()。
//
// 结构体只建一次（每次鼠标移动都新建一张表会制造垃圾），
// 靠 "struct&" 的**传址**语义改字段后复用。
var __u32 = null;
var __tme = null;
var __tmeStruct = {
	INT cbSize = 16;
	INT dwFlags = 2;        // _TME_LEAVE
	HWND hwndTrack = 0;
	DWORD dwHoverTime = 0;
};
var __trackInit = function(){
	if(__tme) return true;
	__u32 = ..raw.loadDll("user32.dll");
	if(!__u32) return false;
	__tme = __u32.api("TrackMouseEvent", "bool(struct &tme)");
	return __tme != null;
}
// 让系统在该窗口上跟踪鼠标，鼠标移出时发 WM_MOUSELEAVE
var __trackLeave = function(hwnd){
	if(!__trackInit()) return false;
	__tmeStruct.hwndTrack = hwnd;
	return __tme(__tmeStruct);
}

// ---------- 鼠标捕获（SetCapture）----------
//
// 弹出式菜单（标题栏的下拉）需要：点开菜单后，即使鼠标移到菜单外面，
// 也要继续收到鼠标消息，直到用户点一下决定「选中还是取消」。
// 没有捕获的话，菜单会一直挂着，点别处也没反应。
var __capSet = null;
var __capRelease = null;
var __capInit = function(){
	if(__capSet) return true;
	__u32 = ..raw.loadDll("user32.dll");
	if(!__u32) return false;
	__capSet = __u32.api("SetCapture", "addr(addr hwnd)");
	__capRelease = __u32.api("ReleaseCapture", "int()");
	return __capSet != null;
}
var __setCapture = function(hwnd){
	if(!__capInit()) return false;
	return __capSet(hwnd);
}
var __releaseCapture = function(){
	if(!__capRelease) return false;
	return __capRelease();
}

// 板面默认字体。
//
// 字号按**物理像素**创建（96dpi 逻辑字号 × DPI 缩放系数）：
// GDI+ 的 gdip.font 默认单位是 _GdipUnitPixel，不随 DPI 变 ——
// 不乘缩放系数的话，系统 150% 时自绘文字会比原生控件小一圈。
//
// 缓存按「字体名 + 物理字号」分桶（原来只有一个全局字体，
// 第一个板面创建后其它板面拿到的都是同一个字号，fontSize 选项形同虚设）。
var __boardFonts = {};
boardFont = function(size, name){
	name = name : "Segoe UI";
	var ps = ..nodio.ui.px(size);
	var key = name ++ "@" ++ ps;
	var f = __boardFonts[key];
	if(f) return f;
	f = ..gdip.font(name, ps);
	__boardFonts[key] = f;
	return f;
}

// 共用的文字格式：水平靠左 + **垂直居中** + 超长省略号截断。
// 默认格式是「左上对齐」，字号放大后文字会贴着行顶，这里统一居中；
// 状态栏这类固定宽度的格子遇到长路径会折行（撑破格子），所以开截断。
var __boardFormat = null;
boardFormat = function(){
	if(__boardFormat) return __boardFormat;
	__boardFormat = ..gdip.stringFormat();
	__boardFormat.align = 0;      // _StringAlignmentNear
	__boardFormat.lineAlign = 1;  // _StringAlignmentCenter
	__boardFormat.trimming = 2;   // _StringTrimmingEllipsisCharacter
	// 不折行：不加这个标志时 GDI+ 会把长文本折成多行，
	// 固定行高的列表/树里会上下串行（标准库页的说明列就是这样糊成一团的）。
	// 加上之后超长文本按 trimming 截断成一行 + 省略号。
	__boardFormat.flags = 0x1000; // _StringFormatFlagsNoWrap
	return __boardFormat;
}

board = function(winform, opt){
	opt = opt : {};
	var self = {
		winform = winform;
		ctrl = null;
		sub = null;
		rect = opt.rect;
		font = null;
		fontSize = opt.fontSize : 12;   // 逻辑字号
		fontName = opt.fontName;
		format = boardFormat();
		downX = 0; downY = 0; bDown = false;
		dblClick = false;       // 最近一次按下是不是双击
		__shown = false;        // 上一次 show 的可见性（重复 show 不再整块重画）
		onDraw = null;          // function(graphics, rc, self)
		onMouseDown = null;    // function(x, y, self)
		onMouseMove = null;
		onMouseUp = null;
		onMouseClick = null;
		onDoubleClick = null;  // function(x, y, self) —— 双击
		onContextMenu = null;   // function(x, y, self) —— x,y 是**屏幕坐标**
		onRightMouseDown = null;   // function(x, y, self) —— 客户区坐标
		onRightMouseUp = null;     // function(x, y, self) —— 客户区坐标
		onMouseWheel = null;       // function(delta, x, y, self) —— delta>0 向上滚
		onMouseLeave = null;       // function(self) —— 鼠标移出画板
		capture = opt.capture;     // true = 按下时捕获鼠标（弹出式菜单用）
		// 鼠标抬起时是否自动释放捕获。弹出式菜单要「点外面 = 取消」，
		// 捕获必须一直保持到用户在菜单上按下为止，所以关掉自动释放。
		// 默认仍然是「抬起即释放」（与 capture 的原始语义一致）。
		autoReleaseCapture = (opt.autoReleaseCapture === null) ? true : opt.autoReleaseCapture;
		__dirty = false;       // 上次重画之后矩形（尺寸）变过 → 需要整块重画
		__errPrinted = false;  // onDraw 首次报错打印后就静默（防刷屏）
	};

	__bdSeq = __bdSeq + 1;
	var bname = "board" + __bdSeq;
	// 矩形：既接受 opt.rect，也接受扁平的 left/top/right/bottom
	var r = opt.rect : {
		left = opt.left : 0;
		top = opt.top : 0;
		right = opt.right : 200;
		bottom = opt.bottom : 100;
	};
	self.ctrl = ..nodio.ui.addCtrl(winform, bname, {
		cls="plus";left=r.left;top=r.top;right=r.right;bottom=r.bottom;
		notify=1;transparent=opt.transparent;bgroup=false;z=opt.z : 15
	});
	// 记录当前矩形（扁平写法时 opt.rect 是 null，
	// 不落地的话 layout() 无参调用会直接返回，矩形永远停在创建时的位置）
	self.rect = r;

	// 完全自绘：取消 plus 的默认背景与文字绘制
	self.ctrl.onDrawBackground = function(graphics, rc, bg, color){
		// 每次重绘都重取字体：跨显示器 DPI 变了以后字号要跟着变
		self.font = boardFont(self.fontSize, self.fontName);
		if(self.onDraw){
			try{
				self.onDraw(graphics, rc, self);
			}
			catch(e){
				// 绘制回调出错不能把整个 IDE 带崩（plus 会吞掉异常，
				// 表现是「画板一片空白」，极难定位）—— 打出来。
				// 持续性错误（比如无头冒烟里每次 WM_PAINT 都炸）只打首条，
				// 不然一条日志刷几百行，把真正的断言淹没。
				if(!self.__errPrinted){
					self.__errPrinted = true;
					io.print("BOARD-DRAW-ERR[" ++ bname ++ "]:" ++ tostring(e)
						++ "（同类错误只打首条）");
				}
			}
		}
		return true;
	}
	self.ctrl.onDrawString = function(graphics, text, font, rectf, strFormat, brush){
		return true;    // 文字由 onDraw 自己画
	}

	// 鼠标：自己子类化（官方 win.ui 的控件路由在 Nodio 里装不上窗口过程）
	self.sub = ..nodio.ui.subclass(self.ctrl.hwnd, function(hwnd, msg, wp, lp){
		var x = lp & 0xFFFF;
		var y = (lp >> 16) & 0xFFFF;
		if(opt.diagTag && ..string.getenv("NODIO_IDE_DIAG") ){
			io.print("DIAG board-msg " ++ opt.diagTag ++ " msg=" ++ msg ++ " lp=" ++ lp);
		}
		if(msg == 0x201){            // WM_LBUTTONDOWN
			self.bDown = true;
			self.dblClick = false;
			self.downX = x; self.downY = y;
			// 捕获鼠标：鼠标移出画板也要继续收到消息（弹出式菜单）
			if(self.capture) __setCapture(self.ctrl.hwnd);
			if(self.onMouseDown) self.onMouseDown(x, y, self, lp);
		}
		elseif(msg == 0x200){       // WM_MOUSEMOVE
			// 跟踪鼠标移出（否则悬停态复位不了）
			__trackLeave(self.ctrl.hwnd);
			if(self.onMouseMove) self.onMouseMove(x, y, self, lp);
		}
		elseif(msg == 0x2A3){       // WM_MOUSELEAVE
			if(self.onMouseLeave) self.onMouseLeave(self);
		}
		elseif(msg == 0x202){       // WM_LBUTTONUP
			var wasDown = self.bDown;
			self.bDown = false;
			if(self.capture && self.autoReleaseCapture) __releaseCapture();
			if(self.onMouseUp) self.onMouseUp(x, y, self, lp);
			// 在同一位置按下并抬起 = 一次点击
			if(wasDown && math.abs(x - self.downX) < 4 && math.abs(y - self.downY) < 4){
				if(self.onMouseClick) self.onMouseClick(x, y, self, lp);
			}
		}
		elseif(msg == 0x203){       // WM_LBUTTONDBLCLK
			self.bDown = false;
			self.dblClick = true;
			// 双击必须**单独派发**：以前这里只转调 onMouseClick，
			// 全仓库没有任何一处调用 onDoubleClick ——
			// 于是 list / tree 挂上去的双击回调是死字段：
			// 工程树双击打开文件、问题列表双击跳转、引用面板双击跳转、
			// 搜索结果双击打开文件，**四个功能全是死的**。
			// （第一次 click 已由前面的 WM_LBUTTONUP 派发过，这里不再重复。）
			if(self.onDoubleClick) self.onDoubleClick(x, y, self, lp);
			elseif(self.onMouseClick) self.onMouseClick(x, y, self, lp);
		}
		elseif(msg == 0x7B){        // WM_CONTEXTMENU
			// 右键 / 菜单键 / Shift+F10。lParam 里是**屏幕坐标**
			// （与官方 win.ui.tracker 的 onContextMenu 语义一致）：
			//   官方 tracker.aardio:162-166
			//     var x,y = ..win.getMessagePos(lParam)
			//     if(x==-1 && y==-1) x,y = ..win.getMessagePos()
			// lParam == -1 表示不是鼠标位置（菜单键 / Shift+F10），
			// 这时退回真实光标位置。
			var cx,cy = ..win.getMessagePos(lp);
			if(cx == -1 && cy == -1) cx,cy = ..win.getMessagePos();
			if(self.onContextMenu) self.onContextMenu(cx, cy, self);
		}
		elseif(msg == 0x204){       // WM_RBUTTONDOWN（lParam 是客户区坐标）
			if(self.onRightMouseDown) self.onRightMouseDown(x, y, self);
		}
		elseif(msg == 0x205){       // WM_RBUTTONUP（lParam 是客户区坐标）
			if(self.onRightMouseUp) self.onRightMouseUp(x, y, self);
		}
		elseif(msg == 0x20A){       // WM_MOUSEWHEEL
			// 注意：滚轮消息的 lParam 是**屏幕坐标**，不是客户区坐标。
			// delta 在 wParam 的高 16 位（120 的倍数，正数=向上滚）。
			var delta = (wp >> 16) & 0xFFFF;
			if(delta > 32767) delta = delta - 65536;
			if(self.onMouseWheel) self.onMouseWheel(delta, x, y, self);
		}
		return null;
	});

	// 重绘
	//
	// **必须整块失效**。
	//
	// 官方 plus 的 WM_PAINT 是这样画的（win/ui/ctrl/plus.aardio:836）：
	//   1) 把窗口当前画面 BitBlt 到内存 DC
	//   2) graphics.setClipRect(rcPaint, Replace)   ← 裁剪区 = **本次失效区域**
	//   3) 画一遍
	//   4) BitBlt 回窗口
	// 于是「只失效了一小块」时，裁剪区就只有那一小块：
	// 画板重画时**其余部分不会被重画**，屏幕上残留的旧像素就留在那里。
	// 表现是：标题栏的 logo 和前两个菜单（文件/工程）忽然整块消失，
	// 而菜单栏右边还是好的 —— 一模一样像「控件没画出来」。
	//
	// 所以 invalidate() 一律按**整窗**失效（rcPaint = 整个客户区），
	// 保证自绘内容每次都完整重画。
	self.invalidate = function(){
		try{
			::InvalidateRect(self.ctrl.hwnd, 0, 1/*erase*/);
		}
		catch(e){
			try{ self.ctrl.invalidate() }catch(e2){}
		}
	}

	// 强制**整块**重绘。
	//
	// invalidate() 只是置脏位，更新区域（rcPaint）可能是残缺的 ——
	// 自绘内容会被 GDI+ 的裁剪区裁掉一部分。
	// 官方 ctrl 没有可用的 redraw 成员（调用会抛「非函数值」），
	// 这里用引擎 sysapi 的 InvalidateRect(整块) 失效整窗。
	//
	// ⚠⚠ 这里**不能**跟 UpdateWindow：
	//   UpdateWindow 会**立刻**把这一块 WM_PAINT 掉并上屏。
	//   布局过程中有 27 块画板，每块尺寸变了都要重画 ——
	//   一块一块「重画 + 立即上屏」，用户看到的就是
	//   「一半新一半旧」的中间态反复出现 = **满屏闪**。
	//   现在只置脏，由 nodio.ui.redrawAll() 在布局收尾时
	//   用一次 RedrawWindow(ALLCHILDREN|UPDATENOW) 统一成帧。
	//
	// 为什么整窗失效就够：官方 plus 的 WM_PAINT 用「本次失效区域」
	// 当裁剪区，整窗失效 ⇒ 裁剪区 = 整个客户区 ⇒ 内容完整重画 ✓
	self.redraw = function(){
		self.__redrawCount = (self.__redrawCount : 0) + 1;
		try{
			::InvalidateRect(self.ctrl.hwnd, 0, 1/*erase*/);
			// UpdateWindow 会**立刻**把这一块 WM_PAINT 掉并上屏。
			// 逐块上屏 = 每块一次上屏 = 用户看到「一半新一半旧」的中间态
			// = 满屏闪。延迟绘制期间只置脏，最后统一画一次。
			if(!__deferred) ::UpdateWindow(self.ctrl.hwnd);
		}
		catch(e){
			try{ self.ctrl.invalidate() }catch(e2){}
		}
	}

	// 重画次数（给回归锁看「有没有在无缘无故地反复重画」）
	self.redrawCount = function(){
		return self.__redrawCount : 0;
	}

	// 显示/隐藏
	//
	// ⚠ 显示之后**必须强制重画一次**：
	//   官方 plus 的 WM_PAINT 用「本次失效区域」当绘制裁剪区
	//   （见上面 invalidate 的说明）。一个画板如果创建时是隐藏的、
	//   后来才 show(true)，Windows 给它的首次更新区域经常是空的 ——
	//   裁剪区一空就等于什么都没画：
	//   窗口在、IsWindowVisible 为真、矩形也对，屏幕上却什么都没有。
	//   （设计器画布、提示条、查找条、补全浮层、下拉菜单全踩过这个坑。）
	//   所以 show(true) 之后统一按整块失效 + 立刻重画。
	//
	// ⚠⚠ 但**不能每次 show(true) 都重画**（第五十八轮修的闪烁）：
	//   IDE 的心跳每 300ms 调一次开始页的 show（可见性跟着页签数走），
	//   而 show(true) 会整块重画 → **每 300ms 闪一次**（无文档时最明显：
	//   开始页一直可见，每拍都重画）。
	//   所以只有「隐藏 → 显示」这一下才重画；重复 show(true) 不动它
	//   （内容变了应该调 invalidate/redraw，不是 show）。
	self.show = function(flag){
		flag = flag ? true : false;
		self.ctrl.show(flag);
		if(flag){
			if(self.__shown !== true){
				self.__shown = true;
				self.redraw();
			}
		}
		else{
			self.__shown = false;
		}
	}

	// 显式捕获/释放鼠标。
	// 弹出式菜单靠它做到「点菜单外面 = 取消」：
	// 菜单打开时捕获，点击落在菜单画板外也算点到了菜单画板。
	self.setCapture = function(on){
		if(on) __setCapture(self.ctrl.hwnd);
		else __releaseCapture();
	}

	// 重新摆放
	self.layout = function(l,t,r,b){
		if(l === null || l === undefined){
			var rc = self.rect;
			if(!rc) return;
			l = rc.left; t = rc.top; r = rc.right; b = rc.bottom;
		}
		var old = self.rect;
		self.rect = {left=l; top=t; right=r; bottom=b};
		// 官方 win.ui 控件的 setPos 是 (x,y,宽,高)，引擎原生控件是 (l,t,r,b)，
		// 两套方言混用会让布局整体错乱 —— 统一走 win.setPos。
		..nodio.ui.setRect(self.ctrl, l, t, r, b);
		// 尺寸变了 → 强制整块重画。
		// 官方 plus 只画「本次失效区域」：尺寸变化时新暴露出来的那一条会画，
		// 其余部分保持旧像素 —— 表现是画板「一半新一半旧」甚至整块空白。
		if(!old
			|| (old.right - old.left) != (r - l)
			|| (old.bottom - old.top) != (b - t)){
			// 标记「需要整块重画」：redrawAll(true)（增量重画）据此挑板子。
			// 只挪位置、尺寸没变的板子不标记 —— 主窗体有 WS_CLIPCHILDREN
			// 之后，父窗体重绘不再擦掉子窗体的像素，内容跟着窗口走。
			self.__dirty = true;
			self.redraw();
		}
	}

	// 「上次重画之后矩形变过」—— nodio.ui.redrawAll(true) 的挑选依据
	self.isDirty = function(){
		return self.__dirty ? true : false;
	}
	self.markClean = function(){
		self.__dirty = false;
	}

	// 释放：解除子类化（否则子类化记录会钉住画板）
	self.dispose = function(){
		if(self.sub){
			try{ self.sub.free() }catch(e){}
			self.sub = null;
		}
		__boards[bname] = null;
		self.ctrl = null;
	}

	// 登记进全局表（启动后统一强制重画用）
	__boards[bname] = self;

	self.layout();
	// ⚠ 创建完立刻**强制整块重画一次**：
	//   画板是先创建、后由窗体显示出来的，中间隔着大量控件创建，
	//   官方 plus 的 WM_PAINT 只画「本次失效区域」，
	//   更新区为空 ⇒ 这一画等于没画 ⇒ 面板一片空白。
	//   这里把整块区域标脏，窗口显示后第一次 WM_PAINT 就会画全。
	self.redraw();
	return self;
}

}
