//object 对象
import web.json;
import util.metaProperty;
namespace py3;

// ---- Nodio x64 补版：允许 py3 子模块被独立导入 ----
// 官方约定必须先 import py3 才能使用 py3.xxx；这里自行载入 64 位 Python 运行时，
// 使 py3.xxx 可以单独导入（::Py3Runtime 与父模块共用同一个 DLL 句柄）。
::Py3Runtime := ::Py3Runtime || ..raw.loadDll("~\lib\py3\.res\DLLs\python38.dll",,"cdecl");
if(!::Py3Runtime) {
	error("未检测到 64 位 python38.dll，py3 扩展库不可用",2);
}
 
class object {

	ctor( object,isPyObjectPtr ){

		var tt = type(object)
		select(tt) {
			case "string"{
				if(..string.getUtf(object)&16) object = ..string.fromUtf16(object);
				this.pyObject = Py_BuildValueByString("s#",object,#object);
			}
			case "number"{
				this.pyObject = Py_BuildValueByNumber("d",object);
			}
			case "buffer"{
				this.pyObject = Py_BuildValueByString("y#",object,#object);
			}
			case "boolean"{
				this.pyObject = ::Py3Runtime.PyBool_FromLongP(!!object);
			}
			case "pointer"{
				if( isPyObjectPtr ){
					this.pyObject = object
				}
				else {
					//而且 pyTuple_SetItem 这些都是将指针作为 pyObject 指针使用
					error("参数请不要指定原生指针,可先用 tonumber 函数转换为数值",2);
				}
			}
			case "table"{
				if(object[["pyObject"]] ) {
					this.pyObject = object[["pyObject"]];
					..py3.IncRef(this.pyObject);
				}
				else{
					var s = ..web.json.stringify(object); 

					var obj = ..py3.json.loads(s);
					if(!obj) return;
				
					if( obj.checkDict()  ) return ..py3.dict(obj.stealPtr());
					elseif( obj.checkList() ) return ..py3.list(obj.stealPtr());
					else{
						this.pyObject = obj.stealPtr();
					}
				}
			}
			case "null"{
				if(isPyObjectPtr){
					var e = ..py3.lasterr();
					if(e) error(e,3)
				}
				
				this.pyObject = ::Py3Runtime.Py_BuildValueP("");
			}
			else { 
				if(..math.isSize64(object)){
					this.pyObject = ::Py3Runtime.Py_BuildValueP("K",object);
				}
				else {
					error("pyObject构造参数不支持此数据类型:" + tt ,2)
				}
			}
		}  
		
		..table.add_gc(this,"release");
	}
	
	@_metaProperty;
}

namespace object {
	
	_metaProperty = ..util.metaProperty( 
	
		release = function(){
			if( owner[["pyObject"]] ){
				..py3.DecRef(owner.pyObject); 
				owner[["pyObject"]] = null;
			}
		}; 
		stealPtr = function(){
			var pyObject = owner.pyObject;
			owner[["pyObject"]] = null;
			return pyObject;
		};
		toBool = function(){
			return !!::Py3Runtime.PyObject_IsTrue(owner); 
		};
		toNumber = function(){
			var ret,n = PyArg_ParseByNumber(owner.pyObject,"d",0);
			if(ret)return n;
		};
		toTuple = function(){
			return ..py3.tuple(owner);
		};
		toList = function(){
			return ..py3.list(owner);
		};
		toDict = function(){
			return ..py3.dict(owner);
		};
		toBytes = function(){
			var ret,s,len = PyArg_ParseByBuffer(owner.pyObject,"y#",,0);
			if(s){
				if( len ){
					var b = ..raw.buffer(len);
					::CopyMemory(b,s,len);
					return b;
				}
				return;
			}
			return;
		};
		toStr = function(){
			var p = ::Py3Runtime.PyObject_StrP(owner);
			if(p) return  ..py3.object(p,true); 
		};
		toString = function(){ 
			var t = ::Py3Runtime.PyObject_TypeP(owner);
			if( t ){ 
				var flags = ::Py3Runtime.PyType_GetFlags(t);
				..py3.DecRef(t);
				
				if ( flags &(1<< 28)){
					var r,s = PyArg_ParseByString(owner.pyObject,"s");
					if( r && s ) { return ..raw.str(s); }
					return;
				}
					
				if(t == PyFloat_Type)
					return tostring(owner.toNumber());
				
				if(flags & (1<< 24))
					return owner.toStr().toString();
						
				if ( flags &(1<< 27))
					return owner.toBytes();
					
				if ( t == PyBool_Type)
					return tostring( owner.toBool() );
					
				if(  ( flags &(1<< 29)) ||  ( flags &(1<< 25))  ||  ( flags &(1<< 26)) ){  
					return ..py3.json.dumps(owner);
				}
				
				if( owner.pyObject == None )
					return "null";
				
				var str = ::Py3Runtime.PyObject_StrP(owner);
				if(str) {
					var result;
					var ok,s = PyArg_ParseByString(str,"s");
					if( ok && s ) result = ..raw.str(s);
					..py3.DecRef(str);
					
					return result;
				}
			}
		};
		size64 = function(){
			var v = ..math.size64()
			var r = PyArg_ParseBySize64(owner.pyObject,"K",v);
			if( r ) { return v }  
		};
		parseValue = function(baseType){ 
			var t = ::Py3Runtime.PyObject_TypeP(owner);
			if( t ){ 
				var flags = ::Py3Runtime.PyType_GetFlags(t);
				..py3.DecRef(t);
				
				if((t == PyFloat_Type) )
					return owner.toNumber();
					
				if ( flags & (1<< 24/*Py_TPFLAGS_LONG_SUBCLASS */) ){
					if( !baseType || ::Py3Runtime._PyLong_NumBits( owner.pyObject )<=53 ){
						return owner.toNumber();
					}
				}	
				
					
				if ( flags &(1<< 28)){
					var r,s = PyArg_ParseByString(owner.pyObject,"s");
					if( r && s ) { return ..raw.str(s); }
					return;
				}
				
				if ( flags &(1<< 27))
					return owner.toBytes();
					
				if ( t == PyBool_Type)
					return owner.toBool();
					
				if(!baseType){
					if(  ( flags &(1<< 29)) ||  ( flags &(1<< 25))  ||  ( flags &(1<< 26)) ){  
						var result;
						var v = ..py3.json.dumps.invokeObject(null,owner); 
						if(v){
							var ok,s = PyArg_ParseByString(v.pyObject,"s");
							if( ok && s ) result = ..web.json.parse( ..raw.str(s) ); 
							v.release();
						}
						return result;
					}	
				}
				
				if( owner.pyObject != None )
					return owner;
			}
		};	
		_topointer = function(){
			if(!owner.pyObject) error("Python对象已经已经被销毁",2);
			
			return owner.pyObject;
		};
		_tonumber = function(){
			var t = ::Py3Runtime.PyObject_TypeP(owner);
			if( t ){ 
				var flags = ::Py3Runtime.PyType_GetFlags(t);
				..py3.DecRef(t);
				
				if((t == PyFloat_Type) || ( flags & (1<< 24) ))
					return owner.toNumber();
					
				if ( flags &(1<< 28))
					return tonumber( owner.toString() );
				 
				if ( t == PyBool_Type)
					return tonumber( owner.toBool() ); 
			}
		};
		type = function(){
			var t = ::Py3Runtime.PyObject_TypeP(owner);
			if( t ){
				var tname =  ..raw.convert(t,pyTypeObject()).tp_name;
				..py3.DecRef(t);
				return tname;
			}
		};
		getTypeFlags = function(){
			var t = ::Py3Runtime.PyObject_TypeP(owner);
			if( t ){ 
				var flags = ::Py3Runtime.PyType_GetFlags(t);
				..py3.DecRef(t);
				return flags;
			}
			
			return 0;	
		};
		hasFeature = function(feature){
			return !!(owner.getTypeFlags()&feature);
		};
		checkNone = function(){
			return owner.pyObject == None;
		};
		checkDict = function(){
			return owner.hasFeature(1<< 29);
		};
		checkList = function(){
			return owner.hasFeature(1<< 25);
		};
		checkTuple = function(){
			return owner.hasFeature(1<< 26);
		};
		checkLong = function(){
			return owner.hasFeature(1<< 24);
		};
		checkUnicode = function(){
			return owner.hasFeature(1<< 28);
		};
		checkBytes = function(){
			return owner.hasFeature(1<< 27);
		};
		checkBool = function(){ 
			var t = ::Py3Runtime.PyObject_TypeP(owner);
			if( t ){ 
				..py3.DecRef(t);
				return t == PyBool_Type
			}	
		};
		checkFloat = function(){
			var t = ::Py3Runtime.PyObject_TypeP(owner);
			if( t ){ 
				..py3.DecRef(t);
				return t == PyFloat_Type
			}	
		};
		checkNumber = function(){
			var t = ::Py3Runtime.PyObject_TypeP(owner);
			if( t ){ 
				var flags = ::Py3Runtime.PyType_GetFlags(t);
				..py3.DecRef(t);
				return (t == PyFloat_Type) || ( flags & (1<< 24) )
			}	
		};
		_startIndex = 0;
		len = function(){
			return ::Py3Runtime.PyObject_Length(owner);	
		};  
		has = function(k){
			return PyObject_HasAttrString( owner.pyObject,k);
		}; 
		getAttr = function(k,noCheck){
			if( noCheck || owner.has(k) ){
				return ..py3.object( PyObject_GetAttrString(owner.pyObject,k),true ).parseValue(true)
			}
		};
		setAttr = function(k,v){
			PyObject_SetAttrString(owner.pyObject,k,..py3.object(v) ); 
		}; 
		__get = function(k,ownerCall){
			var t = type(k);
			
			//非下标索引操作符，且键为字符串
			if( ownerCall !== null && t==="string"  ){
				
				if(k[1] === '$'#){
					k = ..string.right(k,-2);
					if(!owner.has(k)) return;
					
					var pyObj = ..py3.object( PyObject_GetAttrString(owner.pyObject,k),true);
					if(pyObj){ 
						return function(...){
							return pyObj.invoke(...);
						} 
					}
					return;
				}
				
				//Python 读取不存在的属性会抛异常，元方法里最后不要抛异常
				if(owner.has(k)){
					return ..py3.object( PyObject_GetAttrString(owner.pyObject,k),true); 
				}
			}
			
			//键为数值，无论是否使用下标索引操作符
			if(t==="number") {
				if(owner[["$____pyItems____"]]) return owner[["$____pyItems____"]][k]; 

				var flags = owner.getTypeFlags();
				if( flags & (1<< 25) ){
					owner[["$____pyItems____"]] = ..py3.list(owner)
					return owner[["$____pyItems____"]][k];   
				}
				elseif( flags & (1<< 26) ){
					owner[["$____pyItems____"]] = ..py3.tuple(owner)	 
					return owner[["$____pyItems____"]][k]; 
				} 
			}
				
			return owner.getItem(k);
		};
		__set = function(k,v,ownerAttr){
			var t = type(k);
			
			//非下标索引操作符，且键为字符串
			if( ownerAttr && t==="string"){ 
				
				//可以添加新属性，例如 py3.main.xxxxx = value
				PyObject_SetAttrString(owner.pyObject,k,..py3.object(v) ); 
				return; 
			}
			
			if(t==="number") {
				if(owner[["$____pyItems____"]]) {
					owner[["$____pyItems____"]][k] = v; 
					return;
				}
				
				var flags = owner.getTypeFlags();
				if( flags & (1<< 25) ){
					owner[["$____pyItems____"]] = ..py3.list(owner)
					owner[["$____pyItems____"]][k] = v; 
				}
				elseif( flags & (1<< 26) ){
					owner[["$____pyItems____"]] = ..py3.tuple(owner)
					owner[["$____pyItems____"]][k] = v;
				} 
			}
			
			owner.setItem(k,v);
		}; 
		getItem = function(k){ 
			var item = ::Py3Runtime.PyObject_GetItemP(owner.pyObject,..py3.object(k)) ;
			if(item){
				return ..py3.object(  item,true ).parseValue(true);
			} 
		};
		setItem = function(k,v){
			if(v===null)
				::Py3Runtime.PyObject_DelItem(owner.pyObject,..py3.object(k));
			else {
			 	::Py3Runtime.PyObject_SetItem(owner.pyObject,..py3.object(k),..py3.object(v) ); 
			} 
		};
		each = function(){
			var it = ::Py3Runtime.PyObject_GetIter(owner);
			if(!it) return function(){};
			
			var item;
			return function(){
				item = ::Py3Runtime.PyIter_NextP(it);
				if( item !== null){
					return ..py3.object(item,true).parseValue(true)
				}
			} 
		};
		getFuncName = function(){
			return PyEval_GetFuncName(owner.pyObject );	
		};
		getFuncDesc = function(){
			return PyEval_GetFuncDesc(owner.pyObject );	
		};
		invokeObject = function(kwargs,...){
			var args;
			if(kwargs===null){
				args = ..py3.tuple( {...} );
			}
			elseif(type(kwargs)==="table" && !kwargs@ && !kwargs.pyObject) {
				args = ..py3.tuple((...!==null )? {...} : kwargs);
				kwargs = ..py3.dict(kwargs);
			}
			else {
				args = ..py3.tuple( {kwargs,...} );	
				kwargs = null;
			}
			
			return ..py3.object(::Py3Runtime.PyObject_CallP( owner.pyObject,args,kwargs),true );
		};
		callObject = function( args ){
			return ..py3.object(PyObject_CallObject( owner.pyObject,args),true );
		};
		invoke = function(kwargs,...){
			 return owner.invokeObject(kwargs,...).parseValue(true);
		};
		call = function( ... ){
			var args = ... ? {...};
			if( #args ) args = ..py3.tuple( args );
			return ..py3.object(PyObject_CallObject( owner.pyObject,args),true ).parseValue(true);
		};
		_call = function(...){
		 	var args = ... ? {...};
			if( #args ) args = ..py3.tuple( args ); 
			return ..py3.object(PyObject_CallObject( owner.pyObject,args),true ).parseValue(true);
		};
		_eq = function(b) {
			if(owner.checkNumber()) return tonumber(owner) == tonumber(b);
			return owner.pyObject == b.pyObject;
		};
		_le = function(b) {
			if(owner.checkNumber()) return tonumber(owner) <= tonumber(b);
		};
		_lt = function(b) {
			if(owner.checkNumber()) return tonumber(owner) < tonumber(b);
		};
		_add = function(b){
			if(owner.checkNumber()){
				if(!b[["pyObject"]]) b = ..py3.object(b);
				if(b[["pyObject"]]){
					var c = ::Py3Runtime.PyNumber_AddP(owner,b)
					if(c) return ..py3.object(c,true)
				}
			}
		};
		_sub = function(b){
			if(owner.checkNumber()){
				if(!b[["pyObject"]]) b = ..py3.object(b);
				if(b[["pyObject"]]){
					var c = ::Py3Runtime.PyNumber_SubtractP(owner,b)
					if(c) return ..py3.object(c,true)	
				}
			}
		};
		_mul = function(b){
			if(owner.checkNumber()){
				if(!b[["pyObject"]]) b = ..py3.object(b);
				if(b[["pyObject"]]){
					var c = ::Py3Runtime.PyNumber_MultiplyP(owner,b)
					if(c) return ..py3.object(c,true)
				}
			}
		};
		_div = function(b){
			if(owner.checkNumber()){
				if(!b[["pyObject"]]) b = ..py3.object(b);
				if(b[["pyObject"]]){
					var c = ::Py3Runtime.PyNumber_TrueDivideP(owner,b)
					if(c) return ..py3.object(c,true)
				}
			}
		};
		_mod = function(b) {
			if(owner.checkNumber()){
				if(!b[["pyObject"]]) b = ..py3.object(b);
				if(b[["pyObject"]]){
					var c = ::Py3Runtime.PyNumber_RemainderP(owner,b)
					if(c) return ..py3.object(c,true)
				}
			}
		};
		_pow = function(b) {
			if(owner.checkNumber()){
				if(!b[["pyObject"]]) b = ..py3.object(b);
				if(b[["pyObject"]]){
					var c = ::Py3Runtime.PyNumber_PowerP(owner,b,None)
					if(c) return ..py3.object(c,true)
				}
			}
		};
		_unm = function() {
			if(owner.checkNumber()){
				return ..py3.object(::Py3Runtime.PyNumber_NegativeP(owner),true)
			}
		};
		_type = "py3.object";
	) ;
	
	with _metaProperty{
		_tostring = toString;
		_json = lambda() owner.parseValue();//需要丢弃其他参数
	}
	
	PyObject_HasAttrString = ::Py3Runtime.api("PyObject_HasAttrString","bool(PyObject o,str attr_name)")
	PyObject_GetAttrString = ::Py3Runtime.api("PyObject_GetAttrString","pyObject(PyObject o,str attr_name)")   
	PyObject_SetAttrString = ::Py3Runtime.api("PyObject_SetAttrString","int(PyObject o,str attr_name,pyObject v)")
	PyObject_CallObject = ::Py3Runtime.api("PyObject_CallObject","pyObject(PyObject pfunc,pyObject pargs)") 
	
	/*
	避免 PY_SSIZE_T_CLEAN 警告
	#define PyArg_Parse   _PyArg_Parse_SizeT 
	#define Py_BuildValue _Py_BuildValue_SizeT
	*/
	Py_BuildValueByNumber = ::Py3Runtime.api("_Py_BuildValue_SizeT","pyObject(str format,double)") 
	Py_BuildValueByString = ::Py3Runtime.api("_Py_BuildValue_SizeT","pyObject(str format,string,int)")
	PyArg_ParseByNumber = ::Py3Runtime.api("_PyArg_Parse_SizeT","int(PyObject args,str format,double &)")  
	PyArg_ParseBySize64 = ::Py3Runtime.api("_PyArg_Parse_SizeT","int(PyObject args,str format,LONG &)") 
	PyArg_ParseByString = ::Py3Runtime.api("_PyArg_Parse_SizeT","int(PyObject args,str format,ptr &)")  
	PyArg_ParseByBuffer = ::Py3Runtime.api("_PyArg_Parse_SizeT","int(PyObject args,str format,ptr &,int &)")  
	PyEval_GetFuncName = ::Py3Runtime.api("PyEval_GetFuncName","string(PyObject *)") ;
	PyEval_GetFuncDesc = ::Py3Runtime.api("PyEval_GetFuncDesc","string(PyObject *)");
	PyBool_Type =  ::Py3Runtime.api("PyBool_Type");
	PyFloat_Type = ::Py3Runtime.api("PyFloat_Type"); 
	None = ::Py3Runtime.api("_Py_NoneStruct");
	
	class pyTypeObject {
		addr ob_refcnt;
		ptr ob_type;
    	INT ob_size;
    	string tp_name;
    	INT tp_basicsize;
    	INT tp_itemsize;
    	ptr tp_dealloc;
    	ptr tp_print;
    	ptr tp_getattr;
    	ptr tp_setattr;
    	ptr tp_compare;
    	ptr tp_repr;
    	ptr tp_as_number;
    	ptr tp_as_sequence;
    	ptr tp_as_mapping;
    	ptr tp_hash;
    	ptr tp_call;
    	ptr tp_str;
    	ptr tp_getattro;
    	ptr tp_setattro;
    	ptr tp_as_buffer;
    	int tp_flags;
 	} 
}

/**intellisense() 
py3.object( = 所有Python对象都是一个pyObject\n在aardio中使用py3.object封装该指针为对象,\n并自动管理引用计数
py3.object(.(aardio值) = 将aardio值转换为pyObject\npy3扩展库负责在与python交互时自动转换能转换的基础数据类型\n其他对象aardio代码接触到的都会是py3.object\n原始pyObject指针原则上保证不会返回给aardio调用代码
py3.object(.(pyObject指针,true) = 参数@2为true,参数@1就必须是pyObject对象指针\n返回pyObject封装对象,并负责在封装对象销毁时释放一次pyObject引用计数,\n原始pyObject指针原则上保证不会返回给aardio调用代码\n这种用法仅用于py扩展库内部使用
py3.object(.(pyObject封装对象) = 参数是py3.object封装对象\n复制一个对象，并增加引用计数\n并负责在封装对象销毁时释放一次pyObject引用计数\n\n这里传入的参数是aardio值，或者是py3.object统一都会返回py3.object\npy3扩展库基于这种兼容性自动转换所有aardio,python对象
py3.object() = !py3Object.
end intellisense**/

/**intellisense(!py3Object) 
? = 输入 Python 对象属性或函数名称。\n如果首字符为 $ ，则返回支持命名参数的函数对象。\n也就是说 pyObject.$fun 等价于 pyObject.fun.invoke。\n!py3Object.
stealPtr() =  接管此对象的指针并盗用一次引用计数\n原对象的内部指针被清空,并不再负责释放引用计数\n steal references
toBool() = 解析为 aardio 布尔值
toBytes() = 解析为 aardio 字节数组
toNumber() = 解析为 aardio 数值\n也可以直接将对象传入 tonumber 函数并转换为数值
toString() = Python 对象转换为 aardio 字符串\nPython 字节数组（bytes）解析为aardio中的字节数组（buffer）\n其他类型尝试调用 Python 中的 str 函数转换为 aardio 字符串,\n也可以直接将对象作为参数传入 tostring 函数转换为字符串
toStr() = Python 对象转换为 Python 字符串对象,\n相当于调用 Python 中的 str 函数,\n如果要返回 aardio 字符串可使用 toString 函数,\n也可以调用 py3.str 函数创建 Python 字符串对象
toTuple() = 如果 Python 对象是一个 tuple,\n返回绑定相同 Python 对象的 py3.tuple 对象,\n添加引用计数,对象销毁时负责释放引用计数,\n否则将传入对象作为 Python 内置函数 tuple 的参数并返回 py3.tuple 对象,\n失败返回null\n!py3Tuple.
toList() = 如果 Python 对象是一个 list,\n返回绑定相同 Python 对象的 py3.list 对象,\n添加引用计数,对象销毁时负责释放引用计数,\n否则将传入对象作为 Python 内置函数 list 的参数并返回 py3.list 对象,\n失败返回null\n!py3List.
toDict() = 如果 Python 对象是一个 dict,\n返回绑定相同 Python 对象的 py3.dict 对象,\n添加引用计数,对象销毁时负责释放引用计数,\n否则将传入对象作为 Python 内置函数 dict 的参数并返回 py3.dict 对象,\n失败返回null\n!py3Dict.
parseValue() = 检测 Python 对象的类型，并自动返回对应的aardio类型对象。\n基础的数值字符串布尔值转换为同类型，整数值即使大于 53 位仍转为浮点数。\ndict, list, tuple 等等使用json格式转换为 aardio 类型的表
parseValue(true) = 检测P ython 对象的类型，\n基础类型返回对应的 aardio 类型对象，其他对象返回自身。\n基础类型指：数值、布尔值、字符串、字节数组。\n数值仅转换浮点数值，以及不大于 53位（bit）的整数值。\n字节数组指 Python 中的 bytes，aardio 中的 buffer 对象。\n所有 Python 返回的对象自动调用此函数转换基础类型。
size64() = 获取64位无符号长整数\n返回 math.size64 对象
has("__/*属性名*/") = 是否存在指定的属性
getAttr("__/*属性名*/") = 读属性值，也可以用成员操作符获取。\n除数值、布尔值、字符串、字节数组以外的值在 aardio 中存为 py.object 对象。\n指定可选参数 @2 为 true 则不检查属性是否存在。
setAttr("__/*属性名*/",) = 写属性成员的值，也可以用成员操作符赋值。
getAttr() = !py3Object.
getItem(__/*索引*/) = 返回指定索引的项，也可以用索引下标操作符 [] 取值。\n除数值、布尔值、字符串、字节数组以外的值在 aardio 中存为 py.object 对象
setItem(__/*索引*/，) = 修改指定索引的项，也可以用索引下标操作符 [] 赋值。
each() = @for( pyItem in ??.each() ){\n	__/*创建迭代器用于遍历所有的项,返回一个值*/\n}\n!py3Object.
callObject(.( py3->tuple对象 ) = 该对象为 Python 函数对象时支持使用此方法调用 Python 函数,\n参数为tuple元数组对象\n返回值为 py3.object对象,可使用 tostring 或 tonumber 等函数转换为aardio类型
call(__/*不定个数参数*/) = 该对象为 Python 函数对象时支持使用此方法调用 Python 函数,\n也可以不写 call 函数，直接作为普通函数调用。\n参数为不定个数的字符串、数值、布尔值等。\n\n如果函数调用成功，\n返回值除数值、布尔值、字符串、字节数组以外的值\n在 aardio 中存为 py.object 对象
callObject() = !py3Object.
call() = !py3Object.
invokeObject( =  该对象为 Python 函数对象时支持使用此方法调用 Python 函数,\n与通过 call 方法调用不同的是 invokeObject 支持传递命名参数，\n调用成功返回值为 py3.object 对象。\ninvoke 函数调用 invokeObject 函数并会转换基础类型的值为纯 aardio 值。
invokeObject(.(kwarg=value,arg1->->->) = 如果参数@1是未指定元表的纯表对象,且没有 pyObject 成员，\n则将该表中的名值对作为调用时的命名参数，\n该表中的数组成员作为调用时的匿名参数，\n注意名值对参数应当且只能写在最前面，所有参数请用逗号分隔。\n\n如果指定了第 2 个参数或更多参数，则 kwarg 的数组成员被忽略。\n如果参数 @1 不符合前述规则，\n则与 call 调用相同的方式将所有参数作为调用时的匿名参数。\n\n如果参数 @1 为 null，则忽略第一个参数并禁用命名参数。\n并将第二个参数作为第一个参数，后续参数依次前移。
invokeObject() = !py3Object.
invoke( =  该对象为 Python 函数对象时支持使用此方法调用 Python 函数,\n与通过 call 方法调用不同的是 invoke 支持传递命名参数，\n如果函数调用成功，返回值除数值、布尔值、字符串、字节数组以外的值\n在 aardio 中存为 py.object 对象。\n\npyObject.func.invoke 可缩写为 pyObject.$func
invoke(.(kwarg=value,arg1->->->) = 如果参数@1是未指定元表的纯表对象,且没有 pyObject 成员，\n则将该表中的名值对作为调用时的命名参数，\n该表中的数组成员作为调用时的匿名参数，\n注意名值对参数应当且只能写在最前面，所有参数请用逗号分隔。\n\n如果指定了第 2 个参数或更多参数，则 kwarg 的数组成员被忽略。\n如果参数 @1 不符合前述规则，\n则与 call 调用相同的方式将所有参数作为调用时的匿名参数。\n\n如果参数 @1 为 null，则忽略第一个参数并禁用命名参数。\n并将第二个参数作为第一个参数，后续参数依次前移。
invoke() = !py3Object.
invokeObject() = !py3Object.
getFuncDesc() = 获取函数原型，返回值为字符串。
getFuncName() = 获取函数名，返回值为字符串。
type() = 返回类型名字
getTypeFlags() = 返回类型特性,用法请参考此函数源码以及 Python 文档
hasFeature(__) = 检测类型特性,这个函数实现了C++中的PyType_HasFeature宏相同的功能 
checkDict() = 检测是否字典
checkList() = 检测是否列表
checkTuple() = 检测是否字典
checkLong() = 检测是否整数
checkUnicode() = 检测是否字符串，注意Py3中字符串都是Unicode，取回aardio都是UTF8编码
checkBytes() = 检测是否字节串
checkBool() = 检测是否布尔值
checkFloat() = 检测是否浮点数
checkNumber() = 检测是否数值
getFuncName（） = 获取函数名
getFuncDesc = function(){
	return PyEval_GetFuncDesc(owner.pyObject );	
}
end intellisense**/