// apps/nodio-stub/host.rc — resource section for the runtime stub.
#include <windows.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "apps/nodio/host.manifest"

#define NODIO_VER_FIELD_PAD 64

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Nodio                                                                "
            VALUE "FileDescription", "Nodio Runtime Stub                                                  "
            VALUE "FileVersion", "1.0                                                                "
            VALUE "InternalName", "nodio-stub                                                         "
            VALUE "LegalCopyright", "                                                                  "
            VALUE "OriginalFilename", "nodio-stub.exe                                                   "
            VALUE "ProductName", "Nodio                                                               "
            VALUE "ProductVersion", "1.0                                                                "
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
