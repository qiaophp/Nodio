// app/designer.nodio — the visual form designer inside the IDE.
//
//  · 工具箱  → 右栏「控件」页   (nodio.designer.toolbox)
//  · 属性格  → 左栏「属性」页   (nodio.designer.propertyGrid)
//  · 设计画布 → 覆盖在编辑器之上的子窗体 (nodio.designer.canvas)
//  · 组件注册表 → nodio.designer.registry
//
// 自定义组件加入设计器的两种方式：
//  1) 组件模块里自行注册（推荐）：
//       import nodio.designer.registry;
//       nodio.designer.registry.register({name="我的按钮"; cls="button";
//                                         category="我的组件"; drawAs="button"})
//  2) 把组件模块丢进 <工程目录>\components\，IDE 打开工程时自动 discover()，
//     模块 import 时执行上面的 register 即可。
//
// 官方对应机制见 docs/official-ide-reference.md §3（ide.customCtrl 的
// "真实类名 » 设计器替身类名" 映射，对应本模块的 drawAs 字段）。
import win.ui;
import win;          // win.toClient：屏幕坐标 → 客户区坐标（拖拽落点用）
import nodio.designer.registry;
import nodio.designer.toolbox;
import nodio.designer.propertyGrid;
import nodio.designer.canvas;
import nodio.designer.dsg;
import nodio.ui.list;

// state
var shell = null;        // the app.shell module
var toolbox = null;
var propGrid = null;
var canvas = null;
var eventList = null;    // 事件一览（第五十六轮）
var visible = false;
var curItem = null;

// 钩子收进**表**（谁改都看得见 —— 模块级的裸标量会被帧局部副本遮蔽，
// 外部灌进来的钩子内部永远读到 null，见 capability-gap §1.20.3 的教训）
var hooks = {
	// function(item, ev) —— 生成事件处理函数桩。
	// ev 省略 = 该控件的**默认**事件（双击组件 / 右键「查看事件代码」）；
	// ev 指定 = 事件一览里双击的那个事件（第五十六轮）。
	onEventCode = null;
};

// Bind the designer to the IDE shell.
create = function(sh){
	shell = sh;

	// built-in controls first, so the toolbox is never empty
	nodio.designer.registry.defaults();

	// toolbox → right dock, 控件 page (页内容直接建在 IDE 主窗体上)
	var pageCtrl = shell.rightDock.addTab("控件");
	toolbox = nodio.designer.toolbox(pageCtrl, {
		left = 0; top = 0; right = 280; bottom = 500;
	});
	toolbox.refresh();
	shell.rightDock.addTab("控件", toolbox);

	// property grid → left dock, 属性 page
	var pageProp = shell.leftDock.addTab("属性");
	propGrid = nodio.designer.propertyGrid(pageProp, {
		left = 0; top = 0; right = 240; bottom = 200;
	});
	shell.leftDock.addTab("属性", propGrid);

	// 事件一览 → left dock, 事件 page（第五十六轮）
	//
	// 选中控件 → 列出它**真的支持**的事件（数据对齐官方 win.ui 的事件
	// 成员，见 nodio.designer.registry.eventsOf）；双击某个事件 → 生成
	// 对应的处理函数桩（走 hooks.onEventCode —— 设计器不认识编辑器）。
	var pageEvt = shell.leftDock.addTab("事件");
	eventList = nodio.ui.list(pageEvt, {
		left = 0; top = 0; right = 240; bottom = 260;
		columns = {{"事件";120};{"说明";110}};
	});
	shell.leftDock.addTab("事件", eventList);

	// the design canvas: a self-drawn board laid over the editor area
	canvas = nodio.designer.canvas(shell.winform, {
		left = 0; top = 0; right = 400; bottom = 300;
	});
	layout();

	// wiring
	toolbox.onPick = function(spec){
		if(!spec) return;
		if(!visible){
			shell.setStatus("请先打开设计器（Shift+F7）再添加控件");
			return;
		}
		// 落点不再固定在 (20,20)：每次都找一个**不与现有控件重叠**的位置。
		// （以前连点三次 = 三个控件叠在左上角，第二个根本点不中。）
		var spot = canvas.freeSpot(120, 30, 20, 20);
		var item = canvas.add(spec, spot);
		if(!item) return;
		canvas.select(item.name);
		shell.setStatus("已加入控件: " ++ spec.name);
	}
	// 落点计算（拖拽预览与真正放置共用）
	//
	// 坐标链路：屏幕坐标 → 主窗体客户区坐标（win.toClient）→ 设计坐标
	//（canvas.clientToDesign）。落点必须在**窗体表面**里 ——
	// 拖到外面的工作区灰色地带不算（官方行为也是无效）。
	//
	// 返回 {x;y;w;h}（设计坐标）或 null（不在表面内 / 画布没开）。
	var __dropSpot = function(screenX, screenY, w, h){
		if(!canvas || !visible) return null;
		var cx, cy = ..win.toClient(shell.winform.hwnd, screenX, screenY);
		if(!canvas.hitSurface(cx, cy)) return null;
		var d = canvas.clientToDesign(cx, cy);
		var x = math.round(d.x - w/2);
		var y = math.round(d.y - h/2);
		if(x < 0) x = 0;
		if(y < 0) y = 0;
		return {x=x; y=y; w=w; h=h};
	};
	// 拖动过程中：画落点预览框（看不到落点就是盲拖）
	toolbox.onDragMove = function(spec, screenX, screenY){
		if(!spec) return;
		var spot = __dropSpot(screenX, screenY, 120, 30);
		if(!spot){
			canvas.clearDropPreview();
			shell.setStatus("拖到窗体表面内再放下");
			return;
		}
		canvas.setDropPreview(spot.x, spot.y, spot.w, spot.h);
	}
	// 拖拽落点（第五十六轮）：从工具箱**拖**到窗体表面，松手就在那儿建控件。
	toolbox.onDrop = function(spec, screenX, screenY){
		if(!spec) return;
		canvas.clearDropPreview();
		if(!visible){
			shell.setStatus("请先打开设计器（Shift+F7）再添加控件");
			return;
		}
		var spot = __dropSpot(screenX, screenY, 120, 30);
		if(!spot){
			shell.setStatus("请把控件拖到窗体表面内再放下");
			return;
		}
		var item = canvas.add(spec, spot);
		if(!item){
			shell.setStatus("添加控件失败");
			return;
		}
		canvas.select(item.name);
		shell.setStatus("已加入控件: " ++ spec.name ++ "（" ++ spot.x ++ "," ++ spot.y ++ "）");
	}
	// 刷新事件一览（选中控件变化时）
	//
	// 事件清单来自 registry.eventsOf —— 那是对齐官方 win.ui 真实事件
	// 成员的静态表（通用 oncommand/onnotify + 控件特有事件）。
	var refreshEvents = function(item){
		if(!eventList) return;
		if(!item || !item.spec){
			eventList.setRows({});
			return;
		}
		var evs = nodio.designer.registry.eventsOf(item.spec.cls);
		var rows = {};
		for(i=1;#evs;1){
			..table.push(rows, {cells = {evs[i]; nodio.designer.registry.eventDesc(evs[i])};
				tag = evs[i]});
		}
		eventList.setRows(rows);
	};
	// 双击某个事件 → 生成它的处理函数桩
	// （生成动作在 IDE 侧：hooks.onEventCode，设计器不认识编辑器）
	eventList.onDoubleClick = function(row, index){
		if(!curItem || !row || !row.tag) return;
		if(hooks.onEventCode) hooks.onEventCode(curItem, row.tag);
	}
	canvas.onSelect = function(item){
		curItem = item;
		propGrid.setItems(item ? item.props : {});
		refreshEvents(item);
	}
	canvas.onChange = function(item){
		curItem = item;
		propGrid.setItems(item ? item.props : {});
		refreshEvents(item);
		shell.setStatus("设计器: " ++ tostring(item ? item.name : ""));
	}
	// 双击组件 → 事件代码（官方 IDE 的行为：双击控件切到代码视图，
	// 生成/跳到它的事件处理函数；真正生成由 IDE 侧的 hooks.onEventCode 做，
	// 设计器不认识编辑器）
	canvas.onDoubleClick = function(item){
		if(!item) return;
		if(hooks.onEventCode) hooks.onEventCode(item);
	}
	propGrid.onChange = function(index, value){
		if(!curItem) return;
		curItem.props[index].value = value;
		// 选中「窗体本身」时（点画布空白 / 菜单「窗体设置」）：
		// 属性没有对应控件，走 applyFormProps 写回 DSG 头的 win.form(...)
		if(curItem.isForm){
			canvas.applyFormProps(curItem.props);
			shell.setStatus("已修改窗体设置: " ++ curItem.props[index].name);
			return;
		}
		canvas.applyProps(curItem);
		shell.setStatus("已修改属性: " ++ curItem.props[index].name);
	}

	// 设计画布右键菜单（官方 win.ui.popmenu 弹出，popId 同步返回命令 id）
	var cvMenu = win.ui.popmenu(shell.winform);
	var idCvCopy = cvMenu.add("复制", null);
	var idCvDel  = cvMenu.add("删除", null);
	cvMenu.addSeparator();
	var idCvEv   = cvMenu.add("查看事件代码", null);
	var idCvProp = cvMenu.add("属性", null);
	canvas.onContextMenu = function(item, x, y){
		if(!item) return;
		canvas.select(item.name);
		var id = cvMenu.popId();
		if(!id) return;
		if(id == idCvCopy){
			var it2 = canvas.add(item.spec, {x=item.x+10; y=item.y+10; w=item.w; h=item.h});
			canvas.select(it2.name);
			shell.setStatus("已复制控件: " ++ it2.name);
		}
		elseif(id == idCvDel){
			canvas.remove(item.name);
			shell.setStatus("已删除控件: " ++ item.name);
		}
		elseif(id == idCvEv){
			// 双击的菜单兜底路径（个别控件类收不到 WM_LBUTTONDBLCLK）
			if(hooks.onEventCode) hooks.onEventCode(item);
		}
		elseif(id == idCvProp){
			curItem = item;
			propGrid.setItems(item.props);
		}
	}
	return this;
}

// Keep the canvas over the editor area.
//
// 一律按**当前客户区尺寸**自己算：窗口显示后官方 DPI 缩放会把客户区
// 从 1281x821 改成 1921x1231（物理像素），外面传进来的矩形可能是缩放前
// 的旧值，照着用画布就只盖住编辑区的一小块。
layout = function(){
	if(!canvas || !shell) return;
	var w,h = shell.clientWH();
	var er = shell.editorRect(w,h);
	if( ..string.getenv("NODIO_IDE_DIAG") ){
		io.print("DIAG designer.layout client=" ++ w ++ "x" ++ h
			++ " editor=" ++ er.left ++ "," ++ er.top ++ "," ++ er.right ++ "," ++ er.bottom);
	}
	canvas.layout(er.left, er.top + shell.docTabH(), er.right, er.bottom);
}

// Show / hide the canvas (the editor keeps its own text).
//
// 设计 ↔ 源码视图切换（官方 switchActiveForm 的语义）：
//   · open  = 切到**设计视图**：画布载入当前文档里的 DSG 块
//     （源码里有什么设计，画布上就是什么；没有块的文档给空画布）；
//   · close = 切回**代码视图**：把**当前设计**写回文档里的 DSG 块
//     （只写编辑器缓冲，不落盘 —— 落盘交给 Ctrl+S）。
//   两个方向都只在「内容真的不一样」时才动文档。
open = function(){
	if(!canvas) return;
	visible = true;
	layout();
	// 设计视图：从当前文档读 DSG 块 → 画布
	var path = shell ? shell.tabCurPath() : null;
	if(path){
		var src = shell.tabGetText(path);
		if(src){
			var block = nodio.designer.dsg.extractBlock(src);
			if(#block) canvas.fromDSG(block);
			else{
				// 没有设计块的文档给**空画布**：窗体设置也回到默认
				//（不带走上一个文档的窗体标题/尺寸）
				canvas.clear();
				canvas.form = {text="窗体"; w=759; h=469; bgcolor = canvas.form.bgcolor : 0xF0F0F0};
			}
		}
	}
	canvas.show(true);
	// ⚠ **不要 hide 官方 richedit**：它的 show()/hide() 在 Nodio 上会触发
	//   控件重建（官方那套 DPI 初始化路径），**正文直接被清空**，
	//   而且清空会触发 richedit 的 EN_CHANGE → 编辑器把空文本写回缓存 ——
	//   于是「开关一次设计器，代码就没了」。
	//   画布是不透明的浮层（还显式提到 z 序最前），本来就盖得住编辑器，
	//   根本不需要藏 richedit。
	// 行号栏要藏掉：设计面是一块**表单表面**，不是代码区，
	// 留着行号栏既没意义，又会压住画布左边（行号栏是自绘板，层次在前）。
	try{ shell.editor.gutter.show(false) }catch(e){}
	// 自动联动左右侧栏：左栏切到「属性」、右栏切到「控件」工具箱
	try{
		if(shell.leftDock) shell.leftDock.setSelIndex(2);
		if(shell.rightDock) shell.rightDock.setSelIndex(1);
	}catch(eDock){}
	if( ..string.getenv("NODIO_IDE_DIAG") ){
		io.print("DIAG designer.open canvasvis=" ++ tostring(canvas.visible)
			++ " bgvis=" ++ tostring(..win.isVisible(canvas.bg.ctrl.hwnd))
			++ " bgrect=" ++ tostring(canvas.bg.rect.left) ++ "," ++ tostring(canvas.bg.rect.top)
			++ "," ++ tostring(canvas.bg.rect.right) ++ "," ++ tostring(canvas.bg.rect.bottom)
			++ " edvis=" ++ tostring(..win.isVisible(shell.winform.ed.hwnd))
			++ " gutvis=" ++ tostring(..win.isVisible(shell.editor.gutter.ctrl.hwnd)));
	}
	shell.setStatus("设计器: 就绪 (按 Shift+F7 切回代码)");
}

close = function(){
	if(!canvas) return;
	visible = false;
	var synced = false;
	// 代码视图：当前设计写回文档的 DSG 块（编辑器缓冲，不落盘）。
	// 画布空**且**文档本来就没有块时不写 —— 不能往普通脚本里塞空设计。
	var path = shell ? shell.tabCurPath() : null;
	if(path){
		var src = shell.tabGetText(path);
		if(src){
			var block = nodio.designer.dsg.extractBlock(src);
			if(#canvas.items || #block){
				var ns = nodio.designer.dsg.replaceBlock(src, canvas.toDSG());
				if(ns != src){
					shell.tabSetText(path, ns);
					synced = true;
					if(shell.setStatus) shell.setStatus("设计已同步到源码（Ctrl+S 保存）");
				}
			}
		}
	}
	canvas.show(false);
	// richedit 一直没被藏过（见 open 的说明），这里不用再 show(true)：
	// 官方 richedit 的 show() 会重建控件并清空正文。
	try{ shell.editor.gutter.show(true) }catch(e){}
	try{
		if(shell.leftDock) shell.leftDock.setSelIndex(1); // 切回工程树
	}catch(eDock2){}
	if(!synced) shell.setStatus("设计器: 已关闭 (已切回源码)");
}

toggle = function(){
	if(visible) close(); else open();
}

// Discover user components under <projectDir>\components.
discover = function(dir){
	if(!dir) return 0;
	return nodio.designer.registry.discover(dir);
}

// The DSG block for the current design.
toDSG = function(){
	if(!canvas) return "";
	return canvas.toDSG();
}

// 第五十一轮：当前设计的窗体状态（标题/尺寸/底色）——外部驱动（冒烟/
// ideCommand）生成 DSG 头时必须用同一份状态，否则字节级往返校验会
// 靠「generate 默认值恰好等于画布默认」的巧合对齐（已实测破产）。
formGet = function(){
	if(!canvas) return null;
	return canvas.form;
}

// Load a DSG block into the canvas.
fromDSG = function(text){
	if(!canvas) return false;
	return canvas.fromDSG(text);
}

// ---------- 设计的存取（IDE 入口）----------
//
// 设计器的「保存/载入」以前只有 toDSG/fromDSG 两个纯函数，
// **没有任何入口**能把它接到文件或源码上 —— 画完就丢了。
// 这里补两层：
//   ① 独立 .dsg 文件（设计另存为 / 打开 .dsg）
//   ② 源码里的 /*DSG{{*/ … /*}}*/ 块（官方 aardio 就是这么存的：
//      窗体源码自带设计标记，打开源码就能看到设计）

// 另存为 .dsg 文件
saveToFile = function(path){
	if(!canvas || !path) return false;
	var text = canvas.toDSG();
	if(!..string.save(path, text)) return false;
	if(shell) shell.setStatus("设计已保存: " ++ path);
	return true;
}

// 从 .dsg 文件载入
loadFromFile = function(path){
	if(!canvas || !path) return false;
	var text = ..string.load(path);
	if(text === null || text === undefined) return false;
	if(!canvas.fromDSG(text)) return false;
	if(shell) shell.setStatus("已载入设计: " ++ path);
	return true;
}

// 把画布上的设计写进源码（替换 DSG 块；原来没有就追加）
// 返回**新**源码，调用方负责写回编辑器。
applyToSource = function(src){
	if(!canvas) return src;
	return nodio.designer.dsg.replaceBlock(src, canvas.toDSG());
}

// 从源码里读出 DSG 块并载入画布
readFromSource = function(src){
	if(!canvas) return false;
	var block = nodio.designer.dsg.extractBlock(src);
	if(!#block) return false;
	return canvas.fromDSG(block);
}

// —— 官方 ide.command 命令面的画布入口（app.ideCommand 接线用）——
// 外部命令 setSelectedControl / getSelectedControl / getControlParam /
// setControlParam / getActiveForm 都要摸到画布状态；画布是本模块的
// 模块级变量（打开设计器才有），这里给出最小访问面。
isActive = lambda() visible;

canvasSelected = function(){
	return canvas ? canvas.selected : null;
}

canvasSelect = function(name){
	if(!canvas) return null;
	return canvas.select(name);
}

canvasGetParam = function(name, key){
	if(!canvas || !key) return null;
	for(i=1;#canvas.items;1){
		if(canvas.items[i].name == name) return canvas.items[i][key];
	}
	return null;
}

canvasSetParam = function(name, key, v){
	if(!canvas || !key) return false;
	for(i=1;#canvas.items;1){
		var it = canvas.items[i];
		if(it.name == name){
			it[key] = v;
			canvas.__place(it);
			canvas.__refresh();
			if(canvas.onChange) canvas.onChange(it);
			return true;
		}
	}
	return false;
}

// —— 第五十六轮：拖拽落点的换算与避让（供回归锁断言）——
//
// 拖控件进画布要两件事：屏幕坐标 → 设计坐标的换算，以及「别叠在一起」
// 的空位查找。这两件都是纯逻辑，单独暴露出来就能被冒烟直接断言，
// 不必真去拖鼠标、也不必在画布上加/删控件来试。

// 主窗体客户区坐标 → 设计坐标
canvasClientToDesign = function(cx, cy){
	if(!canvas) return null;
	return canvas.clientToDesign(cx, cy);
}

// 设计坐标 → 主窗体客户区坐标（往返一致性用）
canvasDesignToClient = function(dx, dy){
	if(!canvas) return null;
	return canvas.designToClient(dx, dy);
}

// 客户区坐标是否落在窗体表面内
canvasHitSurface = function(cx, cy){
	if(!canvas) return false;
	return canvas.hitSurface(cx, cy);
}

// 避让算法（纯函数）：items = {x;y;w;h} 列表
canvasFreeSpotIn = function(items, w, h, x, y, maxX, maxY){
	if(!canvas) return null;
	return canvas.freeSpotIn(items, w, h, x, y, maxX, maxY);
}

// 工具箱的拖拽入口接上了吗（接线完整性）
dropReady = function(){
	return !!(toolbox && toolbox.onDrop);
}

// —— 端到端拖拽（供回归锁）——
//
// simulateToolboxDrop：模拟一次**真实拖拽**（按下 → 移动 → 松开），
// 走的是工具箱自己的鼠标回调路径，所以拖拽状态机（阈值判定、鼠标
// 捕获、onDrop 触发）全都被覆盖到 —— 只断言「onDrop 被调用」是自欺欺人。
simulateToolboxDrop = function(specName, screenX, screenY){
	if(!toolbox) return false;
	return toolbox.simulateDrag(specName, screenX, screenY);
}

// simulateToolboxDropMsg：同一次拖拽，但走**真实窗口消息**路径
// （PostMessage → 子类化窗口过程 → onMouseDown/Move/Up）。
// 这是最接近「用户真的用鼠标拖」的一条路。
simulateToolboxDropMsg = function(specName, screenX, screenY){
	if(!toolbox) return false;
	return toolbox.simulateDragMsg(specName, screenX, screenY);
}

// 画布上的控件数（拖拽前后对比 = 控件确实建出来了）
canvasCount = function(){
	return canvas ? #canvas.items : 0;
}

// 移除一个控件（回归测试后清理，别把画布弄脏）
canvasRemove = function(name){
	if(!canvas) return false;
	return canvas.remove(name);
}

// 供回归：当前选中控件的事件清单（第五十六轮）
// 每行 {cells={事件名;说明}; tag=事件名}
eventItems = function(){
	if(!eventList) return {};
	return eventList.rows;
}

// 窗体表面在**屏幕坐标**里的矩形（拖拽落点的目标区域）
surfaceScreenRect = function(){
	if(!canvas) return null;
	var a = canvas.designToClient(0, 0);
	var b = canvas.designToClient(canvas.form.w, canvas.form.h);
	if(!a || !b) return null;
	// 客户区原点 → 屏幕坐标
	var ox, oy = ..win.toScreen(shell.winform.hwnd, 0, 0);
	return {left = ox + a.x; top = oy + a.y; right = ox + b.x; bottom = oy + b.y};
}
