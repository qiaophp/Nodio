// app/runner.nodio — F5: run a script through process.popen and stream its
// output into the output pane via a winform timer.
import process.popen;

// create(winform, exe, outCtl, setStatus) -> controller
//   controller.isRunning()
//   controller.run(filePath)   // filePath must be absolute (the child gets a
//                              //   different working directory)
create = function(winform, exe, outCtl, setStatus){
	var proc = null;
	var wid = null;
	// 结束标记：run() 是 [运行结束]；runArgs() 按任务名生成（如 [发布结束]）。
	// 冒烟锁靠 outCtl.contains() 等这个标记判断「子进程跑完了」。
	var endTag = "[运行结束]";

	var stop = function(){
		if(wid){ winform.clearInterval(wid); wid = null }
	};

	var poll = function(){
		var p = proc;
		if(!p) return;
		var o,e = p.peek(0);
		if(o !== null && o !== false && #o) outCtl.append(o);
		if(e !== null && e !== false && #e) outCtl.append(e);
		// done when the process exited and both pipes are drained
		if(p.process && p.process.waitOne(0)){
			var o2,e2 = proc.peek(0);
			if(o2 && #o2) outCtl.append(o2);
			if(e2 && #e2) outCtl.append(e2);
			outCtl.append("\r\n" ++ endTag ++ "\r\n");
			proc.close();
			proc = null;
			stop();
			setStatus("就绪");
		}
		// ⚠ 显式返回 null：官方 WM_TIMER 会把「返回值既不是 null 也不是 true」
		//   的定时器**移除**（win/ui/_.aardio:342）——
		//   这里最后一句是 stop()/setStatus()，返回值会传出去，
		//   一旦是 false，**运行输出就不再流式刷新**了。
		return null;
	};

	return {
		isRunning = function(){ return proc !== null };
		stop = function(){
			if(proc){
				try{ proc.terminate() }catch(e){}
				try{ proc.close() }catch(e2){}
				proc = null;
				stop();
				outCtl.append("\r\n[已强制停止]\r\n");
				setStatus("就绪");
			}
		};
		run = function(filePath, workDir){
			if(proc){ outCtl.append("\r\n[运行中——先等待当前脚本结束]\r\n"); return };
			if(!workDir){
				var pi = ..io.splitpath(filePath);
				if(pi && pi.dir) workDir = pi.dir;
				else workDir = ..io.fullpath(".");
			}
			endTag = "[运行结束]";
			var cmd = """" ++ exe ++ """ """ ++ filePath ++ """";
			proc = process.popen(cmd, , {workDir = workDir; showWindow = 1/*_SW_NORMAL*/});
			if(!proc){ outCtl.append("[启动失败: " ++ exe ++ "]\r\n"); return };
			outCtl.clear();
			outCtl.append("[运行] " ++ filePath ++ "\r\n[工作目录] " ++ workDir ++ "\r\n");
			setStatus("运行中...");
			wid = winform.setInterval(poll,100);
		};
		// 完整参数行版（参数行**不含** exe 本身，路径自带引号）：
		// 发布等「同一个 exe 的另一条命令行」复用同一套流式轮询。
		// title 只影响输出头/结束标记/状态栏文案（如「发布中...」）。
		runArgs = function(argLine, workDir, title){
			if(proc){ outCtl.append("\r\n[运行中——先等待当前任务结束]\r\n"); return };
			var t = title : "运行";
			endTag = "[" ++ t ++ "结束]";
			// 单引号串里可以直接写双引号字符（比 """" 转义堆叠可读）
			var cmd = '"' ++ exe ++ '" ' ++ argLine;
			proc = process.popen(cmd, , {workDir = workDir; showWindow = 1/*_SW_NORMAL*/});
			if(!proc){
				outCtl.append("[启动失败: " ++ cmd ++ "]\r\n");
				endTag = "[运行结束]";
				return;
			}
			outCtl.clear();
			outCtl.append("[" ++ t ++ "] " ++ cmd ++ "\r\n[工作目录] " ++ workDir ++ "\r\n");
			setStatus(t ++ "中...");
			wid = winform.setInterval(poll,100);
		};
	};
}
