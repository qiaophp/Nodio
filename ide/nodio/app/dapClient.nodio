// app/dapClient.nodio — nodio-dap client.
//
// Speaks Content-Length framed JSON-RPC (DAP) over stdio to nodio-dap.exe.
// Same transport facts as lspClient (see that file): popen + peek-driven
// polling, single-quoted CRLF literals, persistent inbox, codepage 65001.
import process.popen;
import JSON;

var p = null;           // popen process
var nextSeq = 1;        // DAP request seq
var inbox = "";         // accumulated server bytes (peek() consumes!)
var readyFlag = false;  // launch acknowledged
var stoppedFlag = false;
var lastVars = {};      // latest variables snapshot
var lastStack = {};     // latest stack frames
var stopLine = null;    // current stop line (0-based)
var terminatedFlag = false;

// ---------- framing ----------
var sendRaw = function(body){
	if(!p) return;
	p.writeUtf8("Content-Length: " ++ #body ++ '\r\n\r\n' ++ body);
	p.writeUtf8('\n');
};

var request = function(command, args){
	if(!p) return null;
	var seq = nextSeq;
	nextSeq = nextSeq + 1;
	var body = JSON.stringify({ seq = seq; type = "request"; command = command; arguments = args : {} });
	sendRaw(body);
	return seq;
};

// drain all complete frames; dispatch events, capture responses.
// returns the response matching wantSeq or null.
var poll = function(wantSeq){
	if(!p) return null;
	var found = null;
	var o = p.peek(0);
	if(o !== null && o !== false && #o > 0) inbox = inbox ++ o;
	while(true){
		var hEnd = ..string.indexOf(inbox, '\r\n\r\n');
		if(hEnd === null) break;
		var head = ..string.left(inbox, hEnd - 1);
		var cl = ..string.match(head, "Content-Length:\s*(\d+)");
		if(cl === null){ inbox = ..string.slice(inbox, 2); continue }
		var nLen = tonumber(cl);
		var bodyStart = hEnd + 4;
		if((#inbox - bodyStart + 1) < nLen) break;
		var body = ..string.mid(inbox, bodyStart, nLen);
		inbox = ..string.slice(inbox, bodyStart + nLen);
		var msg = JSON.parse(body);
		if(!msg) continue;
		if(msg.type == "event" && msg.event == "stopped"){
			stoppedFlag = true;
			var b = msg.body : {};
			stopLine = b.line !== null ? tonumber(b.line) : 0;
		}
		elseif(msg.type == "event" && msg.event == "terminated"){
			terminatedFlag = true;
		}
		elseif(msg.type == "response" && wantSeq !== null && tonumber(msg.request_seq) === tonumber(wantSeq)){
			found = msg;
		}
	}
	return found;
};

// ---------- public API ----------
//
// ⚠ 本模块是**模块式 API**（跟 app.lspClient 一样）：调用方用
//   app.dapClient.start(...) / app.dapClient.launch(...) 这样的写法，
//   不是拿一个对象实例。
//   以前 start() 结尾写的是 `return self` —— 模块作用域里根本没有 self
//   （模块级代码的 this 才是模块表），于是 start 永远返回空，
//   IDE 那边 `if(!dbgSession){ ... }` 恒成立 → 「调试适配器启动失败」，
//   F10 从来就没能真正跑起来过。
// 现在统一返回 "ok" / 错误原因字符串。
start = function(exePath){
	if(p) return "busy";
	p = process.popen(exePath);
	if(!p) return "spawn-failed";
	p.codepage = 65001;
	nextSeq = 1; inbox = ""; readyFlag = false;
	stoppedFlag = false; terminatedFlag = false;
	lastVars = {}; lastStack = {}; stopLine = null;
	var seq = request("initialize", { adapterID = "nodio" });
	for(i=1;25;1){
		sleep(20);
		if(poll(seq) !== null) break;
	}
	return "ok";
};

// spawn the debuggee; true on success
launch = function(scriptPath){
	if(!p) return "no-adapter";
	readyFlag = false;
	stoppedFlag = false;
	terminatedFlag = false;
	var seq = request("launch", { program = scriptPath; noDebug = false });
	for(i=1;50;1){
		sleep(20);
		var r = poll(seq);
		if(r !== null){
			if(r.success === false) return r.message : "launch-failed";
			break;
		}
	}
	readyFlag = true;
	// configurationDone lets the engine begin (it starts stopped)
	request("configurationDone", {});
	return true;
};

// breakpoints: lines = array of 1-based line numbers (client passes them
// 0-based → we add 1 so the editor's 0-based marks map cleanly)
// metas（第五十九轮，可选）：与 lines0 平行的数组，元素为
//   {condition="..."; hitCount=N}（都是可空）——条件/命中次数断点。
// ⚠ breakpoints 必须是 **JSON 数组**，不是对象：
//   用 `{}` + 数字键去拼，JSON.stringify 出来是 {"1":{...}}，
//   服务端按数组解析 → 断点一个都建不起来。
// ⚠ 空数组也必须发出去（= 清除全部断点）：服务端按整表重建，
//   旧实现「空表不发」→ 消掉最后一个断点后引擎侧永远留着。
setBreakpoints = function(path, lines0, metas){
	if(!p) return;
	var bps = [ @{_type="array"} ];
	for(i=1;#lines0;1){
		var m = metas ? metas[i] : null;
		var cond = "";
		var hit = 0;
		if(m){
			cond = tostring(m.condition : "");
			hit = tonumber(m.hitCount : 0) : 0;
		}
		..table.push(bps, {
			line = lines0[i] + 1;
			condition = cond;
			hitCount = hit;
		});
	}
	request("setBreakpoints", { source = { path = path }; breakpoints = bps });
};

next = function(){
	if(!p || !stoppedFlag) return;
	stoppedFlag = false;
	request("next", {});
};

resume = function(){
	if(!p || !stoppedFlag) return;
	stoppedFlag = false;
	request("continue", {});
};

// capture current vars + stack (call after a stopped event)
refresh = function(){
	if(!p || !stoppedFlag) return;
	var s1 = request("variables", { variablesReference = 100 });
	var s2 = request("stackTrace", { threadId = 1 });
	for(i=1;25;1){
		sleep(20);
		var r1 = poll(s1);
		var r2 = poll(s2);
		if(r1 !== null && r2 !== null) break;
	}
	// r1/r2 captured via poll side effects; re-request through poll results
};

// vars from the last stop — array of {name;value;type;ref}
// ref（第五十九轮续）：>100 = 表容器，可用 getVarChildren(ref) 展开
getVars = function(){
	if(!p) return {};
	if(!stoppedFlag) return lastVars;
	var seq = request("variables", { variablesReference = 100 });
	var out = {};
	for(i=1;50;1){
		sleep(20);
		var r = poll(seq);
		if(r !== null){
			var vs = r.body ? r.body.variables : null;
			if(vs){
				for(k,v in vs){
					..table.push(out, {
						name = tostring(v.name);
						value = tostring(v.value);
						type = tostring(v.type : "");
						ref = tonumber(v.variablesReference : 0) : 0;
					});
				}
			}
			lastVars = out;
			return out;
		}
	}
	return lastVars;
};

// 变量子级展开（第五十九轮续）：ref 来自 getVars/getVarChildren 条目的
// ref 字段（0 = 不可展开）。返回 [{name;value;type;ref}]，子表同样带 ref
//（可以逐层展开）。⚠ 停点前进后旧 ref 失效（引擎每次停点重建引用表），
//   适配器对失效引用会回一条 (展开失败) 条目而不是空数组。
getVarChildren = function(ref){
	if(!p) return {};
	var seq = request("variables",
		{ variablesReference = tonumber(ref : 0) : 0 });
	var out = {};
	for(i=1;200;1){
		sleep(20);
		var r = poll(seq);
		if(r !== null){
			var vs = r.body ? r.body.variables : null;
			if(vs){
				for(k,v in vs){
					..table.push(out, {
						name = tostring(v.name);
						value = tostring(v.value);
						type = tostring(v.type : "");
						ref = tonumber(v.variablesReference : 0) : 0;
					});
				}
			}
			return out;
		}
	}
	return out;
};

// setVariable（第五十九轮续）：修改变量。
//   ref=100 → 当前帧变量；ref>100 → 表成员（name 为键名或数组 "[i]"）；
//   value 是**表达式**——引擎在当前帧求值后写入，所以能写 x+1、{a=1}。
// 返回 {ok=true; value; type}（value=写入后的新值渲染）或 {ok=false; error}。
setVariable = function(ref, name, value){
	if(!p) return { ok = false; error = "调试会话未启动" };
	var seq = request("setVariable", {
		variablesReference = tonumber(ref : 0) : 0;
		name = tostring(name : "");
		value = tostring(value : "");
	});
	for(i=1;200;1){
		sleep(20);
		var r = poll(seq);
		if(r !== null){
			var b = r.body;
			if(!b) return { ok = false; error = "空响应" };
			if(b.success){
				return {
					ok = true;
					value = tostring(b.value : "");
					type = tostring(b.type : "");
				};
			}
			return { ok = false; error = tostring(b.message : "修改变量失败") };
		}
	}
	return { ok = false; error = "适配器没有响应" };
};

// stack — array of {line(0-based);name}
stackTrace = function(){
	if(!p) return {};
	var seq = request("stackTrace", { threadId = 1 });
	var out = {};
	for(i=1;50;1){
		sleep(20);
		var r = poll(seq);
		if(r !== null){
			var fs = r.body ? r.body.stackFrames : null;
			if(fs){
				for(k,v in fs){
					..table.push(out, {
						line = v.line !== null ? tonumber(v.line) : 0;
						name = tostring(v.name);
					});
				}
			}
			lastStack = out;
			return out;
		}
	}
	return lastStack;
};

// evaluate -> {result; type} 或 null
//
// 第五十五轮：表达式求值（立即窗口）。
// ⚠ 适配器那边会把请求转成引擎命令 {"cmd":"eval","expr":...}，
//   等引擎回 {"event":"eval",...} 再回 DAP 响应 —— 最长 3 秒。
//   所以这里的等待上限要比适配器长一点（4 秒），否则会先超时。
evaluate = function(expr){
	if(!p) return null;
	var ex = tostring(expr : "");
	if(#ex == 0) return null;
	var seq = request("evaluate", { expression = ex; context = "repl" });
	for(i=1;200;1){
		sleep(20);
		var r = poll(seq);
		if(r !== null){
			var b = r.body;
			if(!b) return null;
			return {
				result = tostring(b.result : "");
				type = tostring(b.type : "");
			};
		}
	}
	return null;
}

// ev(name, data) callback; returns false when the session ended.
// stoppedFlag stays set after the event — getVars()/next()/resume()
// consume it, so callers can inspect variables between stops.
pollEvents = function(ev){
	if(!p) return false;
	poll(null);
	if(stoppedFlag) ev("stopped", { line = stopLine : 0 });
	if(terminatedFlag){ ev("terminated", {}) ; return false }
	return p !== null;
};

ready = function(){ return p !== null && readyFlag };
isStopped = function(){ return stoppedFlag };
isRunning = function(){ return p !== null };

stop = function(){
	if(!p) return;
	request("disconnect", {});
	p.writeClose();
	p.close();
	p = null;
	readyFlag = false;
};
