// app/shell.nodio — the IDE main window, laid out after the official
// aardio IDE (target screenshot; mechanisms in docs/official-ide-reference.md):
//
//   ┌───────────────────────────────────────────────────────────────┐
//   │ 自绘标题栏（应用标记 + 菜单 + 居中标题 + 窗口按钮）            │
//   │ 工具栏                                                         │
//   ├───────────┬───────────────────────────────┬───────────────────┤
//   │ 工程 属性  │ 文档标签 + 编辑器 / 设计器        │ 控件 语法 标准库    │
//   │ 搜索 大纲  │                                │ 范例 工具 AI       │
//   ├───────────┴───────────────────────────────┴───────────────────┤
//   │ 问题 输出 调试 终端                                            │
//   ├───────────────────────────────────────────────────────────────┤
//   │ 状态栏                                                         │
//   └───────────────────────────────────────────────────────────────┘
//
// 面板/工具条/状态栏/工程树全部来自标准库 overlay（nodio.ui.*），
// 本模块只负责布局与接线。设计器（nodio.designer.*）由 main.nodio 接入：
// 它把工具箱放进右栏「控件」页、属性格放进左栏「属性」页，
// 画布是一张覆盖在编辑器之上的子窗体。
//
// 标题栏是**自绘**的（nodio.ui.titlebar）：原生标题栏是浅色的，跟整套深色
// chrome 根本不是一回事；参考 IDE 的标题栏 = 菜单栏，一行。
import win.ui;
import win.ui.menu;
import app.editor;
import nodio.ui.dock;
import nodio.ui.toolbar;
import nodio.ui.statusbar;
import nodio.ui.projectTree;
import nodio.ui.searchPanel;
import nodio.ui.tabstrip;
import nodio.ui.board;
import nodio.ui.subclass;
import nodio.ui.list;
import nodio.ui.tree;
import nodio.ui.theme;
import nodio.ui.dpi;
import nodio.ui.titlebar;
import nodio.ui.editor;
import nodio.ui.filedlg;
import nodio.ui.prompt;
import nodio.ui.richedit;
import app.settings;   // 主题 / 编辑器字号 / 外部工具（持久化在 %APPDATA%\Nodio\ide.cfg）
import app.ai;        // 右栏「AI」页：AI 聊天面板（app.ai.panel）
import app.watch;     // 底部「监视」「变量」页：调试监视窗（app.watch.panel / varsPanel）
import nodio.gui.designerExt;   // nodio.gui 控件 → 设计器工具箱组件（不是展厅）
import gdip;

// ---------- layout constants ----------
// 这里是**逻辑像素**（96dpi 基准）。官方 win.ui 控件的矩形也是逻辑单位
// （官方库建控件时自己乘 DPI 缩放系数），我们自绘的组件走 win.setPos
// （物理像素）—— 两条路径用同一个缩放系数换算，系统 150% 时才一致。
//
// 左右栏宽度要放得下**页签条**：页签宽 = 左留白 + 文字 + 右留白（+ 图标），
// 官方 tabstrip 组件是自绘的，放不下就会把后面的页签裁掉（原来右栏
// 「工具 / AI」两个页签就被裁没了）。
var TOOLBAR_H = 28;
var STATUS_H  = 26;
var LEFT_W    = 272;   // 工程/属性/搜索/大纲 4 个页签（带图标）
var RIGHT_W   = 352;   // 控件/语法/标准库/范例/工具/AI/组件 7 个页签（纯文字）
var BOTTOM_H  = 220;
var DOCTAB_H  = 26;
var TITLEBAR_H = 32;   // 自绘标题栏（菜单栏合并在里面）
// 标题栏 + 工具条 = 顶部 chrome
var TOP0 = TITLEBAR_H + TOOLBAR_H;

/*DSG{{*/
winform = win.form(text="Nodio IDE";right=1280;bottom=820)
// ⚠ autoResize=false 必须写：官方 form 默认把控件登记进**自动缩放名单**，
// 窗体一改尺寸（最大化 / 去掉原生标题栏后客户区变大 / DPI 变化），
// 官方就按「设计时矩形」把控件重新摆一遍 —— 编辑器会被弹回设计位置，
// 而行号栏、导航栏这些自绘板是我们自己摆的（物理像素），两边对不上：
//   · 组件「乱飞」（编辑器和自绘层各走各的）；
//   · 行号与代码错位（显示区在一边，事件区在另一边）。
// 位置一律由 nodio.ui.setRect / win.setPos 管，官方不要插手。
winform.add(
	ed={cls="richedit";left=240;top=58;right=980;bottom=560;multiline=true;vscroll=true;hscroll=false;noscroll=true;autoResize=false;z=6}
)
/*}}*/

// 启动计时（诊断用）：窗体是**这里**建出来的（模块体一执行就 show），
// 所以这一行是「窗口出现」的最早可信时刻。
// ⚠ 用 GetTickCount 的绝对值：和外部 bench 脚本（同一台机器、同一时钟）可比。
if( ..string.getenv("NODIO_IDE_DIAG") ){
	io.print("DIAG boot tick=form-created at=" ++ tostring(..time.tick()));
}

// DPI 缩放系数（建好窗体后立刻取；官方窗体的 dpiScaleX 在 show 之后才有值，
// 这里退回 gdi.getDpiScale —— 官方库自己也是用这个来源）
..nodio.ui.dpiSetScaleFrom(winform);
// 逻辑像素 → 物理像素
var S = function(v){ return ..nodio.ui.px(v) };

// ---------- 主题 ----------
// 目标外观：aar.chengxu.online/thread-903.htm 那套现代深色 IDE。
//
// ⚠ 以前这里铺了一块全客户区的「背景板」把底色刷成主题色 ——
//   现在不需要了：官方窗体的 `winform.background.setColor(主题色)`
//   就会让 WM_ERASEBKGND 把整个客户区刷成深色（win/ui/_.aardio:414），
//   而且开了 WS_CLIPCHILDREN 之后父窗体只画子控件之间的空隙。
//   那块背景板是**全 IDE 最贵的画板**：4K 客户区每次全量重画要
//   78~110ms（两次全屏 BitBlt + 纯色填充），拖拽收口的重画每次都陪它慢。
//   删掉 —— 深色底交给官方 background，鼠标也不必再为它做 sendToBack。
var theme = ..nodio.ui.theme();

// 窗体本身的底色刷成深色：去掉原生标题栏后，窗口四周那圈可缩放边框
// （以及客户区外的残留）露出来的就是它，默认是系统浅色。
try{ winform.background.setColor(theme.bg) }catch(e){}

// ---------- 合成一帧（消灭「改尺寸马赛克」的关键） ----------
//
// 症状（实测）：拖动窗口边框缩放时，27 块自绘板逐块「重画+立即上屏」，
// 每次布局 flush 要 300~600ms —— 窗口跟不上鼠标，屏幕上是一块块
// 先亮后黑的马赛克碎片。
//
// 两个窗口样式各治一半：
//   · WS_CLIPCHILDREN(0x02000000)  父窗体重绘**不再擦掉子窗体的像素**：
//     只挪位置、尺寸没变的板子内容跟着窗口走，不用每次全量重画
//     （这是「最大化→还原之后页签条一片空白」的根源之一）。
//   · WS_EX_COMPOSITED(0x02000000) 子窗体自底向上合成进父窗体的
//     重定向缓冲，**一帧上屏** —— 27 块板各画各的中间态不再直接闪到屏幕上。
// 官方 plus 明确兼容父窗口启用 WS_EX_COMPOSITED
// （win/ui/ctrl/plus.aardio:844 有专门分支）。
try{
	..win.modifyStyle(winform.hwnd, 0, 0x02000000/*_WS_CLIPCHILDREN*/,
		0x20/*_SWP_FRAMECHANGED*/);
}catch(e2a){}
try{
	..win.modifyStyleEx(winform.hwnd, 0, 0x02000000/*_WS_EX_COMPOSITED*/,
		0x20/*_SWP_FRAMECHANGED*/);
}catch(e2b){}

// ---------- 自绘标题栏（菜单栏合并进来）----------
// 原生标题栏是浅色的，跟整套深色 chrome 不是一回事；参考 IDE 的标题栏
// 就是「应用标记 + 菜单 + 居中标题 + 窗口按钮」一行。
var titlebar = nodio.ui.titlebar(winform, {
	height = TITLEBAR_H;
	title = "Nodio IDE";
});

// 把官方 richedit 染成深色（文字色 + 文字背景色 + 控件背景色）
// EM_SETBKGNDCOLOR(0x443) 用引擎 sysapi 表里的 ::SendMessage ——
// 它有**显式签名**（"int64(addr hwnd,int msg,addr wparam,addr lparam)"），
// 安全；不要用 ::User32.SendMessageW（动态绑定，签名靠猜会传错）。
// 控件本身的染色在 nodio.ui.richedit.darken（AI 面板等新面板也用同一份）。
var darkenRichEdit = function(ctrl){
	if(!ctrl) return;
	try{
		var uxtheme = ..raw.loadDll("uxtheme.dll");
		var setAppMode = uxtheme.api(135, "int(int mode)");
		if(setAppMode) setAppMode(2/*ForceDark*/);
		var setTheme = uxtheme.api("SetWindowTheme", "int(addr hwnd,ustring subAppName,ustring subIdList)");
		if(setTheme){
			setTheme(winform.hwnd, "DarkMode_Explorer", null);
			setTheme(ctrl.hwnd, "DarkMode_Explorer", null);
		}
	}catch(eUx){}
	..nodio.ui.richedit.darken(ctrl, theme);
}
darkenRichEdit(winform.ed);

// ---------- 编辑器组件（nodio.ui.editor）----------
// 复用 DSG 里的 richedit（opt.ctrl），组件负责标准 IDE 该有的那一堆：
// 行号栏、aardio 语法着色、当前行高亮、光标行列号回调、Tab/Shift+Tab 缩进、
// Ctrl+/ 注释切换、查找替换浮条、撤销/重做、脏标记。
// shell 只负责摆放它、把它的回调接到状态栏/页签上。
var editor = nodio.ui.editor(winform, {
	ctrl = winform.ed;
	// 字号取设置（app.settings）：用户改过就按用户要的来，
	// 没改过就是官方默认 11pt Consolas。
	fontSize = app.settings.fontSizeGet();
	fontName = "Consolas";
});

// ---------- 双栏对比编辑器 ----------
splitDiff = false;
editor2 = null;

getEditor2 = function(){
	if(!editor2){
		editor2 = nodio.ui.editor(winform, {
			// 字号跟着设置走 —— 硬编码 11 会让「分栏对比」的右半边
			// 跟左半边（以及设置里的字号）对不上。
			fontSize = app.settings.fontSizeGet();
			fontName = "Consolas";
		});
		editor2.show(false);
	}
	return editor2;
};

toggleSplitDiff = function(flag){
	if(flag === null || flag === undefined){
		splitDiff = !splitDiff;
	}
	else{
		splitDiff = flag ? true : false;
	}
	if(splitDiff){
		var ed2 = getEditor2();
		ed2.show(true);
		var t2 = ed2.getText();
		if(!t2 || #t2 == 0){
			ed2.setText(editor.getText());
		}
	}
	else{
		if(editor2) editor2.show(false);
	}
	layout();
	setStatus("双栏对比: " ++ (splitDiff ? "已开启（左右分栏）" : "已关闭"));
};

// ---------- 全屏模式 ----------
var toggleFullscreen = function(){
	try{
		winform.fullscreen();
		layout();
		setStatus(winform.restoreFullScreen ? "全屏模式已开启 (按 Shift+F11 或 Alt+Enter 退出)" : "全屏模式已退出");
	}catch(e){}
};

// ---------- 文件对话框 ----------
var fileDlg = nodio.ui.filedlg(winform, {
	owner = winform;
	filter = '所有文件|*.*|aardio 源文件|*.aardio;*.nodio|';
});

// ---------- 输入提示条（转到行）----------
var prompt = nodio.ui.prompt(winform, {title="转到行"});

// 弹提示条：摆在编辑区顶部居中
showPrompt = function(title, defText, onOk){
	var er = editorRect();
	prompt.layoutCentered(er.left, er.top, er.right, er.bottom);
	prompt.show(title, defText, onOk);
}

// 转到行（Ctrl+G）：问行号
gotoLinePrompt = function(){
	showPrompt("转到行", "", function(t){
		var n = tonumber(t);
		if(!n || n < 1){
			setStatus("行号无效: " ++ t);
			return false;
		}
		editor.gotoLine(n);
		return true;
	});
}
editor.onGotoLine = function(){ gotoLinePrompt() };

// Ctrl+1..9 → 外部工具（官方 IDE 的约定：第 N 个外部工具）。
// 编辑器组件只声明 onHotkey(vk) 钩子，不认识「外部工具」是什么。
editor.onHotkey = function(vk){
	if(!hooks.onRunExternalTool) return 0;
	var idx = tonumber(vk) - 0x30;    // '1'..'9' → 1..9
	if(!idx || idx < 1 || idx > 9) return 0;
	if(hooks.onRunExternalTool(idx) == 1) return 1;
	return 0;
};

// 项目符号搜索（Ctrl+Shift+T）：问一个名字，结果进「引用」面板
showSymbolPrompt = function(){
	showPrompt("转到符号", "", function(t){
		var q = ..string.trim(t);
		if(!q) return false;
		if(hooks.onGotoSymbol) hooks.onGotoSymbol(q);
		return true;
	});
}

// 快速打开文件（Ctrl+P）：输入关键字模糊匹配工程文件
quickOpenFilePrompt = function(){
	showPrompt("快速打开文件", "", function(t){
		var q = ..string.trim(t);
		if(!q) return false;
		if(hooks.onQuickOpen) return hooks.onQuickOpen(q);
		return false;
	});
}

// 编辑框（搜索页）也染深色：edit 控件不吃 setCharformat，
// 但 EM_SETBKGNDCOLOR 对 edit 一样有效，文字色走官方 ctrl.color
var darkenEdit = function(ctrl){
	if(!ctrl) return;
	try{ ctrl.color = ..nodio.ui.themeRef(theme.text) }catch(e){};
	try{
		::SendMessage(ctrl.hwnd, 0x443/*_EM_SETBKGNDCOLOR*/, 0,
			..nodio.ui.themeRef(theme.bg));
	}catch(e){};
};

// ---------- 右键菜单 ----------
// 编辑器：官方 win.ui.tracker 派发 0x7B → onContextMenu（屏幕坐标），
// 官方 win.ui.popmenu 弹出；命令走编辑器组件（nodio.ui.editor）。
app.editor.contextMenu(winform, editor);

// ---------- hooks filled by main.nodio ----------
//
// ⚠⚠⚠ 这些钩子必须放在**表**里，不能写成模块级的裸变量！
//
// 引擎里模块体的裸赋值（`onX = null`）只是**模块帧的局部变量**；
// 外部 `app.shell.onX = f` 写的是**模块表的成员** —— 两者不是同一格。
// 模块内部读裸名字时局部变量**遮蔽**了模块表的成员，
// 于是钩子永远是初值 null：工具条、菜单、快捷键、工程树双击、
// 文档变化刷新大纲……**整片是死的**（实测：main 侧看到的是函数，
// 模块内部读到的却是 null）。
//
// 放进表里就绕开了这层遮蔽：表是同一个对象，谁改都看得见。
// main.nodio 侧写法：`shell.hooks.onX = ...`
var hooks = {
	onOpenProject = null;     // function() — 打开工程
	onOpenFile    = null;     // function(path) — 打开一个文件
	onNewFile     = null;     // function() — 新建文档
	onSave        = null;     // function()
	onSaveAs      = null;     // function()
	onSaveAll     = null;     // function()
	onCloseTab    = null;     // function(path) — 返回 true 才允许关闭
	onDocChange   = null;     // function(path, text) — 文档内容变了
	onRun         = null;     // function()
	onDebug       = null;     // function()
	onDebugStep   = null;     // function() — 单步跳过（F11）
	onStopDebug   = null;     // function()
	onDesigner    = null;     // function() — open/close the designer
	onDesignerSave = null;    // function() — 把设计写回当前文档的 DSG 块
	onDesignerLoad = null;    // function() — 从当前文档的 DSG 块载入设计
	onPrint = null;           // function() — 打印当前文档（第五十六轮）
	onDesignerSaveAs = null;  // function() — 设计另存为 .dsg
	onDesignerOpen = null;    // function() — 打开 .dsg 文件
	onDesignerForm = null;    // function() — 选中窗体本身（改 标题/宽度/高度）
	onDesignerGrid = null;    // function() — 显示网格线 开/关
	onDesignerSnap = null;    // function() — 对齐网格 开/关（拖动/缩放吸附）
	onDesignerAlignSnap = null; // function() — 控件吸附对齐 开/关
	onDesignerMargin = null;  // function() — 边距参考线 开/关
	onDesignerZoom100 = null; // function() — 缩放 100%
	onDesignerZoomIn  = null; // function() — 放大 (+25%)
	onDesignerZoomOut = null; // function() — 缩小 (-25%)
	onAfterLayout = null;     // function(editorRect) — 覆盖层（设计画布）跟随重排
	onTabChange   = null;     // function(path) — 当前文档切换（大纲等派生视图刷新）
	// 代码导航（main.norio 实现：问 LSP，然后跳转 / 填引用面板）
	onGotoDefinition = null;  // function()
	onFindReferences = null;  // function()
	onRenameSymbol    = null; // function()
	onGotoSymbol      = null; // function(query) — 项目符号搜索
	onCursorMove      = null; // function(line, col) — 光标移动（导航栏面包屑跟着走）
	// 工程树文件操作（main.nodio 实现真正的磁盘操作）
	onProjNewFile = null;     // function(dirPath) — 在目录里新建文件
	onProjNewDir  = null;     // function(dirPath) — 在目录里新建子目录
	onProjRename  = null;     // function(path) — 重命名文件/目录
	onProjDelete  = null;     // function(path) — 删除文件/目录
	onProjSetStart = null;    // function(path) — 设为工程启动文件
};

// ---------- left dock: 工程 / 属性 / 搜索 / 大纲 ----------
var leftDock = nodio.ui.dock(winform, {
	rect = {left=0; top=S(TOP0); right=S(LEFT_W); bottom=400};
	tabs = {"工程"; "属性"; "搜索"; "大纲"};
});
// 工程页：工程树建在页里（页内容直接挂在 IDE 主窗体上）
var projTree = nodio.ui.projectTree(leftDock.addTab("工程"), {
	left = 0; top = 0; right = LEFT_W; bottom = 600;
});
leftDock.addTab("工程", projTree);
// 搜索 / 大纲 页
// 搜索页是**真能用的全文搜索**：关键字输入条 + 结果表 + 双击跳转
// （nodio.ui.searchPanel，结果表走自绘 list —— 原生 listview 改不了色）。
// 大纲用**自绘树**（原生 treeview 改不了色，改色消息在本机会崩进程）
var searchPanel = nodio.ui.searchPanel(winform, {
	rect = {left=0; top=0; right=LEFT_W; bottom=600};
});
leftDock.addTab("搜索", searchPanel, {icon="search"});

// 切到左栏「搜索」页并聚焦关键字输入框
showSearchPage = function(){
	leftDock.setSelIndex(3);
	searchPanel.focus();
}
var outlineTree = nodio.ui.tree(winform, {left=0;top=0;right=LEFT_W;bottom=600});
leftDock.addTab("大纲", outlineTree, {icon="list"});
// 类视图（第五十一轮）：class/namespace → 成员的层级树（main.nodio 填充）
var classTree = nodio.ui.tree(winform, {left=0;top=0;right=LEFT_W;bottom=600});
leftDock.addTab("类视图", classTree, {icon="list"});
// 「属性」页留给设计器的属性格（main.nodio 接入）

// ---------- 右栏: 控件 / 语法 / 标准库 / 范例 / 工具 / AI ----------
// 「控件」页 = 设计器工具箱（nodio.designer.toolbox，main.nodio 接入）：
//   原生控件 + nodio.gui 自绘控件都在里面，点选落到设计画布上。
//   （以前的「组件」页是 nodio.gui 展厅 —— 演示页，且是全 IDE 最贵的
//     一块画板：每次重画 110~140ms，拖动窗口大小时每次 flush 都要陪着
//     重画一遍 —— 已删除，组件的归宿是工具箱。）
var rightDock = nodio.ui.dock(winform, {
	rect = {left=1040; top=S(TOP0); right=1280; bottom=400};
	tabs = {"控件"; "语法"; "标准库"; "模板"; "范例"; "工具"; "AI"};
});
// 语法 / 标准库：自绘多列列表（原生 listview 改不了色）
// 列宽是逻辑像素，按右栏宽度（RIGHT_W）分配，别留一大截空白。
var syntaxList = nodio.ui.list(winform, {columns={{"语法";300}}});
rightDock.addTab("语法", syntaxList);
var stdList = nodio.ui.list(winform, {columns={{"命名空间";130};{"说明";190}}});
rightDock.addTab("标准库", stdList);
// 模板面板（第五十二轮）：新建文件的内置模板（main.nodio 填充 + onPick）
var templatesList = nodio.ui.list(winform, {columns={{"模板";90};{"说明";230}}});
rightDock.addTab("模板", templatesList);
// 范例 / 工具：自绘树
var exTree = nodio.ui.tree(winform, {left=0;top=0;right=300;bottom=600});
rightDock.addTab("范例", exTree);
var toolTree = nodio.ui.tree(winform, {left=0;top=0;right=300;bottom=600});
rightDock.addTab("工具", toolTree);
// 「AI」页 = AI 聊天面板（app.ai.panel）：
//   顶栏（模型 / 状态 + 发送 / 清空 / 设置）+ 对话日志 + 输入框，
//   设置页里填接口地址 / 模型 / API Key（Key 存 Windows 凭据管理器）。
//   面板自己管显隐（dock 只认一个 ctrl → 面板给的是「可见性代理」），
//   跟 nodio.ui.searchPanel 同一个套路。
var aiPanel = app.ai.panel(winform, {
	rect = {left=1040; top=S(TOP0); right=1280; bottom=400};
});
aiPanel.onStatus = function(s){ setStatus(s) };
rightDock.addTab("AI", aiPanel, {});
// 原生 treeview / listview 的深色暂时做不了：comctl32 的配色消息在本机会崩
// （见 nodio.ui.theme 的注释）。这两类面板已经改成自绘（nodio.ui.list / tree）。
// 「控件」页留给设计器的工具箱（main.nodio 接入）
// 注：右栏页签**不画图标** —— 页签多了带图标放不进 352 逻辑像素，
// 后面的页签会被裁掉（参考 IDE 的右栏页签本来就是纯文字）。
leftDock.setIcon(1, "folderOpen");
leftDock.setIcon(2, "cog");

// ---------- bottom dock: 问题 / 输出 / 调试 / 终端 ----------
var bottomDock = nodio.ui.dock(winform, {
	rect = {left=S(LEFT_W); top=400; right=1040; bottom=600};
	tabs = {"问题"; "输出"; "调试"; "终端"};
});
var probList = nodio.ui.list(winform, {columns={{"行";40};{"级别";60};{"说明";400}}});
var probLv = bottomDock.addTab("问题", probList, {icon="warning"});
var outEd  = bottomDock.addTab("输出", "richedit", {multiline=true;vscroll=true;readonly=true; icon="comment"});
var dbgEd  = bottomDock.addTab("调试", "richedit", {multiline=true;vscroll=true;readonly=true; icon="bug"});
var termEd = bottomDock.addTab("终端", "richedit", {multiline=true;vscroll=true; icon="terminal"});
// 引用面板：Shift+F12「查找引用」的结果列表（跨文件）
var refList = nodio.ui.list(winform, {columns={{"文件";240};{"行";50};{"说明";260}}});
var refLv = bottomDock.addTab("引用", refList, {icon="search"});
// 立即窗口（第五十五轮）：单行输入，回车 → 在**当前暂停帧**里求值
//   （表达式由 IDE 侧 shell.hooks.onDebugEval 转给 DAP → 引擎）
var imEd = bottomDock.addTab("立即", "richedit", {multiline=false; vscroll=false; icon="terminal"});
// 监视窗 + 变量树（第五十九轮续：调试器之四）。
// 求值钩子/数据源由 main 侧注入（dbgSession 与 app.dapClient 在那边）——
//   watchPanel.setEvaluator / varsPanel.setProvider+setChildren。
// ⚠ 裸赋值进模块表（同 dockHasTab 的坑注释），main.nodio 取
//   shell.watchPanel / shell.varsPanel。
watchPanel = app.watch.panel(winform, {});
bottomDock.addTab("监视", watchPanel, {icon="eye"});
varsPanel = app.watch.varsPanel(winform, {});
bottomDock.addTab("变量", varsPanel, {icon="list"});
// 供回归：底部面板里有没有某个页签（按页签名查）。
// 「立即」页签是第五十五轮新增的，但它默认排在最后、很容易被当成不存在 ——
// 用这条查询把它锁进冒烟自检。
//
// ⚠ 必须**裸赋值**（不能写 shell.dockHasTab）：模块体内没有名为 shell 的
//   变量，`shell.xxx =` 会写到一张临时表上，app.shell 上根本看不到这个成员
//   （main.nodio 取 shell.dockHasTab 会拿到 nil）。模块层裸赋值才进模块表。
dockHasTab = function(caption){
	if(!bottomDock || !bottomDock.tabs) return false;
	for(i=1;#bottomDock.tabs;1){
		if(bottomDock.tabs[i] == caption) return true;
	}
	return false;
}
darkenRichEdit(outEd);
darkenRichEdit(dbgEd);
darkenRichEdit(termEd);
darkenRichEdit(imEd);
// 回车求值：子类化吃回车，并**推迟到消息循环**再问——
//   DAP 求值是同步阻塞的（最长 4 秒），在窗口过程里做会卡住整个 IDE。
var __imSub = nodio.ui.subclass(imEd.hwnd, function(hwnd, msg, wp, lp){
	if(msg == 0x100 && tonumber(wp) == 0x0D){    // WM_KEYDOWN + VK_RETURN
		var txt = ..string.trim(tostring(imEd.text : ""));
		if(#txt){
			imEd.text = "";
			try{
				winform.setTimeout(function(){
					var res = null;
					try{
						if(shell.hooks.onDebugEval) res = shell.hooks.onDebugEval(txt);
					}catch(eEval){}
					if(res === null || res === undefined){
						dbgAppend("立即> " ++ txt ++ "  （没有可用的调试会话）");
					}
					else{
						dbgAppend("立即> " ++ txt ++ " = " ++ tostring(res));
					}
					return null;
				}, 1);
			}catch(e){}
		}
		return 1;      // 吃掉回车（单行 richedit 本来也不插换行）
	}
	return 0;
});
// 「AI」页不是原生 richedit 了（是 app.ai 面板），染色由面板自己做
// 问题列表已改成自绘（nodio.ui.list），不再受原生 listview 的配色限制

// ---------- toolbar ----------
var toolbar = nodio.ui.toolbar(winform, {
	height = TOOLBAR_H;
	buttons = {
		{text="新建";name="new";icon="file";command=function(){ if(hooks.onNewFile) hooks.onNewFile() }};
		{text="打开";name="open";icon="folderOpen";command=function(){ if(hooks.onOpenFile) hooks.onOpenFile("") }};
		{text="保存";name="save";icon="save";command=function(){ if(hooks.onSave) hooks.onSave() }};
		{sep=true};
		{text="运行";name="run";icon="bolt";command=function(){ if(hooks.onRun) hooks.onRun() }};
		{text="调试";name="debug";icon="bug";command=function(){ if(hooks.onDebug) hooks.onDebug() }};
		{text="设计器";name="designer";icon="desktop";command=function(){ if(hooks.onDesigner) hooks.onDesigner() }};
		{sep=true};
		{text="输出";name="output";icon="tasks";command=function(){ bottomDock.setSelIndex(2) }};
		{text="终端";name="terminal";icon="terminal";command=function(){ bottomDock.setSelIndex(4) }};
		{text="设置";name="settings";icon="settings";command=function(){}};
	};
});
// 悬停提示显示到状态栏
toolbar.onHover = function(name, text){
	if(text) setStatus(text);
};

// ---------- status bar ----------
var statusbar = nodio.ui.statusbar(winform, {
	height = STATUS_H;
	panels = { {"就绪";280}; {"行,列";90}; {"工程";240}; {"UTF-8";80}; {"CRLF";80} };
});

// ---------- status ----------
// 按**分段名称**定位（序号会随分段增删错位：工程路径一度被写进了「行,列」）
//
// 状态栏还有一层「保持期」：心跳每 300ms 会写一次「就绪」，
// 用户操作后的反馈（「已保存 xxx」「工程属性」）如果直接写在同一格里，
// 300ms 后就被抹掉了 —— 表现为「点了没反应」。
// 所以用户态消息会**锁住**状态栏若干拍，心跳期间不许覆盖。
var statusHold = 0;
setStatus = function(s){
	statusbar.setText("就绪",s);
	statusHold = 15;      // 15 拍 × 300ms ≈ 4.5 秒
	// 诊断模式：把状态栏文字打到 stdout。
	// 点击审计（tests/ide_click_audit.ps1）靠它判断「点一下有没有反应」——
	// 状态栏是自绘板，外部读不到文字，只能从这里取信号。
	if( ..string.getenv("NODIO_IDE_DIAG") ){
		io.print("STATUS:" ++ tostring(s));
	}
}
setPosStatus = function(s){ statusbar.setText("行,列",s) }
setProjectStatus = function(s){ statusbar.setText("工程",s) }
// 心跳用：返回 true 表示这一拍允许写「就绪」之类的空闲态
statusIdleAllowed = function(){
	if(statusHold > 0){
		statusHold = statusHold - 1;
		return false;
	}
	return true;
}

outAppend = function(s){ outEd.text = outEd.text ++ s ++ '\r\n' }
dbgAppend = function(s){ dbgEd.text = dbgEd.text ++ s ++ '\r\n' }
dbgClear = function(){ dbgEd.text = "" }
termAppend = function(s){ termEd.text = termEd.text ++ s ++ '\r\n' }
outClear = function(){ outEd.text = "" }

// ---------- document tab strip ----------
// 原生 tab 控件做不出官方 IDE 的样子（扁平标签 + 强调下划线 + 关闭标记），
// 所以文档页签用 nodio.ui.tabstrip 自绘。
var docStrip = nodio.ui.tabstrip(winform, {
	left = S(LEFT_W); top = S(TOP0); right = 900; bottom = S(TOP0 + DOCTAB_H);
	closable = true;
});

// ---------- document tabs ----------
// 文档模型：path -> {文本; 已保存的文本; 换行符}
// 文本只有「当前页签」住在编辑器控件里，其余页签的文本存在 tabFiles 里。
tabFiles = {};
tabSaved = {};      // 「上次保存时」的文本 —— 脏标记由它推导
tabEOL = {};
tabOrder = {};
curTab = null;

tabFind = function(path){
	for(i=1;#tabOrder;1){
		if(tabOrder[i] == path) return i;
	}
	return null;
}

// 页签标题：文件名 + 扩展名
tabTitle = function(path){
	var pi = ..io.splitpath(path);
	return pi.name ++ pi.ext;
}

// 页签上显示的文本（脏文档带 *）
tabCaption = function(path){
	var t = tabTitle(path);
	if(tabIsDirty(path)) t = t ++ " *";
	return t;
}

// 脏标记变了 → 刷新页签标题
tabRefresh = function(path){
	var i = tabFind(path);
	if(i) docStrip.setCaption(i, tabCaption(path));
	updateTitle();
}

// 页签图标：aardio 源码用 </> 图标，其它用普通文件图标
tabIcon = function(path){
	var pi = ..io.splitpath(path);
	var ext = string.lower(pi.ext);
	if(ext == ".aardio" || ext == ".nodio") return "fileCode";
	return "file";
}

// 标题栏中间的标题：当前文档 - 应用名（参考 IDE 的写法）
updateTitle = function(){
	var app = "Nodio IDE";
	if(curTab) app = tabTitle(curTab) ++ " - " ++ app;
	titlebar.setTitle(app);
}

tabAdd = function(path, text){
	var i = tabFind(path);
	if(i === null){
		..table.push(tabOrder, path);
		i = #tabOrder;
		docStrip.addTab(tabTitle(path), tabIcon(path));
	}
	// 文档文本统一用控件内部的形式（CRLF）：
	// 脏标记是「当前文本 vs 保存时文本」逐字比较，两边必须同形，
	// 否则 LF 文件一打开就被标成「已修改」。
	var norm = editor.normalize(text);
	tabFiles[path] = norm;
	// 记下这个文档自己的换行符（保存时按原样还原）
	var eol = '\r\n';
	if(text && #text > 0 && ..string.indexOf(text, '\n')
		&& !..string.indexOf(text, '\r\n')){
		eol = '\n';
	}
	tabEOL[path] = eol;
	tabSaved[path] = norm;
	tabSel(path);
	updateTitle();
	if( ..string.getenv("NODIO_IDE_DIAG") ){
		io.print("DIAG tabAdd i=" ++ tostring(i) ++ " cur=" ++ tostring(curTab)
			++ " order=" ++ #tabOrder);
	}
}

// 切换当前文档：把文本推进编辑器，脏标记跟着切换
tabSel = function(path){
	var i = tabFind(path);
	if(i === null) return;
	docStrip.setSelIndex(i);
	curTab = path;
	editor.setText(tabFiles[path] : "");
	editor.setEOL(tabEOL[path] : '\r\n');
	// 脏标记是**推导**出来的：当前文本 vs 这个文档上次保存时的文本
	editor.setSavedText(tabSaved[path] : "");
	updateTitle();
}

tabClose = function(path){
	var i = tabFind(path);
	if(i === null) return null;
	..table.remove(tabOrder, i);
	tabFiles[path] = null;
	tabSaved[path] = null;
	tabEOL[path] = null;
	docStrip.removeTab(i);
	if(#tabOrder == 0){
		curTab = null;
		editor.setText("");
	}
	elseif(curTab == path){
		tabSel(tabOrder[#tabOrder]);
	}
	updateTitle();
	return i;
}

closeOtherTabs = function(keepPath){
	keepPath = keepPath : curTab;
	if(!keepPath) return;
	var toClose = {};
	for(i=1;#tabOrder;1){
		if(tabOrder[i] != keepPath) ..table.push(toClose, tabOrder[i]);
	}
	for(i=1;#toClose;1){
		if(hooks.onCloseTab) hooks.onCloseTab(toClose[i]);
		else tabClose(toClose[i]);
	}
}

closeAllTabs = function(){
	var toClose = {};
	for(i=1;#tabOrder;1){ ..table.push(toClose, tabOrder[i]); }
	for(i=1;#toClose;1){
		if(hooks.onCloseTab) hooks.onCloseTab(toClose[i]);
		else tabClose(toClose[i]);
	}
}

// 切到下一个/上一个文档（Ctrl+Tab / Ctrl+Shift+Tab）
//
// ⚠ 以前只有鼠标点页签才能换文档 —— 一个 IDE 最基本的键盘操作没有。
tabNext = function(dir){
	var n = #tabOrder;
	if(n < 2) return false;
	var i = tabFind(curTab);
	if(i === null){
		i = (dir > 0) ? 1 : n;
	}
	else{
		i = i + dir;
		if(i > n) i = 1;
		if(i < 1) i = n;
	}
	tabSel(tabOrder[i]);
	return true;
}

tabCurPath = function(){
	return curTab;
}

tabSetText = function(path, text){
	if(path === null) return;
	tabFiles[path] = text;
	if(curTab == path) editor.setText(text);
}

tabGetText = function(path){
	if(path === null) return editor.getText();
	if(path == curTab) return editor.getText();
	return tabFiles[path] : "";
}

// 保存用的文本：按该文档自己的换行符还原
tabTextForSave = function(path){
	if(path == curTab) return editor.getTextForSave();
	var t = tabFiles[path] : "";
	if((tabEOL[path] : '\r\n') == '\n'){
		return ..string.replaceLiteral(t, '\r\n', '\n');
	}
	return t;
}

tabIsDirty = function(path){
	// 当前文档问编辑器（它有「上次保存的文本」基准），其它页签自己比
	if(path == curTab) return editor.isDirty();
	return (tabFiles[path] : "") != (tabSaved[path] : "");
}

// 记为已保存（保存后调用）
tabMarkSaved = function(path){
	if(path === null) return;
	// 当前页签的权威文本在编辑器控件里（轮询最多有 250ms 延迟，
	// 刚打完字就保存时 tabFiles 可能是旧的）
	var t = (path == curTab) ? editor.getText() : (tabFiles[path] : "");
	tabFiles[path] = t;
	tabSaved[path] = t;
	if(path == curTab) editor.markSaved();
	tabRefresh(path);
}

tabSetDirty = function(path, dirty){
	if(path === null) return;
	if(dirty){
		// 让「基准」与内容不同 → 推导出来就是脏的
		tabSaved[path] = null;
	}
	else{
		tabSaved[path] = tabFiles[path] : "";
	}
	if(path == curTab) editor.setSavedText(tabSaved[path] : "");
	tabRefresh(path);
}

// 另存为：换掉页签的 key（路径），文本/脏标记/换行符跟着搬过去
tabRename = function(oldPath, newPath){
	var i = tabFind(oldPath);
	if(i === null) return false;
	if(oldPath == newPath) return true;
	if(tabFind(newPath) !== null) return false;   // 目标已经开着
	tabFiles[newPath] = tabFiles[oldPath];
	tabSaved[newPath] = tabSaved[oldPath];
	tabEOL[newPath] = tabEOL[oldPath];
	tabFiles[oldPath] = null;
	tabSaved[oldPath] = null;
	tabEOL[oldPath] = null;
	tabOrder[i] = newPath;
	docStrip.setCaption(i, tabCaption(newPath));
	if(curTab == oldPath){
		curTab = newPath;
		editor.setEOL(tabEOL[newPath] : '\r\n');
	}
	updateTitle();
	return true;
}

// 关掉某个目录下的所有文档（删目录时用）
tabCloseUnder = function(dirPath){
	if(!dirPath) return 0;
	var list = {};
	for(i=1;#tabOrder;1){
		var p = tabOrder[i];
		if(p && ..string.startsWith(p, dirPath, true)){
			..table.push(list, p);
		}
	}
	for(i=1;#list;1){
		tabClose(list[i]);
	}
	return #list;
}

// ---------- 编辑器回调 → 状态栏 / 页签 / 外部 ----------
editor.onCursor = function(line, col){
	setPosStatus("行 " ++ line ++ ", 列 " ++ col);
	// 导航栏（面包屑）跟着光标走 —— 内容由 IDE 用 LSP 的符号树算
	if(hooks.onCursorMove) hooks.onCursorMove(line, col);
}
editor.onChange = function(text){
	var p = curTab;
	if(p === null) return;
	tabFiles[p] = text;
	if(hooks.onDocChange) hooks.onDocChange(p, text);
}
// 脏标记是推导出来的（当前文本 vs 上次保存的文本），
// 这里只需要把页签标题刷新一下
editor.onDirty = function(dirty){
	var p = curTab;
	if(p === null) return;
	tabRefresh(p);
}

// ---------- layout ----------
// clientWH: the client area size of the main window
//
// ⚠⚠ **不能用官方 winform.getClientRect()**：那是官方窗体**缓存**的值，
//   只在官方自己处理过 WM_SIZE 时才更新。我们自己调
//   ShowWindow(MAXIMIZE/RESTORE) 时官方那条路径不一定走到，
//   缓存就停在旧尺寸 —— 心跳的 relayout 于是判定「尺寸没变」→ 永远不重排：
//   画板停在旧尺寸（标题栏的窗口按钮也跟着错位，点「最大化」点到「最小化」），
//   表现就是「最大化/还原之后黑屏」。
//
// 这里改用**实时**的 Win32 客户区尺寸（::GetClientRect 的官方封装）。
clientWH = function(){
	var liveW = 0, liveH = 0, liveErr = null;
	// ⚠⚠⚠ **窗口最小化时绝对不能用客户区尺寸**：
	//   最小化窗口的 GetClientRect 返回的是**退化尺寸**（实测 237x39），
	//   心跳的 relayout 拿它去重排 → 编辑区矩形反转成 (408,90,-291,-330)
	//   → 所有画板被摆到屏幕外 → 用户还原窗口后看到的是一片黑，
	//   而且这块坏布局会一直粘着（心跳每 300ms 重排一次，每次都错）。
	//   官方窗体自己的 WM_MOVE 同样跳过最小化状态（win/ui/_.aardio:491），
	//   这里照抄：最小化期间沿用上一次的尺寸，不触发重排。
	//   （触发路径：鼠标停在标题栏的「最小化」按钮上，窗口弹出到光标下，
	//     一次误点就中招 —— 标题栏按钮的命中区域是按画板宽度实时算的，
	//     位置没错，但用户点下去就是最小化。）
	try{
		if(..win.isIconic(winform.hwnd)){
			if(clientWHLast && clientWHLastH) return clientWHLast, clientWHLastH;
			return 1240, 780;
		}
	}catch(eIcon){}
	// ⚠ 用引擎 sysapi 的 ::GetClientRect（**实时** Win32 API）：
	//   官方 winform.getClientRect() 返回的是官方窗体**缓存**的值，
	//   只在官方自己处理过 WM_SIZE 时才更新 —— 我们自己调
	//   ShowWindow(MAXIMIZE/RESTORE) 时官方那条路径不一定走到，
	//   缓存就停在旧尺寸：心跳的 relayout 于是判定「尺寸没变」→ 永远不重排，
	//   画板停在旧屏幕坐标（最大化时在 -10,-10，还原后窗体挪走了 →
	//   **整块跑到屏幕外 → 黑屏**）。
	try{
		var rc = ::RECT();
		::GetClientRect(winform.hwnd, rc);
		liveW = (rc.right && rc.left !== null) ? (rc.right - rc.left) : (rc.width : 0);
		liveH = (rc.bottom && rc.top !== null) ? (rc.bottom - rc.top) : (rc.height : 0);
	}catch(e0){
		liveErr = tostring(e0);
	}
	var w = liveW, h = liveH;
	if(!(w && h)){
		var rc2 = winform.getClientRect();
		if(rc2){
			w = (rc2.right && rc2.left !== null) ? (rc2.right - rc2.left) : (rc2.width : 0);
			h = (rc2.bottom && rc2.top !== null) ? (rc2.bottom - rc2.top) : (rc2.height : 0);
		}
	}
	if(!(w && h)){ w = 1240; h = 780 }
	// 只在**尺寸变化**时打一行（心跳每 300ms 调一次，不能每次都打）
	if( ..string.getenv("NODIO_IDE_DIAG") ){
		if(clientWHLast != w || clientWHLastH != h){
			clientWHLast = w; clientWHLastH = h;
			// ⚠ 对照打印：live = ::GetClientRect（实时 Win32 API），
			//   off = winform.getClientRect()（官方**缓存**值），
			//   hwnd = 实际取尺寸的窗口句柄。
			//   三者对不上 = 官方缓存没更新 / 句柄不对。
			var offW = 0, offH = 0;
			try{
				var rcOff = winform.getClientRect();
				if(rcOff){ offW = rcOff.width : 0; offH = rcOff.height : 0; }
			}catch(e2){}
			io.print("DIAG clientWH live=" ++ liveW ++ "x" ++ liveH
				++ " used=" ++ w ++ "x" ++ h
				++ " off=" ++ offW ++ "x" ++ offH
				++ " hwnd=" ++ tostring(winform.hwnd)
				++ (liveErr ? (" err:" ++ liveErr) : ""));
		}
	}
	return w,h;
}
var clientWHLast = 0, clientWHLastH = 0;

// 文档页签条高度（物理像素）—— 设计画布要盖在页签条下面
docTabH = function(){
	return S(DOCTAB_H);
}

// editorRect: the document area (tab strip + editor)
// w,h 是**物理**像素（客户区尺寸），返回的矩形也是物理像素
editorRect = function(w,h){
	if(!w || !h){
		var cw,ch = clientWH();
		w = cw; h = ch;
	}
	return {
		left  = S(LEFT_W);
		top   = S(TOP0);
		right = w - S(RIGHT_W);
		bottom= h - S(STATUS_H) - S(BOTTOM_H);
	};
}

layout = function(w,h){
	var srcExplicit = false;
	if(!w || !h){
		var cw,ch = clientWH();
		w = cw; h = ch;
	}else{
		srcExplicit = true;
	}
	var er = editorRect(w,h);

	// ⚠⚠ **客户区尺寸退化时整段重排必须跳过**：
	//   窗口最小化时 GetClientRect 返回的是退化尺寸（实测 237x39），
	//   这时算出来的矩形全是**反的**（right<left、bottom<top，
	//   实测 er=408,90,-291,-330）→ 所有画板被摆到屏幕外 →
	//   用户还原窗口后看到的是一片黑，而且坏布局会一直粘着
	//   （心跳每 300ms 重排一次，每次都错）。
	//   尺寸不合理时**保持上一次的布局**，等窗口恢复正常再重排。
	if(w < 200 || h < 150){
		if( ..string.getenv("NODIO_IDE_DIAG") ){
			io.print("DIAG layout skip degenerate client=" ++ tostring(w) ++ "x" ++ tostring(h));
		}
		return false;
	}

	// ⚠⚠⚠ **重排期间不许上屏**（防「改尺寸时满屏闪」）：
	//   拖动窗口大小时 Windows 会连续发几十个 WM_SIZE，
	//   每一次都重排 27 块画板，而每块画板的 redraw() 都是
	//   「InvalidateRect 整块 + UpdateWindow」= **立刻上屏**。
	//   ⇒ 一次拖拽 = 上百次上屏 = 用户看到的面板一块块跳出来。
	//   这里把整个重排包进「延迟绘制」：期间只置脏不上屏，
	//   收尾时统一画一次（窗口一帧就位，不闪）。
	//   ⚠ 已经在延迟态里的重排不要再套（会互相踩）。
	var __lt0 = ..time.tick();
	var __ltWas = false;
	try{ __ltWas = ..nodio.ui.isDeferredPaint() }catch(e0b){}
	if(!__ltWas) ..nodio.ui.setDeferredPaint(true);

	// docks (left full height, right above the bottom dock, bottom across)
	leftDock.rect   = {left=0; top=S(TOP0); right=S(LEFT_W); bottom=h - S(STATUS_H)};
	rightDock.rect  = {left=w - S(RIGHT_W); top=S(TOP0); right=w; bottom=h - S(STATUS_H) - S(BOTTOM_H)};
	bottomDock.rect = {left=S(LEFT_W); top=h - S(STATUS_H) - S(BOTTOM_H); right=w; bottom=h - S(STATUS_H)};
	leftDock.layout();
	rightDock.layout();
	bottomDock.layout();
	var __lt1 = ..time.tick();

	// 自绘标题栏（菜单栏在里面）
	titlebar.layout(0, 0, w, S(TITLEBAR_H));

	// toolbar + status bar span the full width
	toolbar.layout(0, S(TITLEBAR_H), w, S(TOP0));
	statusbar.layout(0, h - S(STATUS_H), w, h);
	var __lt2 = ..time.tick();

	// （窗体底色由官方 background 在 WM_ERASEBKGND 里画，
	//   以前的全客户区「背景板」已删除 —— 见模块开头的说明。）
	var __lt3 = ..time.tick();

	// document tabs + editor
	docStrip.layout(er.left, er.top, er.right, er.top + S(DOCTAB_H));
	// 编辑器组件（支持双栏对比拆分）
	if(splitDiff && editor2){
		var mid = er.left + math.round((er.right - er.left) / 2);
		editor.layout(er.left, er.top + S(DOCTAB_H) + 2, mid - 2, er.bottom);
		editor2.layout(mid + 2, er.top + S(DOCTAB_H) + 2, er.right, er.bottom);
	}
	else{
		editor.layout(er.left, er.top + S(DOCTAB_H) + 2, er.right, er.bottom);
		if(editor2) editor2.show(false);
	}

	// 输入提示条（转到行）跟着编辑区走
	prompt.layoutCentered(er.left, er.top, er.right, er.bottom);
	var __lt4 = ..time.tick();

	// 覆盖层（设计画布）跟着走：它不在窗体的自动布局里。
	// 注意：钩子放在模块全局里在官方 onSize 回调里取不到（跨作用域），
	// 所以真正的重排由 main.nodio 的心跳驱动（见 main.nodio 的 relayout）。
	if( ..string.getenv("NODIO_IDE_DIAG") ){
		io.print("DIAG shell.layout w=" ++ w ++ " h=" ++ h
			++ " src=" ++ (srcExplicit ? "explicit" : "clientWH")
			++ " er=" ++ er.left ++ "," ++ er.top ++ "," ++ er.right ++ "," ++ er.bottom);
	}
	if(hooks.onAfterLayout) hooks.onAfterLayout(er);

	// ⚠ 尺寸变了之后，**矩形变过的**自绘板要整块重画。
	//
	// 官方 plus 的 WM_PAINT 只画「本次失效区域」（win/ui/ctrl/plus.aardio:833），
	// 而窗口尺寸变化时 Windows 只给子窗体发「暴露区」失效通知 ——
	// 页签条这类**只挪位置、尺寸没变**的板子拿不到任何失效通知。
	// 但主窗体已经开了 WS_CLIPCHILDREN：父窗体重绘不再擦掉子窗体像素，
	// 挪位置的板子内容跟着窗口走，根本不用重画 ——
	// 这里只失效「尺寸变过」的板子（redrawAll(true) 按 __dirty 挑），
	// 不再像以前那样 27 块全量失效 + 逐块 UpdateWindow（实测 220ms+/次）。
	try{
		..nodio.ui.redrawAll(true);
	}catch(e2){}
	// ⚠ 收尾：退出延迟绘制。
	//   拖拽中**不要**逐块强制上屏（UpdateWindow 一块一块蹦 = 马赛克）：
	//   板子已经置脏，自然 WM_PAINT 循环 + WS_EX_COMPOSITED 会把它们
	//   合成一帧呈现；拖拽结束（WM_EXITSIZEMOVE，见 install 的 onFormMsg）
	//   再补一次全量重画收口。
	if(!__ltWas){
		..nodio.ui.setDeferredPaint(false);
		if(!..nodio.ui.inSizeMove()){
			try{ ..nodio.ui.redrawAll() }catch(e3){}
		}
	}
	if( ..string.getenv("NODIO_IDE_DIAG") ){
		io.print("DIAG layout cost docks=" ++ tostring(__lt1-__lt0)
			++ "ms chrome=" ++ tostring(__lt2-__lt1)
			++ "ms bg=" ++ tostring(__lt3-__lt2)
			++ "ms ed=" ++ tostring(__lt4-__lt3)
			++ "ms total=" ++ tostring(..time.tick()-__lt0) ++ "ms");
	}
}

// ---------- install ----------
// 去掉原生标题栏（必须**在窗口 show 之后**调用：
// 官方 win.form 会在 show 时做 DPI 初始化并重排控件）。
// 去掉之后客户区变大（原来标题栏占的那条），所以要立刻重排一次。
applyBorderless = function(){
	titlebar.applyBorderless();
	layout();
}

install = function(){
	// F5 run, F10 debug, Ctrl+F9 stop, Ctrl+S save — hotkeys + menu share hooks
	//
	// ⚠ 修饰键掩码是 Win32 的 MOD_*：ALT=0x1 / CONTROL=0x2 / SHIFT=0x4 / WIN=0x8。
	// 官方 win.ui 的 reghotkey 直接把 mod 传给 RegisterHotKey（没有换算），
	// 之前这里写成 0x8 / 0x11 —— 0x8 是 Win 键、0x10 压根不是合法标志位，
	// 于是 Ctrl+S / Ctrl+N / Ctrl+O / Ctrl+W / Ctrl+F9 **一个都没注册上**
	// （RegisterHotKey 直接失败）。这轮一并修好。
	var MOD_ALT = 0x1, MOD_CTRL = 0x2, MOD_SHIFT = 0x4;
	winform.reghotkey(function(id,mod,vk){
		if(hooks.onRun) hooks.onRun();
	}, 0, 0x74); // F5
	winform.reghotkey(function(id,mod,vk){
		if(hooks.onDebug) hooks.onDebug();
	}, 0, 0x79); // F10
	winform.reghotkey(function(id,mod,vk){
		if(hooks.onDebugStep) hooks.onDebugStep();
	}, 0, 0x7A); // F11 = 单步跳过
	winform.reghotkey(function(id,mod,vk){
		if(hooks.onStopDebug) hooks.onStopDebug();
	}, MOD_CTRL, 0x78); // Ctrl+F9
	winform.reghotkey(function(id,mod,vk){
		if(hooks.onSave) hooks.onSave();
	}, MOD_CTRL, 0x53); // Ctrl+S
	winform.reghotkey(function(id,mod,vk){
		if(hooks.onNewFile) hooks.onNewFile();
	}, MOD_CTRL, 0x4E); // Ctrl+N
	winform.reghotkey(function(id,mod,vk){
		if(hooks.onOpenFile) hooks.onOpenFile("");
	}, MOD_CTRL, 0x4F); // Ctrl+O
	winform.reghotkey(function(id,mod,vk){
		if(hooks.onCloseTab) hooks.onCloseTab(curTab);
	}, MOD_CTRL, 0x57); // Ctrl+W
	winform.reghotkey(function(id,mod,vk){
		editor.showFind(false);
	}, MOD_CTRL, 0x46); // Ctrl+F —— 查找浮条
	winform.reghotkey(function(id,mod,vk){
		editor.showFind(true);
	}, MOD_CTRL, 0x48); // Ctrl+H —— 替换浮条
	winform.reghotkey(function(id,mod,vk){
		gotoLinePrompt();
	}, MOD_CTRL, 0x47); // Ctrl+G —— 转到行
	winform.reghotkey(function(id,mod,vk){
		showSearchPage();
	}, MOD_CTRL + MOD_SHIFT, 0x46); // Ctrl+Shift+F —— 工程内全文搜索
	winform.reghotkey(function(id,mod,vk){
		editor.toggleFold(editor.curLine);
	}, MOD_CTRL + MOD_SHIFT, 0xDB); // Ctrl+Shift+[ —— 折叠/展开当前块
	winform.reghotkey(function(id,mod,vk){
		tabNext(1);
	}, MOD_CTRL, 0x09); // Ctrl+Tab —— 下一个文档
	winform.reghotkey(function(id,mod,vk){
		tabNext(-1);
	}, MOD_CTRL + MOD_SHIFT, 0x09); // Ctrl+Shift+Tab —— 上一个文档
	winform.reghotkey(function(id,mod,vk){
		showSymbolPrompt();
	}, MOD_CTRL + MOD_SHIFT, 0x54); // Ctrl+Shift+T —— 项目符号搜索
	winform.reghotkey(function(id,mod,vk){
		quickOpenFilePrompt();
	}, MOD_CTRL, 0x50/*VK_P*/); // Ctrl+P —— 快速打开文件
	winform.reghotkey(function(id,mod,vk){
		toggleFullscreen();
	}, MOD_SHIFT, 0x7A/*VK_F11*/); // Shift+F11 —— 全屏模式
	winform.reghotkey(function(id,mod,vk){
		toggleFullscreen();
	}, MOD_ALT, 0x0D/*VK_RETURN*/); // Alt+Enter —— 全屏模式
	winform.reghotkey(function(id,mod,vk){
		if(editor) editor.toggleBreakpoint(editor.curLine);
	}, 0, 0x78/*VK_F9*/); // F9 —— 切换当前行断点
	winform.reghotkey(function(id,mod,vk){
		if(hooks.onBpCondition) hooks.onBpCondition();
	}, MOD_SHIFT, 0x78/*VK_F9*/); // Shift+F9 —— 条件/命中次数断点（第五十九轮）
	winform.reghotkey(function(id,mod,vk){
		if(hooks.onDesigner) hooks.onDesigner();
	}, MOD_SHIFT, 0x76/*VK_F7*/); // Shift+F7 —— 设计视图/代码视图切换
	winform.reghotkey(function(id,mod,vk){
		if(hooks.onDesigner) hooks.onDesigner();
	}, 0, 0x76/*VK_F7*/); // F7 —— 设计视图/代码视图切换
	winform.reghotkey(function(id,mod,vk){
		bottomDock.selectCaption("立即");
	}, MOD_CTRL + MOD_SHIFT, 0x49/*VK_I*/); // Ctrl+Shift+I —— 立即窗口（表达式求值）
	winform.reghotkey(function(id,mod,vk){
		bottomDock.selectCaption("监视");
	}, MOD_CTRL + MOD_SHIFT, 0x57/*VK_W*/); // Ctrl+Shift+W —— 监视窗口

	// 菜单：自绘标题栏的一行（不再是原生系统菜单栏）。
	// 表结构：{ {"标题"; { {"菜单项"; 函数}; {"-"; null} }} }
	// 主题当前值在**建菜单时**读一次：主题是构造期配色，改主题要重启 IDE
	// （见 app/settings.nodio 的说明），所以菜单上的「（当前）」不会中途变。
	var __curTheme = app.settings.themeGet();
	var __themeDark = (__curTheme == "dark") ? "深色（当前）" : "深色";
	var __themeLight = (__curTheme == "light") ? "浅色（当前）" : "浅色";
	// 「文件」菜单条目**每次重建**：最近文件列表会变（打开任何文档就置顶入队，
	// 见 app/settings.nodio 的 recentGet/recentPush）。自绘菜单
	// （nodio.ui.titlebar）打开下拉时**现读** items 表，重建后 setMenus
	// 一次即生效 —— 不需要二级子菜单机制，也不需要菜单句柄级 API。
	//
	// ⚠ mkOpen 闭包工厂：循环里直接写 function(){...p...} 的话，所有条目
	//   可能共享同一个循环变量（点哪条都打开最后一条）。mkOpen 把路径绑进
	//   **参数**，每次调用是独立的新局部变量，与循环变量无关，无条件安全。
	var mkOpen = function(p){
		return function(id){ if(hooks.onOpenFile) hooks.onOpenFile(p) };
	}
	var buildFileMenuItems = function(){
		var items = {
			{ "新建  Ctrl+N"; function(id){ if(hooks.onNewFile) hooks.onNewFile() } };
			{ "打开文件...  Ctrl+O"; function(id){ if(hooks.onOpenFile) hooks.onOpenFile("") } };
			{ "快速打开文件...  Ctrl+P"; function(id){ quickOpenFilePrompt() } };
			{ "打开工程..."; function(id){ if(hooks.onOpenProject) hooks.onOpenProject() } };
		};
		var rf = app.settings.recentGet();
		if(#rf){
			..table.push(items, { "-"; null });
			for(i=1;#rf;1){
				..table.push(items, { (tostring(i) ++ ".  " ++ rf[i]); mkOpen(rf[i]) });
			}
			..table.push(items, { "-"; null });
		}
		..table.push(items, { "保存  Ctrl+S"; function(id){ if(hooks.onSave) hooks.onSave() } });
		..table.push(items, { "另存为..."; function(id){ if(hooks.onSaveAs) hooks.onSaveAs() } });
		..table.push(items, { "全部保存"; function(id){ if(hooks.onSaveAll) hooks.onSaveAll() } });
		..table.push(items, { "打印..."; function(id){ if(hooks.onPrint) hooks.onPrint() } });
		..table.push(items, { "-"; null });
		..table.push(items, { "关闭标签页  Ctrl+W"; function(id){ if(hooks.onCloseTab) hooks.onCloseTab(curTab) } });
		..table.push(items, { "关闭其他标签页"; function(id){ if(hooks.onCloseOtherTabs) hooks.onCloseOtherTabs(curTab); else closeOtherTabs(curTab); } });
		..table.push(items, { "关闭全部标签页"; function(id){ if(hooks.onCloseAllTabs) hooks.onCloseAllTabs(); else closeAllTabs(); } });
		..table.push(items, { "-"; null });
		..table.push(items, { "下一个文档  Ctrl+Tab"; function(id){ tabNext(1) } });
		..table.push(items, { "上一个文档  Ctrl+Shift+Tab"; function(id){ tabNext(-1) } });
		..table.push(items, { "-"; null });
		..table.push(items, { "退出"; function(id){ winform.close() } });
		return items;
	}
	// 菜单表持有为局部变量：refreshRecentMenu 重建「文件」条目后用
	// setMenus 原表重挂（titlebar 打开下拉时现读，重建即生效）。
	var menusDef = {
		{ "文件"; buildFileMenuItems() };
		{ "工程";{
			{ "打开工程..."; function(id){ if(hooks.onOpenProject) hooks.onOpenProject() } };
			{ "新建文件..."; function(id){ if(hooks.onProjNewFile) hooks.onProjNewFile(null) } };
			{ "新建目录..."; function(id){ if(hooks.onProjNewDir) hooks.onProjNewDir(null) } };
			{ "工程属性"; function(id){ if(hooks.onProjProperties) hooks.onProjProperties() } };
			{ "-"; null };
			{ "在资源管理器中定位"; function(id){ if(hooks.onRevealInExplorer) hooks.onRevealInExplorer() } };
			{ "在终端中打开"; function(id){ if(hooks.onOpenTerminal) hooks.onOpenTerminal() } };
			{ "工程代码行统计"; function(id){ if(hooks.onProjectStats) hooks.onProjectStats() } };
			{ "-"; null };
			{ "发布为独立 exe（控制台）..."; function(id){ if(hooks.onPublishConsole) hooks.onPublishConsole() } };
			{ "发布为独立 exe（界面程序）..."; function(id){ if(hooks.onPublishGui) hooks.onPublishGui() } };
			{ "-"; null };
			{ "打开设计器"; function(id){ if(hooks.onDesigner) hooks.onDesigner() } };
		} };
		{ "编辑";{
			{ "剪切  Ctrl+X"; function(id){ app.editor.cut(editor) } };
			{ "复制  Ctrl+C"; function(id){ app.editor.copy(editor) } };
			{ "粘贴  Ctrl+V"; function(id){ app.editor.paste(editor) } };
			{ "全选  Ctrl+A"; function(id){ app.editor.selectAll(editor) } };
			{ "以 RTF 格式复制"; function(id){
				if(app.editor.copyRtf(editor)) setStatus("已复制 RTF（整篇带色，可贴入 Word）");
			} };
			{ "以 HTML 格式复制"; function(id){
				if(app.editor.copyHtml(editor)) setStatus("已复制 HTML（整篇带色，可贴入邮件/网页）");
			} };
			{ "-"; null };
			{ "复制文件完整路径"; function(id){
				var cur = tabCurPath();
				if(cur){
					win.clip.write(cur);
					setStatus("已复制路径: " ++ cur);
				}
			} };
			{ "-"; null };
			{ "撤销  Ctrl+Z"; function(id){ editor.undo() } };
			{ "重做  Ctrl+Y"; function(id){ editor.redo() } };
			{ "-"; null };
			{ "查找  Ctrl+F"; function(id){ editor.showFind(false) } };
			{ "替换  Ctrl+H"; function(id){ editor.showFind(true) } };
			{ "转到行  Ctrl+G"; function(id){ gotoLinePrompt() } };
			{ "-"; null };
			{ "代码补全  Ctrl+Space"; function(id){ editor.requestComplete() } };
			{ "-"; null };
			{ "转到定义  F12"; function(id){ if(hooks.onGotoDefinition) hooks.onGotoDefinition() } };
			{ "查找引用  Shift+F12"; function(id){ if(hooks.onFindReferences) hooks.onFindReferences() } };
			{ "重命名  F2"; function(id){ if(hooks.onRenameSymbol) hooks.onRenameSymbol() } };
		} };
		{ "选择";{
			{ "工程树"; function(id){ leftDock.setSelIndex(1) } };
			{ "属性"; function(id){ leftDock.setSelIndex(2) } };
			{ "大纲"; function(id){ leftDock.setSelIndex(4) } };
		} };
		{ "格式";{
			{ "格式化代码  Shift+Alt+F"; function(id){
				if(editor.formatDocument()) setStatus("代码格式化完成");
				else setStatus("代码格式无需变更");
			} };
			{ "-"; null };
			{ "增加缩进  Tab"; function(id){ editor.indent() } };
			{ "减少缩进  Shift+Tab"; function(id){ editor.unindent() } };
			{ "注释/取消注释  Ctrl+/"; function(id){ editor.toggleComment() } };
			{ "-"; null };
			{ "折叠/展开  Ctrl+Shift+["; function(id){ editor.toggleFold(editor.curLine) } };
			{ "全部折叠"; function(id){
				var n = editor.foldAll();
				setStatus("已折叠 " ++ n ++ " 个区块");
			} };
			{ "全部展开"; function(id){
				editor.unfoldAll();
				setStatus("已展开全部区块");
			} };
		} };
		{ "转到";{
			{ "转到定义  F12"; function(id){ if(hooks.onGotoDefinition) hooks.onGotoDefinition() } };
			{ "查找引用  Shift+F12"; function(id){ if(hooks.onFindReferences) hooks.onFindReferences() } };
			{ "重命名  F2"; function(id){ if(hooks.onRenameSymbol) hooks.onRenameSymbol() } };
			{ "转到符号  Ctrl+Shift+T"; function(id){ showSymbolPrompt() } };
			{ "-"; null };
			{ "转到行  Ctrl+G"; function(id){ gotoLinePrompt() } };
			{ "-"; null };
			{ "切换书签  Ctrl+F2"; function(id){ editor.toggleBookmark(); setStatus("已切换当前行书签") } };
			{ "下一个书签  F2"; function(id){ if(editor.nextBookmark()) setStatus("已跳转到下一书签"); else setStatus("无更多书签") } };
			{ "上一个书签  Shift+F2"; function(id){ if(editor.prevBookmark()) setStatus("已跳转到上一书签"); else setStatus("无更多书签") } };
			{ "清除全部书签"; function(id){ editor.clearBookmarks(); setStatus("已清除全部书签") } };
			{ "-"; null };
			{ "上一个问题"; function(id){ bottomDock.setSelIndex(1) } };
			{ "下一个问题"; function(id){ bottomDock.setSelIndex(1) } };
		} };
		{ "查找";{
			{ "查找  Ctrl+F"; function(id){ editor.showFind(false) } };
			{ "替换  Ctrl+H"; function(id){ editor.showFind(true) } };
			{ "查找下一个"; function(id){ editor.findNext(editor.findText(), true) } };
			{ "查找上一个"; function(id){ editor.findPrev(editor.findText()) } };
			{ "全部替换"; function(id){
				var n = editor.replaceAll(editor.findText(), editor.replaceText());
				setStatus("已替换 " ++ n ++ " 处");
			} };
			{ "-"; null };
			{ "在工程中搜索  Ctrl+Shift+F"; function(id){ showSearchPage() } };
		} };
		{ "显示";{
			{ "控件"; function(id){ rightDock.setSelIndex(1) } };
			{ "语法"; function(id){ rightDock.setSelIndex(2) } };
			{ "标准库"; function(id){ rightDock.setSelIndex(3) } };
			{ "范例"; function(id){ rightDock.setSelIndex(4) } };
			{ "工具"; function(id){ rightDock.setSelIndex(5) } };
			{ "AI"; function(id){ rightDock.setSelIndex(6) } };
		} };
		{ "运行";{
			{ "运行  F5"; function(id){ if(hooks.onRun) hooks.onRun() } };
			{ "启动调试  F10"; function(id){ if(hooks.onDebug) hooks.onDebug() } };
			{ "单步跳过  F11"; function(id){ if(hooks.onDebugStep) hooks.onDebugStep() } };
			{ "停止调试  Ctrl+F9"; function(id){ if(hooks.onStopDebug) hooks.onStopDebug() } };
			{ "-"; null };
			{ "切换断点  F9"; function(id){ if(editor) editor.toggleBreakpoint(editor.curLine) } };
			{ "条件断点...  Shift+F9"; function(id){ if(hooks.onBpCondition) hooks.onBpCondition() } };
			{ "-"; null };
			{ "添加监视表达式..."; function(id){ if(hooks.onAddWatch) hooks.onAddWatch() } };
			{ "清空监视列表"; function(id){ if(hooks.onClearWatch) hooks.onClearWatch() } };
			{ "-"; null };
			{ "立即窗口  Ctrl+Shift+I"; function(id){ bottomDock.selectCaption("立即") } };
		} };
		{ "视图";{
			{ "属性格"; function(id){ leftDock.setSelIndex(2) } };
			{ "问题"; function(id){ bottomDock.setSelIndex(1) } };
			{ "输出"; function(id){ bottomDock.setSelIndex(2) } };
			{ "调试"; function(id){ bottomDock.setSelIndex(3) } };
			{ "终端"; function(id){ bottomDock.setSelIndex(4) } };
			{ "立即窗口"; function(id){ bottomDock.selectCaption("立即") } };
			{ "监视窗口  Ctrl+Shift+W"; function(id){ bottomDock.selectCaption("监视") } };
			{ "变量窗口"; function(id){ bottomDock.selectCaption("变量") } };
			{ "-"; null };
			{ "双栏对比"; function(id){ toggleSplitDiff() } };
			{ "下一个差异"; function(id){ if(hooks.onNextDiff) hooks.onNextDiff() } };
			{ "上一个差异"; function(id){ if(hooks.onPrevDiff) hooks.onPrevDiff() } };
			{ "-"; null };
			{ "显示行号"; function(id){
				var v = editor.toggleGutter();
				setStatus(v ? "行号栏: 已显示" : "行号栏: 已隐藏");
			} };
			{ "自动换行"; function(id){
				var w = editor.toggleWordWrap();
				setStatus(w ? "自动换行: 已开启" : "自动换行: 已关闭");
			} };
			{ "-"; null };
			{ "全屏模式  Shift+F11"; function(id){ toggleFullscreen() } };
		} };
		{ "设计";{
			{ "打开设计器"; function(id){ if(hooks.onDesigner) hooks.onDesigner() } };
			{ "-"; null };
			{ "窗体设置"; function(id){ if(hooks.onDesignerForm) hooks.onDesignerForm() } };
			{ "Tab 顺序"; function(id){ if(hooks.onDesignerTabOrder) hooks.onDesignerTabOrder() } };
			{ "显示网格线"; function(id){ if(hooks.onDesignerGrid) hooks.onDesignerGrid() } };
			{ "对齐网格"; function(id){ if(hooks.onDesignerSnap) hooks.onDesignerSnap() } };
			{ "控件吸附对齐"; function(id){ if(hooks.onDesignerAlignSnap) hooks.onDesignerAlignSnap() } };
			{ "显示边距线"; function(id){ if(hooks.onDesignerMargin) hooks.onDesignerMargin() } };
			{ "-"; null };
			{ "设计器缩放 100%"; function(id){ if(hooks.onDesignerZoom100) hooks.onDesignerZoom100() } };
			{ "设计器放大 (+25%)"; function(id){ if(hooks.onDesignerZoomIn) hooks.onDesignerZoomIn() } };
			{ "设计器缩小 (-25%)"; function(id){ if(hooks.onDesignerZoomOut) hooks.onDesignerZoomOut() } };
			{ "-"; null };
			{ "左对齐"; function(id){ if(hooks.onDesignerAlignLeft) hooks.onDesignerAlignLeft() } };
			{ "右对齐"; function(id){ if(hooks.onDesignerAlignRight) hooks.onDesignerAlignRight() } };
			{ "顶对齐"; function(id){ if(hooks.onDesignerAlignTop) hooks.onDesignerAlignTop() } };
			{ "底对齐"; function(id){ if(hooks.onDesignerAlignBottom) hooks.onDesignerAlignBottom() } };
			{ "水平居中"; function(id){ if(hooks.onDesignerAlignCenterH) hooks.onDesignerAlignCenterH() } };
			{ "垂直居中"; function(id){ if(hooks.onDesignerAlignCenterV) hooks.onDesignerAlignCenterV() } };
			{ "等宽"; function(id){ if(hooks.onDesignerSameWidth) hooks.onDesignerSameWidth() } };
			{ "等高"; function(id){ if(hooks.onDesignerSameHeight) hooks.onDesignerSameHeight() } };
			{ "-"; null };
			{ "设计撤销  Ctrl+Z"; function(id){ if(hooks.onDesignerUndo) hooks.onDesignerUndo() } };
			{ "设计重做  Ctrl+Y"; function(id){ if(hooks.onDesignerRedo) hooks.onDesignerRedo() } };
			{ "-"; null };
			{ "保存设计到源码"; function(id){ if(hooks.onDesignerSave) hooks.onDesignerSave() } };
			{ "从源码载入设计"; function(id){ if(hooks.onDesignerLoad) hooks.onDesignerLoad() } };
			{ "-"; null };
			{ "设计另存为 .dsg"; function(id){ if(hooks.onDesignerSaveAs) hooks.onDesignerSaveAs() } };
			{ "打开 .dsg 文件"; function(id){ if(hooks.onDesignerOpen) hooks.onDesignerOpen() } };
		} };
		{ "设置";{
			{ "主题（重启后生效）";{
				{ __themeDark; function(id){ if(hooks.onSetTheme) hooks.onSetTheme("dark") } };
				{ __themeLight; function(id){ if(hooks.onSetTheme) hooks.onSetTheme("light") } };
			} };
			{ "编辑器字体大小...  (6-24 pt)"; function(id){ if(hooks.onEditorFontSize) hooks.onEditorFontSize() } };
			{ "-"; null };
			{ "添加外部工具..."; function(id){ if(hooks.onAddExternalTool) hooks.onAddExternalTool() } };
			{ "删除外部工具..."; function(id){ if(hooks.onDelExternalTool) hooks.onDelExternalTool() } };
			{ "-"; null };
			{ "打开配置文件..."; function(id){ if(hooks.onOpenConfigFile) hooks.onOpenConfigFile() } };
		} };
		{ "帮助";{
			{ "关于"; function(id){ ..win.msgbox("Nodio IDE\n自托管 aardio 风格 IDE","Nodio") } };
		} };
	};
	titlebar.setMenus(menusDef);

	// 最近文件变化后重建「文件」菜单（openFile 成功后由 main.nodio 调）
	refreshRecentMenu = function(){
		if(!menusDef || !#menusDef) return;
		menusDef[1] = { "文件"; buildFileMenuItems() };
		titlebar.setMenus(menusDef);
	}
	// 供回归：当前「文件」菜单里的条目文本（含最近文件动态段）
	fileMenuLabels = function(){
		var out = {};
		if(!menusDef || !menusDef[1] || !menusDef[1][2]) return out;
		for(i=1;#menusDef[1][2];1){
			..table.push(out, tostring(menusDef[1][2][i][1] : ""));
		}
		return out;
	}
	// 供回归：**全部**菜单的条目文本（各顶级菜单的条目拼在一起）。
	// 「立即窗口」这类入口只存在于菜单表里，外部看不到 —— 用它把入口锁住。
	// （裸赋值进模块表，同 fileMenuLabels —— 见上方 dockHasTab 的坑注释）
	menuLabels = function(){
		var out = {};
		if(!menusDef || !#menusDef) return out;
		for(m=1;#menusDef;1){
			var items = menusDef[m][2];
			if(!items || !#items) continue;
			for(i=1;#items;1){
				..table.push(out, tostring(items[i][1] : ""));
			}
		}
		return out;
	}
	// 启动时把 cfg 里已有的最近文件落进「文件」菜单
	refreshRecentMenu();

	// 钩子自检（诊断模式）：钩子必须**真的**被 main.nodio 灌上了。
	//
	// ⚠ 这里为什么用 hooks 表而不是模块级裸变量：
	//   引擎里模块体的裸赋值只是**模块帧的局部变量**，外部
	//   `app.shell.onX = f` 写的是**模块表的成员** —— 两者不是同一格，
	//   模块内部读裸名字时被局部变量遮蔽 → 钩子永远是 null，
	//   工具条/菜单/快捷键/工程树**整片是死的**。
	//   放进表里就绕开了遮蔽：表是同一个对象，谁改都看得见。
	if( ..string.getenv("NODIO_IDE_DIAG") ){
		var hkNames = {"onOpenProject";"onOpenFile";"onNewFile";"onSave";"onSaveAs";
			"onSaveAll";"onCloseTab";"onDocChange";"onRun";"onDebug";"onDebugStep";"onStopDebug";
			"onDesigner";"onDesignerSave";"onDesignerLoad";"onDesignerSaveAs";"onDesignerOpen";
			"onDesignerForm";"onDesignerSnap";"onDesignerMargin";
			"onAfterLayout";"onTabChange";"onGotoDefinition";
			"onFindReferences";"onRenameSymbol";"onGotoSymbol";"onCursorMove";
			"onProjNewFile";"onProjNewDir";"onProjRename";"onProjDelete";"onProjSetStart"};
		var hkMissing = "";
		var hk;
		for(hk=1;#hkNames;1){
			if(!hooks[hkNames[hk]]) hkMissing = hkMissing ++ hkNames[hk] ++ " ";
		}
		// ⚠ aardio 里**空串是真值**（只有 null/false 为假），
		//   所以判空要用 #hkMissing == 0，不能写 if(hkMissing)。
		if(#hkMissing) io.print("DIAG hooks: MISSING: " ++ hkMissing);
		else io.print("DIAG hooks: all " ++ tostring(#hkNames) ++ " ok");
	}

	// tree double-click opens the file (main.onOpenFile resolves the node)
	projTree.onOpen = function(path, node){
		if(hooks.onOpenFile) hooks.onOpenFile(path);
	}
	projTree.onSelect = function(path, node){
		if(path) setPosStatus(path);
	}
	// 工程树右键菜单：官方 win.ui.tracker 的 onContextMenu（屏幕坐标），
	// 自绘树的 nodeAt 定位光标下的节点。
	// 菜单项：打开 / 复制路径 / 新建文件 / 新建目录 / 重命名 / 删除 / 设为启动文件。
	// 分隔线：add(null,null) —— 官方 menubase.add 见到空标题就插 MF_SEPARATOR。
	var treeMenu = win.ui.popmenu(winform);
	var idTreeOpen = treeMenu.add("打开", null);
	var idTreeCopy = treeMenu.add("复制路径", null);
	treeMenu.add(null, null);
	var idTreeNewFile = treeMenu.add("新建文件...", null);
	var idTreeNewDir = treeMenu.add("新建目录...", null);
	treeMenu.add(null, null);
	var idTreeRename = treeMenu.add("重命名...", null);
	var idTreeDelete = treeMenu.add("删除", null);
	treeMenu.add(null, null);
	var idTreeStart = treeMenu.add("设为启动文件", null);
	projTree.onContextMenu = function(x,y){
		var node = projTree.nodeAt(x,y);
		if(!node) node = projTree.selectedNode();
		if(!node) return;
		var path = projTree.pathOf(node);
		if(!path) return;
		var id = treeMenu.popId();
		if(!id) return;
		if(id == idTreeOpen){
			if(hooks.onOpenFile) hooks.onOpenFile(path);
		}
		elseif(id == idTreeCopy){
			win.clip.write(path);
			setStatus("已复制路径: " ++ path);
		}
		elseif(id == idTreeNewFile){
			// 新文件落在「光标节点的所在目录」：目录节点就是它自己，
			// 文件节点是它的父目录（projTree.dirOf 统一处理）
			if(hooks.onProjNewFile) hooks.onProjNewFile(projTree.dirOf(node));
		}
		elseif(id == idTreeNewDir){
			if(hooks.onProjNewDir) hooks.onProjNewDir(projTree.dirOf(node));
		}
		elseif(id == idTreeRename){
			if(hooks.onProjRename) hooks.onProjRename(path);
		}
		elseif(id == idTreeDelete){
			if(hooks.onProjDelete) hooks.onProjDelete(path);
		}
		elseif(id == idTreeStart){
			if(hooks.onProjSetStart) hooks.onProjSetStart(path);
		}
	}

	// page switches
	leftDock.onSelChange   = function(i, page){ setStatus("工程面板: " ++ i) }
	rightDock.onSelChange  = function(i, page){ setStatus("工具面板: " ++ i) }
	bottomDock.onSelChange = function(i, page){
		setStatus("输出面板: " ++ i);
		// 切到「立即」页签时自动聚焦输入框：
		// 否则用户点了页签还得再点一下输入框才能打字，白白多一步。
		if(page && page.ctrl == imEd){
			try{ imEd.setFocus() }catch(eFocus){}
		}
	}

	// the editor tab strip drives the document model
	docStrip.onSelect = function(idx){
		if(idx >= 1 && idx <= #tabOrder){
			tabSel(tabOrder[idx]);
			// 大纲等派生视图跟着换文档
			if(hooks.onTabChange) hooks.onTabChange(curTab);
		}
	}
	// 点 × 关闭页签（脏文档要先经过 hooks.onCloseTab 的确认）
	docStrip.onClick = function(idx, closeHit){
		if(closeHit && idx >= 1 && idx <= #tabOrder){
			if(hooks.onCloseTab) hooks.onCloseTab(tabOrder[idx]);
			else tabClose(tabOrder[idx]);
		}
	}

	// 页签右键菜单：关闭 / 关闭其他 / 关闭全部 / 复制路径 / 定位
	var tabMenu = win.ui.popmenu(winform);
	var idTabClose = tabMenu.add("关闭标签页", null);
	var idTabCloseOthers = tabMenu.add("关闭其他标签页", null);
	var idTabCloseAll = tabMenu.add("关闭全部标签页", null);
	tabMenu.add(null, null);
	var idTabCopyPath = tabMenu.add("复制完整路径", null);
	var idTabReveal = tabMenu.add("在资源管理器中定位", null);

	docStrip.onRightClick = function(idx, x, y){
		if(idx < 1 || idx > #tabOrder) return;
		var path = tabOrder[idx];
		tabSel(path);
		var id = tabMenu.popId();
		if(!id) return;
		if(id == idTabClose){
			if(hooks.onCloseTab) hooks.onCloseTab(path);
			else tabClose(path);
		}
		elseif(id == idTabCloseOthers){
			if(hooks.onCloseOtherTabs) hooks.onCloseOtherTabs(path);
			else closeOtherTabs(path);
		}
		elseif(id == idTabCloseAll){
			if(hooks.onCloseAllTabs) hooks.onCloseAllTabs();
			else closeAllTabs();
		}
		elseif(id == idTabCopyPath){
			win.clip.write(path);
			setStatus("已复制路径: " ++ path);
		}
		elseif(id == idTabReveal){
			if(hooks.onRevealInExplorer) hooks.onRevealInExplorer();
		}
	};

	// 状态栏点击交互：点「行,列」直接弹出「转到行」
	statusbar.onPanelClick = function(idx, name){
		if(idx == 2 || name == "行,列"){
			gotoLinePrompt();
		}
	};

	// re-layout on resize
	//
	// ⚠⚠⚠ **必须合并，不能每个 WM_SIZE 都全量重排**：
	//   一次 layout = 布局 15ms + redrawAll 94ms = **110ms 同步阻塞**
	//   （实测：27 块画板逐块「整块失效 + 立即上屏」，其中 6 块各 15~16ms）。
	//   拖动窗口大小时 Windows 连发几十个 WM_SIZE —— 每个都阻塞 110ms
	//   ⇒ 界面「跳来跳去」、卡成幻灯片、满屏闪。
	//
	//   改法：onSize 只**记下**目标尺寸，真正的重排交给一个 50ms 的合并定时器：
	//   拖拽期间几十个 WM_SIZE 被合并成十几次重排；拖完后再补一次最终的。
	var __pendingW = 0, __pendingH = 0, __layoutTimer = null;
	var __flushLayout = function(){
		if(__layoutTimer){
			try{ winform.clearInterval(__layoutTimer) }catch(e0){}
			__layoutTimer = null;
		}
		var pw = __pendingW, ph = __pendingH;
		__pendingW = 0; __pendingH = 0;
		if(pw && ph) layout(pw, ph);
	};
	winform.onSize = function(w,h){
		__pendingW = w; __pendingH = h;
		if(__layoutTimer) return;          // 已经在排队了 → 合并到同一拍
		// 拖拽中的合并窗口放宽到 120ms：拖拽时每 16ms 一个 WM_SIZE，
		// 50ms 一次 flush 意味着每次 flush 的布局工作量（~100ms）比间隔还长，
		// 消息队列永远在堆积 —— 表现就是窗口拖不动。放宽后 flush 间隔
		// 大于工作耗时，队列能排干，窗口跟手。
		var ms = ..nodio.ui.inSizeMove() ? 120 : 50;
		__layoutTimer = winform.setTimeout(function(){
			__layoutTimer = null;
			__flushLayout();
			return null;                   // ⚠ 官方 setTimeout 回调必须显式返回 null
		}, ms);
	}
	winform.adjust = function(cx, cy, wParam){
		if(wParam != 1/*_SIZE_MINIMIZED*/) winform.onSize(cx, cy);
	}
	// 拖拽开始/结束（WM_ENTERSIZEMOVE 0x231 / WM_EXITSIZEMOVE 0x232）：
	//   开始 → nodio.ui.setSizeMove(true)，layout 收尾不再逐块强制上屏，
	//          成帧交给合成器；合并窗口放宽。
	//   结束 → 立刻 flush（用最终尺寸补一帧）+ 全量重画收口。
	titlebar.onFormMsg = function(hwnd, msg, wp, lp){
		if(msg == 0x231){
			..nodio.ui.setSizeMove(true);
			return null;
		}
		if(msg == 0x232){
			..nodio.ui.setSizeMove(false);
			__flushLayout();
			try{ ..nodio.ui.redrawAll() }catch(e4){}
			return null;
		}
		return null;
	}
	// 供外部（心跳/关闭前）强制立刻重排
	flushLayout = function(){
		__flushLayout();
	}
	layout();
}
