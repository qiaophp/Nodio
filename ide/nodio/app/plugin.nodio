// app/plugin.nodio — IDE 插件注册与生命周期管理机制
//
// 对应官方 extensions/plugin/pane 与 extensions/plugin/view 契约：
//   1. 插件注册表（registry）：维护插件名称、脚本路径、形态（pane/view）、图标、元数据；
//   2. 目录扫描（scan）：自动发现内置 plugins/ 及官方 extensions/plugin 插件并注册；
//   3. 宿主加载契约（createView）：机械替换尾部 win.loopMessage() 为 null;，
//      通过 loadcode 动态执行并注入 parent=container 参数；
//   4. 显示与切换（showView）：激活对应停靠栏或主视图页签。

namespace app.plugin{

var __registry = {};

register = function(name, path, opt){
	if(!name || !path) return false;
	var pi = ..io.splitpath(path);
	var item = {
		name = name;
		path = ..io.fullpath(path);
		type = (opt && opt.type) ? opt.type : "pane";
		title = (opt && opt.title) ? opt.title : name;
		icon = (opt && opt.icon) ? opt.icon : null;
		description = (opt && opt.description) ? opt.description : "";
		loaded = false;
	};
	__registry[name] = item;
	return true;
};

unregister = function(name){
	if(!name || !__registry[name]) return false;
	__registry[name] = null;
	return true;
};

get = function(name){
	return __registry[name];
};

list = function(){
	var arr = {};
	for(k, v in __registry){
		..table.push(arr, v);
	}
	return arr;
};

count = function(){
	var n = 0;
	for(k, v in __registry) n++;
	return n;
};

scan = function(dir, opt){
	if(!dir || !..io.exist(dir)) return 0;
	var type = (opt && opt.type) ? opt.type : "pane";
	var files = ..io.listFiles(dir, "*.nodio") : {};
	var added = 0;
	for(i=1; #files; 1){
		var f = files[i];
		if(f && !f.isDir && f.path){
			var pi = ..io.splitpath(f.path);
			var name = pi ? pi.name : null;
			if(name && !__registry[name]){
				if(register(name, f.path, { type = type; title = name })){
					added++;
				}
			}
		}
	}
	var afiles = ..io.listFiles(dir, "*.aardio") : {};
	for(i=1; #afiles; 1){
		var f = afiles[i];
		if(f && !f.isDir && f.path){
			var pi = ..io.splitpath(f.path);
			var name = pi ? pi.name : null;
			if(name && !__registry[name]){
				if(register(name, f.path, { type = type; title = name })){
					added++;
				}
			}
		}
	}
	return added;
};

createView = function(name, path, container){
	if(!name) return false;
	var item = __registry[name];
	var targetPath = path : (item ? item.path : null);
	if(!targetPath || !..io.exist(targetPath)) return false;

	var code = ..string.load(targetPath);
	if(!code) return false;

	var tok = "win.loopMessage()";
	var p = ..string.indexOf(code, tok);
	while(p){
		code = ..string.left(code, p - 1) ++ "null;" ++ ..string.slice(code, p + 17);
		p = ..string.indexOf(code, tok);
	}

	var fn = loadcode(code);
	if(!fn) return false;

	try{
		fn(container);
		if(item) item.loaded = true;
		return true;
	}catch(e){
		return false;
	}
};

}
