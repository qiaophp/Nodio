// Nodio IDE — assembly point.
//
// The shell, project model, runner, designer and the language/debug clients
// live in app/*.nodio; this file only wires them together and enters the
// message loop. The IDE is its own project: ide.nproj.
import win.ui;
import app.settings;
// ⚠ 主题必须在 app.shell **之前**应用：各 chrome 组件都是**构造期**读一次
// theme() 把配色存进自己的字段（nodio.ui.list / tree / tabstrip / toolbar /
// statusbar / titlebar …），构造完再切主题就得重建整排 chrome。
// 官方 aardio 同样是「换主题重开 IDE」。
app.settings.themeApply();
import app.shell;
import app.output;
import app.editor;
import app.project;
import app.runner;
import app.designer;
import app.library;
import app.lspClient;
import app.dapClient;
import nodio.designer.registry;
import nodio.intellisense;   // 第五十一轮：官方 intellisense 词库（补全并入）
import nodio.ui.dpi;
import nodio.ui.board;   // nodio.ui.redrawAll（窗口显示后统一强制重画）
import nodio.ui.startPane;   // 第五十三轮：开始页（无文档时的落地页）
import nodio.ui.rect;    // nodio.ui.setCtrlText（AI 面板冒烟要往输入框写字）
import nodio.ai.cred;    // AI 面板冒烟：隔离凭据名 + 写/删测试 Key
import app.ideCommand;   // 官方 ide.command 37 命令外部命令面
import raw;

// ---------- 启动期：延迟绘制（防满屏闪）----------
//
// 窗体在 app.shell 的模块体里就 show 了（那 27 块画板会各上一次屏），
// 之后官方窗体还要做 DPI 初始化、去掉原生标题栏、再最大化 ——
// 客户区连跳 3 次（1281×821 → 1943×1287 → 3840×2160），
// 每次跳变都触发一次全量重排 + 27 块画板各**强制上屏**一次：
// 上百次上屏 = 用户看到的「满屏闪」。
//
// 这里把这段时间的绘制**全部压掉**（只置脏不上屏），
// 启动代码跑完再统一画**最终一帧** ⇒ 窗口一出现就是最终样子。
//
// ⚠ 为什么不能改成「一次 RedrawWindow 批量成帧」：
//   官方 plus 的 WM_PAINT 用「本次失效区」当裁剪区，
//   父窗口先画背景会把子控件的更新区吃掉 ⇒ 子控件裁剪区为空 = 什么都没画
//   （实测：标题栏/工具条/停靠面板整片消失）。详见 lib/nodio/ui/board.aardio。
..nodio.ui.setDeferredPaint( !..string.getenv("NODIO_IDE_NODEFER") );

// ---------- 启动计时（诊断用）----------
//
// 回答「IDE 打开要 1 秒，花在哪」：
//   · bootT0 是**所有模块 import 完**的时刻（import = 编译 aardio 源码，最贵的一段）
//   · 每一拍（fillLibrary / 工程 / 打开文件 / LSP）单独计时
// 绝对值用 GetTickCount，和外部 bench 脚本同钟可比。
var bootT0 = ..time.tick();
var bootMark = function(tag){
	if( ..string.getenv("NODIO_IDE_DIAG") ){
		io.print("DIAG boot " ++ tag ++ " at=" ++ tostring(..time.tick())
			++ " since-import=" ++ tostring(..time.tick() - bootT0) ++ "ms");
	}
};


var NODIO_EXE = ..string.getenv("NODIO_EXE") : "nodio.exe";

// 测试 / 演示模式：启动流程要**同步**跑完（冒烟测试与截图回归
// 依赖「起来就是那样」）。正常启动走的是分阶段异步加载（见 bootTick）。
var isTestMode = ( ..string.getenv("NODIO_IDE_SMOKE") )
	|| ( ..string.getenv("NODIO_IDE_NAV_SMOKE") )
	|| ( ..string.getenv("NODIO_IDE_DEMO") );

// LSP / DAP 可执行文件是 nodio.exe **同目录**下的 nodio-lsp.exe / nodio-dap.exe。
// ⚠ 不能用 NODIO_EXE ++ "-lsp" 拼：NODIO_EXE 本身就带 .exe，拼出来是
//   "nodio.exe-lsp"（不存在）→ popen 失败 → LSP / 调试器**从来没起来过**。
var NODIO_DIR = ..io.splitpath(NODIO_EXE).dir;
if(!NODIO_DIR) NODIO_DIR = "";
var LSP_EXE   = NODIO_DIR ++ "nodio-lsp.exe";
var DAP_EXE   = NODIO_DIR ++ "nodio-dap.exe";
if( ..string.getenv("NODIO_IDE_DIAG") ){
	io.print("DIAG lsp=" ++ LSP_EXE ++ " dap=" ++ DAP_EXE);
}

// ---------- wiring ----------
var shell  = app.shell;
var outCtl = app.output.create(shell.outEd);
var runner = app.runner.create(shell.winform, NODIO_EXE, outCtl, shell.setStatus);

var proj    = null;   // current project model (app.project)
var curFile = null;   // file loaded in the editor

// ---------- designer ----------
// The design canvas lives over the editor; the toolbox is the right dock's
// 控件 page and the property grid the left dock's 属性 page.
var designer = app.designer.create(shell);

// ---------- 开始页（第五十三轮） ----------
// 无文档时盖在编辑区上的落地页：标题 + 最近文件。可见性由心跳按页签数
// 驱动，矩形跟随编辑区（与设计器画布同款）；recent 变化才重建树。
var startPane = nodio.ui.startPane(shell.winform, {left=0;top=0;right=0;bottom=0});
startPane.onOpenFile = function(path){
	if(shell.hooks.onOpenFile) shell.hooks.onOpenFile(path);
};
var startPaneLastRecent = "";
var updateStartPane = function(){
	var w,h = shell.clientWH();
	var er = shell.editorRect(w,h);
	startPane.layout(er.left, er.top + shell.docTabH(), er.right, er.bottom);
	var list = app.settings.recentGet();
	var sig = "";
	for(i=1;#list;1){ sig = sig ++ list[i] ++ "|" }
	if(sig != startPaneLastRecent){
		startPaneLastRecent = sig;
		startPane.setRecent(list);
	}
	startPane.show(#shell.tabOrder == 0);
};

// ---------- LSP ----------
//
// LSP 服务端持有**整个工程**的符号索引：
//   · 转到定义（F12）      —— 跨文件找定义
//   · 查找引用（Shift+F12）—— 跨文件找引用
//   · 跨文件重命名（F2）
//   · 项目符号搜索
// 所以启动后要把**工程根目录 + 源文件清单**发给它；
// 换标签页时也要把当前文档切过去（openDoc），不能只跟一个文档 ——
// 之前只有一个 uri，切文件后补全/诊断都落到错的文档上。
var lspTimer = null;
var lspProjectSent = false;

// 把工程文件清单交给 LSP（建立项目级符号索引）
//
// ⚠ files 必须是**数组**表：JSON.stringify 只把带 _type="array" 的表
//   当数组输出，普通表会被写成对象。
var lspSendProject = function(){
	if(!app.lspClient.isRunning()) return;
	if(!proj || !proj.root || !projFiles) return;
	var files = [ @{_type="array"} ];
	for(i=1;#projFiles;1){
		var f = projFiles[i];
		var ext = ..string.lower(..io.splitpath(f.full).ext);
		if(ext == ".nodio" || ext == ".aardio"){
			..table.push(files, f.path);
		}
	}
	app.lspClient.setProject(proj.root, files);
	lspProjectSent = true;
};

var lspEnsure = function(){
	if(!app.lspClient.isRunning()){
		if(!curFile) return;
		var r = app.lspClient.start(LSP_EXE, curFile, shell.tabGetText(curFile));
		if(r != "ok"){ shell.setStatus("LSP 启动失败"); return }
		lspProjectSent = false;
	}
	if(!lspProjectSent) lspSendProject();
};
// ⚠ 心跳每 300ms 都会调一次同步，**文档没改就不要送**：
//   didChange 会把整篇文本发给 LSP 服务端，67KB 的文件每 300ms 送一次
//   = 持续不断的 IPC + 服务端重新分析 —— 「一动鼠标就卡一下」的大头。
var lspLastText = null;
var lspSync = function(){
	if(!curFile || !app.lspClient.isRunning()) return;
	var txt = shell.tabGetText(curFile);
	if(txt === null || txt === undefined) return;
	if(txt === lspLastText) return;
	lspLastText = txt;
	app.lspClient.didChange(txt);
};
// 当前文档的诊断（喂给编辑器画槽内标记）
var editorDiags = {};// 代码补全：编辑器算好前缀 → 这里问 LSP 要候选 → 交回编辑器弹浮层
//
// ⚠ lspClient.completion 是**同步阻塞**的（最多等 1 秒）。
//   本地 LSP 正常 ~20~40ms 就回；服务器没起来时最多卡 1 秒。
shell.editor.onComplete = function(line, col, prefix){
	var items = null;
	if(app.lspClient.isRunning()){
		items = app.lspClient.completion(line - 1, col - 1);
	}
	// 第五十一轮：官方词库条目并入（config/intellisense kernel/winform.txt
	// 经 nodio.intellisense 解析，前缀过滤）。LSP 结果优先，词库补差集。
	try{
		var lib = nodio.intellisense.complete(prefix : "");
		if(lib && #lib){
			var merged = {};
			var seen = {};
			if(items) for(k,v in items){ seen[v.label] = true; ..table.push(merged, v) }
			for(k,v in lib){
				if(seen[v.label]) continue;
				seen[v.label] = true;
				..table.push(merged, v);
			}
			items = merged;
		}
	}catch(eLib){}
	if(!items || !#items){
		items = {
			{label="function"; kind=14; detail="keyword"};
			{label="var"; kind=14; detail="keyword"};
			{label="import"; kind=14; detail="keyword"};
			{label="return"; kind=14; detail="keyword"};
			{label="if"; kind=14; detail="keyword"};
			{label="else"; kind=14; detail="keyword"};
			{label="elseif"; kind=14; detail="keyword"};
			{label="while"; kind=14; detail="keyword"};
			{label="for"; kind=14; detail="keyword"};
			{label="class"; kind=14; detail="keyword"};
			{label="try"; kind=14; detail="keyword"};
			{label="catch"; kind=14; detail="keyword"};
		};
	}
	if(!items || !#items){
		shell.editor.hideCompletion();
		return;
	}
	shell.editor.showCompletion(items);
};
// 悬停提示：编辑器算出鼠标下的词 → 这里问 LSP → 交回编辑器弹浮层
//
// ⚠ lspClient.hover 是**同步阻塞**的（最多等 50ms）。
//   组件侧已经做了两件事保证不卡：
//   ① 只在鼠标**停住 350ms** 之后才问；
//   ② 提问放到定时器里，不在窗口过程里做。
shell.editor.onHover = function(line, col, qual, word){
	// ① 官方词库优先（LSP 侧 hover 只回 "**词名** + 类型"，没有说明文字；
	//    官方 API 的中文文档**只存在于词库**里）。
	//    qual = 词的限定符（"winform."），用来在多个同名成员里定位那一条。
	try{
		var key = (qual : "") ++ (word : "");
		if(#key){
			var libTxt = nodio.intellisense.hover(key);
			if(libTxt && #libTxt) return tostring(libTxt);
		}
	}catch(eLib){}
	// ② LSP（用户自己写的符号，只有 LSP 知道它的类型）
	if(!app.lspClient.isRunning()) return "";
	var txt = app.lspClient.hover(line - 1, col - 1);
	if(txt === null || txt === undefined) return "";
	return tostring(txt);
};
// 代码导航：转到定义 / 查找引用 / 重命名
//
// 编辑器组件负责按键（F12 / Shift+F12 / F2 / Ctrl+点击），
// 并且已经把这些动作**推迟到定时器**（问 LSP 是同步阻塞的，
// 在窗口过程里做会卡住整个窗口过程）。
shell.editor.onDefinition = function(line, col, word){
	navGotoDefinition(line, col, word);
};
shell.editor.onReferences = function(line, col, word){
	navFindReferences(line, col, word);
};
shell.editor.onRename = function(line, col, word){
	navRenameSymbol(line, col, word);
};
// 引用标记：光标在符号上停留 ~300ms → 编辑器这里回调 → 问 LSP 拿
// 本文档里同一符号的全部出现 → 喂回编辑器垫亮背景。
// ⚠ documentHighlight 同样是同步阻塞（最多 100ms），但触发点在
//   setTimeout 里（编辑器 __scheduleHighlight），不在窗口过程里。
shell.editor.onHighlight = function(line, col, word){
	if(!app.lspClient.isRunning()) return;
	var hl = app.lspClient.documentHighlight(line - 1, col - 1);
	if(hl === null || hl === undefined) hl = {};
	if( ..string.getenv("NODIO_IDE_DIAG") ){
		io.print("DIAG onHighlight word=" ++ tostring(word)
			++ " marks=" ++ tostring(#hl));
	}
	shell.editor.setHighlights(hl);
};
// 菜单入口（键盘之外的路径）：以当前光标位置为准
shell.hooks.onGotoDefinition = function(){
	var w = shell.editor.__wordAtPos ? shell.editor.__wordAtPos(shell.editor.__caretPos()) : null;
	if(!w || !w.word){ shell.setStatus("光标处没有符号"); return }
	navGotoDefinition(w.line, w.col, w.word);
};
shell.hooks.onFindReferences = function(){
	var w = shell.editor.__wordAtPos ? shell.editor.__wordAtPos(shell.editor.__caretPos()) : null;
	if(!w || !w.word){ shell.setStatus("光标处没有符号"); return }
	navFindReferences(w.line, w.col, w.word);
};
shell.hooks.onRenameSymbol = function(){
	var w = shell.editor.__wordAtPos ? shell.editor.__wordAtPos(shell.editor.__caretPos()) : null;
	if(!w || !w.word){ shell.setStatus("光标处没有符号"); return }
	navRenameSymbol(w.line, w.col, w.word);
};
var lastDiagsSig = "";
var lspPoll = function(){
	if(!app.lspClient.isRunning()) return;
	var ds = app.lspClient.getDiags();
	var n = #ds;
	var sig = tostring(curFile) ++ ":" ++ n;
	if(n > 0){
		var d0 = ds[1];
		var dn = ds[n];
		sig = sig ++ ":" ++ d0.line ++ ":" ++ d0.msg ++ ":" ++ dn.line ++ ":" ++ dn.msg;
		shell.setStatus("诊断: " ++ n ++ " 项 — 行 " ++ (d0.line + 1) ++ ": " ++ d0.msg);
	}
	else if(shell.statusIdleAllowed()){
		// 空闲态只在**没有**待展示的用户消息时才写，
		// 否则用户操作后的反馈 300ms 就被抹掉（表现为「点了没反应」）。
		shell.setStatus("就绪");
	}
	// 诊断无变化时直接跳过列表和波浪线重绘，避免心跳每 300ms 无脑重绘 UI
	if(sig == lastDiagsSig) return;
	lastDiagsSig = sig;

	// 问题列表（自绘 nodio.ui.list）：行 / 级别 / 说明
	// tag 里带上文件路径和行号 —— 双击能跳到出错那一行。
	var rows = {};
	for(i=1;#ds;1){
		var d = ds[i];
		var sev = d.sev : 1;
		var sevText = "错误", sevIcon = "times";
		if(sev == 2){ sevText = "警告"; sevIcon = "warning" }
		elseif(sev == 3){ sevText = "信息"; sevIcon = "info" }
		elseif(sev == 4){ sevText = "提示"; sevIcon = "question" }
		..table.push(rows, {
			cells = {tostring(d.line + 1); sevText; d.msg};
			icon = sevIcon;
			tag = {path = curFile; line = d.line + 1};
		});
	}
	shell.probList.setRows(rows);
	// 槽内标记：当前文档的诊断交给编辑器（波浪线 + 行号栏圆点）
	editorDiags = {};
	if(curFile && shell.tabCurPath() == curFile){
		for(i=1;#ds;1){
			var d = ds[i];
			..table.push(editorDiags, {
				line = d.line + 1;
				col = d.col : 0;
				endLine = (d.endLine : d.line) + 1;
				endCol = d.endCol : (d.col : 0);
				msg = d.msg;
				sev = d.sev : 1;
			});
		}
	}
	shell.editor.setDiagnostics(editorDiags);
};

// ---------- 代码导航：转到定义 / 查找引用 / 重命名 ----------
//
// ⚠ 这三个动作都要**同步**问 LSP（最多 1 秒），绝不能放在按键处理里 ——
//   编辑器组件已经用定时器把它们从窗口过程里推迟出来了。

// 相对工程根的短路径（引用面板 / 状态栏里显示用）
var navShortPath = function(path){
	if(!path) return "";
	if(proj && proj.root){
		var r = app.project.relPath(proj, path);
		if(r) return r;
	}
	var pi = ..io.splitpath(path);
	return pi.name ++ (pi.ext : "");
};

// 跳到某个文件的某行某列（列是 1 基）
var jumpTo = function(path, line, col){
	if(!path) return false;
	if(shell.tabCurPath() != path){
		if(!openFile(path)) return false;
	}
	if(line) shell.editor.gotoLineCol(line, col ? col : 1);
	shell.editor.setFocus();
	return true;
};

// ---------- 导航栏（面包屑）----------
//
// VS 的导航栏：编辑区正上方一条，跟着光标显示
// 「工程 › 目录 › 文件 › 命名空间 › 函数」，点哪一段就跳到哪一段。
// 一眼看出自己在**整个项目**的哪个位置 —— VS 体感的关键一环。
//
// 数据来源：LSP 的 documentSymbol（**层级树**）。
// ⚠ 层级链是**本地**算的：符号树只在文档变化时重新问一次 LSP，
//   光标移动只做纯内存遍历 —— 每动一下都同步问一次 LSP 会把编辑器卡死。
var curSymTree = [ @{_type="array"} ];   // 当前文档的符号树
var symTreeDirty = false;                // 符号树要重新拉

// 模块路径段：工程名 / 目录 / 文件
var navModuleSegs = function(path){
	var out = [ @{_type="array"} ];
	var i;
	if(!path) return out;
	if(proj && proj.root){
		// 工程根自带一个尾部分隔符（"D:\a\b\"），直接 splitpath 拿不到名字 ——
		// 先把尾部的分隔符去掉。
		// ⚠⚠ aardio 的 s[i] 取出来是**字节值**（数字），不是 1 字符的串！
		//   所以 t[#t] == '\\' 永远不成立（数字 vs 字符串）——
		//   必须跟字节值比：'\' = 92，'/' = 47。
		var rootTrim = proj.root;
		while(#rootTrim > 1 &&
			(rootTrim[#rootTrim] == 92 || rootTrim[#rootTrim] == 47)){
			rootTrim = ..string.left(rootTrim, #rootTrim - 1);
		}
		var pn = ..io.splitpath(rootTrim).name;
		if(pn && #pn) ..table.push(out, {text = pn; kind = "dir"});
	}
	var rel = navShortPath(path);
	if(!rel) rel = path;
	rel = ..string.replaceLiteral(rel, "/", '\\');
	var ps = ..string.split(rel, '\\');
	var last = #ps;
	for(i=1;last;1){
		var seg = ps[i];
		if(!seg || #seg == 0) continue;
		..table.push(out, {
			text = seg;
			kind = (i == last) ? "file" : "dir";
			path = path;
		});
	}
	return out;
}

// 从符号树里找「包含该行的最内层符号」，返回从外到内的链
//
// 判定用**包含**（line <= 光标行 <= endLine），不是「在它上面」：
// 只看起始行的话，光标停在一个刚结束的函数**之后**的顶层语句上时，
// 会被误算成「还在那个函数里」。
//
// 只有**作用域类**符号（命名空间 / 类 / 函数）才算外层；
// 变量不是作用域（kind 13 = Variable）。
var navSymChain = function(tree, line){
	var chain = [ @{_type="array"} ];
	var walk = function(nodes){
		var i, n;
		var pick = null;
		if(!nodes) return null;
		for(i=1;#nodes;1){
			n = nodes[i];
			if(n.kind == 13) continue;              // 变量不是作用域
			if(n.line <= line && line <= n.endLine) pick = n;
		}
		if(!pick) return null;
		..table.push(chain, pick);
		return walk(pick.children);
	}
	walk(tree);
	return chain;
}

// 拼出完整的面包屑：工程 › 目录 › 文件 › 符号链
var navBuildChain = function(line){
	var chain = [ @{_type="array"} ];
	var i, n;
	var ms = navModuleSegs(curFile);
	for(i=1;#ms;1) ..table.push(chain, ms[i]);
	var sc = navSymChain(curSymTree, line);
	for(i=1;#sc;1){
		n = sc[i];
		var nm = n.name;
		// 命名空间/类的名字是**全限定名**（app.editor），
		// 面包屑里只显示最后一段（前面的层级已经由目录/文件名体现了）
		var dot = ..string.indexOf(nm, '.');
		if(dot) nm = ..string.slice(nm, dot + 1);
		..table.push(chain, {
			text = nm;
			kind = "symbol";
			line = n.line;
			col = n.col;
		});
	}
	return chain;
}

// 光标移动 → 刷新导航栏
var navLastLine = 0;
var navUpdate = function(line){
	if(!line) line = 1;
	navLastLine = line;
	shell.editor.setNavChain(navBuildChain(line));
}

// 拉一次符号树（同步阻塞，最多 50ms —— 放在心跳里，不在按键路径上）
var navRefreshSymTree = function(){
	symTreeDirty = false;
	if(!app.lspClient.isRunning() || !curFile) return;
	curSymTree = app.lspClient.symbols();
	navUpdate(shell.editor.curLine);
}

// 点导航栏的一段 → 跳过去
shell.editor.onNavClick = function(seg){
	if(!seg) return;
	if(seg.kind == "symbol"){
		shell.editor.gotoLineCol(seg.line, (seg.col : 0) + 1);
		shell.editor.setFocus();
		return;
	}
	if(seg.kind == "file"){
		shell.setStatus("当前文件: " ++ navShortPath(seg.path));
		return;
	}
};
// 光标移动 → 导航栏跟着走
// （行号没变就不重算：onCursor 每 250ms 就会回调一次）
shell.hooks.onCursorMove = function(line, col){
	if(line == navLastLine) return;
	navUpdate(line);
};

// 转到定义（F12 / Ctrl+点击）
var navGotoDefinition = function(line, col, word){
	if(!app.lspClient.isRunning()){
		shell.setStatus("LSP 未运行，无法转到定义");
		return;
	}
	var list = app.lspClient.definition(line - 1, col - 1);
	if(!list || !#list){
		shell.setStatus("没有找到定义" ++ (word ? ("：" ++ word) : ""));
		return;
	}
	var loc = list[1];
	if(jumpTo(loc.path, loc.line, loc.col + 1)){
		shell.setStatus("定义: " ++ navShortPath(loc.path)
			++ " 第 " ++ tostring(loc.line) ++ " 行");
	}
};

// 查找引用（Shift+F12）：结果填进底部「引用」页
var navFindReferences = function(line, col, word){
	if(!app.lspClient.isRunning()){
		shell.setStatus("LSP 未运行，无法查找引用");
		return;
	}
	var list = app.lspClient.references(line - 1, col - 1);
	var rows = {};
	var n = 0;
	if(list){
		for(i=1;#list;1){
			var loc = list[i];
			n = n + 1;
			..table.push(rows, {
				cells = {navShortPath(loc.path); tostring(loc.line); (word : "")};
				tag = {path = loc.path; line = loc.line; col = loc.col};
			});
		}
	}
	shell.refList.setRows(rows);
	shell.bottomDock.setSelIndex(5);
	shell.setStatus("找到 " ++ tostring(n) ++ " 处引用" ++ (word ? ("：" ++ word) : ""));
};

// 编辑清单按「行号从大到小」排（改的时候从后往前，前面的偏移才不会失效）
var navSortEdits = function(es){
	var n = #es;
	for(a=1; a<=n; 1){
		var mx = a;
		for(b=a+1; b<=n; 1){
			if(es[b].line > es[mx].line
				|| (es[b].line == es[mx].line && es[b].col > es[mx].col)){
				mx = b;
			}
		}
		if(mx != a){
			var t = es[a]; es[a] = es[mx]; es[mx] = t;
		}
	}
	return es;
};

// 应用跨文件重命名
var navApplyRename = function(edits, newName){
	var byFile = {};
	for(i=1;#edits;1){
		var e = edits[i];
		if(!e || !e.path) continue;
		if(!byFile[e.path]) byFile[e.path] = {};
		..table.push(byFile[e.path], e);
	}
	var changed = 0;
	for(path, es in byFile){
		navSortEdits(es);
		var isOpen = (shell.tabCurPath() == path);
		var text = isOpen ? shell.tabGetText(path) : ..string.load(path);
		if(!text) continue;
		var ok = true;
		for(j=1;#es;1){
			var e = es[j];
			// ⚠ LSP 的列是 0 基、UTF-16 码元；编辑器要 1 基
			var nt = shell.editor.replaceTextAt(text, e.line, e.col + 1, e.len, newName);
			if(nt === null){ ok = false; break }
			text = nt;
		}
		if(!ok) continue;
		if(isOpen){
			shell.tabSetText(path, text);
			shell.tabSetDirty(path, true);
		}
		else{
			..string.save(path, text);
		}
		// 新内容推给 LSP，索引要跟上
		app.lspClient.pushDoc(path, text);
		changed = changed + 1;
	}
	shell.setStatus("已重命名：" ++ tostring(#edits) ++ " 处（" ++ tostring(changed) ++ " 个文件）");
};

// 跨文件重命名（F2）：先问新名字，再让 LSP 算改动点
var navRenameSymbol = function(line, col, word){
	if(!app.lspClient.isRunning()){
		shell.setStatus("LSP 未运行，无法重命名");
		return;
	}
	if(!word){
		shell.setStatus("光标处没有可重命名的符号");
		return;
	}
	shell.showPrompt("重命名为", word, function(t){
		var nn = ..string.trim(t);
		if(!nn || nn == word) return false;
		var edits = app.lspClient.rename(line - 1, col - 1, nn);
		if(!edits || !#edits){
			shell.setStatus("没有找到可重命名的位置");
			return false;
		}
		navApplyRename(edits, nn);
		return true;
	});
};

// 项目符号搜索（Ctrl+Shift+T）：结果也填进「引用」面板
shell.hooks.onGotoSymbol = function(q){
	if(!app.lspClient.isRunning()){
		shell.setStatus("LSP 未运行，无法搜索符号");
		return;
	}
	var list = app.lspClient.workspaceSymbols(q);
	var rows = {};
	var n = 0;
	if(list){
		for(i=1;#list;1){
			var s = list[i];
			n = n + 1;
			..table.push(rows, {
				cells = {navShortPath(s.path); tostring(s.line); s.name};
				tag = {path = s.path; line = s.line; col = s.col};
			});
		}
	}
	shell.refList.setRows(rows);
	shell.bottomDock.setSelIndex(5);
	shell.setStatus("符号 “" ++ q ++ "”：找到 " ++ tostring(n) ++ " 个");
};
// ---------- property grid (file info) ----------
var propShowFile = function(path){
	var pi = ..io.splitpath(path);
	designer.propGrid.setItems({
		{name="名称"; value=pi.name ++ pi.ext};
		{name="目录"; value=pi.dir};
		{name="大小"; value=..io.getSize(path) ++ " 字节"};
	});
};

// ---------- 大纲（左栏「大纲」页）----------
// 扫当前文档的**顶层定义**（顶格的行；缩进行属于函数体，不算）：
//   · 函数：name = function(...)  /  var name = function(...)
//   · 变量：var name = ...
//   · 命名空间：namespace x{
// 大纲是自绘树（nodio.ui.tree），点一下跳到对应行。
//
// 解析全部用 string.split（aardio 的 string.sub 第三参语义在
// 「起点+长度」和「起点+终点」之间有歧义，split 没有这个问题）。
//
// 注意：**字面包含判断必须用 string.indexOf，不能用 string.find**。
// 官方 string.find 是**模式匹配**（正则）：
//   ..string.find("myFunc", ".")   → 1（"." 是正则「任意字符」，永远命中）
//   ..string.find("myFunc", " ")   → null
//   ..string.find("myFunc", "(")   → 1（"(" 是不完整的分组）
// 拿它当「有没有这个字符」用，标识符校验会永远失败 —— 大纲列表恒空。
// 官方文档也明说：字面值原样查找用 string.indexOf。
//
// 另一个坑：**空串是真值**（aardio 只有 null/false 为假），
// 所以 `if(!name) continue` 拦不住空名字 —— 注释行会被当成定义，
// 大纲里塞满空节点。必须用 `#name == 0` 判断长度。
var fillOutline = function(){
	shell.outlineTree.clear();
	var path = shell.tabCurPath();
	if(!path) return 0;
	var text = shell.tabGetText(path);
	if(!text) return 0;
	var lines = ..string.split(text, '\n');
	var n = 0;
	// 注意：所有临时变量都声明在循环**外面**。
	// 循环体里 new var 会让循环环境的哈希表 rehash，
	// 而引擎的 ForNum 早期是持节点裸指针的（已改成按 key 重查，
	// 但仍然把临时变量提到外面更省事、也更不容易踩坑）。
	var raw = "";
	var line = "";
	var name = "";
	var icon = "";
	var pf = {};
	var pre = "";
	var pv = {};
	var pv2 = {};
	var rest = "";
	var pe = {};
	var nm = "";
	var pb = {};
	var ps = {};
	var c1 = 0;
	var node = null;
	for(i=1;#lines;1){
		raw = lines[i];
		if(!raw) continue;
		// 顶格才是顶层定义（缩进的属于函数体）
		c1 = raw[1];
		if(c1 == 32 || c1 == 9) continue;
		line = ..string.trim(raw);
		if(line == "") continue;
		name = "";
		icon = "code";
		// ① name = function(...)  /  var name = function(...)
		pf = ..string.split(line, "<= function>");
		if(#pf >= 2){
			pre = ..string.trim(pf[1]);
			if(..string.startsWith(pre, "var ")){
				pv = ..string.split(pre, "<var >");
				pre = ..string.trim(pv[2]);
			}
			// 只要简单标识符：成员函数（a.b）、带参调用都不算
			if(#pre > 0 && !..string.indexOf(pre, " ") && !..string.indexOf(pre, "(")
				&& !..string.indexOf(pre, ".")){
				name = pre;
			}
		}
		// ② var name = ...（变量）
		if(!name && ..string.startsWith(line, "var ")){
			pv2 = ..string.split(line, "<var >");
			rest = ..string.trim(pv2[2]);
			pe = ..string.split(rest, "=");
			nm = ..string.trim(pe[1]);
			if(#nm > 0 && !..string.indexOf(nm, " ") && !..string.indexOf(nm, "(")
				&& !..string.indexOf(nm, ".")){
				name = nm;
				icon = "list";
			}
		}
		// ③ namespace x{
		if(!name && ..string.startsWith(line, "namespace ")){
			pb = ..string.split(line, "{");
			ps = ..string.split(pb[1], " ");
			if(#ps >= 2 && #ps[2] > 0){
				name = ps[2];
				icon = "folder";
			}
		}
		if(!name || #name == 0) continue;
		n = n + 1;
		node = shell.outlineTree.addNode(name, null, null);
		if(node){
			node.icon = icon;
			node.line = i;
		}
	}
	return n;
};

// ---------- 类视图（左栏「类视图」页，第五十一轮）----------
// 层级树：class/namespace → 成员函数/成员变量（缩进归属 + 花括号配平）。
// 扫描纪律与 fillOutline 相同：string.indexOf 字面包含（string.find 是
// 模式匹配，字面判断会被 ".": 1 坑死）、空串是真值用 #name == 0 拦、
// 循环临时变量提到外面。
// 类视图扫描核心（第五十二轮）：text 的 class/namespace 层级挂到
// baseNode（null=树根）；filePath 非空时节点带 .path（工程级跨文件跳转）。
// 返回节点数。stack/depth 每次调用独立。
var scanClassInto = function(tree, baseNode, text, filePath){
	var lines = ..string.split(text, '\n');
	var stack = {};          // {node; depth}——class/namespace 进栈；
	var stackTop = 0;        // 栈顶用索引管理，不依赖 table.remove 的单参语义
	var depth = 0;           // 花括号净深度（配平弹栈）
	var n = 0;
	var raw = "";
	var line = "";
	var indent = 0;
	var name = "";
	var icon = "";
	var top = null;
	var node = null;
	var pb = null;
	var ps = null;
	var pe = null;
	var nm = "";
	var bFunc = false;
	var bOpen = false;
	for(i=1;#lines;1){
		raw = lines[i];
		line = ..string.trim(raw);
		if(line == '') continue;
		if(..string.startsWith(line, "//")) continue;
		// 弹栈：花括号**严格浅于**进栈时的深度（== 时还在类体内）
		while(stackTop && depth < stack[stackTop].depth){
			stack[stackTop] = null;
			stackTop--;
		}
		top = stackTop ? stack[stackTop] : null;
		name = "";
		icon = "";
		bOpen = ..string.indexOf(line, "{") !== null;
		// ① class X{ / namespace X{（进栈）
		if(bOpen and (..string.startsWith(line, "class ")
			or ..string.startsWith(line, "namespace "))){
			pb = ..string.split(line, "{");
			ps = ..string.split(pb[1], " ");
			nm = #ps >= 2 ? ..string.trim(ps[#ps]) : "";
			if(#nm > 0 && !..string.indexOf(nm, "(")
				&& !..string.indexOf(nm, "=")){
				name = nm;
				icon = "folder";
			}
		}
		// ② 成员/顶层：name = function(...)（函数）/ name = ...（变量）
		if(#name == 0){
			pe = ..string.split(line, "=");
			if(#pe >= 2){
				nm = ..string.trim(pe[1]);
				if(#nm > 0 && !..string.indexOf(nm, " ")
					&& !..string.indexOf(nm, "(")
					&& !..string.indexOf(nm, ".")
					&& !..string.startsWith(nm, "//")){
					bFunc = ..string.indexOf(line, "function") !== null;
					// 函数才算类成员；普通赋值（如 self.x = 1）在类体里
					// 太密，v1 只收函数成员与顶层变量
					if(top === null or bFunc){
						name = nm;
						icon = bFunc ? "list" : "list";
					}
				}
			}
		}
		// 花括号净深度必须每行都计（含注释外的普通行）
		depth += (#..string.split(line, "{") - 1) - (#..string.split(line, "}") - 1);
		if(#name == 0) continue;
		var parent = top ? top.node : baseNode;
		if(icon == "folder" and bOpen){
			// class/namespace：挂到当前栈顶（或基节点），进栈
			node = tree.addNode(name, filePath, parent);
			if(node){
				node.icon = icon;
				node.line = i;
				if(filePath) node.path = filePath;
				stackTop++;
				stack[stackTop] = {node = node; depth = depth};
			}
			n = n + 1;
			continue;
		}
		// 成员/顶层条目
		node = tree.addNode(name, filePath, parent);
		if(node){
			node.icon = icon;
			node.line = i;
			if(filePath) node.path = filePath;
		}
		n = n + 1;
	}
	return n;
};

// 当前文档模式（心跳重扫走这条；工程模式见 fillClassViewProject）
var classViewMode = "doc";
var fillClassView = function(){
	classViewMode = "doc";
	shell.classTree.clear();
	var path = shell.tabCurPath();
	if(!path) return 0;
	var text = shell.tabGetText(path);
	if(!text) return 0;
	return scanClassInto(shell.classTree, null, text, null);
};

// 工程级扫描（第五十二轮）：工程每个文件的 class/namespace 挂到文件节点
// 之下。左栏切到「类视图」页时触发（onSelChange），心跳不扫（成本高）；
// 工程里一个类都没有就退回当前文档视图。
var fillClassViewProject = function(){
	classViewMode = "project";
	shell.classTree.clear();
	if(!proj || !proj.files) return fillClassView();
	var count = 0;
	for(i=1;#proj.files;1){
		var rel = proj.files[i].path;
		if(proj.files[i].ignored) continue;
		var full = proj.root ++ rel;
		var text = ..string.load(full);
		if(!text) continue;
		var fnode = shell.classTree.addNode(rel, full, null);
		if(fnode) fnode.icon = "folder";
		count += scanClassInto(shell.classTree, fnode, text, full);
	}
	if(count == 0) return fillClassView();
	return count;
};

// 类视图：点条目跳行；工程模式下节点带 .path，先开文件再跳
shell.classTree.onSelect = function(node){
	if(!node) return;
	if(node.path && node.path != shell.tabCurPath()){
		if(shell.hooks.onOpenFile) shell.hooks.onOpenFile(node.path);
	}
	if(node.line) app.editor.gotoLine(shell.editor, node.line);
};
// 左栏切到「类视图」页 → 工程级扫描（第五十二轮）
shell.leftDock.onSelChange = function(idx, name){
	if(name == "类视图" and classViewMode != "project") fillClassViewProject();
};

// ---------- right dock data: 标准库 / 范例 ----------
// ---------- 模板面板（右栏「模板」页，第五十二轮）----------
// 内置模板集：双击 → newFile 落模板内容（新文档的初始文本通道）。
var fileTemplates = {
	{ name = "空白文档"; desc = "空 aardio 源文件"; text = null };
	{ name = "控制台程序"; desc = "console 输出与暂停";
	  text = "import console;" ++ '\r\n\r\n'
		++ "console.log(""Hello, Nodio!"");" ++ '\r\n'
		++ "console.pause();" };
	{ name = "窗口程序"; desc = "win.form 窗体 + DSG 设计块";
	  text = "import win.ui;" ++ '\r\n'
		++ "/*DSG{{*/" ++ '\r\n'
		++ "var winform = win.form(text=""我的窗体"";right=599;bottom=449)" ++ '\r\n'
		++ "winform.add(" ++ '\r\n'
		++ "\tbutton={cls=""button"";text=""确定"";left=460;top=380;right=560;bottom=420;z=1}" ++ '\r\n'
		++ ")" ++ '\r\n'
		++ "/*}}*/" ++ '\r\n'
		++ "winform.show();" ++ '\r\n'
		++ "win.loopMessage();" };
	{ name = "类模块"; desc = "namespace + class 骨架";
	  text = "namespace myLib{" ++ '\r\n\r\n'
		++ "class myClass{" ++ '\r\n'
		++ "\tctor(...)" ++ '\r\n'
		++ "\t{" ++ '\r\n' + '\r\n'
		++ "\t};" ++ '\r\n'
		++ "\tmethod = function()" ++ '\r\n'
		++ "\t{" ++ '\r\n'
		++ "\t\t..io.print(""myClass.method"");" ++ '\r\n'
		++ "\t}" ++ '\r\n\r\n'
		++ "}" ++ '\r\n\r\n'
		++ "}" };
	{ name = "线程函数"; desc = "thread.create 骨架";
	  text = "import thread;" ++ '\r\n'
		++ "var h = thread.create(function(...)" ++ '\r\n'
		++ "{" ++ '\r\n'
		++ "\t// 线程函数：独立的全局环境" ++ '\r\n'
		++ "\treturn true;" ++ '\r\n'
		++ "}, ""参数"");" ++ '\r\n'
		++ "io.print(thread.waitOne(h, 5000));" };
};
var fillTemplates = function(){
	var rows = {};
	for(i=1;#fileTemplates;1){
		..table.push(rows, {
			cells = { fileTemplates[i].name; fileTemplates[i].desc };
			tag = fileTemplates[i]
		});
	}
	shell.templatesList.setRows(rows);
};
fillTemplates();
// 双击模板 → 新建文档落模板内容
shell.templatesList.onDoubleClick = function(row){
	if(row && row.tag) newFile(row.tag.text);
};

fillLibrary = function(){
	// 标准库：命名空间清单 + 官方中文说明
	// （右栏已是**自绘列表** nodio.ui.list —— 原生 listview 改不了色）
	var libs = app.library.scanLib();
	var rows = {};
	for(i=1;#libs;1){
		..table.push(rows, {libs[i].name; libs[i].desc});
	}
	shell.stdList.setRows(rows);

	// 语法：内置速查表
	var syn = app.library.scanSyntax();
	var srows = {};
	for(i=1;#syn;1){
		..table.push(srows, {syn[i][1]; syn[i][2]});
	}
	shell.syntaxList.setRows(srows);

	// 范例：官方 examples 目录（自绘树）
	var exs = app.library.scanExamples();
	shell.exTree.clear();
	for(i=1;#exs;1){
		var node = shell.exTree.addNode(exs[i].name, exs[i].name, null);
		if(node) node.icon = "fileCode";
	}
	if( ..string.getenv("NODIO_IDE_DIAG") ){
		io.print("DIAG fillLibrary libs=" ++ #libs ++ " syn=" ++ #syn
			++ " ex=" ++ #exs ++ " stdRows=" ++ #shell.stdList.rows
			++ " cols=" ++ #shell.stdList.columns);
	}
}

// ---------- right dock「工具」：一组可直接执行的命令 ----------
fillTools = function(){
	shell.toolTree.clear();
	var defs = {
		{"全部保存"; function(){ saveFile() }};
		{"运行 (F5)"; function(){ runScript() }};
		{"打开设计器"; function(){ designer.toggle() }};
		{"重新扫描标准库"; function(){ fillLibrary() }};
	};
	for(i=1;#defs;1){
		var n = shell.toolTree.addNode(defs[i][1], null, null);
		if(n){
			n.icon = "wrench";
			n.cmd = defs[i][2];
		}
	}
	// 外部工具（官方 IDE 的「工具」面板同样列在这里）：分组父节点 + 子节点。
	// 闭包用工厂函数造 —— 循环里直接闭包捕获循环变量，取到的可能是最后一次的值。
	var mkToolCmd = function(idx){
		return function(){ shell.hooks.onRunExternalTool(idx) };
	};
	var tools = app.settings.toolsGet();
	if(#tools){
		var grp = shell.toolTree.addNode("外部工具", null, null);
		if(grp){
			grp.icon = "wrench";
			for(i=1;#tools;1){
				var tn = shell.toolTree.addNode(tools[i].name, null, grp);
				if(tn){
					tn.icon = "wrench";
					tn.cmd = mkToolCmd(tools[i].idx);
				}
			}
		}
	}
	shell.toolTree.onSelect = function(node){
		if(node && node.cmd) node.cmd();
	};
}

// ---------- 工程树（实时文件系统视图）----------
//
// 树 = 工程根目录下的**实时文件系统树**：
//   · 目录和文件都来自磁盘扫描 —— 新建的文件/目录立刻可见
//   · 工程清单（.nproj）里有、磁盘上还没有的文件也补进树里
// 扫描有深度和节点数上限：误开一个大目录时不会把界面刷爆。
//
// ⚠ 递归扫描里的循环变量必须声明在**函数体顶部**：闭包共享外层作用域，
//   递归调用会把外层的 i 冲掉（列表会漏项/死循环）。
var SKIP_DIRS = {"node_modules"; ".git"; ".svn"; ".vs"; ".idea"};
var MAX_TREE_NODES = 1200;
var projFiles = {};      // 搜索范围：{path=相对路径; full=绝对路径}
var TEXT_EXTS = {".aardio"; ".nodio"; ".aproj"; ".nproj"; ".txt"; ".md";
	".json"; ".xml"; ".cfg"; ".ini"; ".yml"; ".yaml"; ".log"; ".ps1"};

var projRefresh = function(){
	projFiles = {};
	if(!proj) return 0;
	var tree = shell.projTree;
	tree.clear();
	var projName = proj.name : ..io.splitpath(proj.root).name;
	if(!projName || !#projName) projName = proj.root;
	var root = tree.addNode(projName, proj.root, null);
	tree.markDir(root);
	var dirNodes = {};    // 绝对路径 → 目录节点
	dirNodes[proj.root] = root;
	var seen = {};        // 绝对路径 → true（磁盘上已有）
	var nodes = 1;
	var scanDir = null;
	var ensureDir = null;
	var i, k, it, name, skip, rel, full, dn, pi;

	// 目录节点：缺就建（工程清单里的路径可能指向还没建的目录）
	ensureDir = function(absDir){
		if(dirNodes[absDir]) return dirNodes[absDir];
		var r = app.project.relPath(proj, absDir);
		if(!r) return root;
		var ps = ..string.split(r, '\\');
		var cur = proj.root;
		var parent = root;
		var j = 1;
		for(j=1;#ps;1){
			cur = cur ++ ps[j] ++ '\\';
			var n = dirNodes[cur];
			if(!n){
				n = tree.addNode(ps[j], cur, parent);
				tree.markDir(n);
				dirNodes[cur] = n;
				nodes = nodes + 1;
			}
			parent = n;
		}
		return parent;
	}

	scanDir = function(absDir, parentNode, depth){
		if(depth > 4 || nodes >= MAX_TREE_NODES) return;
		var list = ..io.listFiles(absDir, "*");
		if(!list) return;
		var i, k, it, name, skip, rel;
		// 先目录
		for(i=1;#list;1){
			it = list[i];
			if(!it.isDir) continue;
			name = it.name;
			if(..string.startsWith(name, ".")) continue;
			skip = false;
			for(k=1;#SKIP_DIRS;1){
				if(name == SKIP_DIRS[k]){ skip = true; break }
			}
			if(skip) continue;
			if(nodes >= MAX_TREE_NODES) return;
			nodes = nodes + 1;
			var dn = tree.addNode(name, it.path, parentNode);
			tree.markDir(dn);
			dirNodes[it.path] = dn;
			scanDir(it.path, dn, depth + 1);
		}
		// 再文件
		for(i=1;#list;1){
			it = list[i];
			if(it.isDir) continue;
			name = it.name;
			if(..string.startsWith(name, ".")) continue;
			if(nodes >= MAX_TREE_NODES) return;
			nodes = nodes + 1;
			seen[it.path] = true;
			tree.addNode(name, it.path, parentNode);
			rel = app.project.relPath(proj, it.path);
			..table.push(projFiles, {path = rel : it.path; full = it.path});
		}
	}
	scanDir(proj.root, root, 1);

	// 工程清单里有、磁盘上还没有的文件：补进树（清单是发布规则，别丢）
	for(i=1;proj.count;1){
		rel = ..string.replaceLiteral(proj.files[i].path, "/", '\\');
		full = proj.root ++ rel;
		if(seen[full]) continue;
		pi = ..io.splitpath(full);
		dn = ensureDir(pi.dir);
		tree.addNode(pi.name ++ pi.ext, full, dn);
		nodes = nodes + 1;
		..table.push(projFiles, {path = rel; full = full});
	}
	searchScopeUpdate();
	// 工程清单变了 → LSP 的项目级符号索引也要跟着重建
	lspSendProject();
	tree.expand(root);
	return nodes;
}

// 把搜索范围交给左栏「搜索」页（只收文本文件：二进制搜了没意义，还刷屏）
var searchScopeUpdate = function(){
	var scope = {};
	if(projFiles){
		for(i=1;#projFiles;1){
			var f = projFiles[i];
			var ext = ..string.lower(..io.splitpath(f.full).ext);
			var isText = false;
			for(k=1;#TEXT_EXTS;1){
				if(ext == TEXT_EXTS[k]){ isText = true; break }
			}
			if(!isText) continue;
			..table.push(scope, {path = f.path; full = f.full});
		}
	}
	shell.searchPanel.setScope(proj ? proj.root : null, scope);
	return #scope;
}

// ---------- commands ----------
openProject = function(){
	var m = app.project.open();
	if(!m) return;
	proj = m;
	projRefresh();
	shell.setProjectStatus(tostring(m.path));
	// 记住上次打开的工程：下次启动 IDE 直接回到这个工程
	// （否则正常启动是一片空白，见下面的 startupProject）
	cfgWrite("lastProject", m.path);
	shell.setStatus("工程: " ++ tostring(m.path));
	// user components join the designer from <project>\components
	var n = designer.discover(m.root ++ "components");
	if(n) shell.setStatus("已加载自定义组件: " ++ n ++ " 个");
}

// 打开文件：path 为空 → 弹系统「打开文件」对话框
openFile = function(path){
	if(!path){
		openFileDialog();
		return false;
	}
	if(!..io.exist(path)) return false;
	openTab(path);
	// 最近文件：打开成功就置顶入队 + 重建「文件」菜单（最近使用的文档，
	// 工程、搜索跳转、钩子打开的文档都走这里，一处收口）
	app.settings.recentPush(path);
	shell.refreshRecentMenu();
	return true;
}

// 系统「打开文件」对话框
//
// ⚠ 模态对话框有自己的消息循环：对话框开着的时候，心跳定时器照样会被触发
// （= 树遍历解释器在调用栈还没退的时候被重入）。用一个闸门把心跳挡掉。
var modalBusy = false;

openFileDialog = function(){
	modalBusy = true;
	var p = shell.fileDlg.open(
		'所有文件|*.*|aardio 源文件|*.aardio;*.nodio|',
		"打开文件");
	modalBusy = false;
	if(!p) return false;
	return openFile(p);
}

// ---------- 工程树文件操作 ----------
//
// 新建文件 / 新建目录 / 重命名 / 删除 / 设为启动文件。
// 磁盘操作走 io（引擎内置，语义明确），工程清单（.nproj）跟着改 ——
// 新文件不进清单就不会被打进发布包。
//
// 名字一律用**双引号**原样串（单引号串里 "\t" 是 TAB、"\n" 是换行，
// 反斜杠得写成 "\\" —— 路径写成单引号串必踩这个坑）。

// 确认框（模态，同样要走 modalBusy 闸门）
var confirmBox = function(text, title){
	modalBusy = true;
	var r = ..win.msgbox(text, title, 0x1/*_MB_OKCANCEL*/ | 0x30/*_MB_ICONWARNING*/);
	modalBusy = false;
	return (r == 1) ? true : false;
}

// 递归删除（目录里还有东西时 io.remove 删不掉，得自己往下走）
var removeTree = function(path){
	var list = ..io.listFiles(path, "*");
	if(list){
		for(i=1;#list;1){
			var it = list[i];
			if(it.isDir) removeTree(it.path);
			else ..io.remove(it.path);
		}
	}
	return ..io.remove(path);
}

// 目录参数为空 = 工程根
var projDirOf = function(dir){
	if(dir) return dir;
	if(proj) return proj.root;
	return null;
}

// 名字里不能带路径分隔符
var badName = function(name){
	if(..string.indexOf(name, '\\') || ..string.indexOf(name, "/")) return true;
	return false;
}

var projNewFile = function(dir){
	dir = projDirOf(dir);
	if(!dir){ shell.setStatus("先打开一个工程"); return }
	shell.showPrompt("新建文件", "新建文件.nodio", function(name){
		if(!name) name = "";
		name = ..string.trim(name);
		if(!name){ shell.setStatus("文件名不能为空"); return false }
		if(badName(name)){ shell.setStatus("文件名不能带路径"); return false }
		var full = dir ++ name;
		if(..io.exist(full)){ shell.setStatus("已存在: " ++ name); return false }
		if(!..string.save(full, "")){ shell.setStatus("创建失败: " ++ name); return false }
		// 工程清单跟着加（新文件要能被打进发布包）
		var rel = app.project.relPath(proj, full);
		if(rel){
			app.project.addFile(proj, rel);
			app.project.save(proj);
		}
		projRefresh();
		shell.setStatus("已新建: " ++ name);
		openFile(full);
		return true;
	})
}

var projNewDir = function(dir){
	dir = projDirOf(dir);
	if(!dir){ shell.setStatus("先打开一个工程"); return }
	shell.showPrompt("新建目录", "新建目录", function(name){
		if(!name) name = "";
		name = ..string.trim(name);
		if(!name){ shell.setStatus("目录名不能为空"); return false }
		if(badName(name)){ shell.setStatus("目录名不能带路径"); return false }
		var full = dir ++ name;
		if(..io.exist(full)){ shell.setStatus("已存在: " ++ name); return false }
		if(!..io.createDir(full)){ shell.setStatus("创建目录失败: " ++ name); return false }
		projRefresh();
		shell.setStatus("已新建目录: " ++ name);
		return true;
	})
}

var projRename = function(path){
	if(!path) return;
	if(!proj){ shell.setStatus("先打开一个工程"); return }
	var pi = ..io.splitpath(path);
	var oldName = pi.name ++ pi.ext;
	shell.showPrompt("重命名", oldName, function(newName){
		if(!newName) newName = "";
		newName = ..string.trim(newName);
		if(!newName){ shell.setStatus("名字不能为空"); return false }
		if(badName(newName)){ shell.setStatus("名字不能带路径"); return false }
		if(newName == oldName) return true;
		var newFull = pi.dir ++ newName;
		if(..io.exist(newFull)){ shell.setStatus("已存在: " ++ newName); return false }
		if(!..io.rename(path, newFull)){ shell.setStatus("重命名失败"); return false }
		// 工程清单跟着改（目录改名要把底下所有条目一起挪）
		var oldRel = app.project.relPath(proj, path);
		var newRel = app.project.relPath(proj, newFull);
		if(oldRel && newRel){
			if(..fsys.isDir(newFull)) app.project.renameDir(proj, oldRel, newRel);
			else app.project.renameFile(proj, oldRel, newRel);
			app.project.save(proj);
		}
		// 打开着的文档：页签跟着改
		shell.tabRename(path, newFull);
		projRefresh();
		shell.setStatus("已重命名: " ++ oldName ++ " → " ++ newName);
		return true;
	})
}

var projDelete = function(path){
	if(!path) return;
	if(!proj){ shell.setStatus("先打开一个工程"); return }
	var isDir = ..fsys.isDir(path);
	var pi = ..io.splitpath(path);
	var name = pi.name ++ pi.ext;
	var msg = isDir
		? ("删除目录 " ++ name ++ " 及其中全部内容？")
		: ("删除文件 " ++ name ++ " ？");
	if(!confirmBox(msg, "确认删除")){
		shell.setStatus("已取消删除");
		return;
	}
	var ok = isDir ? removeTree(path) : ..io.remove(path);
	if(!ok){ shell.setStatus("删除失败: " ++ path); return }
	// 工程清单跟着删
	var rel = app.project.relPath(proj, path);
	if(rel){
		if(isDir) app.project.removeDir(proj, rel);
		else app.project.removeFile(proj, rel);
		app.project.save(proj);
	}
	// 打开着的文档：关掉（文件都没了，留着也没用）
	shell.tabCloseUnder(path);
	projRefresh();
	shell.setStatus("已删除: " ++ name);
}

var projSetStart = function(path){
	if(!proj || !path) return;
	proj.start = path;
	if(app.project.save(proj)) shell.setStatus("启动文件: " ++ path);
	else shell.setStatus("已设为启动文件（工程文件未更新）");
}

// 工程属性（真对话框，替代旧的 setStatus 占位）：
// 文件清单就是发布规则 —— 这里把发布要用的四个事实一次说清。
var projProperties = function(){
	if(!proj){
		..win.msgbox("当前没有打开的工程。\r\n用「工程 → 打开工程...」或「文件 → 打开工程...」。"
			, "Nodio IDE - 工程属性");
		return;
	}
	var pub = proj.root ++ "default.aproj";
	if(!..io.exist(pub)) pub = proj.root ++ "default.nproj";
	var msg = "工程文件: " ++ tostring(proj.path)
		++ "\r\n根目录: " ++ tostring(proj.root)
		++ "\r\n启动文件: " ++ tostring(proj.start : "(未设置)")
		++ "\r\n清单文件数: " ++ tostring(proj.count)
		++ "\r\n发布清单: " ++ (..io.exist(pub) ? pub : "(无 — 发布时只打 import 闭包)");
	..win.msgbox(msg, "Nodio IDE - 工程属性");
}

// 新建文档（未命名）
newFile = function(initialText){
	var n = 1;
	while(shell.tabFind("未命名-" ++ n) !== null) n = n + 1;
	var name = "未命名-" ++ n;
	if(initialText === null || initialText === undefined){
		initialText = "// 新建 aardio 源文件" ++ '\r\n'
			++ "import console;" ++ '\r\n\r\n'
			++ "console.log(""Hello, Nodio!"");" ++ '\r\n'
			++ "console.pause();" ++ '\r\n';
	}
	shell.tabAdd(name, initialText);
	curFile = name;
	fillOutline();
	fillClassView();
	shell.setStatus("新建文档: " ++ name);
	shell.editor.setFocus();
	return true;
}

// the tree stores absolute paths as node data
openTab = function(path){
	// 用 string.load 而不是 io.readFile：
	// 官方 io.readFile = file.read，读回来的是**原始字节**（每个字节一个字符），
	// UTF-8 中文源码会整篇乱码；string.load 按 UTF-8 解码（还认 BOM）。
	var txt = ..string.load(path);
	if(txt === null) return false;
	shell.tabAdd(path, txt);
	curFile = path;
	fillOutline();
	fillClassView();
	lspEnsure();
	// LSP 是多文档的：换文件要把**当前文档**切过去，
	// 否则补全/诊断/定义查询全都作用在旧文件上。
	if(app.lspClient.isRunning()){
		app.lspClient.openDoc(path, shell.tabGetText(path));
	}
	// 符号树要重拉（导航栏面包屑的层级链）
	curSymTree = [ @{_type="array"} ];
	symTreeDirty = true;
	navUpdate(shell.editor.curLine);
	shell.setStatus("已打开: " ++ path);
	return true;
}

// ---------- 保存 ----------
// 原子安全落盘：写临时文件 -> 校验大小 -> MoveFileEx 替换目标，
// 杜绝断电/崩溃/磁盘满导致原文件截断损坏。
var atomicSaveFile = function(dstPath, text){
	var fullDst = ..io.fullpath(dstPath);
	var tmpPath = fullDst ++ ".nodio.tmp";
	if(!..string.save(tmpPath, text)){
		return false;
	}
	var fsize = ..io.getSize(tmpPath);
	if(fsize === null || fsize != #text){
		try{ ..io.remove(tmpPath) }catch(e){}
		return false;
	}
	// 0x1 = MOVEFILE_REPLACE_EXISTING, 0x8 = MOVEFILE_WRITE_THROUGH
	var ok = ::Kernel32.MoveFileEx(tmpPath, fullDst, 0x1 | 0x8);
	if(!ok){
		try{
			..io.remove(fullDst);
			..io.rename(tmpPath, fullDst);
			ok = true;
		}catch(e){
			ok = false;
		}
	}
	if(!ok){
		..string.save(fullDst, text);
		try{ ..io.remove(tmpPath) }catch(e){}
	}
	return true;
};

// 保存当前文档
saveFile = function(){
	var path = shell.tabCurPath();
	if(!path){
		shell.setStatus("没有打开的文档");
		return false;
	}
	return savePath(path);
}

// 保存指定文档（未命名的先转「另存为」）
savePath = function(path){
	if(!path) return false;
	if(!..io.exist(path)){
		return saveFileAs(path);
	}
	// 按该文档自己的换行符还原（LF 文件不会被写成 CRLF）
	var text = shell.tabTextForSave(path);
	if(!atomicSaveFile(path, text)){
		shell.setStatus("保存失败: " ++ path);
		return false;
	}
	shell.tabMarkSaved(path);
	shell.setStatus("已保存: " ++ path);
	lspSync();
	return true;
}

// 另存为（path 为空 = 当前文档）
saveFileAs = function(path){
	path = path : shell.tabCurPath();
	if(!path){
		shell.setStatus("没有打开的文档");
		return false;
	}
	var pi = ..io.splitpath(path);
	var defName = pi.name ++ (pi.ext : ".aardio");
	var dir = pi.dir;
	if(!dir) dir = shell.fileDlg.dir;
	modalBusy = true;
	var np = shell.fileDlg.save(
		'所有文件|*.*|aardio 源文件|*.aardio;*.nodio|',
		"另存为", dir, defName);
	modalBusy = false;
	if(!np) return false;
	// 目标已经开着就别去覆盖别人的页签
	if(np != path && shell.tabFind(np) !== null){
		shell.setStatus("该文件已经打开: " ++ np);
		return false;
	}
	if(!shell.tabRename(path, np)){
		shell.setStatus("另存为失败: " ++ np);
		return false;
	}
	curFile = np;
	atomicSaveFile(np, shell.tabTextForSave(np));
	shell.tabMarkSaved(np);
	shell.setStatus("已另存为: " ++ np);
	lspSync();
	return true;
}

// 全部保存
saveAllFiles = function(){
	var files = shell.tabOrder;
	if(!files || #files == 0){
		shell.setStatus("没有打开的文档");
		return false;
	}
	var n = 0;
	for(i=1;#files;1){
		if(savePath(files[i])) n = n + 1;
	}
	shell.setStatus("已保存 " ++ n ++ " 个文件");
	return true;
}

// ---------- 关闭 ----------
// 脏文档要先问：保存 / 不保存 / 取消
closeTab = function(path){
	if(!path) return false;
	if(shell.tabIsDirty(path)){
		var r = ..win.msgbox("是否保存对 " ++ path ++ " 的修改?", "Nodio IDE",
			0x3/*_MB_YESNOCANCEL*/);
		// 6=是(IDYES) 7=否(IDNO) 2=取消(IDCANCEL)
		if(r == 6){
			if(!savePath(path)) return false;
		}
		elseif(r == 2){
			return false;
		}
	}
	shell.tabClose(path);
	if(curFile == path) curFile = shell.tabCurPath();
	fillOutline();
	fillClassView();
	return true;
}

runScript = function(){
	var f = proj ? proj.start : curFile;
	if(!f){
		newFile();
		f = curFile;
	}
	// 切换底栏到「输出」页签（索引 2）
	if(shell.bottomDock){
		shell.bottomDock.setSelIndex(2);
	}
	if(!..io.exist(f)){
		// 临时草稿文档：存入临时运行文件直接跑，无需弹窗打扰
		var tempRun = ..io.fullpath(..string.getenv("TEMP") ++ "/nodio_scratch_run.aardio");
		var text = shell.tabTextForSave(curFile);
		..string.save(tempRun, text);
		runner.run(tempRun, ..io.splitpath(tempRun).dir);
		return;
	}
	saveFile();
	runner.run(f);
}

// ---------- 发布为独立 exe（工程 → 发布）----------
//
// 发布器（publish/publish.cpp）一直在、CLI 契约也早有回归锁
// （tests/run_publish_tests.ps1），但 IDE 一直**没有发布入口** ——
// 能写、能跑、能调试，就是出不了货。这里把链路接上：
//
//   工程打开时     entry = 工程启动文件，清单 = 工程文件（--proj 显式传入）
//   没有工程时     entry = 当前文档（先存盘），清单 = 入口旁的 default.aproj/.nproj
//
// 输出走「输出」面板（runner.runArgs 流式刷新），结束标记 [发布结束]。
publishRun = function(entry, outExe, manifest, bGui){
	if(!entry || !..io.exist(entry)){ shell.setStatus("启动文件不存在: " ++ tostring(entry)); return false }
	if(!outExe){ shell.setStatus("没有输出路径"); return false }
	// 参数行不含 exe 本身；路径自带引号（单引号串里直接写双引号字符）
	var args = '--publish "' ++ entry ++ '" -o "' ++ outExe ++ '"';
	if(manifest && #manifest) args = args ++ ' --proj "' ++ manifest ++ '"';
	if(bGui) args = args ++ " --gui";
	var pi = ..io.splitpath(entry);
	if(shell.bottomDock) shell.bottomDock.setSelIndex(2);   // 切到「输出」页
	runner.runArgs(args, pi.dir, "发布");
	return true;
}

publishExe = function(bGui){
	var f = proj ? proj.start : curFile;
	if(!f){ shell.setStatus("没有工程/启动文件"); return }
	if(!..io.exist(f)){
		// 草稿文档：先落盘（与 F5 的临时运行文件同一份），再发布
		var text = shell.tabTextForSave(curFile);
		f = ..io.fullpath(..string.getenv("TEMP") ++ "/nodio_scratch_run.aardio");
		..string.save(f, text);
	}
	else{
		saveFile();
	}
	var pi = ..io.splitpath(f);
	var out = shell.fileDlg.save('可执行文件|*.exe|所有文件|*.*|',
		bGui ? "发布为独立 exe（界面程序）" : "发布为独立 exe（控制台）",
		pi.dir, pi.name ++ ".exe");
	if(!out) return;   // 用户取消
	// 清单：工程打开时显式传工程文件；散文件靠发布器自动探测 default.aproj/.nproj
	publishRun(f, out, proj ? proj.path : null, bGui);
}


// ---------- debugging (F10) ----------
//
// dapClient 是**模块式 API**（跟 lspClient 一样），不是对象实例：
//   app.dapClient.start() 返回 "ok" / 失败原因；
//   之后一律 app.dapClient.launch() / .pollEvents() 调用。
// 以前这里把 start() 的返回值当对象用，而 dapClient.start() 结尾写的是
// `return self`（模块作用域里没有 self）→ 永远返回空 → F10 永远
// 「调试适配器启动失败」。
var dbgSession = null;   // 调试会话是否已建立
var dbgTimer = null;

debugRun = function(){
	var f = proj ? proj.start : curFile;
	if(!f){ shell.setStatus("没有工程/启动文件"); return }
	saveFile();
	if(!dbgSession){
		var st = app.dapClient.start(DAP_EXE);
		if(st !== "ok"){ shell.setStatus("调试适配器启动失败: " ++ tostring(st)); return }
		dbgSession = true;
	}
	shell.dbgClear();
	shell.setStatus("调试中...");
	var r = app.dapClient.launch(f);
	if(r !== true){ shell.setStatus("调试启动失败: " ++ tostring(r)); app.dapClient.stop(); dbgSession = null; return }
	// 调试会话起来之后，把**之前**就打好的断点补发给适配器
	// （断点是在会话之前点的，当时没有地方可发）。
	// 第五十九轮：条目可能是元数据表 {condition;hitCount}（条件断点），
	// 补发时一并带上。
	if(curFile && breakpoints[curFile]){
		var bl = {};
		var bm = {};
		var bn = 0;
		var bp0 = breakpoints[curFile];
		for(l,v in bp0){
			if(v){ bn = bn + 1; bl[bn] = l - 1; bm[bn] = v }
		}
		if(bn) app.dapClient.setBreakpoints(curFile, bl, bm);
	}
	if(dbgTimer) shell.winform.clearInterval(dbgTimer);
	dbgTimer = shell.winform.setInterval(pollDebug, 120);
}

stopDebug = function(){
	if(dbgTimer){ shell.winform.clearInterval(dbgTimer); dbgTimer = null }
	if(dbgSession){ app.dapClient.stop(); dbgSession = null }
	if(runner.isRunning()) runner.stop();
	shell.setStatus("已停止");
}

// one IDE-side breakpoint slot per line on the debugged file
// 第五十九轮：条目从 true 升级为**元数据表**（普通过点 = {}，
// 条件断点 = {condition="..."; hitCount=N}）——表在 aardio 里恒为真值，
// `if(条目)` 的旧判断不受影响。
var breakpoints = {};
var setBreakpoint = function(path, line, onOff, meta){
	breakpoints[path] = breakpoints[path] : {};
	breakpoints[path][line] = onOff ? (meta : {}) : null;
	if(dbgSession && app.dapClient.ready()){
		var lines = {};
		var metas = {};
		var n = 0;
		var bp = breakpoints[path] : {};
		for(l,v in bp){
			if(v){
				n = n + 1;
				lines[n] = l - 1;    // 0-based for DAP
				metas[n] = v;
			}
		}
		app.dapClient.setBreakpoints(path, lines, metas);
	}
}

// 条件/命中次数断点（第五十九轮）：Shift+F9 在当前行设/改条件断点。
// 输入格式「条件表达式 | 命中次数N」——竖线分隔，两边都可留空：
//   只写条件 → 每次到达都判条件，真值才停（真值语义同 if）；
//   只写数字 → 每第 N 次到达才停；
//   全空     → 退化为普通断点。
// 该行没打过断点时先点亮断点标记，再挂元数据。
var toggleConditionalBp = function(){
	var line = shell.editor.curLine;
	if(!curFile || !line){ shell.setStatus("没有可设断点的行"); return }
	var bp = breakpoints[curFile] : {};
	var old = bp[line] : null;
	var def = "";
	if(old){
		var c = tostring(old.condition : "");
		var h = tonumber(old.hitCount : 0) : 0;
		def = c;
		if(h > 0) def = (#def ? def ++ " | " : "") ++ h;
	}
	shell.showPrompt("条件断点 行" ++ line ++ "（条件 | 命中次数N，可留空）", def, function(t){
		var cond = ..string.trim(tostring(t : ""));
		var hit = 0;
		var bar = ..string.indexOf(cond, "|");
		if(bar !== null){
			hit = tonumber(..string.trim(..string.slice(cond, bar + 1))) : 0;
			cond = ..string.trim(..string.left(cond, bar - 1));
		}
		if(#cond == 0 && hit <= 0){
			setBreakpoint(curFile, line, true, {});
			shell.setStatus("已设断点（无条件） 行 " ++ line);
			return true;
		}
		setBreakpoint(curFile, line, true, { condition = cond; hitCount = hit });
		shell.setStatus("已设条件断点 行 " ++ line
			++ (#cond ? " 条件: " ++ cond : "")
			++ (hit > 0 ? " 每第 " ++ hit ++ " 次" : ""));
		return true;
	});
}
shell.hooks.onBpCondition = toggleConditionalBp;

pollDebug = function(){
	if(!dbgSession) return;
	// ⚠ 方法名：dapClient 暴露的是 pollEvents(ev)，不是 poll()
	// （poll 是模块内部的收包函数，外部调用不到）。
	app.dapClient.pollEvents(function(ev, data){
		if(ev == "stopped"){
			shell.dbgAppend("[停止] 行 " ++ (data.line + 1));
			var vars = app.dapClient.getVars();
			for(i=1;#vars;1){
				shell.dbgAppend("  " ++ vars[i].name ++ " = " ++ vars[i].value);
			}
			if(refreshWatchList) refreshWatchList();
			var v = app.dapClient.stackTrace();
			for(i=1;#v;1){
				// 第五十九轮续：适配器现在回真实调用栈，帧名是调用点文本
				//（"b()"）或 "main"——main 帧不重复显示名字。
				var nm = tostring(v[i].name : "");
				shell.dbgAppend("  @ " ++ ((#nm && nm != "main") ? nm ++ " " : "") ++ "行 " ++ (v[i].line + 1));
			}
			shell.setStatus("已停止 — F10 继续, F11 单步, Ctrl+F9 停止");
			// 光标跳到停住的那一行（不跳的话用户根本不知道停在哪）
			// ⚠ data.line 是 **0 基**行号，编辑器的 gotoLine 是 1 基。
			if(data.line !== null && data.line !== undefined){
				shell.editor.gotoLine(data.line + 1);
			}
		}
		elseif(ev == "terminated"){
			shell.dbgAppend("[调试结束]");
			// 变量树的引用只在停点期间有效（引擎每停点重建）——
			// 会话结束整树清空，不留下可点击的假引用
			if(shell.varsPanel) shell.varsPanel.clear();
			stopDebug();
		}
	});
	// ⚠ 显式返回 null：官方 WM_TIMER 会把「返回值既不是 null 也不是 true」
	//   的定时器**移除**（win/ui/_.aardio:342）——
	//   这里最后一句是 pollEvents(...)，返回值会传出去，
	//   一旦是 false，**调试轮询就停了**（断点不再命中、F10 失灵）。
	return null;
}

debugStep = function(){
	if(dbgSession) app.dapClient.next();
}

// 立即窗口求值（第五十五轮）
//
// 底栏「立即」页签里敲一个表达式回车 → 在**当前暂停帧的环境**里求值
// （引擎侧 debug.cpp 的 eval 命令：Lex → Parser → Eval(node, env)）。
// 所以它能看到局部变量，而不只是全局。
//
// ⚠ 返回 null = 没有可用的调试会话（调用方会给出提示）；
//   引擎侧报错（语法错/运行时错）会以 type="error" 回来。
shell.hooks.onDebugEval = function(expr){
	if(!dbgSession || !app.dapClient.ready() || !app.dapClient.isStopped()){
		return null;
	}
	var r = app.dapClient.evaluate(expr);
	if(!r) return "（求值没有响应）";
	if(r.type == "error") return "错误: " ++ r.result;
	return r.result;
};

// 行号栏点一下打/消断点 → 转给 DAP 适配器
shell.editor.onToggleBreakpoint = function(line, on){
	if(!curFile) return;
	setBreakpoint(curFile, line, on);
	shell.setStatus((on ? "已设断点 行 " : "已取消断点 行 ") ++ line);
};

shell.hooks.onOpenProject = openProject;
shell.hooks.onOpenFile    = openFile;      // path == "" → 弹「打开文件」对话框
shell.hooks.onNewFile     = newFile;
shell.hooks.onSave        = saveFile;
shell.hooks.onSaveAs      = function(){ return saveFileAs() };
shell.hooks.onSaveAll     = saveAllFiles;
// 打印（第五十六轮）：页数测量 → 确认 prompt → EM_FORMATRANGE 渲染
var printDocument = function(){
	var pages = shell.editor.pageCount();
	if(pages == 0){
		shell.setStatus("打印：未找到默认打印机");
		return;
	}
	shell.showPrompt("打印确认", "共 " ++ pages ++ " 页（回车打印，Esc 取消）", function(t){
		var n = shell.editor.print();
		shell.setStatus("已打印 " ++ tostring(n) ++ " 页到默认打印机");
		return true;
	});
};
shell.hooks.onPrint       = printDocument;
shell.hooks.onCloseTab    = closeTab;
shell.hooks.onCloseOtherTabs = function(keepPath){
	keepPath = keepPath : shell.curTab;
	if(!keepPath) return;
	var toClose = {};
	for(i=1;#shell.tabOrder;1){
		if(shell.tabOrder[i] != keepPath) ..table.push(toClose, shell.tabOrder[i]);
	}
	for(i=1;#toClose;1){
		closeTab(toClose[i]);
	}
};
shell.hooks.onCloseAllTabs = function(){
	var toClose = {};
	for(i=1;#shell.tabOrder;1){ ..table.push(toClose, shell.tabOrder[i]); }
	for(i=1;#toClose;1){
		closeTab(toClose[i]);
	}
};
shell.hooks.onQuickOpen = function(query){
	var target = null;
	var lowerQ = ..string.lower(query);
	if(proj && projFiles && #projFiles){
		for(i=1;#projFiles;1){
			var pf = projFiles[i];
			var pi = ..io.splitpath(pf.path);
			var name = pi.name ++ pi.ext;
			if(..string.lower(name) == lowerQ){
				target = pf.full : (proj.root ++ pf.path);
				break;
			}
		}
		if(!target){
			for(i=1;#projFiles;1){
				var pf = projFiles[i];
				if(..string.find(..string.lower(pf.path), lowerQ)){
					target = pf.full : (proj.root ++ pf.path);
					break;
				}
			}
		}
	}
	if(!target){
		if(..io.exist(query)) target = ..io.fullpath(query);
		elseif(proj && proj.root && ..io.exist(proj.root ++ query)){
			target = proj.root ++ query;
		}
	}
	if(target && ..io.exist(target)){
		openFile(target);
		shell.setStatus("已快速打开: " ++ target);
		return true;
	}
	shell.setStatus("未找到匹配的文件: " ++ query);
	return false;
};
// 工程树文件操作（磁盘动作 + 工程清单同步）
shell.hooks.onProjNewFile = projNewFile;
shell.hooks.onProjNewDir  = projNewDir;
shell.hooks.onProjRename  = projRename;
shell.hooks.onProjDelete  = projDelete;
shell.hooks.onProjSetStart = projSetStart;
shell.hooks.onProjProperties = projProperties;
// 左栏「搜索」页：双击结果 → 打开文件并跳到那一行
shell.searchPanel.onStatus = function(text){
	shell.setStatus(text);
}
shell.searchPanel.onOpenFile = function(path, line){
	if(!openFile(path)) return;
	if(line) shell.editor.gotoLine(line);
}
// 文档内容变了：大纲要重建（标个脏，心跳里统一做，别在按键回调里重扫全文）
var outlineDirty = false;
shell.hooks.onDocChange   = function(path, text){
	outlineDirty = true;
	// 导航栏的层级链也依赖符号树 → 同样标脏
	symTreeDirty = true;
};
shell.hooks.onRun         = runScript;
// 发布为独立 exe（工程 → 发布）：控制台 / 界面程序两条入口
shell.hooks.onPublishConsole = function(){ publishExe(false) };
shell.hooks.onPublishGui     = function(){ publishExe(true) };
// F10 = 调试：没有会话 → 开始调试；已经停住了 → **继续**（resume）
//
// ⚠ 以前这里停住之后走的是 next()（单步跳过），resume() 从来没被调用过 ——
//   「F10 继续」在界面上写着，实际上是单步，跑不出效果。
//   单步挪到 F11（见 onDebugStep），两边语义就分开了。
shell.hooks.onDebug       = function(){
	if(dbgSession && app.dapClient.ready()){
		if(app.dapClient.isStopped()){
			app.dapClient.resume();
			shell.setStatus("继续运行...");
		}
		else{
			app.dapClient.next();
		}
		pollDebug();
		return;
	}
	debugRun();
};
// F11 = 单步跳过
shell.hooks.onDebugStep   = function(){
	if(!dbgSession){ shell.setStatus("没有调试会话"); return }
	if(!app.dapClient.isStopped()){ shell.setStatus("程序没有停在断点上"); return }
	debugStep();
	pollDebug();
};
shell.hooks.onStopDebug   = stopDebug;
shell.hooks.onDesigner    = function(){ designer.toggle() };
// ---------- 设计的保存 / 载入 ----------
//
// 官方 aardio 的窗体源码里带 /*DSG{{*/ … /*}}*/ 设计块，
// 设计器读写的就是这一段 —— 所以「保存设计」= 把画布内容写回当前文档。
//
// ⚠ 以前 designer 只有 toDSG()/fromDSG() 两个纯函数，**没有任何入口**：
//   画完就丢，工具条上的「设计器」按钮只能开合面板，存不下来。
shell.hooks.onDesignerSave = function(){
	var path = shell.tabCurPath();
	if(!path){ shell.setStatus("没有打开的文档"); return }
	var src = shell.tabGetText(path);
	var ns = designer.applyToSource(src);
	if(ns == src){ shell.setStatus("设计没有变化"); return }
	shell.tabSetText(path, ns);
	shell.setStatus("设计已写回源码: " ++ path);
};
shell.hooks.onDesignerLoad = function(){
	var path = shell.tabCurPath();
	if(!path){ shell.setStatus("没有打开的文档"); return }
	designer.open();
	if(!designer.readFromSource(shell.tabGetText(path))){
		shell.setStatus("当前文档里没有 DSG 设计块");
		return;
	}
	shell.setStatus("已从源码载入设计");
};
shell.hooks.onDesignerSaveAs = function(){
	var path = shell.fileDlg.save('DSG 文件|*.dsg|所有文件|*.*|', "设计另存为", null, "设计.dsg");
	if(!path) return;
	designer.saveToFile(path);
};
shell.hooks.onDesignerOpen = function(){
	var path = shell.fileDlg.open('DSG 文件|*.dsg|所有文件|*.*|', "打开设计");
	if(!path) return;
	designer.open();
	designer.loadFromFile(path);
};
// ---------- 窗体设置 / 网格吸附 / 边距线（官方 USR.CFG 的 dlg_* 一族） ----------
//
// 窗体设置 = 选中「窗体本身」：点画布空白处或这里 —— 左栏属性格改
// 标题/宽度/高度，写回的是 DSG 头 win.form(text=..;right=..;bottom=..)。
// 网格吸附 = 拖动/缩放时把坐标钉到网格上（属性格里的精确值不吸附）。
// 边距线 = 表单内容区参考线（设计坐标，默认 8 逻辑像素）。
shell.hooks.onDesignerForm = function(){
	// 第五十九轮续：升级为官方同款窗体属性对话框（就地浮层）——
	// 标题/宽度/高度/底色/边框一处改完；画布空白点击仍走属性格
	designer.showFormDialog();
};
shell.hooks.onDesignerGrid = function(){
	designer.canvas.showGrid = designer.canvas.showGrid ? false : true;
	designer.canvas.__refresh();
	shell.setStatus("显示网格线: " ++ (designer.canvas.showGrid ? "开" : "关"));
};
shell.hooks.onDesignerSnap = function(){
	designer.canvas.snap = designer.canvas.snap ? false : true;
	shell.setStatus("对齐网格: " ++ (designer.canvas.snap ? "开" : "关"));
};
shell.hooks.onDesignerAlignSnap = function(){
	designer.canvas.alignSnap = designer.canvas.alignSnap ? false : true;
	shell.setStatus("控件吸附对齐: " ++ (designer.canvas.alignSnap ? "开" : "关"));
};
shell.hooks.onDesignerMargin = function(){
	if(designer.canvas.margins){
		designer.canvas.margins = null;
		designer.canvas.__refresh();
		shell.setStatus("边距线: 关");
	}
	else{
		designer.canvas.margins = {left=8; top=8; right=8; bottom=8};
		designer.canvas.__refresh();
		shell.setStatus("边距线: 8 逻辑像素（设计菜单可关）");
	}
};
shell.hooks.onDesignerZoom100 = function(){
	designer.canvas.setZoom(100);
	shell.setStatus("设计器缩放: 100%");
};
shell.hooks.onDesignerZoomIn = function(){
	var cur = designer.canvas.zoom : 100;
	designer.canvas.setZoom(cur + 25);
	shell.setStatus("设计器缩放: " ++ tostring(designer.canvas.zoom) ++ "%");
};
shell.hooks.onDesignerZoomOut = function(){
	var cur = designer.canvas.zoom : 100;
	designer.canvas.setZoom(cur - 25);
	shell.setStatus("设计器缩放: " ++ tostring(designer.canvas.zoom) ++ "%");
};

// ---------- 设计器批量对齐与画布撤销/重做 ----------
shell.hooks.onDesignerAlignLeft = function(){
	if(designer.canvas.alignLeft()) shell.setStatus("已左对齐选中控件");
	else shell.setStatus("至少需要选中 2 个控件进行对齐");
};
shell.hooks.onDesignerAlignRight = function(){
	if(designer.canvas.alignRight()) shell.setStatus("已右对齐选中控件");
	else shell.setStatus("至少需要选中 2 个控件进行对齐");
};
shell.hooks.onDesignerAlignTop = function(){
	if(designer.canvas.alignTop()) shell.setStatus("已顶对齐选中控件");
	else shell.setStatus("至少需要选中 2 个控件进行对齐");
};
shell.hooks.onDesignerAlignBottom = function(){
	if(designer.canvas.alignBottom()) shell.setStatus("已底对齐选中控件");
	else shell.setStatus("至少需要选中 2 个控件进行对齐");
};
shell.hooks.onDesignerAlignCenterH = function(){
	if(designer.canvas.alignCenterH()) shell.setStatus("已水平居中对齐选中控件");
	else shell.setStatus("至少需要选中 2 个控件进行对齐");
};
shell.hooks.onDesignerAlignCenterV = function(){
	if(designer.canvas.alignCenterV()) shell.setStatus("已垂直居中对齐选中控件");
	else shell.setStatus("至少需要选中 2 个控件进行对齐");
};
shell.hooks.onDesignerSameWidth = function(){
	if(designer.canvas.sameWidth()) shell.setStatus("已统一选中控件宽度");
	else shell.setStatus("至少需要选中 2 个控件进行等宽调整");
};
shell.hooks.onDesignerSameHeight = function(){
	if(designer.canvas.sameHeight()) shell.setStatus("已统一选中控件高度");
	else shell.setStatus("至少需要选中 2 个控件进行等高调整");
};
shell.hooks.onDesignerUndo = function(){
	if(designer.canvas.undo()) shell.setStatus("已撤销设计画布操作");
	else shell.setStatus("无更多可撤销画布操作");
};
shell.hooks.onDesignerRedo = function(){
	if(designer.canvas.redo()) shell.setStatus("已重做设计画布操作");
	else shell.setStatus("无更多可重做画布操作");
};

// ---------- 差异对比导航 (Diff Navigation) ----------
shell.hooks.onNextDiff = function(){
	if(!shell.splitDiff || !shell.editor2){
		shell.setStatus("双栏对比未开启");
		return;
	}
	var t1 = shell.editor.getText();
	var t2 = shell.editor2.getText();
	var l1 = ..string.split(t1, '\n');
	var l2 = ..string.split(t2, '\n');
	var d1 = {};
	var d2 = {};
	var maxL = (#l1 > #l2) ? #l1 : #l2;
	var firstDiff = null;
	var cur = shell.editor.curLine : 1;
	for(i=1;maxL;1){
		var s1 = (i <= #l1) ? ..string.trimright(l1[i]) : null;
		var s2 = (i <= #l2) ? ..string.trimright(l2[i]) : null;
		if(s1 != s2){
			if(s1 === null) d2[i] = "add";
			elseif(s2 === null) d1[i] = "del";
			else { d1[i] = "mod"; d2[i] = "mod"; }
			if(firstDiff === null && i > cur) firstDiff = i;
		}
	}
	shell.editor.setDiffLines(d1);
	shell.editor2.setDiffLines(d2);
	if(firstDiff !== null){
		shell.editor.gotoLine(firstDiff);
		shell.editor2.gotoLine(firstDiff);
		shell.setStatus("已跳转至差异行: " ++ firstDiff);
	}
	else{
		shell.setStatus("向下无更多差异");
	}
};

shell.hooks.onPrevDiff = function(){
	if(!shell.splitDiff || !shell.editor2){
		shell.setStatus("双栏对比未开启");
		return;
	}
	var t1 = shell.editor.getText();
	var t2 = shell.editor2.getText();
	var l1 = ..string.split(t1, '\n');
	var l2 = ..string.split(t2, '\n');
	var d1 = {};
	var d2 = {};
	var maxL = (#l1 > #l2) ? #l1 : #l2;
	var prevDiff = null;
	var cur = shell.editor.curLine : 1;
	for(i=maxL;1;-1){
		var s1 = (i <= #l1) ? ..string.trimright(l1[i]) : null;
		var s2 = (i <= #l2) ? ..string.trimright(l2[i]) : null;
		if(s1 != s2){
			if(s1 === null) d2[i] = "add";
			elseif(s2 === null) d1[i] = "del";
			else { d1[i] = "mod"; d2[i] = "mod"; }
			if(prevDiff === null && i < cur) prevDiff = i;
		}
	}
	shell.editor.setDiffLines(d1);
	shell.editor2.setDiffLines(d2);
	if(prevDiff !== null){
		shell.editor.gotoLine(prevDiff);
		shell.editor2.gotoLine(prevDiff);
		shell.setStatus("已跳转至上一差异行: " ++ prevDiff);
	}
	else{
		shell.setStatus("向上无更多差异");
	}
};

// ---------- 监视表达式 (Watch Expressions) ----------
// 第五十九轮续：监视窗升级为**独立面板**（shell.watchPanel）——表达式
// 逐条经 DAP evaluate 求值（能看到局部变量，支持 x+1、t.a 这类表达式），
// 不再是旧版「变量名 = 值」的名字匹配输出。变量树（shell.varsPanel）
// 同轮落地：顶层来自停点快照，表/数组节点经 varsRef 懒展开。
// pollDebug 的每个停点都会调 refreshWatchList()（本模块裸名）→ 两面板
// 一起刷新。
if(shell.watchPanel){
	shell.watchPanel.onStatus = function(s){ shell.setStatus(s) };
	shell.watchPanel.setEvaluator(function(expr){
		if(!dbgSession || !app.dapClient.ready() || !app.dapClient.isStopped()){
			return null;
		}
		var r = app.dapClient.evaluate(expr);
		if(!r) return { value = "（求值没有响应）"; type = "error" };
		return { value = r.result; type = r.type };
	});
}
if(shell.varsPanel){
	shell.varsPanel.setProvider(function(){
		if(!dbgSession || !app.dapClient.ready() || !app.dapClient.isStopped()){
			return null;
		}
		return app.dapClient.getVars();
	});
	shell.varsPanel.setChildren(function(ref){
		return app.dapClient.getVarChildren(ref);
	});
}
var refreshWatchList = function(){
	if(shell.watchPanel) shell.watchPanel.refresh();
	if(shell.varsPanel) shell.varsPanel.refresh();
};

shell.hooks.onAddWatch = function(){
	shell.showPrompt("添加监视表达式", "", function(expr){
		if(shell.watchPanel && shell.watchPanel.add(expr)){
			shell.setStatus("已添加监视: " ++ ..string.trim(expr));
			refreshWatchList();
			return true;
		}
		return false;
	});
};

shell.hooks.onClearWatch = function(){
	if(shell.watchPanel) shell.watchPanel.clearAll();
	shell.setStatus("已清空监视列表");
};

// ---------- 设置（主题 / 编辑器字号 / 外部工具）----------
//
// 三件事的生效方式不一样，菜单里也标清楚了：
//   · 主题 —— **重启后生效**（各 chrome 组件构造期读一次配色）
//   · 编辑器字号 —— **即时生效**（editor.setFontSize 走完整链条）
//   · 外部工具 —— 加完立刻能用，Ctrl+1..9 触发
shell.hooks.onSetTheme = function(name){
	if(!app.settings.themeSet(name)) return;
	shell.setStatus("主题已设为「" ++ name ++ "」，重启 IDE 后生效");
};

shell.hooks.onEditorFontSize = function(){
	var cur = app.settings.fontSizeGet();
	shell.showPrompt("编辑器字体大小 (6-24 pt)", tostring(cur : ""), function(t){
		var n = tonumber(t);
		if(!n || n < 6 || n > 24) return false;
		if(!shell.editor.setFontSize(n)) return false;
		// 分栏对比的第二个编辑器（如果已经开过）也要跟着变，
		// 否则左右两半字号对不上。
		if(shell.editor2 && shell.editor2.setFontSize(n)){}
		app.settings.fontSizeSet(n);
		shell.setStatus("编辑器字号已设为 " ++ n ++ " pt");
		return true;
	});
};

// 外部工具：名称 → 命令 → 参数（%f = 当前文档，%p = 工程目录）
shell.hooks.onAddExternalTool = function(){
	shell.showPrompt("外部工具名称", "", function(name){
		name = ..string.trim(name);
		if(!name) return false;
		shell.showPrompt("命令（可执行文件路径）", "", function(cmd){
			cmd = ..string.trim(cmd);
			if(!cmd) return false;
			shell.showPrompt("参数（%f=当前文件 %p=工程目录，可留空）", "", function(args){
				var slot = app.settings.toolFreeSlot();
				if(!slot){
					shell.setStatus("外部工具已满（最多 9 个），先删一个");
					return true;
				}
				if(!app.settings.toolSave(slot, name, cmd, ..string.trim(args : ""))){
					shell.setStatus("外部工具保存失败");
					return true;
				}
				fillTools();
				shell.setStatus("已添加外部工具 " ++ slot ++ ": " ++ name ++ "（Ctrl+" ++ slot ++ " 触发）");
				return true;
			});
			return true;   // 后一个 prompt 接管后本层不再关
		});
		return true;
	});
};

shell.hooks.onDelExternalTool = function(){
	var list = app.settings.toolsGet();
	if(!#list){
		shell.setStatus("还没有配置任何外部工具");
		return;
	}
	var names = "";
	for(i=1;#list;1){
		names = names ++ (i : "") ++ ":" ++ list[i].name ++ "  ";
	}
	shell.showPrompt("删除哪个外部工具（" ++ names ++ "）", "", function(t){
		var n = tonumber(t);
		if(!n || n < 1 || n > 9){ return false }
		if(!app.settings.toolRemove(n)){
			shell.setStatus("删除失败");
			return true;
		}
		fillTools();
		shell.setStatus("已删除外部工具 " ++ n);
		return true;
	});
};

// Ctrl+1..9 / 「工具」面板 → 执行外部工具
shell.hooks.onRunExternalTool = function(idx){
	var t = app.settings.toolGet(idx);
	if(!t) return 0;
	var cur = shell.tabCurPath();
	var wd = proj ? proj.root : null;
	var ok = app.settings.toolRun(idx, shell.winform, outCtl, shell.setStatus, cur, wd);
	return ok ? 1 : 0;
};

// 打开配置文件（%APPDATA%\Nodio\ide.cfg）—— 用户可以直接手改
shell.hooks.onOpenConfigFile = function(){
	var p = ..string.getenv("APPDATA") ++ "\Nodio\ide.cfg";
	if(!..io.exist(p)){
		shell.setStatus("配置文件还不存在: " ++ p);
		return;
	}
	openFile(p);
};

// ---------- 外部工具与工程代码统计 ----------
shell.hooks.onRevealInExplorer = function(){
	var cur = shell.tabCurPath();
	if(!cur && proj) cur = proj.root;
	if(!cur){
		shell.setStatus("当前没有打开的文件或工程");
		return;
	}
	var full = ..io.fullpath(cur);
	try{
		::Shell32.ShellExecute(0, "open", "explorer.exe", '/select,"' ++ full ++ '"', null, 1);
		shell.setStatus("已在资源管理器中定位: " ++ full);
	}catch(e){
		shell.setStatus("定位失败: " ++ tostring(e));
	}
};

shell.hooks.onOpenTerminal = function(){
	var dir = (proj && proj.root) ? proj.root : ..io.fullpath(".");
	var cur = shell.tabCurPath();
	if(cur){
		var pi = ..io.splitpath(cur);
		if(pi && pi.dir) dir = pi.dir;
	}
	try{
		::Shell32.ShellExecute(0, "open", "cmd.exe", null, dir, 1);
		shell.setStatus("已在目录打开终端: " ++ dir);
	}catch(e){
		shell.setStatus("打开终端失败: " ++ tostring(e));
	}
};

shell.hooks.onProjectStats = function(){
	if(!proj || !proj.root){
		shell.setStatus("当前未打开工程");
		return;
	}
	var totalFiles = 0;
	var totalLines = 0;
	var codeLines = 0;
	var commentLines = 0;
	var blankLines = 0;
	var files = projFiles;
	if(files && #files){
		for(i=1;#files;1){
			var fp = files[i].full : (proj.root ++ files[i].path);
			if(..io.exist(fp)){
				totalFiles = totalFiles + 1;
				var txt = ..string.load(fp);
				if(txt){
					var lines = ..string.split(txt, '\n');
					totalLines = totalLines + #lines;
					for(k=1;#lines;1){
						var trimmed = ..string.trim(lines[k]);
						if(trimmed == "") blankLines = blankLines + 1;
						elseif(..string.startsWith(trimmed, "//") || ..string.startsWith(trimmed, "/*")) commentLines = commentLines + 1;
						else codeLines = codeLines + 1;
					}
				}
			}
		}
	}
	var msg = "工程路径: " ++ proj.root ++ '\r\n\r\n'
		++ "源文件总数: " ++ totalFiles ++ " 个\r\n"
		++ "代码总行数: " ++ totalLines ++ " 行\r\n"
		++ "有效代码行: " ++ codeLines ++ " 行\r\n"
		++ "注释行数:   " ++ commentLines ++ " 行\r\n"
		++ "空行行数:   " ++ blankLines ++ " 行";
	modalBusy = true;
	..win.msgbox(msg, "Nodio IDE - 工程代码行统计");
	modalBusy = false;
};
// ---------- 事件代码生成（双击组件 / 右键「查看事件代码」） ----------
//
// 官方 IDE 的行为：设计视图里双击控件 → 切到代码视图，
// 在源码里生成（或跳到）它的事件处理函数。事件名按官方控件库的默认事件：
//   button/checkbox/radio/groupbox → oncommand        (WM_COMMAND)
//   combobox/listbox               → onSelChange      (WM_COMMAND 通知)
//   edit/richedit                  → onChange         (EN_CHANGE)
//   listview/treeview/tab          → onnotify         (WM_NOTIFY)
// （对照 D:\aardio\lib\win\ui\ctrl\*.aardio 的 _commandFuncnames /
//   事件成员文档；自定义组件可以在 registry spec 里自带 event 字段。）
var defaultEventOf = function(cls){
	var t = {
		button="oncommand"; checkbox="oncommand"; radio="oncommand"; groupbox="oncommand";
		combobox="onSelChange"; listbox="onSelChange";
		edit="onChange"; richedit="onChange";
		listview="onnotify"; treeview="onnotify"; tab="onnotify";
	};
	return cls ? t[cls] : null;
};
var eventSigOf = function(ev){
	if(ev == "onChange") return "function()";
	if(ev == "onnotify") return "function(id,code,ptr)";
	return "function(id,event)";
};
// pos（1 基字符位置）之前有几个换行 → 所在行（1 基）
var lineOfPos = function(src, pos){
	var head = ..string.left(src, pos - 1);
	var n = 1;
	for(c in ..string.gmatch(head, '\n')) n = n + 1;
	return n;
};
// 生成事件处理函数桩
//
// ev 省略 = 该控件的默认事件（双击组件 / 右键「查看事件代码」）；
// ev 指定 = 事件一览里双击的那个事件（第五十六轮）。
var genEventStub = function(item, ev){
	if(!item || !item.spec) return;
	ev = ev ? ev : (item.spec.event : defaultEventOf(item.spec.cls));
	if(!ev){ shell.setStatus("「" ++ item.spec.name ++ "」没有默认事件"); return }
	var path = shell.tabCurPath();
	if(!path){ shell.setStatus("没有打开的文档"); return }
	// 先切回代码视图：close 会把当前设计同步进文档的 DSG 块，
	// 事件代码要插在**同步后**的源码上（官方窗体里 DSG 块在前、事件代码在后）。
	designer.close();
	var src = shell.tabGetText(path);
	if(!src) return;
	// 已有这个事件的处理函数 → 只跳过去，不重复生成（官方同款行为）
	var pat = 'winform\.' ++ item.name ++ '\.' ++ ev ++ '\s*=';
	if(..string.match(src, pat)){
		shell.setStatus("已转到 " ++ item.name ++ " 的 " ++ ev ++ "（源码里已有）");
		return;
	}
	var stub = 'winform.' ++ item.name ++ '.' ++ ev ++ ' = '
		++ eventSigOf(ev) ++ '{\r\n\t\r\n}\r\n';
	// 插入点：有 DSG 块就插在块结束标记后面，没有就追加到文件末尾
	var b = ..string.indexOf(src, '/*}}*/');
	var ns, at;
	if(b !== null){
		at = b + 6;   // '/*}}*/' 共 6 个字符，插在它后面
		var tail = ..string.mid(src, at);
		// 吃掉紧跟着的行尾，避免出现空行夹层
		while(#tail && (..string.sub(tail, 1, 1) == '\r' || ..string.sub(tail, 1, 1) == '\n')){
			tail = ..string.sub(tail, 2);
		}
		ns = ..string.left(src, at - 1) ++ '\r\n' ++ stub ++ tail;
	}
	else{
		at = #src + 1;
		var nl = (#src && ..string.sub(src, #src, #src) == '\n') ? '' : '\r\n';
		ns = src ++ nl ++ stub;
	}
	shell.tabSetText(path, ns);
	// 光标落到函数体那一行（stub 的第二行），直接开写
	shell.editor.gotoLine(lineOfPos(ns, at) + 1);
	shell.setStatus("已生成 " ++ item.name ++ "." ++ ev ++ " 事件代码");
};
designer.hooks.onEventCode = genEventStub;
shell.hooks.onTabChange   = function(path){
	curFile = path;
	fillOutline();
	fillClassView();
	// 换文档 → 符号树要重拉，导航栏面包屑跟着换
	curSymTree = [ @{_type="array"} ];
	symTreeDirty = true;
	navUpdate(shell.editor.curLine);
	// 换文档：槽内标记先清掉（下一个心跳会用新文档的诊断补上）
	editorDiags = {};
	shell.editor.setDiagnostics(editorDiags);
	// LSP 跟着当前文档走（多文档：切 uri，不用重开服务）
	if(app.lspClient.isRunning() && path && ..io.exist(path)){
		app.lspClient.openDoc(path, shell.tabGetText(path));
	}
};
// 布局重排后：设计画布（覆盖层）立刻跟着编辑区走。
// 以前这条只能靠心跳兜底（relayout 里调 designer.layout），
// 布局与重排之间会差一拍；接上钩子后是即时的。
shell.hooks.onAfterLayout = function(er){
	designer.layout();
};
shell.install();
bootMark("install-done");
// 填右栏列表（标准库 / 范例 / 工具）要扫官方 lib 目录，不便宜 ——
// 正常启动改到**分阶段**里做（bootTick 第 1 拍），
// 这样窗口能先画出来。测试/演示模式仍然同步做完（截图要完整界面）。
if(isTestMode){
	fillLibrary();
	fillTools();
}
// 问题列表：双击跳到出错那一行（文件没开着就顺手打开）
shell.probList.onDoubleClick = function(row, index){
	if(!row || !row.tag) return;
	var p = row.tag.path;
	if(!p) return;
	if(shell.tabCurPath() != p){
		if(!openFile(p)) return;
	}
	if(row.tag.line) shell.editor.gotoLine(row.tag.line);
	shell.setStatus("跳到 " ++ p ++ " 第 " ++ tostring(row.tag.line) ++ " 行");
};
// 大纲：点条目跳到对应行
shell.outlineTree.onSelect = function(node){
	if(node && node.line) app.editor.gotoLine(shell.editor, node.line);
};
// 引用面板：双击跳到那一处（跨文件）
shell.refList.onDoubleClick = function(row, index){
	if(!row || !row.tag) return;
	var p = row.tag.path;
	if(!p) return;
	if(shell.tabCurPath() != p){
		if(!openFile(p)) return;
	}
	if(row.tag.line) shell.editor.gotoLineCol(row.tag.line, (row.tag.col : 0) + 1);
	shell.setStatus("跳到 " ++ navShortPath(p) ++ " 第 " ++ tostring(row.tag.line) ++ " 行");
};
if( ..string.getenv("NODIO_IDE_DIAG") ){
	io.print("DIAG outline nodes=" ++ #shell.outlineTree.nodes
		++ " path=" ++ tostring(shell.tabCurPath()));
}

// ---------- 布局自愈 ----------
// 窗口显示后官方的 DPI 缩放会把客户区从 1281x821 改成 1921x1231（物理像素），
// 官方 onSize 回调虽然会触发，但那条路径上取不到 app.shell 的模块钩子
// （跨作用域），覆盖层（设计画布）不会跟着重排 —— 于是画布只盖住编辑区
// 的一小块。这里在心跳里比较客户区尺寸，变了就整体重排一次。
//
// 心跳还要盯着 **DPI 缩放系数**：窗口拖到另一台不同缩放的显示器时，
// 官方会改缩放系数，我们的自绘层（nodio.ui.px）也要跟着换。
var lastClientW = 0, lastClientH = 0;
var lastScale = ..nodio.ui.dpiScale();
var relayout = function(){
	var t0 = ..time.tick();
	var curScale = null;
	try{ curScale = shell.winform.dpiScaleX }catch(e){}
	if(type(curScale) != "number" || curScale <= 0){
		try{
			var sx = ..gdi.getDpiScale(, shell.winform.hwnd);
			if(type(sx) == "number" && sx > 0) curScale = sx;
		}catch(e2){}
	}
	if(type(curScale) == "number" && curScale > 0 && curScale != lastScale){
		..nodio.ui.dpiSetScale(curScale);
		lastScale = curScale;
		shell.layout();
		designer.layout();
		if( ..string.getenv("NODIO_IDE_DIAG") ){
			io.print("DIAG dpi-changed scale=" ++ tostring(curScale)
				++ " cost=" ++ tostring(..time.tick() - t0) ++ "ms");
		}
	}
	var w,h = shell.clientWH();
	if(w == lastClientW && h == lastClientH) return;
	lastClientW = w; lastClientH = h;
	shell.layout();
	designer.layout();
	updateStartPane();
	if( ..string.getenv("NODIO_IDE_DIAG") ){
		io.print("DIAG relayout client=" ++ w ++ "x" ++ h
			++ " cost=" ++ tostring(..time.tick() - t0) ++ "ms");
	}
};

// ---------- 启动分阶段：先渲染，后加载 ----------
//
// 以前启动是「全部做完才显示窗口」：扫工程树、打开起始文件（67KB 源码
// + 全量语法着色）、扫官方标准库目录、起 LSP —— 全在 UI 线程上串行跑完，
// 窗口迟迟不出现，用户看到的是「半分钟白屏 / 组件半天不出来」。
//
// 现在改成：
//   第 0 拍  窗口已经显示（chrome 全部画好）→ 马上能用
//   第 1 拍  填右栏列表（标准库 / 范例 / 工具）—— 要扫官方 lib 目录
//   第 2 拍  加载工程 + 扫工程树
//   第 3 拍  打开起始文件（全量语法着色，最重的一步）
//   第 4 拍  起 LSP（握手有超时，单独一拍）
// 每一拍之间窗口都在正常跑消息循环，随时可点。
var bootStage = (isTestMode) ? 4 : 0;   // 测试/演示模式：启动已同步做完
var bootNeedProject = false;
var bootTick = function(){
	if(bootStage >= 4) return;
	bootStage = bootStage + 1;
	var t0 = ..time.tick();
	if(bootStage == 1){
		fillLibrary();
		fillTools();
	}
	elseif(bootStage == 2){
		if(bootNeedProject){
			if(!startupProject()){
				shell.setStatus("就绪（未打开工程）—— 文件 → 打开工程");
			}
		}
	}
	elseif(bootStage == 3){
		if(bootNeedProject){
			if(!startupOpenStart()){
				// 未指定工程或工程无启动文件时，自动建一个新文件让用户直接可输入可运行！
				if(!curFile && #shell.tabOrder == 0){
					newFile();
				}
			}
		}
	}
	elseif(bootStage == 4){
		lspEnsure();
	}
	if( ..string.getenv("NODIO_IDE_DIAG") ){
		// 这一拍占了多少毫秒 —— 卡顿定位的关键
		io.print("DIAG boot stage=" ++ bootStage ++ " cost=" ++ tostring(..time.tick() - t0) ++ "ms");
	}
}

// idle timer: LSP sync + diagnostics poll + 布局自愈 (single 300ms heartbeat)
//
// ⚠⚠ **回调必须显式返回 null**：
//   官方 win.form 的 WM_TIMER 处理（win/ui/_.aardio:342）是：
//       var ret = invoke(proc,this);
//       if( (ret !== null) && ( ret !== true ) ){
//           var tick = tonumber(ret)
//           if( !tick ) this.clearInterval(wParam)   ← **把定时器移除**
//       }
//   也就是说：回调返回值只要「不是 null 也不是 true」，而且转成数字是 0，
//   官方就**把这个定时器删掉** —— 静默失效，连异常都不报。
//   心跳最后一句如果落在 `if(...)` 判断上，返回值随内容变化
//   （fillOutline() / navRefreshSymTree() 返回 false 时）→ 心跳被自己杀掉：
//   于是布局不再自愈（窗口一改尺寸就是黑屏）、状态栏不再更新、LSP 不再轮询。
//
//   所以：**所有 setInterval 回调一律以 `return null;` 收尾**。
var hbTick = 0;
var hbErr = 0;
shell.winform.setInterval(function(){
	// 模态对话框开着的时候不要动 VM（对话框自己的消息循环会重入解释器）
	if(modalBusy) return null;
	hbTick = hbTick + 1;
	if( ..string.getenv("NODIO_IDE_DIAG") && (hbTick % 5 == 0) ){
		io.print("DIAG hb=" ++ hbTick);
	}
	// ⚠ 心跳里任何一处抛异常，官方 setInterval 都会**停掉这个定时器** ——
	//   于是 IDE 从此不再重绘、不再轮询 LSP、不再自愈布局：
	//   窗口改个大小就变成黑屏（自绘板还停在旧尺寸），状态栏也不再更新。
	//   所以整段包在 try 里，异常要**打出来**（原来只有编辑器那边的
	//   子类化会吞异常，心跳这一层没人管）。
	try{
		bootTick();
		relayout();
		updateStartPane();   // 开始页：矩形/可见性/最近列表（第五十三轮）
		lspSync();
		lspPoll();
		// 大纲跟着文档内容走（按键回调只标脏，重扫放在这里做）
		if(outlineDirty){
			outlineDirty = false;
			fillOutline();
			// 类视图的工程模式不被心跳清掉（切页/文档事件才重扫）
			if(classViewMode == "doc") fillClassView();
		}
		// 符号树（导航栏面包屑的层级链）同理
		if(symTreeDirty){
			navRefreshSymTree();
		}
	}
	catch(e){
		hbErr = (hbErr : 0) + 1;
		if( ..string.getenv("NODIO_IDE_DIAG") ){
			io.print("DIAG HB-ERR #" ++ hbErr ++ " tick=" ++ hbTick ++ " :" ++ tostring(e));
		}
	}
	return null;
}, 300);

// ---------- 配置持久化（%APPDATA%\Nodio\ide.cfg）----------
// 极简 key=value，一行一个键。
// 只存「上次打开的工程」这种跨会话要记住的东西。
//
// ⚠ 实现放在 app.settings（设置面板与外部工具共用同一份配置，也保证
// 官方命令面 getConfig/setConfig 与设置面板看到的是同一个文件）。
var cfgRead = function(key){ return app.settings.cfgRead(key) };
var cfgWrite = function(key, val){ return app.settings.cfgWrite(key, val) };

// ---------- 正常启动：加载工程 + 打开文档 ----------
//
// ⚠ 之前工程只在 smoke / nav / demo 三个**测试**分支里加载 ——
//   正常启动 IDE 是一片空白：工程树空的、编辑器空的、状态栏没有工程，
//   用户第一眼看到的是「什么都没发生」，等于功能残了。
//
// 现在的顺序（跟 VS 打开解决方案一致）：
//   1) NODIO_IDE_PROJECT 指定的工程
//   2) 上次打开的工程（%APPDATA%\Nodio\ide.cfg 的 lastProject）
//   3) 当前工作目录下的 *.nproj / *.aproj（以及 ide/nodio 子目录下的工程）
//   4) 都没有 → 提示「文件 → 打开工程」，编辑器留空可输入
var findProjectNearby = function(){
	var cwd = ..io.fullpath(".");
	var masks = {"*.nproj"; "*.aproj"};
	for(m=1;#masks;1){
		var files = ..io.listFiles(cwd, masks[m]) : {};
		for(i=1;#files;1){
			if(files[i].isDir) continue;
			return files[i].path;
		}
	}
	var sub = ..io.fullpath("ide/nodio");
	if(..io.exist(sub)){
		for(m=1;#masks;1){
			var files = ..io.listFiles(sub, masks[m]) : {};
			for(i=1;#files;1){
				if(files[i].isDir) continue;
				return files[i].path;
			}
		}
	}
	return null;
}
var startupProject = function(){
	var p = ..string.getenv("NODIO_IDE_PROJECT");
	if(!p) p = cfgRead("lastProject");
	if(!p) p = findProjectNearby();
	if(!p) return false;
	if(!..io.exist(p)) return false;
	proj = app.project.load(p);
	if(!proj) return false;
	projRefresh();
	shell.setProjectStatus(tostring(proj.path));
	cfgWrite("lastProject", proj.path);
	// 自定义组件直接进工具箱
	designer.discover(proj.root ++ "components");
	shell.setStatus("工程: " ++ tostring(proj.path));
	return true;
}

// 打开工程的起始文件（**单独一拍**）：
// 打开 67KB 源码要跑全量语法着色，是启动里最重的一步 ——
// 和「加载工程」分开，窗口能更早变成可交互状态。
var startupOpenStart = function(){
	if(!proj || !proj.start) return false;
	if(!..io.exist(proj.start)) return false;
	openFile(proj.start);
	return true;
}

// ---------- 官方 ide.command 外部命令面 ----------
//
// 官方 aardio.exe 注册了一张可被外部进程/插件驱动的命令表
// （docs/official-ide-reference.md §1 的 37 条）；这里把同一张表挂到
// 共享注册表上——外部工具/插件 ide.command.join() 后按名 send 即可
// 驱动本 IDE。实现闭包引用 main 的既有函数，不经 hooks 改造。
var ideCmdImpl = {};
ideCmdImpl.showStatus = function(text){
	shell.setStatus(text);
	return true;
};
ideCmdImpl.gotoLine = function(n){
	n = tonumber(n);
	if(!n) return false;
	shell.editor.gotoLine(n);
	return true;
};
ideCmdImpl.save = function(){
	saveFile();
	return true;
};
ideCmdImpl.saveAll = function(){
	saveAllFiles();
	return true;
};
ideCmdImpl.getActiveCode = function(){
	return curFile ? shell.tabGetText(curFile) : null;
};
ideCmdImpl.setActiveCode = function(text){
	if(!curFile || text === null) return false;
	shell.tabSetText(curFile, text);
	return true;
};
ideCmdImpl.insertCode = function(text){
	if(!curFile || text === null) return false;
	var e = shell.editor;
	var t = shell.tabGetText(curFile);
	var nt = e.replaceTextAt(t, e.curLine : 1, e.curCol : 1, 0, text);
	if(nt === null) return false;
	shell.tabSetText(curFile, nt);
	return true;
};
ideCmdImpl.openDocument = function(path){
	if(!path) return false;
	openFile(path);
	return true;
};
ideCmdImpl.newDocument = function(){
	if(shell.hooks.onNewFile) shell.hooks.onNewFile();
	return true;
};
ideCmdImpl.newForm = ideCmdImpl.newDocument;   // 官方语义：新建窗体文档
ideCmdImpl.getMainHwnd = function(){
	return shell.winform.hwnd;
};
ideCmdImpl.getActiveViewHwnd = function(){
	try{ return shell.editor.ctrl.hwnd }catch(e){ return shell.winform.hwnd }
};
ideCmdImpl.redrawCodeEditor = function(){
	try{ shell.editor.ctrl.invalidate() }catch(e){}
	return true;
};
ideCmdImpl.projectIsOpened = lambda() proj != null;
ideCmdImpl.isInProject = function(path){
	if(!proj || !path) return false;
	var full = ..io.fullpath(path);
	for(i=1;#proj.files;1){
		if(..io.fullpath(proj.files[i].path) == full) return true;
	}
	return false;
};
ideCmdImpl.getProjectPath = lambda() proj ? proj.path : null;
ideCmdImpl.getProjectDir  = lambda() proj ? proj.root : null;
ideCmdImpl.getProjectMainFile = lambda() proj ? proj.start : null;
ideCmdImpl.getProjectProperty = function(k){ return cfgRead("projprop." ++ (k : "")) };
ideCmdImpl.setProjectProperty = function(k, v){ return cfgWrite("projprop." ++ (k : ""), tostring(v : "")) };
ideCmdImpl.getConfig = function(k){ return cfgRead(k) };
ideCmdImpl.setConfig = function(k, v){ return cfgWrite(k, tostring(v : "")) };
ideCmdImpl.switchActiveForm = function(){
	if(shell.hooks.onDesigner) shell.hooks.onDesigner();
	return app.designer.isActive();
};
ideCmdImpl.getActiveForm = lambda() app.designer.isActive() ? "design" : "code";
ideCmdImpl.getSelectedControl = lambda() app.designer.canvasSelected();
ideCmdImpl.setSelectedControl = function(name){ return app.designer.canvasSelect(name) };
ideCmdImpl.getControlParam = function(name, k){ return app.designer.canvasGetParam(name, k) };
ideCmdImpl.setControlParam = function(name, k, v){ return app.designer.canvasSetParam(name, k, v) };
ideCmdImpl.refreshStdLib = function(){
	try{ app.library.scanLib() }catch(e){ return false }
	return true;
};
ideCmdImpl.refreshUserLib = ideCmdImpl.refreshStdLib;
ideCmdImpl.createProcessEx = function(path, args){
	var p = ..process.popen(path, args);
	return p ? p.pid : null;
};
ideCmdImpl.loadPrivateFont = function(path){
	if(!path) return false;
	// FR_PRIVATE(0x10)：进程私有字体，不写系统字体表
	var n = ::Gdi32.AddFontResourceExW(path, 0x10, 0);
	return n ? true : false;
};
ideCmdImpl.killOnExit = function(v){
	return cfgWrite("killOnExit", tostring(v : ""));
};

ideCmdImpl.pluginViewCreate = function(name, path){
	if(!name || !path) return false;
	var container = shell.rightDock.addPluginTab(name);
	if(!container) return false;
	var code = ..string.load(path);
	if(!code) return false;
	// 宿主契约（官方 pane 同款）：子窗体消息由 IDE 主循环派发，脚本尾部的
	// win.loopMessage() 机械替换为 null;（独立运行不受影响，只有 IDE 内
	// 加载走这条路径）
	var tok = "win.loopMessage()";
	var p = ..string.indexOf(code, tok);
	while(p){
		code = ..string.left(code, p - 1) ++ "null;" ++ ..string.slice(code, p + 17);
		p = ..string.indexOf(code, tok);
	}
	var fn = loadcode(code);
	if(!fn) return false;
	fn(container);   // 官方 pane 契约：parent=... 变参注入
	return true;
};
ideCmdImpl.pluginViewShow = function(name){
	return shell.rightDock.selectCaption(name);
};

app.ideCommand.init(shell.winform, ideCmdImpl);

// 内置插件页（官方 extensions/plugin/pane 的对应物）——注册失败不阻断启动
var __paneErr = null;
try{
	var __ideDir = ..io.splitpath(..string.getenv("NODIO_RUN") : "").dir;
	if(__ideDir){
		app.ideCommand.dispatch("pluginViewCreate", "助手",
			__ideDir ++ "plugins\tool.nodio");
	}
}catch(__paneErr){ io.print("PLUGIN-REG-ERR:" ++ tostring(__paneErr)); }


// ---------- smoke mode (headless test hook) ----------
if( ..string.getenv("NODIO_IDE_SMOKE") ){
	io.print("SMOKE-BRANCH");
	// DPI 缩放系数（设计坐标是逻辑像素，控件实际尺寸 = 逻辑值 × 系数）
	io.print("DPI-SCALE:" ++ tostring(..nodio.ui.dpiScale()));
	// 「立即窗口」入口自检（第五十五轮）：底部页签 + 菜单项都得在。
	// 求值功能做出来了但入口没人找得到，等于白做 —— 页签默认排在最后一位，
	// 很容易被当成「不存在」，所以把它锁进冒烟自检。
	var __imTab = shell.dockHasTab ? shell.dockHasTab("立即") : false;
	io.print("IMMEDIATE-TAB:" ++ (__imTab ? "OK" : "MISSING"));
	// 监视窗/变量树入口自检（第五十九轮续）：同「立即窗口」的教训——
	// 页签排在最后两位最容易被当成「不存在」，锁进冒烟自检。
	var __wTab = shell.dockHasTab ? shell.dockHasTab("监视") : false;
	io.print("WATCH-TAB:" ++ (__wTab ? "OK" : "MISSING"));
	var __vTab = shell.dockHasTab ? shell.dockHasTab("变量") : false;
	io.print("VARS-TAB:" ++ (__vTab ? "OK" : "MISSING"));
	// 监视窗/变量树**面板逻辑**自检（第五十九轮续）：没有调试会话，
	// 注入假求值器/假数据源——锁 add→求值→计数、树重建→懒展开两条链。
	if(shell.watchPanel){
		shell.watchPanel.clearAll();
		shell.watchPanel.setEvaluator(function(expr){
			return { value = tostring(expr) ++ "!"; type = "number" };
		});
		shell.watchPanel.add("1+2");
		io.print("WATCH-ADD:" ++ ((shell.watchPanel.count() == 1) ? "OK" : "FAIL"));
		shell.watchPanel.clearAll();
	}
	if(shell.varsPanel){
		shell.varsPanel.setProvider(function(){
			return {
				{ name = "x"; value = "7"; type = "number"; ref = 0 };
				{ name = "t"; value = "table"; type = "table"; ref = 101 };
			};
		});
		shell.varsPanel.setChildren(function(ref){
			return { { name = "a"; value = "1"; type = "number"; ref = 0 } };
		});
		shell.varsPanel.refresh();
		io.print("VARS-TREE:" ++ ((#shell.varsPanel.tr.nodes == 2) ? "OK" : "FAIL"));
		var __t2 = shell.varsPanel.tr.nodes[2];
		shell.varsPanel.tr.toggle(__t2);
		var __ok = __t2.expanded && #__t2.children == 1;
		io.print("VARS-LAZY:" ++ (__ok ? "OK" : "FAIL"));
	}
	var __ml = shell.menuLabels ? shell.menuLabels() : {};
	var __imMenu = false;
	for(__imI=1;#__ml;1){
		if(..string.indexOf(tostring(__ml[__imI] : ""), "立即窗口") > 0){
			__imMenu = true;
			break;
		}
	}
	io.print("IMMEDIATE-MENU:" ++ (__imMenu ? "OK" : "MISSING"));
	var __wMenu = false;
	for(__imI=1;#__ml;1){
		if(..string.indexOf(tostring(__ml[__imI] : ""), "监视窗口") > 0){
			__wMenu = true;
			break;
		}
	}
	io.print("WATCH-MENU:" ++ (__wMenu ? "OK" : "MISSING"));
	var target = ..io.fullpath(..string.getenv("TEMP") ++ "/nodio_ide_smoke.aardio");
	app.editor.setText(shell.editor, `io.print("ide-smoke-echo")`);
	..io.writeFile(target, app.editor.text(shell.editor));
	io.print("SMOKE-FILE:" ++ target);

	// exercise the new tab model headlessly
	shell.tabAdd(target, app.editor.text(shell.editor));
	io.print("TAB-COUNT:" ++ #shell.tabOrder);
	io.print("TAB-CUR:" ++ tostring(shell.tabCurPath()));

	// 文档闭环（无交互的那一半）：脏标记 / 文本 / 保存文本 / 行号栏
	io.print("DOC-DIRTY-INIT:" ++ tostring(shell.tabIsDirty(target)));
	shell.tabSetDirty(target, true);
	io.print("DOC-DIRTY-SET:" ++ tostring(shell.tabIsDirty(target)));
	io.print("DOC-TEXT-LEN:" ++ tostring(..string.len(shell.tabGetText(target))));
	io.print("DOC-SAVE-LEN:" ++ tostring(..string.len(shell.tabTextForSave(target))));
	io.print("DOC-GUTTER:" ++ tostring(shell.editor.gutterWidth()));
	io.print("DOC-LINES:" ++ tostring(shell.editor.control().lineCount));
	// 编辑器组件的行列号回调 → 状态栏
	shell.editor.gotoLine(1);
	io.print("DOC-CURSOR:" ++ tostring(shell.statusbar.panels[2].text));
	// 缩进 / 注释命令（真实改动文本）
	shell.editor.indent();
	io.print("DOC-INDENT-LEN:" ++ tostring(..string.len(shell.editor.getText())));
	shell.editor.toggleComment();
	io.print("DOC-COMMENT-LEN:" ++ tostring(..string.len(shell.editor.getText())));
	shell.editor.undo();
	io.print("DOC-UNDO-LEN:" ++ tostring(..string.len(shell.editor.getText())));
	// 编辑器字号：三处必须一致 —— 主编辑器 / 设置里的值 / 分栏对比编辑器。
	// （分栏那个曾经硬编码 11，用户改字号时左右两半对不上。）
	io.print("DOC-FONT:" ++ tostring(shell.editor.getFontSize())
		++ "/" ++ tostring(app.settings.fontSizeGet()));
	var ed2 = shell.getEditor2();
	io.print("DOC-FONT-DIFF:" ++ tostring(ed2 ? ed2.getFontSize() : -1));

	// layout + docks (only contract-documented members are asserted)
	io.print("DOCK-LEFT-STRIP:" ++ tostring(shell.leftDock.strip ? 1 : 0));
	io.print("DOCK-RIGHT-CONTENT:" ++ tostring(shell.rightDock.content(1) ? 1 : 0));
	io.print("DOCK-BOTTOM-CONTENT:" ++ tostring(shell.bottomDock.content(2) ? 1 : 0));

	// 插件视图（官方 pluginViewCreate/Show 契约：loadcode + parent=... 注入）
	try{
		var pluginPath = ..io.fullpath(..string.getenv("TEMP") ++ "/nodio_ide_plugin.nodio");
		..io.writeFile(pluginPath, `import win.ui;
mainForm = win.form(text="SmokePane";right=270;bottom=400;bgcolor=0x333333;border="none";exmode="none";mode="child";parent=...)
mainForm.add(
	btn={cls="button";text="ok";left=10;top=10;right=110;bottom=40}
);
mainForm.show();
win.loopMessage();`);
		io.print("PLUGIN-CREATE:" ++ tostring(app.ideCommand.dispatch("pluginViewCreate", "SmokePane", pluginPath)));
		io.print("PLUGIN-SHOW:" ++ tostring(app.ideCommand.dispatch("pluginViewShow", "SmokePane")));
		var __paneFound = false;
		for(i=1;#shell.rightDock.tabs;1){
			if(shell.rightDock.tabs[i] == "SmokePane") __paneFound = true;
		}
		io.print("PLUGIN-TAB:" ++ tostring(__paneFound));
	}catch(eP2){ io.print("PLUGIN-ERR:" ++ tostring(eP2)); }
	io.print("LAYOUT-OK:" ++ tostring(shell.clientWH()));

	// 几何断言：自绘组件与官方控件必须落在预期位置
	// （官方 win.ui 的 setPos 是 x,y,宽,高；引擎原生是 l,t,r,b —— 混用就歪）
	var rectOf = function(ctrl){
		if(!ctrl) return "null";
		var r = ctrl.getRect();
		if(!r) return "norec";
		return r.left ++ "," ++ r.top ++ "," ++ r.right ++ "," ++ r.bottom;
	}
	io.print("GEO-ED:" ++ rectOf(shell.winform.ed));
	io.print("GEO-DOCSTRIP:" ++ rectOf(shell.docStrip.board.ctrl));
	io.print("GEO-LEFTSTRIP:" ++ rectOf(shell.leftDock.strip.board.ctrl));
	io.print("GEO-RIGHTSTRIP:" ++ rectOf(shell.rightDock.strip.board.ctrl));
	io.print("GEO-BOTTOMSTRIP:" ++ rectOf(shell.bottomDock.strip.board.ctrl));
	io.print("GEO-STATUS:" ++ rectOf(shell.statusbar.board.ctrl));
	io.print("GEO-TOOLBAR:" ++ rectOf(shell.toolbar.buttons.new));
	var rectOfHwnd = function(hwnd){
		if(!hwnd) return "null";
		var r = ..win.getRect(hwnd);
		if(!r) return "norec";
		return r.left ++ "," ++ r.top ++ "," ++ r.right ++ "," ++ r.bottom;
	}
	io.print("GEO-LEFTPAGE:" ++ rectOf(shell.leftDock.pages[1].ctrl));
	io.print("GEO-RIGHTPAGE:" ++ rectOf(shell.rightDock.pages[1].ctrl));
	io.print("GEO-BOTTOMPAGE:" ++ rectOf(shell.bottomDock.pages[1].ctrl));
	io.print("GEO-EDVIS:" ++ tostring(..win.isVisible(shell.winform.ed.hwnd)));
	io.print("GEO-RIGHTSTRIPVIS:" ++ tostring(..win.isVisible(shell.rightDock.strip.board.ctrl.hwnd)));
	var cr = shell.winform.getClientRect();
	io.print("GEO-CLIENT:" ++ cr.left ++ "," ++ cr.top ++ "," ++ cr.right ++ "," ++ cr.bottom);
	var wr = ..win.getRect(shell.winform.hwnd, true);
	io.print("GEO-WINDOW:" ++ wr.left ++ "," ++ wr.top ++ "," ++ wr.right ++ "," ++ wr.bottom);

	// designer: register a custom component and add it to the canvas
	var spec = nodio.designer.registry.register({
		name = "冒烟按钮";
		cls = "button";
		category = "自定义";
		props = {{"text";"标题";"string"};{"width";"宽度";"number"};
			{"height";"高度";"number"};{"left";"左边";"number"};{"top";"上边";"number"}};
	});
	var item = designer.canvas.add(spec, {x=10;y=10;w=100;h=24});
	io.print("DESIGNER-ITEM:" ++ tostring(item ? item.name : "null"));
	io.print("DESIGNER-DSG:" ++ tostring(designer.toDSG()));
	io.print("TOOLBOX-COUNT:" ++ tostring(#nodio.designer.registry.list()));

	// 属性格回写：改「宽度」→ 组件矩形和控件宽度都要跟着变
	if(item){
		designer.canvas.select(item.name);
		var wIdx = 0;
		for(i=1;#item.props;1){
			if(item.props[i].key == "width") wIdx = i;
		}
		if(wIdx){
			item.props[wIdx].value = "160";
			designer.canvas.applyProps(item);
			var ir = item.ctrl.getRect();
			io.print("PROP-WRITEBACK:item=" ++ item.w
				++ " ctrl=" ++ (ir.right - ir.left)
				++ " prop=" ++ tostring(item.props[wIdx].value));
		}
		// 文本回写
		var tIdx = 0;
		for(i=1;#item.props;1){
			if(item.props[i].key == "text") tIdx = i;
		}
		if(tIdx){
			item.props[tIdx].value = "回写文本";
			designer.canvas.applyProps(item);
			io.print("PROP-TEXT:" ++ tostring(item.ctrl.text));
		}
	}

	// DSG 往返：数值保持数值、字符串保持字符串，再生成一次结果不变
	var dsg1 = designer.toDSG();
	var back = nodio.designer.dsg.parse(dsg1);
	var dsg2 = nodio.designer.dsg.generate((function(){
		var arr = {};
		for(i=1;#back;1){
			var b = back[i];
			var pr = {};
			for(k,v in b.props){
				if(k == "left" || k == "top" || k == "right" || k == "bottom") continue;
				pr[k] = v;
			}
			..table.push(arr, {name=b.name; cls=b.cls; props=pr;
				x = tonumber(b.props.left) : 0;
				y = tonumber(b.props.top) : 0;
				w = (tonumber(b.props.right) : 0) - (tonumber(b.props.left) : 0);
				h = (tonumber(b.props.bottom) : 0) - (tonumber(b.props.top) : 0);
			});
		}
		return arr;
	})(), designer.formGet().text, designer.formGet().w, designer.formGet().h, designer.formGet().bgcolor);
	// 第五十一轮：dsg2 生成带上真实窗体状态——原来单参调用靠「generate
	// 默认值恰好等于画布默认」的巧合对齐，toDSG 把 bgcolor 写进头部后
	// 巧合破产（套件里必挂、单跑偶挂的 DSG round-trip 假红）。带上状态
	// 后断言反而更强：头部字段也参与字节级往返校验。
io.print("DSG-ROUNDTRIP:" ++ tostring(dsg1 == dsg2) ++ " items=" ++ #back);
	var types = {};
	for(i=1;#back;1){
		for(k,v in back[i].props){ types[k] = type(v) }
	}
	io.print("DSG-TYPES:left=" ++ tostring(types.left) ++ " text=" ++ tostring(types.text));

	// 官方词库接入（第五十一轮）：onComplete 合并词库条目——
	// 用词库前缀直呼 onComplete，候选里必须出现 kernel.txt 的常量
	shell.editor.onComplete(1, 5, "_AARD");
	var compLib = false;
	for(i=1;#shell.editor.compItems;1){
		if(shell.editor.compItems[i].label == "_AARDIO_VERSION") compLib = true;
	}
	io.print("INTEL-ENTRY:" ++ tostring(compLib));

	// 打印管线（第五十六轮）：页数测量走默认打印机 DC 的
	// EM_FORMATRANGE 测量遍历（无打印机/无法取 DC → 0，断言只验链路）
	io.print("PRINT-PAGES:" ++ tostring(shell.editor.pageCount()));

	// 类视图（第五十一轮）：class → 成员函数 + 顶层变量的层级扫描。
	// 测完恢复编辑器原文，别让后面的段落读到夹具。
	app.editor.setText(shell.editor, `class demoCls{` ++ '\r\n' ++ `	mf = function(){` ++ '\r\n' ++ `	}` ++ '\r\n' ++ `}` ++ '\r\n' ++ `topVar = 1;`);
	fillClassView();
	var cvRoots = shell.classTree.nodes;
	var bCls = false;
	var bMem = false;
	var bTop = false;
	if(#cvRoots >= 2){
		bCls = cvRoots[1].text == "demoCls";
		bMem = #cvRoots[1].children == 1 and cvRoots[1].children[1].text == "mf";
		bTop = cvRoots[2].text == "topVar";
	}
	io.print("CLASSVIEW:" ++ tostring(bCls) ++ tostring(bMem) ++ tostring(bTop));
	app.editor.setText(shell.editor, `io.print("ide-smoke-echo")`);
	fillClassView();

	// 模板面板（第五十二轮）：双击模板 → 新建文档落内容；测完关掉
	// 模板页签，别把后面的 TABSTRIP-COUNT 顶爆
	shell.templatesList.onDoubleClick({ tag = fileTemplates[2] }, 1);
	var tplText = shell.tabGetText(shell.tabCurPath());
	io.print("TPL-NEW:" ++ tostring(..string.indexOf(tplText, "console.log") !== null));
	shell.tabClose(shell.tabCurPath());
	app.editor.setText(shell.editor, `io.print("ide-smoke-echo")`);

	// 自绘页签：增删
	io.print("TABSTRIP-COUNT:" ++ tostring(shell.docStrip.count()));
	shell.docStrip.addTab("临时页签");
	io.print("TABSTRIP-AFTER-ADD:" ++ tostring(shell.docStrip.count()));
	shell.docStrip.removeTab(shell.docStrip.count());
	io.print("TABSTRIP-AFTER-REMOVE:" ++ tostring(shell.docStrip.count()));

	// ---------- 事件代码生成（设计器双击组件的代码路径） ----------
	//
	// 官方 IDE 的行为：双击控件 → 切到代码视图，源码里出现（或跳到）
	// 它的事件处理函数。冒烟直接驱动 hooks.onEventCode（= 双击回调走的同一条路）。
	if(item){
		designer.hooks.onEventCode(item);
		var stubKey = 'winform.button1.oncommand = function(id,event)';
		io.print("EVENT-STUB:" ++ tostring(..string.indexOf(shell.tabGetText(target), stubKey) !== null ? 1 : 0));
		// 再来一次：已有处理函数只跳转，不重复生成
		designer.hooks.onEventCode(item);
		var stubCnt = 0;
		for(x in ..string.gmatch(shell.tabGetText(target), 'winform\.button1\.oncommand')) stubCnt = stubCnt + 1;
		io.print("EVENT-STUB-DUP:" ++ stubCnt);
		// 双击 = 切回代码视图（设计器收起）
		io.print("EVENT-CODE-VIEW:" ++ tostring(designer.visible ? 0 : 1));
	}

	// ---------- 事件一览（第五十六轮） ----------
	//
	// 选中控件 → 左栏「事件」页列出它支持的事件；双击某个事件 →
	// 生成那个事件的处理函数桩。
	//
	// ① 事件清单（button：通用 oncommand/onnotify）
	designer.canvas.select(item.name);
	var __evs = app.designer.eventItems();
	var __evCnt = 0, __hasCmd = 0;
	for(ei=1;#__evs;1){
		__evCnt = __evCnt + 1;
		if(__evs[ei].tag == "oncommand") __hasCmd = 1;
	}
	io.print("EVENT-LIST:" ++ __evCnt ++ "/" ++ tostring(__hasCmd));
	// ② 事件表对齐官方：edit 有 onChange / onFocusGot（官方 edit.aardio:104）
	var __editEvs = nodio.designer.registry.eventsOf("edit");
	var __hasChg = 0, __hasFocus = 0;
	for(ej=1;#__editEvs;1){
		if(__editEvs[ej] == "onChange") __hasChg = 1;
		if(__editEvs[ej] == "onFocusGot") __hasFocus = 1;
	}
	io.print("EVENTS-EDIT:" ++ tostring(__hasChg) ++ tostring(__hasFocus));
	// ③ 指定事件生成桩（事件一览里双击 onSelChange）
	if(item){
		designer.hooks.onEventCode(item, "onSelChange");
		var evStub = 'winform.' ++ item.name ++ '.onSelChange = function(id,event)';
		io.print("EVENT-STUB-EV:" ++ tostring(
			..string.indexOf(shell.tabGetText(target), evStub) !== null ? 1 : 0));
	}

	// ---------- 设计 ↔ 源码同步（switchActiveForm 语义） ----------
	//
	// 开设计器 = 从源码载入设计块；关设计器 = 把当前设计写回源码。
	// 用一个独立页签验证两个方向（加页签的断言都放在页签计数之后，见上）。
	var syncPath = ..io.fullpath(..string.getenv("TEMP") ++ "/nodio_ide_sync.nodio");
	var syncSrc = '// sync 测试\r\n' ++ designer.toDSG() ++ '\r\nio.print("sync-ok");\r\n';
	..string.save(syncPath, syncSrc);
	shell.tabAdd(syncPath, syncSrc);
	designer.open();   // 设计视图：应自动从源码载入 1 个组件
	io.print("SYNC-ITEMS:" ++ tostring(designer.canvas ? #designer.canvas.items : -1));
	var syncOk = 0;
	if(designer.canvas && #designer.canvas.items){
		var sit = designer.canvas.items[1];
		designer.canvas.select(sit.name);
		var swIdx = 0;
		for(i=1;#sit.props;1){ if(sit.props[i].key == "width") swIdx = i }
		if(swIdx){
			// 走属性格回写这条真实链路把宽度改成 222
			designer.propGrid.onChange(swIdx, "222");
			designer.close();   // 切回代码视图 → 当前设计写回源码
			var stxt = shell.tabGetText(syncPath);
			syncOk = (..string.indexOf(stxt, 'right=' ++ (sit.x + 222)) !== null) ? 1 : 0;
			// 设计块只有一份（同步是替换，不是追加）
			var blocks = 0;
			for(x in ..string.gmatch(stxt, '/\*DSG\{\{\*/')) blocks = blocks + 1;
			io.print("SYNC-BLOCKS:" ++ blocks);
		}
		else{ designer.close() }
	}
	io.print("SYNC-WRITEBACK:" ++ tostring(syncOk));

	// ---------- 官方 ide.customCtrl 替身映射 / 窗体设置 / 网格吸附 ----------
	// 1) 映射表本身（官方 lib/ide/customCtrl.aardio 原文照抄）
	io.print("CUSTOMCTRL-MAP:" ++ tostring(nodio.designer.registry.customCtrl.textbox));
	// 2) DSG 里的官方自定义类（textbox）：Nodio 用 edit 代画，
	//    **DSG 仍写真实类名** —— 官方工程画得出，写回官方也认
	var tDsg = '/*DSG{{*/\r\nwinform = win.form(text="窗体";right=400;bottom=300)\r\nwinform.add(\r\n\ttextbox1={cls="textbox";text="输入";left=10;top=10;right=110;bottom=30}\r\n)\r\n/*}}*/\r\n';
	designer.canvas.fromDSG(tDsg);
	var tIt = (#designer.canvas.items ? designer.canvas.items[1] : null);
	io.print("CUSTOMCTRL-DRAW:" ++ (tIt ? tostring(tIt.spec.cls) ++ "/" ++ tostring(tIt.spec.drawAs) : "none"));
	// 3) 窗体设置：选中窗体本身 → 属性格改 标题/宽度/高度 → DSG 头跟着变
	designer.canvas.selectForm();
	designer.propGrid.onChange(1, "登录窗口");
	designer.propGrid.onChange(2, "800");
	designer.propGrid.onChange(3, "600");
	var fds = designer.toDSG();
	io.print("FORM-SET:"
		++ ((..string.indexOf(fds, 'text="登录窗口"') !== null) ? 1 : 0)
		++ ((..string.indexOf(fds, 'right=800') !== null) ? 1 : 0)
		++ ((..string.indexOf(fds, 'bottom=600') !== null) ? 1 : 0));
	// 4) 网格吸附：30 → 32（1.875 逐进），33 → 32（2.0625 逐退）
	io.print("SNAP:" ++ tostring(designer.canvas.__snap(30)) ++ "/" ++ tostring(designer.canvas.__snap(33)));

	// 5) 设置面：编辑器字号**即时生效** + 配置往返（配置路径由 NODIO_IDE_CFG 隔离）
	var __f0 = shell.editor.getFontSize();
	var __fOk = shell.editor.setFontSize(13) ? 1 : 0;
	io.print("SET-FONT:" ++ tostring(__fOk) ++ "/" ++ tostring(shell.editor.getFontSize()));
	app.settings.fontSizeSet(13);
	io.print("SET-FONT-CFG:" ++ tostring(app.settings.fontSizeGet()));
	io.print("SET-THEME:" ++ app.settings.themeGet());
	io.print("SET-TOOLS:" ++ #app.settings.toolsGet());
	// 还原（别把冒烟跑出来的字号留给用户）
	shell.editor.setFontSize(__f0);
	app.settings.fontSizeSet(__f0);

	// 钩子链路：shell.hooks.onOpenFile → main.nodio 的 openFile → 真的打开页签
	// （以前这条链是**死的**：模块级的钩子被模块帧的局部副本遮蔽，
	//   外部 app.shell.onX = f 灌不进来 —— 工具条/菜单/快捷键/工程树全废）
	// ⚠ 放在页签计数断言**之后**：它会真的多开一个页签。
	var hookTarget = ..io.fullpath(..string.getenv("TEMP") ++ "/nodio_ide_hook.aardio");
	..io.writeFile(hookTarget, `io.print("hook-open-ok")`);
	shell.hooks.onOpenFile(hookTarget);
	io.print("SMOKE-HOOK-OPEN:" ++ tostring(shell.tabCurPath()));
	// 最近文件：openFile 链路应已自动入队；再 push 两次验证置顶/去重/菜单重建
	var rc0 = app.settings.recentGet();
	var autoIn = 0;
	for(i=1;#rc0;1){ if(rc0[i] == hookTarget){ autoIn = 1; break } }
	io.print("RECENT-AUTO:" ++ autoIn);
	app.settings.recentPush(hookTarget);   // 置顶（后面 PROJOPS 段可能开过别的文档）
	var rc1 = app.settings.recentGet();
	io.print("RECENT-TOP-OK:" ++ tostring((#rc1 >= 1 && rc1[1] == hookTarget) ? 1 : 0));
	var n1 = #rc1;
	app.settings.recentPush(hookTarget);
	var rc2 = app.settings.recentGet();
	io.print("RECENT-DUP-OK:" ++ tostring((#rc2 == n1 && rc2[1] == hookTarget) ? 1 : 0));
	shell.refreshRecentMenu();
	var lbls = shell.fileMenuLabels();
	var menuHit = 0;
	for(i=1;#lbls;1){ if(lbls[i] == "1.  " ++ hookTarget) menuHit = 1 }
	io.print("RECENT-MENU-HIT:" ++ menuHit);
	// optional: prove the project model loads (NODIO_IDE_PROJECT=<*.nproj>)
	var smokeProj = ..string.getenv("NODIO_IDE_PROJECT");
	if(smokeProj){
		proj = app.project.load(smokeProj);
		if(proj){
			var tn = projRefresh();
			io.print("PROJ-FILES:" ++ tostring(proj.count));
			io.print("PROJ-START:" ++ tostring(proj.start));
			// 类视图工程级扫描（第五十二轮）：ide.nproj 真跑——
			// 每个工程文件的 class/namespace 挂到文件节点之下
			fillClassViewProject();
			io.print("CVPROJ-N:" ++ tostring(#shell.classTree.nodes));
			io.print("TREE-CTRL:" ++ tostring(shell.projTree.ctrl ? 1 : 0));
			io.print("TREE-NODES:" ++ tostring(tn));
			io.print("SEARCH-SCOPE:" ++ tostring(#shell.searchPanel.files));
			// 搜索面板：真跑一次搜索（工程内全文搜索）
			var hits = shell.searchPanel.search("function");
			io.print("SEARCH-HITS:" ++ tostring(hits));
			io.print("SEARCH-ROWS:" ++ tostring(#shell.searchPanel.list.rows));
			// 工程清单维护：增删改 + 写回（用临时工程文件，不碰真工程）
			// ⚠ 写进 TEMP 而不是仓库里：冒烟要验证的是「清单增删改 + 写回」
			//   这条链路本身，工程文件落在哪个盘不该影响结果
			//   （只读检出 / CI 临时目录 / 沙箱里仓库不可写时同样能跑）。
			var tmpProj = ..string.getenv("TEMP") ++ "\_tmp_proj.nproj";
			..string.save(tmpProj, 'f?xml version="1.0" encoding="utf-8"?>\n'
				++ '<project start="main.nodio">\n\t<file path="main.nodio" />\n'
				++ '\t<file path="app\\a.nodio" />\n</project>\n');
			var pm = app.project.load(tmpProj);
			io.print("PROJOPS-COUNT:" ++ tostring(pm.count));
			app.project.addFile(pm, "app\b.nodio");
			app.project.renameFile(pm, "app\a.nodio", "app\c.nodio");
			app.project.save(pm);
			var pm2 = app.project.load(tmpProj);
			io.print("PROJOPS-AFTER:" ++ tostring(pm2.count));
			io.print("PROJOPS-PATHS:" ++ pm2.files[2].path ++ "," ++ pm2.files[3].path);
			app.project.removeFile(pm2, "app\b.nodio");
			app.project.save(pm2);
			var pm3 = app.project.load(tmpProj);
			io.print("PROJOPS-REMOVED:" ++ tostring(pm3.count));
			io.print("PROJOPS-REL:" ++ tostring(app.project.relPath(pm3, pm3.root ++ "app\c.nodio")));
			io.print("PROJOPS-START:" ++ tostring(pm3.start));
			..io.remove(tmpProj);
		}else{
			io.print("PROJ-LOAD-FAILED");
		}
	}

	// ---------- AI 面板：端到端发两条（成功 + 失败）----------
	//
	// 目的：证明「填输入 → 发送 → 回包 → 落日志 → 记进会话」这条链在
	// **面板层**是通的（库层由 tests/ide_ai 单独锁）。
	//
	// 两条路径：
	//   ① **成功**：base_url 指向本地 mock 服务器（tests/ai_mock_server.py，
	//      端口由 ide_smoke.ps1 起好后用 NODIO_IDE_AI_MOCK_PORT 传进来）
	//      → 必须出现「AI: MOCK-OK …」，会话里多出一条 assistant 消息。
	//      断言的是**面板的成功分支**（原来只测过失败分支）。
	//   ② **失败**：base_url 指向 127.0.0.1:1（本机没人监听这个端口）
	//      → 连接必然失败 → 必须出现一条「[错误]」。
	//   两条都不依赖外网 ✅
	//
	// ⚠⚠ 只有在凭据名是**隔离的测试名**时才发：
	//   这条链要写一条 API Key 凭据，冒烟结束时还会删掉它 ——
	//   要是打的是用户自己配的那条 "NodioIDE/ai/apiKey"，就把它抹了。
	//   tests/ide_smoke.ps1 设的 NODIO_AI_CRED_TARGET=NodioIDE/test/ide_smoke
	//   才满足这个条件；不满足就整段跳过（AI-SEND-SKIP:1）。
	var aiCredTarget = ..string.getenv("NODIO_AI_CRED_TARGET");
	var aiIsolated = aiCredTarget && #aiCredTarget
		&& ..string.indexOf(aiCredTarget, "/test/") ? 1 : 0;
	// 关窗定时器要等 AI 断言跑完（见下面那段轮询）
	var aiCheckDone = false;
	// mock 服务器在不在（没有 Python / 没起 mock 时降级成「只测失败路径」）
	var aiMockPort = ..string.getenv("NODIO_IDE_AI_MOCK_PORT");
	var aiHasMock = aiMockPort && #aiMockPort ? 1 : 0;
	if(aiIsolated){
		try{
			// 启动时对话必须是空的（这条要在发消息**之前**断言）
			io.print("AI-SESSION-INIT:" ++ tostring(#shell.aiPanel.session.messages));
			nodio.ai.cred.apiKeySet("sk-smoke-test");
			if(aiHasMock){
				shell.aiPanel.session.baseUrl = "http://127.0.0.1:" ++ aiMockPort ++ "/v1";
				shell.aiPanel.session.model = "mock-model";
				..nodio.ui.setCtrlText(shell.aiPanel.input, "冒烟-成功");
				shell.aiPanel.send();
				io.print("AI-SEND-START:1");
				io.print("AI-SEND-MOCK:1");
			}
			else{
				// 没有 mock：直接走失败路径（连没人监听的端口）
				shell.aiPanel.session.baseUrl = "http://127.0.0.1:1/v1";
				shell.aiPanel.session.model = "smoke-model";
				..nodio.ui.setCtrlText(shell.aiPanel.input, "冒烟-失败");
				shell.aiPanel.send();
				io.print("AI-SEND-START:1");
				io.print("AI-SEND-MOCK:0");
			}
		}
		catch(eAi){
			io.print("AI-SEND-START:0");
			io.print("AI-SEND-EXC:" ++ tostring(eAi));
		}
	}
	else{
		io.print("AI-SEND-SKIP:1");
	}

	// ---------- 发布链路（端到端）：IDE 入口 → 发布器 → 独立 exe 跑起来 ----------
	// runner 是单槽：先发布、后 F5 回声（下面那个 600ms 定时器等 pubDone）。
	// 产物内容带**每次不同的 token** —— 旧的发布产物混进来也骗不过 PUB-RUN。
	var pubExe = ..io.fullpath(..string.getenv("TEMP") ++ "/nodio_ide_smoke_pub.exe");
	var pubToken = "pubtok-" ++ tostring(..time.tick());
	var pubSrc = ..io.fullpath(..string.getenv("TEMP") ++ "/nodio_ide_smoke_pub.aardio");
	..string.save(pubSrc, 'io.print("' ++ pubToken ++ '")');
	var pubDone = false;
	publishRun(pubSrc, pubExe, null, false);
	io.print("PUB-START:" ++ tostring(runner.isRunning() ? 1 : 0));

	var pubTicks = 0;
	shell.winform.setInterval(function(){
		pubTicks = pubTicks + 1;
		if(pubDone) return null;
		// 最多等 30s（75 × 400ms）；发布器正常 1~2s 就完
		if(!outCtl.contains("[发布结束]") && pubTicks < 75) return null;
		if(!outCtl.contains("[发布结束]")){
			io.print("PUB-EXE:0");
			io.print("PUB-RUN:0");
			io.print("PUB-TIMEOUT:1");
			pubDone = true;
			return null;
		}
		io.print("PUB-EXE:" ++ tostring(..io.exist(pubExe) ? 1 : 0));
		var runOk = 0;
		// ⚠ IDE 进程带着 NODIO_RUN（跑 IDE 自己的脚本），子进程会继承 ——
		//   main.cpp 里 NODIO_RUN harness（464 行）在 payload 模式（586 行）
		//   **之前**，不清掉的话发布产物会去跑 IDE 脚本而不是自己的 payload。
		//   popen 的 startInfo 塞 environment 表实测报错（popen.aardio:63 .indexOf），
		//   改走「spawn 前后临时清父进程 env」：定时器回调同线程同步执行，无重入风险；
		//   置空串 ≡ 删除变量 → main.cpp 的 `> 0` 判定等于未设置。
		var envNames = {"NODIO_RUN";"NODIO_PUBLISH";"NODIO_PUBOUT";"NODIO_LIBDIR"};
		var envOld = {};
		for(i=1;#envNames;1){
			envOld[i] = ..string.getenv(envNames[i]);
			..string.setenv(envNames[i], "");
		}
		var p = null;
		var pubExc = null;
		try{ p = ..process.popen('"' ++ pubExe ++ '"') }catch(ePub){ pubExc = ePub }
		for(i=1;#envNames;1){ ..string.setenv(envNames[i], envOld[i] : "") }
		if(pubExc){ io.print("PUB-EXC:" ++ tostring(pubExc)) }
		if(p){
			try{
				var acc = "";
				for(i=1;50;1){
					var o,e = p.peek(50);
					if(o && #o) acc = acc ++ o;
					if(e && #e) acc = acc ++ e;
					if(p.process.waitOne(0)){
						var o2,e2 = p.peek(0);
						if(o2 && #o2) acc = acc ++ o2;
						if(e2 && #e2) acc = acc ++ e2;
						break;
					}
				}
				p.close();
				runOk = ..string.indexOf(acc, pubToken) ? 1 : 0;
				if(!runOk) io.print("PUB-OUT:" ++ acc);
			}catch(ePub){ io.print("PUB-EXC:" ++ tostring(ePub)) }
		}
		io.print("PUB-RUN:" ++ tostring(runOk));
		pubDone = true;
		return null;
	},400);

	shell.winform.setInterval(function(){
		if(!pubDone) return null;   // 等发布链路走完（runner 单槽，别去抢）
		try{ runner.run(target) }catch(e){ io.print("RUN-ERR:" ++ tostring(e)) };
		return null;   // 官方 WM_TIMER 会按返回值决定是否移除定时器
	},600);
	shell.winform.setInterval(function(){
		if(!runner.isRunning() && outCtl.contains("[运行结束]") && pubDone && aiCheckDone){
			var ok = outCtl.contains("ide-smoke-echo") ? "OK" : "NO-ECHO";
			..string.setenv("NODIO_IDE_SMOKE_RESULT",ok);
			io.print("IDE-SMOKE-" ++ ok);
			io.print("SMOKE-OUT:" ++ outCtl.getText());
			shell.winform.close();
		}
	},1200);

	// 显示后再查一次可见性（窗口 show 之前查没有意义）
	shell.winform.setInterval(function(){
		io.print("VIS-LEFT:" ++ tostring(..win.isVisible(shell.leftDock.strip.board.ctrl.hwnd)));
		io.print("VIS-RIGHT:" ++ tostring(..win.isVisible(shell.rightDock.strip.board.ctrl.hwnd)));
		io.print("VIS-BOTTOM:" ++ tostring(..win.isVisible(shell.bottomDock.strip.board.ctrl.hwnd)));
		io.print("VIS-DOC:" ++ tostring(..win.isVisible(shell.docStrip.board.ctrl.hwnd)));
		io.print("VIS-ED:" ++ tostring(..win.isVisible(shell.winform.ed.hwnd)));
		io.print("VIS-TOOLBOX:" ++ tostring(..win.isVisible(shell.rightDock.pages[1].ctrl.hwnd)));
		// AI 页签：切过去面板内容应当显示，切回来应当隐藏
		// （面板给 dock 的是「可见性代理」，dock 只切这一个 ctrl）
		// AI 页索引动态查找——右栏页签会增（第五十二轮加了「模板」）
		var aiIdx = 1;
		for(i=1;#shell.rightDock.tabs;1){
			if(shell.rightDock.tabs[i] == "AI") aiIdx = i;
		}
		shell.rightDock.setSelIndex(aiIdx);
		var aiOn = ..win.isVisible(shell.aiPanel.head.ctrl.hwnd);
		shell.rightDock.setSelIndex(1);
		var aiOff = ..win.isVisible(shell.aiPanel.head.ctrl.hwnd);
		io.print("AI-TAB:" ++ tostring(aiOn) ++ "/" ++ tostring(aiOff));
		io.print("AI-CTRLS:" ++ tostring(shell.aiPanel.log ? 1 : 0) ++ "/"
			++ tostring(shell.aiPanel.input ? 1 : 0));

		// ---------- 第五十六轮：设计器拖拽落点 ----------
		//
		// ① 接线完整性：工具箱的 onDrop 回调挂上了吗
		io.print("DROP-WIRED:" ++ tostring(app.designer.dropReady() ? 1 : 0));
		// ② 避让算法：已有控件占着 (20,20) 时，落点必须避开它
		//    （以前从工具箱加控件一律落在 (20,20)，连点三次就叠一起）
		var __spot = app.designer.canvasFreeSpotIn(
			{ {x=20; y=20; w=120; h=30} }, 120, 30, 20, 20, 600, 400);
		var __ovl = (__spot.x < 142 && __spot.x + 122 > 20
			&& __spot.y < 52 && __spot.y + 32 > 20) ? 1 : 0;
		io.print("SPOT-FREE:" ++ (__ovl ? "OVERLAP" : "OK"));
		// ③ 坐标往返：设计坐标 → 客户区 → 设计坐标，误差 ≤ 1 设计像素
		var __c = app.designer.canvasDesignToClient(40, 30);
		var __d = app.designer.canvasClientToDesign(__c.x, __c.y);
		var __err = math.abs(__d.x - 40) + math.abs(__d.y - 30);
		io.print("COORD-RT:" ++ (__err <= 2 ? "OK" : ("BAD:" ++ tostring(__err))));
		// ④ 表面命中：窗体表面内 true、表面外 false
		var __inS = app.designer.canvasHitSurface(__c.x, __c.y);
		var __outS = app.designer.canvasHitSurface(5, 5);
		io.print("SURFACE-HIT:" ++ ((__inS && !__outS) ? "OK" : "BAD"));

		// ⑤ 端到端：模拟一次**真实拖拽**（按下 → 移动 → 松开），
		//    控件必须真的落到画布上（走工具箱自己的鼠标回调路径）。
		if(!app.designer.isActive()){
			if(shell.hooks.onDesigner) shell.hooks.onDesigner();
		}
		var __n0 = app.designer.canvasCount();
		var __rect = app.designer.surfaceScreenRect();
		var __e2e = 0;
		if(__rect){
			var __ran = app.designer.simulateToolboxDrop("按钮",
				__rect.left + 120, __rect.top + 80);
			var __n1 = app.designer.canvasCount();
			var __sel = app.designer.canvasSelected();
			// ⚠ 不能用 `#__sel` 判空：aardio 的 `#` 是**数组长度**语义，
			//   对字符串键的 table（组件描述）恒为 0 —— 写 `#>0` 会永远判假。
			var __hasSel = (__sel !== null && __sel !== undefined) ? 1 : 0;
			__e2e = (__ran && __n1 == __n0 + 1 && __hasSel) ? 1 : 0;
			io.print("DROP-E2E:" ++ tostring(__e2e));
			// 清理：测试加的控件删掉，别把画布弄脏（后面的断言还要用画布）
			if(__hasSel) app.designer.canvasRemove(__sel.name);
		}
		// ⑥ 真实窗口消息路径的拖拽（PostMessage → 子类化窗口过程 → 状态机）
		//
		// 这是最接近「用户真的用鼠标拖」的一条路：消息进工具箱板的
		// 窗口过程 → onMouseDown/Move/Up → 拖拽状态机 → onDrop。
		// PostMessage 是异步的，所以延后一拍再查结果。
		var __n0c = app.designer.canvasCount();
		if(__rect){
			var __ranC = app.designer.simulateToolboxDropMsg("按钮",
				__rect.left + 200, __rect.top + 120);
			shell.winform.setTimeout(function(){
				var __n1c = app.designer.canvasCount();
				io.print("DROP-MSG:" ++ tostring((__ranC && __n1c == __n0c + 1) ? 1 : 0));
				var __selC = app.designer.canvasSelected();
				if(__selC) app.designer.canvasRemove(__selC.name);
			}, 200);
		}
		else{
			io.print("DROP-E2E:SKIP");
		}
		// —— 窗体属性对话框（第五十九轮续）——
		// ① DSG 往返：border/bgcolor 从 DSG 头读回、toDSG 原样写出；
		// ② 全链：菜单「窗体设置」→ 对话框填字段 → 确定 → applyFormProps
		//    写回 canvas.form（DSG 头跟着变），对话框自关。
		if(!app.designer.isActive()){
			if(shell.hooks.onDesigner) shell.hooks.onDesigner();
		}
		var __dsg0 = '/*DSG{{*/\r\nwinform = win.form(text="测试";right=600;bottom=400;bgcolor=0x3C3C3C;border="resize")\r\nwinform.add(\r\n)\r\n/*}}*/';
		app.designer.fromDSG(__dsg0);
		var __rtF = app.designer.toDSG();
		var __fRT = ((..string.indexOf(__rtF, 'border="resize"') !== null)
			&& (..string.indexOf(__rtF, 'bgcolor=0x3C3C3C') !== null)) ? 1 : 0;
		io.print("FORM-DSG-RT:" ++ tostring(__fRT));
		var __dlg = app.designer.formDialogRef();
		var __fDlg = 0;
		if(__dlg){
			if(shell.hooks.onDesignerForm) shell.hooks.onDesignerForm();
			..nodio.ui.setCtrlText(__dlg.edText, "冒烟窗体");
			..nodio.ui.setCtrlText(__dlg.edW, "520");
			..nodio.ui.setCtrlText(__dlg.edH, "380");
			..nodio.ui.setCtrlText(__dlg.edBg, "0x2B2B2B");
			..nodio.ui.setCtrlText(__dlg.edBd, "dialog");
			__dlg.__ok();
			var __f2 = app.designer.formGet();
			__fDlg = ((__f2.text == "冒烟窗体") && (__f2.w == 520)
				&& (__f2.h == 380) && (__f2.bgcolor == 0x2B2B2B)
				&& (__f2.border == "dialog") && !__dlg.visible) ? 1 : 0;
			// 还原画布（别把后续断言弄脏）
			app.designer.fromDSG('/*DSG{{*/\r\nwinform = win.form(text="窗体";right=759;bottom=469)\r\nwinform.add(\r\n)\r\n/*}}*/');
		}
		io.print("FORM-DLG:" ++ tostring(__fDlg));
		// ⑦ 闪烁回归（第五十八轮）：连续 show(true) 不该反复整块重画
		//
		// IDE 的心跳每 300ms 调一次开始页的 show —— 而 show(true) 原来
		// 每次都整块重画 → **每 300ms 闪一次**（无文档时最明显）。
		// 现在只有「隐藏→显示」这一下才重画。
		var __bd = shell.rightDock.strip.board;
		if(__bd && __bd.redrawCount){
			__bd.show(true);
			var __c1 = __bd.redrawCount();
			__bd.show(true);
			__bd.show(true);
			var __c2 = __bd.redrawCount();
			io.print("SHOW-REDRAW:" ++ tostring(__c2 - __c1));
		}
	},900);

	// ---------- AI 发送链路：等结果出来再断言 ----------
	//
	// ⚠ 不能用固定时间点断言：worker 线程第一次跑时要**自己解析**
	//   nodio.ai.chat / nodio.ai.http 两个模块（每个解释器各有一份模块缓存），
	//   x86 上这一步比 900ms 检查点还慢 —— 固定点断言会在请求还没回来时
	//   就打印「没有错误」，看着像通过，其实链路根本没跑完。
	//   所以这里改成**轮询到请求结束**再打印，超时（20s）也打印（带 busy:true）。
	//
	// 关窗也要等它：上面的关窗定时器带 aiCheckDone 条件。
	//
	// 两段：阶段 0 = 成功（对 mock 服务器）→ 阶段 1 = 失败（对没人监听的端口）。
	if(aiIsolated){
		var aiTicks = 0;
		var aiPhase = 0;      // 0=等成功 1=等失败 2=完事
		var aiTimer = shell.winform.setInterval(function(){
			aiTicks = aiTicks + 1;
			if(aiTicks < 5) return null;          // 先给 worker 一点时间起跑
			if(shell.aiPanel.busy && aiTicks < 200) return null;   // 还在请求 → 继续等

			if(aiPhase == 0){
				// ---- 阶段 0：成功回包 ----
				var logOk = shell.aiPanel.getLog();
				io.print("AI-SEND-USER:" ++ tostring(..string.indexOf(logOk, "我: 冒烟-成功") ? 1 : 0));
				io.print("AI-SEND-REPLY:" ++ tostring(..string.indexOf(logOk, "AI: MOCK-OK") ? 1 : 0));
				io.print("AI-SEND-MSGS:" ++ tostring(#shell.aiPanel.session.messages));
				io.print("AI-SEND-BUSY:" ++ tostring(shell.aiPanel.busy));
				// ---- 进入阶段 1：失败回包 ----
				aiPhase = 1;
				aiTicks = 0;
				try{
					shell.aiPanel.session.baseUrl = "http://127.0.0.1:1/v1";
					..nodio.ui.setCtrlText(shell.aiPanel.input, "冒烟-失败");
					shell.aiPanel.send();
				}
				catch(e3){}
				return null;
			}

			// ---- 阶段 1：失败回包 ----
			var logErr = shell.aiPanel.getLog();
			io.print("AI-SEND-ERRUSER:" ++ tostring(..string.indexOf(logErr, "我: 冒烟-失败") ? 1 : 0));
			io.print("AI-SEND-ERR:" ++ tostring(..string.indexOf(logErr, "[错误]") ? 1 : 0));
			io.print("AI-SEND-ERRMSGS:" ++ tostring(#shell.aiPanel.session.messages));
			io.print("AI-SEND-TICKS:" ++ tostring(aiTicks));
			// 测试凭据用完就删（隔离名，不影响用户真实 Key）
			try{ nodio.ai.cred.apiKeyRemove() }catch(e2){}
			// ⚠ 定时器必须自己摘掉：官方 WM_TIMER 只按返回值决定留不留，
			//   这里返回 null = 继续跑 → 每 100ms 重复打一遍断言。
			try{ shell.winform.clearInterval(aiTimer) }catch(e4){}
			aiCheckDone = true;
			return null;
		},100);
	}
	else{
		aiCheckDone = true;
	}
}

// ---------- 导航 smoke（NODIO_IDE_NAV_SMOKE=1）----------
// 无头自检「转到定义 / 查找引用 / 重命名 / 符号搜索」整条链路：
// 打开 app/shell.nodio，问 LSP 它里面 app.editor.contextMenu 的定义在哪
//（contextMenu 定义在 app/editor.nodio —— 必须跨文件找得到）。
if( ..string.getenv("NODIO_IDE_NAV_SMOKE") ){
	io.print("NAV-SMOKE-BRANCH");
	var navProj = ..string.getenv("NODIO_IDE_PROJECT") : "D:\Nodio\ide\nodio\ide.nproj";
	proj = app.project.load(navProj);
	if(proj) projRefresh();
	var navPath = proj ? (proj.root ++ "app\shell.nodio") : "";
	if(!navPath || !..io.exist(navPath)){
		io.print("NAV-SMOKE-NO-FILE");
		shell.winform.close();
	}
	else{
		openTab(navPath);
		var navTick = 0;
		var navDone = false;
		shell.winform.setInterval(function(){
			if(navDone) return;
			navTick = navTick + 1;
			// setProject 是通知：服务端要把整个工程扫一遍才建好索引，等它一会儿
			if(navTick < 8) return;
			navDone = true;
			// 找 app.editor.contextMenu 的调用点
			var txt = shell.tabGetText(navPath);
			var lines = ..string.split(txt, '\n');
			var row = 0, col = 0;
			for(i=1;#lines;1){
				var j = ..string.indexOf(lines[i], "app.editor.contextMenu");
				if(j > 0){ row = i; col = j + 11; break }
			}
			io.print("NAV-SITE:" ++ tostring(row) ++ "," ++ tostring(col));
			var navDiags = app.lspClient.getDiags();
			io.print("NAV-DIAGS:" ++ tostring(#navDiags));
			for(i=1;#navDiags;1){
				io.print("NAV-DIAG:" ++ tostring(navDiags[i].line + 1) ++ ":" ++ tostring(navDiags[i].msg));
			}
			// 导航栏（面包屑）：工程 › 目录 › 文件 › 符号链
			// 符号树是懒的（心跳里拉），这里先强制拉一次再算链
			navRefreshSymTree();
			io.print("NAV-SYMTREE:" ++ tostring(#curSymTree));
			var navChain = navBuildChain(row);
			var navTxt = "";
			for(k=1;#navChain;1){
				navTxt = navTxt ++ navChain[k].text ++ "|";
			}
			io.print("NAV-CHAIN:" ++ navTxt);

			// 找一个**有body的函数**（kind 12 = Function）：
			// 光标落在它里面时，链里必须出现它；点它要能跳回那一行。
			var fnLine = 0, fnName = "";
			var findFn = function(nodes){
				var i, n;
				for(i=1;#nodes;1){
					n = nodes[i];
					if(n.kind == 12 && n.endLine > n.line){
						fnLine = n.line; fnName = n.name;
						return true;
					}
					if(findFn(n.children)) return true;
				}
				return false;
			};
			findFn(curSymTree);
			if(fnLine){
				var fnChain = navBuildChain(fnLine + 1);
				var fnTxt = "";
				for(k=1;#fnChain;1) fnTxt = fnTxt ++ fnChain[k].text ++ "|";
				io.print("NAV-FNCHAIN:" ++ fnTxt);
				io.print("NAV-FNNAME:" ++ fnName);
				io.print("NAV-FNLINE:" ++ tostring(fnLine));
				shell.editor.onNavClick(fnChain[#fnChain]);
				io.print("NAV-FNCUR:" ++ tostring(shell.editor.curLine));
				// 钩子链路端到端：onNavClick → 光标移动 → 编辑器 onCursor →
				// shell 的 hooks.onCursorMove → navUpdate → 组件 navChain
				var cc = shell.editor.navChain;
				var ct = "";
				for(k=1;#cc;1) ct = ct ++ cc[k].text ++ "|";
				io.print("NAV-COMPCHAIN:" ++ ct);
			}
			var defs = app.lspClient.definition(row - 1, col - 1);
			io.print("NAV-DEF-COUNT:" ++ tostring(#defs));
			if(#defs){
				io.print("NAV-DEF-PATH:" ++ defs[1].path);
				io.print("NAV-DEF-LINE:" ++ tostring(defs[1].line));
				io.print("NAV-DEF-COL:" ++ tostring(defs[1].col));
			}
			var refs = app.lspClient.references(row - 1, col - 1);
			io.print("NAV-REF-COUNT:" ++ tostring(#refs));
			var ren = app.lspClient.rename(row - 1, col - 1, "ctxMenuRenamed");
			io.print("NAV-RENAME-COUNT:" ++ tostring(#ren));
			var syms = app.lspClient.workspaceSymbols("contextMenu");
			io.print("NAV-SYM-COUNT:" ++ tostring(#syms));
			// 引用面板：填进去看看行数对不对
			navFindReferences(row, col, "contextMenu");
			io.print("NAV-REF-ROWS:" ++ tostring(#shell.refList.rows));

			// ---- 完整链路：编辑器回调 → 跨文件打开 → 光标落位 ----
			shell.editor.onDefinition(row, col, "contextMenu");
			io.print("NAV-JUMP-PATH:" ++ tostring(shell.tabCurPath()));
			io.print("NAV-JUMP-LINE:" ++ tostring(shell.editor.curLine));

			// ---- 跨文件重命名（临时工程，绝不碰真源码）----
			var tmpDir = ..io.fullpath(..string.getenv("TEMP") ++ "/nodio_nav_proj");
			..io.createDir(tmpDir);
			var aPath = tmpDir ++ "\a.nodio";
			var bPath = tmpDir ++ "\b.nodio";
			..string.save(aPath, "var shared = 1;\nvar other = 2;\n");
			..string.save(bPath, "..io.print(shared);\n");
			openTab(bPath);
			// 把 LSP 的项目索引指到临时工程
			var tmpFiles = [ @{_type="array"} ];
			..table.push(tmpFiles, "a.nodio");
			..table.push(tmpFiles, "b.nodio");
			app.lspClient.setProject(tmpDir, tmpFiles);
			// 等服务端把临时工程扫完
			var navTick2 = 0;
			shell.winform.setInterval(function(){
				navTick2 = navTick2 + 1;
				if(navTick2 < 6) return;
				var bt = shell.tabGetText(bPath);
				var blines = ..string.split(bt, '\n');
				var brow = 0, bcol = 0;
				for(i=1;#blines;1){
					var j = ..string.indexOf(blines[i], "shared");
					if(j > 0){ brow = i; bcol = j; break }
				}
				io.print("NAV-REN2-SITE:" ++ tostring(brow) ++ "," ++ tostring(bcol));
				var ren2 = app.lspClient.rename(brow - 1, bcol - 1, "renamed");
				io.print("NAV-REN2-COUNT:" ++ tostring(#ren2));
				if(#ren2) navApplyRename(ren2, "renamed");
				var atext = ..string.load(aPath);
				var btext = shell.tabGetText(bPath);
				io.print("NAV-REN2-A:" ++ ((..string.indexOf(atext, "renamed") > 0) ? "OK" : "BAD"));
				io.print("NAV-REN2-B:" ++ ((..string.indexOf(btext, "renamed") > 0) ? "OK" : "BAD"));
				io.print("NAV-REN2-AOLD:" ++ ((..string.indexOf(atext, "shared") > 0) ? "STILL" : "GONE"));
				io.print("NAV-SMOKE-DONE");
				// 收工前把 LSP 停掉：它继承了 stdout 句柄，
				// 不关的话 IDE 退出后日志文件还被占着，测试脚本读不出来。
				app.lspClient.stop();
				shell.winform.close();
			},500);
			return;
			io.print("NAV-SMOKE-DONE");
			shell.winform.close();
		},500);
	}
}

// ---------- 布局诊断（NODIO_IDE_DIAG=1 时每秒打印一次几何） ----------
if( ..string.getenv("NODIO_IDE_DIAG") ){
	var diagRect = function(label, ctrl){
		if(!ctrl) { io.print("DIAG " ++ label ++ " = null"); return }
		var r = ctrl.getRect();
		io.print("DIAG " ++ label ++ " = " ++ (r ? (r.left ++ "," ++ r.top ++ "," ++ r.right ++ "," ++ r.bottom) : "norec")
			++ "  vis=" ++ tostring(..win.isVisible(ctrl.hwnd)));
	}
	shell.winform.setInterval(function(){
		var cr = shell.winform.getClientRect();
		var wr = ..win.getRect(shell.winform.hwnd, true);
		io.print("DIAG client = " ++ cr.left ++ "," ++ cr.top ++ "," ++ cr.right ++ "," ++ cr.bottom
			++ "  win = " ++ wr.left ++ "," ++ wr.top ++ "," ++ wr.right ++ "," ++ wr.bottom);
		diagRect("leftstrip", shell.leftDock.strip.board.ctrl);
		diagRect("rightstrip", shell.rightDock.strip.board.ctrl);
		diagRect("bottomstrip", shell.bottomDock.strip.board.ctrl);
		diagRect("docstrip", shell.docStrip.board.ctrl);
		diagRect("editor", shell.winform.ed);
		diagRect("toolbox", shell.rightDock.pages[1].ctrl);
		diagRect("status", shell.statusbar.panels[1].ctrl);
		diagRect("toolbarbtn", shell.toolbar.buttons.new);
		diagRect("canvas", designer.canvas.bg.ctrl);
		if(designer.canvas.items[1]){
			diagRect("item1", designer.canvas.items[1].ctrl);
		}
		return null;   // 官方 WM_TIMER 会按返回值决定是否移除定时器
	},1000);
}

// ---------- 演示模式（NODIO_IDE_DEMO=1）----------
// 打开工程树 / 文档页签 / 设计器，供截图回归看到完整界面。
if( ..string.getenv("NODIO_IDE_DEMO") ){
	var demoProj = ..string.getenv("NODIO_IDE_PROJECT") : "D:\Nodio\ide\nodio\ide.nproj";
	proj = app.project.load(demoProj);
	if(proj){
		projRefresh();
		shell.setProjectStatus(tostring(proj.path));
	}
	// 演示模式可以指定要打开的文件（默认开一个能正常编译的文件）：
	//   NODIO_IDE_DEMO_FILE=<路径>  —— 走 openFile，LSP 会跟着起来，
	//   打开一个**有语法错**的文件就能看到槽内波浪线 + 行号栏标记 + 问题列表。
	var demoFile = ..string.getenv("NODIO_IDE_DEMO_FILE")
		: "D:\Nodio\ide\nodio\app\shell.nodio";
	if(..io.exist(demoFile)){
		openFile(demoFile);
		fillOutline();
	}
	// 演示模式可以把光标放到指定行（截图回归用）：
	//   NODIO_IDE_DEMO_LINE=<行号> —— 导航栏面包屑会跟着显示所在函数
	var demoLine = tonumber(..string.getenv("NODIO_IDE_DEMO_LINE"));
	if(demoLine && demoLine > 0){
		shell.winform.setTimeout(function(){
			shell.editor.gotoLine(demoLine);
			// NODIO_IDE_DEMO_COL=<列> —— 把光标钉到行内第 N 个字符上
			//（引用标记的视觉回归：光标停在符号上 ~300ms 后同符号垫亮）
			var demoCol = tonumber(..string.getenv("NODIO_IDE_DEMO_COL"));
			if(demoCol && demoCol > 0){
				try{
					var a = shell.editor.__lineStart(demoLine);
					if(a) shell.editor.ctrl.setSel(a + demoCol - 1);
					shell.editor.updateCursor();
				}catch(e1){}
			}
		}, 2200);
	}
	designer.open();
	// 演示模式可以弹出**悬停提示**浮层（视觉回归用）：
	//   NODIO_IDE_DEMO_HOVER=1 —— 在编辑区放一个 hover 提示
	if( ..string.getenv("NODIO_IDE_DEMO_HOVER") ){
		shell.winform.setTimeout(function(){
			shell.editor.gotoLine(12);
			var p = shell.editor.__posOf(60);
			shell.editor.showHover('myFunc  \n*function*',
				(p & 0xFFFF) + 12, (p >> 16) & 0xFFFF);
		}, 2400);
	}
	// 演示模式可以指定要看哪个页签（视觉回归用）：
	//   NODIO_IDE_DEMO_TAB=outline|library|problems|syntax|tools|examples|search|gallery|source
	var demoTab = ..string.getenv("NODIO_IDE_DEMO_TAB");
	if(demoTab == "outline") shell.leftDock.setSelIndex(4);
	elseif(demoTab == "library") shell.rightDock.setSelIndex(3);
	elseif(demoTab == "syntax") shell.rightDock.setSelIndex(2);
	elseif(demoTab == "tools") shell.rightDock.setSelIndex(5);
	elseif(demoTab == "examples") shell.rightDock.setSelIndex(4);
	elseif(demoTab == "problems"){
		shell.bottomDock.setSelIndex(1);
		designer.close();     // 设计器画布会盖住编辑器 —— 看诊断时关掉
	}
	elseif(demoTab == "search") shell.leftDock.setSelIndex(3);
	elseif(demoTab == "gallery") shell.rightDock.setSelIndex(1);
	// ↑ 右栏已无「组件」展厅页 —— gallery 映射到「控件」（设计器工具箱）
	elseif(demoTab == "designer"){
		// 设计器 + 左栏「属性」页：验证属性格的**分组带**
		shell.leftDock.setSelIndex(2);
	}
	elseif(demoTab == "source") designer.close();   // 只看编辑器（查源码渲染）
	elseif(demoTab == "references"){
		// 演示「查找引用」：问 LSP 要 app.editor.contextMenu 的全部引用，
		// 填进底部「引用」页签（截图回归用）。
		designer.close();
		shell.bottomDock.setSelIndex(5);
		shell.winform.setTimeout(function(){
			var dpath = curFile;
			var dtxt = shell.tabGetText(dpath);
			var dlines = ..string.split(dtxt, '\n');
			var drow = 0, dcol = 0;
			for(i=1;#dlines;1){
				var j = ..string.indexOf(dlines[i], "app.editor.contextMenu");
				if(j > 0){ drow = i; dcol = j + 11; break }
			}
			if(drow) navFindReferences(drow, dcol, "contextMenu");
		},2500);
	}
	var dspec = nodio.designer.registry.get("按钮");
	if(dspec){
		var ditem = designer.canvas.add(dspec, {x=40; y=40; w=120; h=30});
		designer.canvas.select(ditem.name);
	}
	// 演示：搜索页跑一次真实搜索（视觉回归用）
	if(demoTab == "search"){
		shell.winform.setTimeout(function(){
			shell.searchPanel.ed.text = "function";
			shell.searchPanel.search("function");
		}, 600);
	}
	shell.setStatus("演示模式");
	// 演示：拉起系统「打开文件」对话框（验证「打开文件」这条链路）
	if( ..string.getenv("NODIO_IDE_DEMO_DLG") ){
		shell.winform.setTimeout(function(){
			openFileDialog();
		}, 1500);
	}
	// 演示：拉起查找替换条（验证查找浮条这条链路）
	if( ..string.getenv("NODIO_IDE_DEMO_FIND") ){
		shell.winform.setTimeout(function(){
			shell.editor.showFind(true);
			shell.editor.findEd.text = "function";
		}, 1200);
	}
	// 演示：拉起输入提示条（转到行）
	if( ..string.getenv("NODIO_IDE_DEMO_PROMPT") ){
		shell.winform.setTimeout(function(){
			shell.showPrompt("转到行", "42", function(t){
				shell.setStatus("跳到行 " ++ t);
				return true;
			});
		}, 1200);
	}
	// 演示：拉起代码补全浮层（走真 LSP：编辑器算前缀 → LSP 出候选 → 浮层）
	if( ..string.getenv("NODIO_IDE_DEMO_COMPLETE") ){
		shell.winform.setTimeout(function(){
			// 停在第 1 行 "var alpha = 1" 的 alph| 后面
			var ln = 1;
			var ls = shell.editor.__lineStart(ln);
			shell.editor.gotoPos(ls + 8);
			shell.editor.requestComplete();
		}, 1500);
	}
	// 演示：模拟真实键盘输入（在 IDE 自己身上打字，验证输入链路通不通）
	//
	// 这条链路以前是**必崩**的：官方 win 消息泵对任何按键消息都会调
	// win.isDialogMessage(root,msg)，而消息表没有结构体定义 → FFI 传 NULL
	// → IsDialogMessageW 读地址 0 → 进程直接没了。
	if( ..string.getenv("NODIO_IDE_DEMO_TYPE") ){
		shell.winform.setTimeout(function(){
			shell.editor.setFocus();
			..win.setForeground(shell.winform.hwnd);
			var u32 = ..raw.loadDll("user32.dll");
			var keybd = u32.api("keybd_event",
				"void(int bVk,int bScan,int dwFlags,addr dwExtraInfo)");
			..win.delay(400);
			var before = shell.editor.text;
			keybd(0x58, 0, 0, 0); keybd(0x58, 0, 2, 0);   // X
			..win.delay(600);
			var after = shell.editor.text;
			io.print("TYPE-LEN-BEFORE:" ++ tostring(#before)
				++ " AFTER:" ++ tostring(#after));
			io.print("TYPE-TEXT:[" ++ ..string.replace(tostring(after), '\r\n', '|') ++ "]");
		}, 2000);
	}
}

// ---------- 正常模式（不是任何测试分支）：加载工程 ----------
//
// 之前这一段根本不存在 —— 工程只在 smoke / nav / demo 三个测试分支里加载，
// 正常启动 IDE 是**一片空白**（工程树空、编辑器空、没工程），
// 看上去就像「所有功能都没接上」。
//
// ⚠ 现在**不再**放在 show() 之前：加载工程要扫目录树、打开起始文件还要
// 做全量语法着色，全在窗口显示前跑完的话，用户看到的是「半分钟白屏」。
// 改成 show() 之后由心跳分阶段做（见 bootTick）—— 先渲染，再加载。
if(!isTestMode){
	// 标记「等窗口出来后再加载」
	bootNeedProject = true;
}

// 显示主窗体。
//
// 这里不是简单地调 show()：实测官方 win.ui 的 show() 路径在 Nodio 上
// **偶发**（约 1/4 概率）只把窗口建出来却不真正显示 —— 窗口过程的
// WM_SHOWWINDOW 没有走到 DefWindowProc，WS_VISIBLE 永远不被置上，
// 表现是「进程活着、IDE 在跑、但屏幕上没有窗口」。
// 所以：调用后显式自检一次可见性，不可见就用最朴素的 ShowWindow 兜底，
// 并把状态打印出来（宁可吵，也不要静默地没有窗口）。
var showErr = null;
try{
	shell.winform.show();
}
catch(e){
	showErr = tostring(e);
}
var formVis = false;
try{ formVis = !!::User32.IsWindowVisible(shell.winform.hwnd) }catch(e3){};
if(showErr || !formVis){
	if(showErr) io.print("SHOW-ERR:" ++ showErr);
	else io.print("SHOW-WARN: 主窗体已创建但不可见（官方 win.ui show 路径）");
	// 兜底：绕开官方 DPI 初始化，直接按 Win32 语义显示
	try{
		::User32.ShowWindow(shell.winform.hwnd, 5);
		::User32.SetWindowPos(shell.winform.hwnd, -2/*_HWND_NOTOPMOST*/,
			0, 0, 0, 0, 0x43/*_SWP_NOMOVE|_SWP_NOSIZE|_SWP_SHOWWINDOW*/);
	}catch(e2){};
}

// 去掉原生标题栏，换成自绘标题栏（菜单栏合并在里面）。
// 必须在 show 之后：官方 win.form 在 show 时才做 DPI 初始化并重排控件，
// 提前改样式会被官方那套布局打回去。
// 去掉标题栏后客户区会变大（原来标题栏占的那条），applyBorderless 里重排一次。
try{
	shell.applyBorderless();
}
catch(e4){
	io.print("BORDERLESS-ERR:" ++ tostring(e4));
}

// 窗口摆位：官方 win.form 建窗时给的默认位置会把窗口甩到屏幕外
// （实测 2560x1440 屏上，1280x820 的窗体会落在 x=946，右边 329 像素
//  在屏幕外 —— 右栏「标准库/工具/AI/组件」那几页签根本点不到）。
// IDE 的窗口应该老老实实落在主显示器工作区里并最大化。
try{
	var _hwnd = shell.winform.hwnd;
	::User32.SetWindowPos(_hwnd, -2/*_HWND_NOTOPMOST*/, 0, 0, 0, 0,
		0x43/*_SWP_NOMOVE|_SWP_NOSIZE|_SWP_SHOWWINDOW*/);
	::User32.ShowWindow(_hwnd, 3/*_SW_MAXIMIZE*/);
	..nodio.ui.dpiSetScaleFrom(shell.winform);
	shell.flushLayout();
}
catch(e5){}

// ⚠ 窗口显示后**强制所有自绘板整块重画一次**。
//
// 官方 plus 的 WM_PAINT 只画「本次失效区域」（win/ui/ctrl/plus.aardio:833
// 把 rcPaint 当裁剪区）：更新区为空 ⇒ 这一画等于没画。
// 画板是在窗体显示**之前**创建的，等窗体真正显示出来时它们的更新区
// 往往已经被判空 —— 于是窗口在、面板在、矩形也对，屏幕上却是一片空白。
// （实测：标题栏 / 工具条 / 行号栏画出来了，三个停靠面板、页签条、
//   状态栏全没有 —— 正好是「从没被显式提到 HWND_TOP 的那些板子」。）
// 启动期结束：关掉延迟绘制，把**最终一帧**画出来。
// 这一帧是用户真正看到的第一帧完整界面。
..nodio.ui.setDeferredPaint(false);
try{
	..nodio.ui.redrawAll();
}catch(e6){}

return win.loopMessage();
